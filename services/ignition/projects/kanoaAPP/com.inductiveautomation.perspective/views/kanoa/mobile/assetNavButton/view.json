    "events": {
      "dom": {
        "onClick": {
          "config": {
            "script": "\t\n\tif self.view.custom.tagOEEInfo is None:\n\t\tif self.view.custom.assetInfo.assetTypeName \u003d\u003d \u0027line\u0027:\n\t\t\tself.toast({\u0027message\u0027: \u0027Line asset not OEE configured\u0027, \u0027type\u0027: \u0027info\u0027})\n\t\telse:\n\t\t\tsystem.kanoa.utilities.storeAssetPath(self, self.view.params.value.assetPath)\n\t\t\tsystem.perspective.sendMessage(\u0027assetNavSelection\u0027, payload\u003d{\u0027value\u0027: {\u0027assetId\u0027: self.view.params.value.assetId, \u0027assetPath\u0027: self.view.params.value.assetPath}})\n\telse:\n\t\tsystem.kanoa.utilities.storeAssetPath(self, self.view.params.value.assetPath)\n\t\tparams\u003d {\"path\": \"kanoa/mes/asset/operation/main\", \"name\": \"Asset Operation\", \"type\": \"view\", \"params\": {}}\n\t\tsystem.perspective.sendMessage(\"updateNavigation\", payload\u003dparams)\n\t\n\treturn"
          },
          "scope": "G",
          "type": "script"
        }
