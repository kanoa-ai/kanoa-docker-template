            "events": {
              "component": {
                "onActionPerformed": {
                  "config": {
                    "script": "\n\tworkOrderEventStatusInfo \u003d dict(self.view.custom.workOrderEventStatusInfo)\n\tuserId \u003d system.kanoa.security.getIDPUserId(self.session.props.auth.user)\n\t\n\tif workOrderEventStatusInfo[\u0027workOrderEventStatusId\u0027] is not None: \t#If name has changed, we need to check that it doesn\u0027t already exist\n\t\tcurrentWorkOrderEventStatusId \u003d system.kanoa.utilities.getFieldValue(\u0027workOrderEventStatusId\u0027, system.kanoa.cmms.getWorkOrderEventStatus({\u0027workOrderEventStatusName\u0027: workOrderEventStatusInfo[\u0027workOrderEventStatusName\u0027], \u0027workOrderEventStatusId\u0027: workOrderEventStatusInfo[\u0027workOrderEventStatusId\u0027]}))\n\t\tif currentWorkOrderEventStatusId is not None and currentWorkOrderEventStatusId !\u003d workOrderEventStatusInfo[\u0027workOrderEventStatusId\u0027]:\n\t\t\tsystem.perspective.sendMessage(\u0027showFailerToast\u0027, {\u0027message\u0027: \u0027This status already exists\u0027})\n\t\t\treturn\n\t\t\n\t\tsystem.perspective.sendMessage(\u0027showInfoToast\u0027, {\u0027message\u0027: \u0027Updating status %i \u0027%workOrderEventStatusInfo[\u0027workOrderEventStatusId\u0027]})\t\t\t\n\t\tretVal, msg \u003d system.kanoa.cmms.updateWorkOrderEventStatus(workOrderEventStatusInfo, userId)\n\telse:\n\t\tsystem.perspective.sendMessage(\u0027showInfoToast\u0027, {\u0027message\u0027: \u0027Adding status\u0027})\t\n\t\tworkOrderEventStatusId, msg \u003d system.kanoa.cmms.addWorkOrderEventStatus(workOrderEventStatusInfo, userId)\n\t\t\n\tif msg:\n\t\tsystem.perspective.sendMessage(\u0027showFailerToast\u0027, {\u0027message\u0027: \"Couldn\u0027t save this status. %s\"%msg})\n\telse:\n\t\tsystem.perspective.sendMessage(\u0027showSuccessfulToast\u0027, {\u0027message\u0027: \"Status has been saved\"})\n\n\tsystem.perspective.sendMessage(\"refreshWorkOrderEventStatus\", {})\t\n\tsystem.perspective.closePopup(\u0027\u0027)\n\t\n\treturn"
                  },
                  "scope": "G",
                  "type": "script"
                }
              }
            },
