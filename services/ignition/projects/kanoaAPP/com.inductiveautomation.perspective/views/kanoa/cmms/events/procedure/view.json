    "custom.steps.selectedStepName": {
      "binding": {
        "config": {
          "struct": {
            "steps": "{view.custom.procedureStepEvents}",
            "tabs": "{view.custom.tabs}"
          },
          "waitOnAll": true
        },
        "overlayOptOut": true,
        "transforms": [
          {
            "code": "\n\tif len(value[\u0027tabs\u0027][\u0027tabList\u0027]) \u003d\u003d 0: return None\n\treturn value[\u0027tabs\u0027][\u0027tabList\u0027][value[\u0027tabs\u0027][\u0027tabIndex\u0027]]\n",
            "type": "script"
          }
        ],
        "type": "expr-struct"
      }
    },
    "custom.tabs": {
      "persistent": true
    },
    "custom.tabs.tabIndex": {
      "binding": {
        "config": {
          "expression": "now(0)"
        },
        "overlayOptOut": true,
        "transforms": [
          {
            "code": "\treturn 0",
            "type": "script"
          }
        ],
        "type": "expr"
      }
    },
    "custom.tabs.tabList": {
      "binding": {
        "config": {
          "path": "view.custom.procedureStepEvents"
        },
        "overlayOptOut": true,
        "transforms": [
          {
            "code": "\t\n\tif not value: return []\n\treturn [row[\u0027stepName\u0027] for row in value]",
            "type": "script"
          }
        ],
        "type": "property"
      }
    },
    "custom.userAction": {
      "binding": {
        "config": {
          "struct": {
            "security": "{view.custom.security}"
          },
          "waitOnAll": false
        },
        "overlayOptOut": true,
        "transforms": [
          {
            "code": "\n\tsecurity \u003d value[\u0027security\u0027]\n\tcanCreate \u003d False\n\tcanEdit \u003d False\n\tif security[\u0027userCRUD\u0027] is not None and security[\u0027userId\u0027] is not None:\n\t\tif security[\u0027userCRUD\u0027][\u0027isGatewayAdmin\u0027] or security[\u0027userCRUD\u0027][\u0027configureMaintenance\u0027][\u0027enabled\u0027]: \n\t\t\tcanCreate \u003d True\n\t\t\tcanEdit \u003d True\n\t\n\treturn {\"canCreate\": canCreate, \"canDelete\": canEdit, \"canRead\": True, \"canUpdate\": canEdit}",
            "type": "script"
          }
        ],
        "type": "expr-struct"
      },
      "persistent": true
    },
    "custom.workOrderEventInfo": {
      "binding": {
        "config": {
          "path": "view.params.values"
        },
        "overlayOptOut": true,
        "transforms": [
          {
            "code": "\t\n\treturn system.kanoa.utilities.convertDatasetRowToJSON(system.kanoa.cmms.getWorkOrderEvents({\u0027workOrderEventId\u0027: value[\u0027workOrderEventId\u0027] or -1}),0)",
            "type": "script"
          }
        ],
        "type": "property"
      },
      "persistent": true
    },
    "params.values": {
      "paramDirection": "input",
      "persistent": true
    }
  },
