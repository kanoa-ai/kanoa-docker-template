          "name": "evStepEventEditor"
        },
        "position": {
          "grow": 1
        },
        "propConfig": {
          "position.display": {
            "binding": {
              "config": {
                "path": "view.custom.steps.selectedStepName"
              },
              "overlayOptOut": true,
              "transforms": [
                {
                  "code": "\treturn value is not None",
