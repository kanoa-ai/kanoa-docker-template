      },
      {
        "children": [
          {
            "meta": {
              "name": "tbSteps"
            },
            "position": {
              "shrink": 0
            },
            "propConfig": {
              "props.currentTabIndex": {
                "binding": {
                  "config": {
                    "bidirectional": true,
                    "path": "view.custom.tabs.tabIndex"
                  },
                  "overlayOptOut": true,
                  "type": "property"
                }
              },
              "props.tabs": {
                "binding": {
                  "config": {
                    "struct": {
                      "checks": "{view.custom.checks}",
                      "tabs": "{view.custom.tabs}"
                    },
                    "waitOnAll": true
                  },
                  "overlayOptOut": true,
                  "transforms": [
                    {
                      "code": "\n\tchecksByStep \u003d {}\n\tfor check in value[\u0027checks\u0027]:\tchecksByStep.setdefault(check[\u0027stepName\u0027], []).append(check)\n\t\n\ticons \u003d {\n\t\t\u0027PASS\u0027: {\u0027iconPath\u0027: \u0027material/check\u0027, \u0027color\u0027: \u0027--kcGoodContainer\u0027},\n\t\t\u0027FAIL\u0027: {\u0027iconPath\u0027: \u0027material/warning\u0027, \u0027color\u0027: \u0027--kcBadContainer\u0027},\n\t\t\u0027WARNING\u0027: {\u0027iconPath\u0027: \u0027material/warning\u0027, \u0027color\u0027: \u0027--kcOrange-30\u0027},\n\t\t\u0027NEUTRAL\u0027: {\u0027iconPath\u0027: \u0027material/check\u0027, \u0027color\u0027: \u0027--kcGray-10\u0027},\n\t\t\u0027NO STATE\u0027: {\u0027iconPath\u0027: \u0027\u0027, \u0027color\u0027: \u0027--kcGray-00\u0027}\n\t}\n\t\n\tinstances \u003d []\n\tfor i, tab in enumerate(value[\u0027tabs\u0027][\u0027tabList\u0027]):\n\t\tstepChecks \u003d checksByStep.get(tab, [])\n\t\tstateNames \u003d [c.get(\u0027chkItemStateName\u0027) for c in stepChecks if c.get(\u0027chkItemStateName\u0027)]\n\t\n\t\tif \u0027FAIL\u0027 in stateNames: stateName \u003d \u0027FAIL\u0027\n\t\telif \u0027WARNING\u0027 in stateNames: stateName \u003d \u0027WARNING\u0027\n\t\telif stateNames and all(s \u003d\u003d \u0027PASS\u0027 for s in stateNames): stateName \u003d \u0027PASS\u0027\n\t\telif \u0027NEUTRAL\u0027 in stateNames: stateName \u003d \u0027NEUTRAL\u0027\n\t\telse: stateName \u003d \u0027NO STATE\u0027\n\t\n\t\tinstances.append({\n\t\t\t\u0027viewPath\u0027: \u0027kanoa/core/templates/tabs/tabButton\u0027,\n\t\t\t\u0027viewParams\u0027: {\u0027values\u0027: {\n\t\t\t\t\u0027bgColor\u0027: icons[stateName][\u0027color\u0027],\n\t\t\t\t\u0027text\u0027: \u0027%s (%d)\u0027%(tab, len(stepChecks)) if len(stepChecks) \u003e 1 else \u0027%s\u0027%tab,\n\t\t\t\t\u0027icon\u0027: icons[stateName],\n\t\t\t\t\u0027selected\u0027: i \u003d\u003d value[\u0027tabs\u0027][\u0027tabIndex\u0027],\n\t\t\t\t\u0027toolTip\u0027: stateName\n\t\t\t}}\n\t\t})\n\t\n\treturn instances",
                      "type": "script"
                    }
                  ],
                  "type": "expr-struct"
                }
              }
            },
            "props": {
              "contentStyle": {
                "borderStyle": "none"
              },
              "menuType": "modern",
              "style": {
                "borderStyle": "none"
              },
              "tabSize": {
