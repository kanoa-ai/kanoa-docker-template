  "propConfig": {
    "custom.checks": {
      "binding": {
        "config": {
          "path": "view.custom.workOrderEventInfo"
        },
        "overlayOptOut": true,
        "transforms": [
          {
            "code": "\t\t\n#\tif value[\u0027procedureStepId\u0027] is None: return []\n#\t\n#\tchecks \u003d system.kanoa.utilities.convertDatasetToJSON(system.kanoa.cmms.getProcedureStepChecks({\u0027procedureStepId\u0027: value[\u0027procedureStepId\u0027]}))\n#\tcheckEventDict \u003d system.kanoa.utilities.convertDatasetToDict(system.kanoa.cmms.getProcedureStepCheckEvents({\u0027procedureStepEventId\u0027: value[\u0027procedureStepEventId\u0027] or -1}), \u0027checkName\u0027, None) or {}\n#\n#\tfor check in checks:\n#\t\tcheckEventInfo \u003d checkEventDict.get(check[\u0027checkName\u0027], {}) or {}\n#\t\tcheck[\u0027workOrderEventId\u0027] \u003d self.params.values.workOrderEventId\n#\t\tcheck[\u0027procedureStepCheckEventId\u0027] \u003d checkEventInfo.get(\u0027procedureStepCheckEventId\u0027)\n#\t\tcheck[\u0027procedureStepEventId\u0027] \u003d self.custom.procedureStepEventInfo.procedureStepEventId\n#\t\tcheck[\u0027value\u0027] \u003d checkEventInfo.get(\u0027value\u0027)\n#\t\tcheck[\u0027status\u0027] \u003d checkEventInfo.get(\u0027status\u0027)\n#\t\tcheck[\u0027chkItemStateName\u0027] \u003d checkEventInfo.get(\u0027chkItemStateName\u0027)\n#\t\tcheck[\u0027chkItemStateColor\u0027] \u003d checkEventInfo.get(\u0027chkItemStateColor\u0027)\n#\t\tcheck[\u0027comment\u0027] \u003d (checkEventDict.get(check[\u0027checkName\u0027], {}).get(\u0027comment\u0027))\n#\t\n#\treturn checks\t\t\n\t\n\tif value[\u0027workOrderEventId\u0027] is None or value[\u0027procedureId\u0027] is None:\treturn []\n\t\n\tsteps \u003d system.kanoa.utilities.convertDatasetToJSON(system.kanoa.cmms.getProcedureSteps({\u0027procedureId\u0027: value[\u0027procedureId\u0027]}))\n\tstepEventDict \u003d system.kanoa.utilities.convertDatasetToDict(system.kanoa.cmms.getProcedureStepEvents({\u0027workOrderEventId\u0027: value[\u0027workOrderEventId\u0027]}), \u0027procedureStepId\u0027, None)\n\tchecks \u003d system.kanoa.utilities.convertDatasetToJSON(system.kanoa.cmms.getProcedureStepChecks({\u0027procedureId\u0027: value[\u0027procedureId\u0027]}))\n\tcheckEvents \u003d system.kanoa.utilities.convertDatasetToJSON(system.kanoa.cmms.getProcedureStepCheckEvents({\u0027workOrderEventId\u0027: value[\u0027workOrderEventId\u0027]}))\n\t\n\tchecksByStepId \u003d {}\n\tfor check in checks: checksByStepId.setdefault(check[\u0027procedureStepId\u0027], []).append(check)\n\t\n\tcheckEventByCheckId \u003d {}\n\tfor event in checkEvents: checkEventByCheckId[event[\u0027procedureStepCheckId\u0027]] \u003d event\n\t\n\tstepChecks \u003d []\n\tfor step in steps:\n\t\tstepId \u003d step[\u0027procedureStepId\u0027]\n\t\tstepEvent \u003d stepEventDict.get(stepId, {})\n\t\tstepChecksForStep \u003d checksByStepId.get(stepId, [None])\n\t\n\t\tfor check in stepChecksForStep:\n\t\t\trow \u003d dict(step)\n\t\t\trow[\u0027procedureStepEventId\u0027] \u003d stepEvent.get(\u0027procedureStepEventId\u0027)\n\t\t\trow[\u0027actualMinutes\u0027] \u003d stepEvent.get(\u0027actualMinutes\u0027)\n\t\t\trow[\u0027completed\u0027] \u003d stepEvent.get(\u0027completed\u0027)\n\t\t\trow[\u0027comment\u0027] \u003d stepEvent.get(\u0027comment\u0027)\n\t\t\trow[\u0027workOrderEventId\u0027] \u003d value[\u0027workOrderEventId\u0027]\n\t\n\t\t\tif check is None:\n\t\t\t\trow[\u0027procedureStepCheckId\u0027] \u003d None\n\t\t\t\trow[\u0027procedureStepCheckEventId\u0027] \u003d None\n\t\t\t\trow[\u0027status\u0027] \u003d None\n\t\t\t\trow[\u0027chkItemStateName\u0027] \u003d None\n\t\t\t\trow[\u0027chkItemStateColor\u0027] \u003d None\n\t\t\telse:\n\t\t\t\tcheckEvent \u003d checkEventByCheckId.get(check[\u0027procedureStepCheckId\u0027], {})\n\t\t\t\trow.update(check)\n\t\t\t\trow[\u0027procedureStepCheckEventId\u0027] \u003d checkEvent.get(\u0027procedureStepCheckEventId\u0027)\n\t\t\t\trow[\u0027checkValue\u0027] \u003d checkEvent.get(\u0027value\u0027)\n\t\t\t\trow[\u0027status\u0027] \u003d checkEvent.get(\u0027status\u0027)\n\t\t\t\trow[\u0027chkItemStateName\u0027] \u003d checkEvent.get(\u0027chkItemStateName\u0027)\n\t\t\t\trow[\u0027chkItemStateColor\u0027] \u003d checkEvent.get(\u0027chkItemStateColor\u0027)\n\t\t\t\trow[\u0027checkStatus\u0027] \u003d checkEvent.get(\u0027status\u0027)\n\t\t\t\trow[\u0027checkComment\u0027] \u003d checkEvent.get(\u0027comment\u0027)\n\t\n\t\t\tstepChecks.append(row)\n\t\n\treturn stepChecks",
            "type": "script"
          }
        ],
        "type": "property"
      },
      "persistent": true
    },
    "custom.procedureStepEvents": {
      "binding": {
        "config": {
          "path": "view.custom.workOrderEventInfo"
        },
        "overlayOptOut": true,
        "transforms": [
          {
            "code": "\t\n\tif value[\u0027procedureId\u0027] is None: return []\n\n\tsteps \u003d system.kanoa.utilities.convertDatasetToJSON(system.kanoa.cmms.getProcedureSteps({\u0027procedureId\u0027: value[\u0027procedureId\u0027]}))\n\tstepEventDict \u003d system.kanoa.utilities.convertDatasetToDict(system.kanoa.cmms.getProcedureStepEvents({\u0027workOrderEventId\u0027: value[\u0027workOrderEventId\u0027]}), \u0027procedureStepId\u0027, None)\n\n\tfor step in steps:\n\t\tstep[\u0027procedureStepEventId\u0027] \u003d (stepEventDict.get(step[\u0027procedureStepId\u0027], {}).get(\u0027procedureStepEventId\u0027))\n\t\tstep[\u0027actualMinutes\u0027] \u003d (stepEventDict.get(step[\u0027procedureStepId\u0027], {}).get(\u0027actualMinutes\u0027))\n\t\tstep[\u0027completed\u0027] \u003d (stepEventDict.get(step[\u0027procedureStepId\u0027], {}).get(\u0027completed\u0027))\n\t\tstep[\u0027comment\u0027] \u003d (stepEventDict.get(step[\u0027procedureStepId\u0027], {}).get(\u0027comment\u0027))\n\t\tstep[\u0027workOrderEventId\u0027] \u003d self.params.values.workOrderEventId\n\t\n\treturn steps\n\t",
            "type": "script"
          }
        ],
        "type": "property"
      },
      "persistent": true
    },
    "custom.security": {
      "binding": {
        "config": {
          "path": "session.custom.kanoa.security"
        },
        "overlayOptOut": true,
        "type": "property"
      },
      "persistent": true
    },
    "custom.steps": {
      "persistent": true
