{
  "custom": {},
  "params": {
    "bgColor": "#FF0000",
    "borderColor": "#BADA55",
    "label": ""
  },
  "propConfig": {
    "params.bgColor": {
      "paramDirection": "input",
      "persistent": true
    },
    "params.borderColor": {
      "paramDirection": "input",
      "persistent": true
    },
    "params.label": {
      "paramDirection": "input",
      "persistent": true
    }
  },
  "props": {
    "defaultSize": {
      "height": 20,
      "width": 100
    }
  },
  "root": {
    "meta": {
      "domId": "root",
      "name": "root",
      "tooltip": {
        "enabled": true,
        "location": "top"
      }
    },
    "propConfig": {
      "meta.tooltip.text": {
        "binding": {
          "config": {
            "path": "view.params.label"
          },
          "transforms": [
            {
              "code": "\treturn value or \u0027\u0027",
              "type": "script"
            }
          ],
          "type": "property"
        }
      },
      "props.style.backgroundColor": {
        "binding": {
          "config": {
            "path": "view.params.bgColor"
          },
          "type": "property"
        }
      },
      "props.style.borderColor": {
        "binding": {
          "config": {
            "path": "view.params.borderColor"
          },
          "type": "property"
        }
      }
    },
    "props": {
      "direction": "column",
      "style": {
        "borderWidth": "2px",
        "classes": "kanoa/border",
        "margin": "2px",
        "maxWidth": "100px",
        "overflow": "hidden"
      }
    },
    "type": "ia.container.flex"
  }
}