        "type": "ia.container.flex"
      },
      {
        "children": [
          {
            "events": {
              "component": {
                "onActionPerformed": {
                  "config": {
                    "script": "\n\tworkTypeInfo = dict(self.view.custom.workTypeInfo)\n\tuserId = system.kanoa.security.getIDPUserId(self.session.props.auth.user)\n\t\n\tif workTypeInfo['workTypeId'] is not None: \t#If name has changed, we need to check that it doesn't already exist\n\t\tcurrentWorkTypeId = system.kanoa.utilities.getFieldValue('workTypeId', system.kanoa.cmms.getWorkTypes({'workTypeName': workTypeInfo['workTypeName']}))\n\t\tif currentWorkTypeId is not None and currentWorkTypeId != workTypeInfo['workTypeId']:\n\t\t\tsystem.perspective.sendMessage('showFailerToast', {'message': 'This work type already exists'})\n\t\t\treturn\n\t\t\n\t\tsystem.perspective.sendMessage('showInfoToast', {'message': 'Updating work type %i '%workTypeInfo['workTypeId']})\t\t\t\n\t\tretVal, msg = system.kanoa.cmms.updateWorkType(workTypeInfo, userId)\n\telse:\n\t\tsystem.perspective.sendMessage('showInfoToast', {'message': 'Adding work type'})\t\n\t\tworkTypeId, msg = system.kanoa.cmms.addWorkType(workTypeInfo, userId)\n\t\t\n\tif msg:\n\t\tsystem.perspective.sendMessage('showFailerToast', {'message': \"Couldn't save this work type. %s\"%msg})\n\telse:\n\t\tsystem.perspective.sendMessage('showSuccessfulToast', {'message': \"Work type has been saved\"})\n\n\tsystem.perspective.sendMessage(\"refreshWorkType\", {})\t\n\tsystem.perspective.closePopup('')\n\t\n\treturn"
                  },
                  "scope": "G",
                  "type": "script"
                }
              }
            },
            "meta": {
              "domId": "btnSave",
              "name": "btnSave",
              "tooltip": {
                "enabled": true,
                "location": "bottom-left",
                "text": "Save"
              }
            },
            "position": {
              "shrink": 0
            },
            "propConfig": {
              "props.enabled": {
                "binding": {
                  "config": {
                    "path": "view.custom.workTypeInfo"
                  },
                  "overlayOptOut": true,
                  "transforms": [
                    {
                      "code": "\t\n\tif (value['workTypeName'] or None) is None: return False\n\treturn True",
                      "type": "script"
                    }
                  ],
                  "type": "property"
                }
              }
            },
