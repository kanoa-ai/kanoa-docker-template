{
  "custom": {
    "workTypeInfo": {
      "changedBy": null,
      "changedByUser": null,
      "changedDate": null,
      "createdBy": null,
      "createdByUser": null,
      "createdDate": null,
      "enabled": true,
      "lastUpdatedBy": null,
      "sortOrder": null,
      "workTypeColor": null,
      "workTypeId": null,
      "workTypeName": ""
    }
  },
  "params": {
    "values": {
      "workTypeId": null
    }
  },
  "propConfig": {
    "custom.workTypeInfo": {
      "binding": {
        "config": {
          "path": "view.params.values.workTypeId"
        },
        "overlayOptOut": true,
        "transforms": [
          {
            "code": "\n\tworkTypeInfo = system.kanoa.utilities.convertDatasetRowToJSON(system.kanoa.cmms.getWorkTypes({'workTypeId':value or -1}),0)\n\tworkTypeInfo['workTypeName'] = workTypeInfo['workTypeName'] or ''\n\tif workTypeInfo['workTypeId'] is None:\n\t\tworkTypeInfo['enabled'] = True\n\t\t\n\treturn workTypeInfo\n",
            "type": "script"
          }
        ],
        "type": "property"
      },
      "persistent": true
    },
    "params.values": {
      "paramDirection": "input",
      "persistent": true
    }
  },
  "props": {
    "defaultSize": {
      "height": 158,
      "width": 350
    }
  },
