          "script": "\n\tsystem.perspective.print(\"colorPicked msg rcvd with payload \" + str(payload))\n\tself.view.custom.procedureInfo.procedureColor \u003d payload[\u0027color\u0027]\n\t\n\treturn",
          "sessionScope": false,
          "viewScope": false
        },
