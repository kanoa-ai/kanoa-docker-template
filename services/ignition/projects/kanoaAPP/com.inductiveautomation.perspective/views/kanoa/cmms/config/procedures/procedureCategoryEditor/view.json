            "events": {
              "component": {
                "onActionPerformed": {
                  "config": {
                    "script": "\n\tparams \u003d self.view.params.values\n\tprocedureCategoryInfo \u003d dict(self.view.custom.procedureCategoryInfo)\n\tprocedureCategoryId \u003d procedureCategoryInfo[\u0027procedureCategoryId\u0027]\n\tuserId \u003d system.kanoa.security.getIDPUserId(self.session.props.auth.user)\n\t\n\tif params[\u0027add\u0027] or params[\u0027procedureCategoryId\u0027] is None:\n\t\tsystem.perspective.sendMessage(\u0027showInfoToast\u0027, {\u0027message\u0027: \u0027Adding procedure category\u0027})\t\n\t\tprocedureId, msg \u003d system.kanoa.cmms.addProcedureCategory(procedureCategoryInfo, userId)\n\telse:\n\t\tsystem.perspective.sendMessage(\u0027showInfoToast\u0027, {\u0027message\u0027: \u0027Updating procedure category Id %s\u0027%procedureCategoryId})\t\t\t\n\t\tretVal, msg \u003d system.kanoa.cmms.updateProcedureCategory(procedureCategoryInfo, userId)\n\t\t\n\tsystem.perspective.sendMessage(\"updateProcedures\", {})\n\n\tif msg: system.perspective.sendMessage(\u0027showFailerToast\u0027, {\u0027message\u0027: \"Couldn\u0027t save procedure category. %s\"%msg})\n\telse: \n\t\tsystem.perspective.sendMessage(\u0027showSuccessfulToast\u0027, {\u0027message\u0027: \u0027procedure category as been saved.\u0027})\n\t\tsystem.perspective.closePopup(\u0027\u0027)\n\t\n\treturn"
                  },
