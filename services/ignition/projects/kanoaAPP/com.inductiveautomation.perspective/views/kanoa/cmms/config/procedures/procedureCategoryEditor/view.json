        "overlayOptOut": true,
        "transforms": [
          {
            "code": "\n\tprocedureCategoryInfo \u003d system.kanoa.utilities.convertDatasetRowToJSON(system.kanoa.cmms.getProcedureCategory({\u0027procedureCategoryId\u0027: value[\u0027procedureCategoryId\u0027] or -1}),0)\n\t\n\tif value[\u0027procedureCategoryId\u0027] is not None and value[\u0027add\u0027]:\n\t\tprocedureCategoryInfo[\u0027parentId\u0027] \u003d procedureCategoryInfo[\u0027procedureCategoryId\u0027]\t\t\n\t\tprocedureCategoryInfo[\u0027procedureCategoryId\u0027] \u003d None\n\t\tprocedureCategoryInfo[\u0027procedureCategoryName\u0027] \u003d None\n\n\tprocedureCategoryInfo[\u0027procedureCategoryName\u0027] \u003d procedureCategoryInfo[\u0027procedureCategoryName\u0027] or \u0027\u0027\n\t\n\treturn procedureCategoryInfo\n",
            "type": "script"
          }
        ],
        "type": "property"
      },
      "persistent": true
    },
    "params.values": {
      "paramDirection": "input",
      "persistent": true
    }
  },
