              "component": {
                "onActionPerformed": {
                  "config": {
                    "script": "\n\tworkOrderEventStatusCategoryInfo \u003d dict(self.view.custom.workOrderEventStatusCategoryInfo)\n\tuserId \u003d system.kanoa.security.getIDPUserId(self.session.props.auth.user)\n\t\n\tif workOrderEventStatusCategoryInfo[\u0027workOrderEventStatusCategoryId\u0027] is not None: \t#If name has changed, we need to check that it doesn\u0027t already exist\n\t\tcurrentWorkOrderEventStatusCategoryId \u003d system.kanoa.utilities.getFieldValue(\u0027workOrderEventStatusCategoryId\u0027, system.kanoa.cmms.getWorkOrderEventStatusCategory({\u0027workOrderEventStatusCategoryName\u0027: workOrderEventStatusCategoryInfo[\u0027workOrderEventStatusCategoryName\u0027]}))\n\t\tif currentWorkOrderEventStatusCategoryId is not None and currentWorkOrderEventStatusCategoryId !\u003d workOrderEventStatusCategoryInfo[\u0027workOrderEventStatusCategoryId\u0027]:\n\t\t\tsystem.perspective.sendMessage(\u0027showFailerToast\u0027, {\u0027message\u0027: \u0027This Status Category already exists\u0027})\n\t\t\treturn\n\t\t\n\t\tsystem.perspective.sendMessage(\u0027showInfoToast\u0027, {\u0027message\u0027: \u0027Updating workOrderEventStatusCategoryId %i \u0027%workOrderEventStatusCategoryInfo[\u0027workOrderEventStatusCategoryId\u0027]})\t\t\t\n\t\tretVal, msg \u003d system.kanoa.cmms.updateWorkOrderEventStatusCategory(workOrderEventStatusCategoryInfo, userId)\n\telse:\n\t\tsystem.perspective.sendMessage(\u0027showInfoToast\u0027, {\u0027message\u0027: \u0027Adding Status Category\u0027})\t\n\t\tworkOrderEventStatusCategoryId, msg \u003d system.kanoa.cmms.addWorkOrderEventStatusCategory(workOrderEventStatusCategoryInfo, userId)\n\t\t\n\tif msg:\n\t\tsystem.perspective.sendMessage(\u0027showFailerToast\u0027, {\u0027message\u0027: \"Couldn\u0027t save this status category. %s\"%msg})\n\telse:\n\t\tsystem.perspective.sendMessage(\u0027showSuccessfulToast\u0027, {\u0027message\u0027: \"Status category has been saved\"})\n\n\tsystem.perspective.sendMessage(\"refreshWorkOrderEventStatusCategories\", {})\t\n\tsystem.perspective.closePopup(\u0027\u0027)\n\t\n\treturn"
                  },
