                          "code": "\n\tds \u003d value\n\tif not ds:\n\t\treturn [\n\t\t\t{\"name\": \"MTTR\", \"type\": \"line\", \"data\": []},\n\t\t\t{\"name\": \"MTTA\", \"type\": \"line\", \"data\": []}\n\t\t]\n\t\n\tmttr \u003d []\n\tmtta \u003d []\n\t\n\tfor row in ds:\n\t\tmttr.append(min(row.get(\"MTTR_Minutes\") or 0, 4000))\n\t\tmtta.append(min(row.get(\"MTTA_Minutes\") or 0, 4000))\n\t\n\treturn [\n\t\t{\n\t\t\t\"name\": \"MTTR\",\n\t\t\t\"type\": \"line\",\n\t\t\t\"data\": mttr\n\t\t},\n\t\t{\n\t\t\t\"name\": \"MTTA\",\n\t\t\t\"type\": \"line\",\n\t\t\t\"data\": mtta\n\t\t}\n\t]\n",
