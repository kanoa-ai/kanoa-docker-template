  "propConfig": {
    "custom.filter": {
      "binding": {
        "config": {
          "path": "view.params.value"
        },
        "overlayOptOut": true,
        "transforms": [
          {
            "code": "\t\n\tfilters \u003d dict(value)\n\tif value.get(\u0027workOrderId\u0027) is not None:\n\t\tfilters[\u0027rangeStart\u0027] \u003d system.date.addDays(system.date.now(), -1)\n\t\tfilters[\u0027rangeEnd\u0027] \u003d system.date.now()\n\t\n\treturn filters",
            "type": "script"
          }
        ],
        "type": "property"
      },
      "persistent": true
    },
    "custom.security": {
      "binding": {
        "config": {
          "struct": {
            "user": "{session.props.auth.user}"
          },
          "waitOnAll": false
        },
        "overlayOptOut": true,
        "transforms": [
          {
            "code": "\t\n\tsecConfig \u003d system.kanoa.utilities.convertDatasetToDict(system.kanoa.security.getConfig({}), \u0027configName\u0027, \u0027configValue\u0027)\n\tuserId \u003d system.kanoa.security.getIDPUserId(value[\u0027user\u0027])\t\n\tuserCRUD \u003d system.kanoa.security.getUserAssetCRUD(userId)\n\t\n\treturn {\"userId\": userId, \"config\": secConfig, \"userCRUD\": userCRUD}",
            "type": "script"
          }
        ],
        "type": "expr-struct"
      },
      "persistent": true
    },
    "custom.table": {
      "persistent": true
    },
    "custom.table.data": {
      "binding": {
        "config": {
          "struct": {
            "filter": "{view.custom.filter}"
          },
          "waitOnAll": true
        },
        "overlayOptOut": true,
        "transforms": [
          {
            "code": "\n\treturn system.kanoa.cmms.getWorkOrderEventImageData(value[\u0027filter\u0027])",
            "type": "script"
          }
        ],
        "type": "expr-struct"
      }
    },
    "custom.userAction": {
      "binding": {
        "config": {
          "struct": {
            "data": "{view.custom.table.selection.data}",
            "params": "{view.params.value}",
            "security": "{view.custom.security}"
          },
          "waitOnAll": true
        },
        "overlayOptOut": true,
        "transforms": [
          {
            "code": "\t\n\tsecurity \u003d value[\u0027security\u0027]\n\tcanCreate \u003d False\n\tcanEdit \u003d False\n\tif security[\u0027userCRUD\u0027] is not None and security[\u0027userId\u0027] is not None:\n\t\tif security[\u0027userCRUD\u0027][\u0027isGatewayAdmin\u0027] or security[\u0027userCRUD\u0027][\u0027configureQuality\u0027][\u0027enabled\u0027]: \n\t\t\tcanCreate \u003d True if value[\u0027params\u0027].get(\u0027workOrderEventId\u0027) is not None else False\n\t\t\tcanEdit \u003d True if len(value[\u0027data\u0027] or []) \u003e 0 else False\n\t\n\treturn {\"canCreate\": canCreate, \"canDelete\": canEdit, \"canRead\": True, \"canUpdate\": canEdit}",
            "type": "script"
          }
        ],
        "type": "expr-struct"
      },
      "persistent": true
    },
    "params.value": {
      "paramDirection": "input",
      "persistent": true
    }
  },
  "props": {
    "defaultSize": {
      "height": 670,
      "width": 1068
    }
  },
