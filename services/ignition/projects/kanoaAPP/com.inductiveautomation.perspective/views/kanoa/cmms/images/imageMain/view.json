                        {
                          "code": "\t\n\timageData \u003d system.kanoa.utilities.convertDatasetToJSON(value)\n\treturn [{\u0027value\u0027: {\u0027imageId\u0027: row[\u0027workOrderEventImageId\u0027]}, \u0027selected\u0027: False} for row in imageData]",
