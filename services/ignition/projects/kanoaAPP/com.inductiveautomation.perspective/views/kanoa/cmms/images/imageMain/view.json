                      "script": "\t\n\tsystem.perspective.print(\"instances change event %s\"%origin)\n\t\n\timageIds \u003d []\n\tif origin \u003d\u003d \u0027Browser\u0027:\n\t\tinstances \u003d self.props.instances\n\t\timageIds \u003d [row[\u0027value\u0027][\u0027imageId\u0027] for row in instances if row[\u0027selected\u0027]]\n\t\n\tself.view.custom.selectedImageIds \u003d imageIds\n\t\t\n\treturn"
