    "scripts": {
      "customMethods": [
        {
          "name": "updateStepCheckEvent",
          "params": [],
          "script": "\n\tsystem.perspective.print(\u0027updateStepCheckEvent() called\u0027)\n\n\tuserId \u003d self.view.custom.security.userId\n\tcheckEventInfo \u003d dict(self.view.custom.checkEventInfo)\n\t\n\tkeysToKeep \u003d {\"workOrderEventId\", \"procedureStepCheckEventId\", \"procedureStepEventId\", \"procedureStepCheckId\", \"procedureStepId\", \"value\", \"status\", \"comment\"}\n\tcheckEventInfo \u003d {k: checkEventInfo[k] for k in keysToKeep if k in checkEventInfo}\n\n\tcheckStepEventInfo \u003d dict(self.view.params.values)\n\t\t\n\tif checkEventInfo[\u0027procedureStepEventId\u0027] is None:\n\t\tstepEventInfo \u003d {\n\t\t\t\t\t\t\t\u0027workOrderEventId\u0027: checkEventInfo[\u0027workOrderEventId\u0027],\n\t\t\t \t\t\t\t\u0027procedureStepId\u0027: checkEventInfo[\u0027procedureStepId\u0027],\n\t\t\t \t\t\t\t\u0027actualMinutes\u0027:  None,\n\t\t\t \t\t\t\t\u0027comment\u0027:  checkEventInfo[\u0027comment\u0027],\n\t\t\t \t\t\t\t\u0027completed\u0027: False\n\t\t\t \t\t\t}\n\t\tsystem.perspective.print(\u0027Calling addProcedureStepEvent() with %s %s\u0027%(stepEventInfo, userId))\n\t\tcheckEventInfo[\u0027procedureStepEventId\u0027], msg \u003d system.kanoa.cmms.addProcedureStepEvent(stepEventInfo, userId)\n\t\tcheckStepEventInfo[\u0027procedureStepEventId\u0027] \u003d checkEventInfo[\u0027procedureStepEventId\u0027]\n\t\tsystem.perspective.print(\u0027addProcedureStepEvent() returned %s %s\u0027%(checkEventInfo[\u0027procedureStepEventId\u0027], msg))\n\n\tcheckConfig \u003d system.util.jsonDecode(self.view.custom.checkEventInfo[\u0027checkConfig\u0027]) if self.view.custom.checkEventInfo[\u0027checkConfig\u0027] else {}\n\tstateInfo \u003d system.kanoa.cmms.getEnteredValueState(checkEventInfo[\u0027value\u0027], checkConfig)\n\tcheckEventInfo[\u0027status\u0027] \u003d stateInfo[\u0027chkItemStateId\u0027] if stateInfo else None\n\n#\tcheckConfig \u003d system.util.jsonDecode(self.view.custom.checkEventInfo[\u0027checkConfig\u0027])\n#\t