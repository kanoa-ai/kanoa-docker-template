  "propConfig": {
    "custom.checkEventInfo": {
      "binding": {
        "config": {
          "path": "view.params.values"
        },
        "overlayOptOut": true,
        "transforms": [
          {
            "code": "\n#\tif value[\u0027procedureStepCheckId\u0027] is None: return {}\n\t\n\tcheck \u003d system.kanoa.utilities.convertDatasetRowToJSON(system.kanoa.cmms.getProcedureStepChecks({\u0027procedureStepCheckId\u0027: value[\u0027procedureStepCheckId\u0027] or -1}),0)\n\tcheckEventInfo \u003d system.kanoa.utilities.convertDatasetRowToJSON(system.kanoa.cmms.getProcedureStepCheckEvents({\u0027procedureStepCheckEventId\u0027: value[\u0027procedureStepCheckEventId\u0027] or -1}), 0)\n\n\tcheck[\u0027workOrderEventId\u0027] \u003d self.params.values.workOrderEventId\n\tcheck[\u0027procedureStepCheckEventId\u0027] \u003d checkEventInfo.get(\u0027procedureStepCheckEventId\u0027)\n\tcheck[\u0027procedureStepCheckId\u0027] \u003d self.params.values.procedureStepCheckId\n\tcheck [\u0027procedureStepEventId\u0027] \u003d self.params.values.procedureStepEventId\n\tcheck[\u0027value\u0027] \u003d checkEventInfo.get(\u0027value\u0027) or \u0027\u0027\n\tcheck[\u0027status\u0027] \u003d checkEventInfo.get(\u0027status\u0027) or \u0027\u0027\n\tcheck[\u0027chkItemStateName\u0027] \u003d checkEventInfo.get(\u0027chkItemStateName\u0027) or \u0027\u0027\n\tcheck[\u0027chkItemStateColor\u0027] \u003d checkEventInfo.get(\u0027chkItemStateColor\u0027) or \u0027\u0027\n\tcheck[\u0027comment\u0027] \u003d checkEventInfo.get(\u0027comment\u0027) or \u0027\u0027\n\t\n\treturn check",
            "type": "script"
          }
        ],
        "type": "property"
      },
      "onChange": {
        "enabled": null,
        "script": "\n\tif origin in (\u0027BindingWriteback\u0027, \u0027Script\u0027): self.getChild(\"root\").updateStepCheckEvent()\n\n\treturn"
      },
      "persistent": true
    },
