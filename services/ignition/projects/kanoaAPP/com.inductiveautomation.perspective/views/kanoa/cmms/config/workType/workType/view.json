                  "config": {
                    "script": "\n\tif self.view.custom.workType.userAction.canUpdate:\n\t\tworkTypeId = self.props.data[event.row]['workTypeId']\n\t\t\n\t\tif event.column in ('enabled', 'sortOrder'):\n\t\t\tretVal, msg = system.kanoa.cmms.updateWorkTypeField(workTypeId, event.column, event.value, self.view.custom.security.userId)\t\t\t\n\t\t\tif msg: system.perspective.sendMessage('showFailerToast', {'message': 'Failed to update the work type. %s'%msg})\n\t\t\telse: system.perspective.sendMessage('showSuccessfulToast', {'message': 'Work Type has been updated'})\t\t\n\t\telse:\n\t\t\tsystem.perspective.sendMessage('showFailerToast', 'Column is not enabled for editing')\n\telse:\n\t\tsystem.perspective.sendMessage('showFailerToast', 'No permissions to update')\n\n\tself.view.refreshBinding(\"custom.workType.data\")\n\tself.props.selection.selectedRow = None\t\n\tself.props.selection.selectedCol = None\t\n\t\t\n\treturn"
                  },
                  "scope": "G",
                  "type": "script"
                }
