  "params": {},
  "propConfig": {
    "custom.security": {
      "binding": {
        "config": {
          "struct": {
            "user": "{session.props.auth.user}"
          },
          "waitOnAll": false
        },
        "overlayOptOut": true,
        "transforms": [
          {
            "code": "\t\n\tsecConfig = system.kanoa.utilities.convertDatasetToDict(system.kanoa.security.getConfig({}), 'configName', 'configValue')\n\tuserId = system.kanoa.security.getIDPUserId(value['user'])\t\n\tuserCRUD = system.kanoa.security.getUserAssetCRUD(userId)\n\t\n\treturn {\"userId\": userId, \"config\": secConfig, \"userCRUD\": userCRUD}",
            "type": "script"
          }
        ],
        "type": "expr-struct"
      },
      "persistent": true
    },
    "custom.workType": {
      "persistent": true
    },
    "custom.workType.data": {
      "binding": {
        "config": {
          "expression": "now(0)"
        },
        "overlayOptOut": true,
        "transforms": [
          {
            "code": "\n\treturn system.kanoa.utilities.convertDatasetToJSON(system.kanoa.cmms.getWorkTypes({}))",
            "type": "script"
          }
        ],
        "type": "expr"
      }
    },
    "custom.workType.userAction": {
      "binding": {
        "config": {
          "struct": {
            "data": "{view.custom.workType.selectedData}",
            "security": "{view.custom.security}"
          },
          "waitOnAll": true
        },
        "overlayOptOut": true,
        "transforms": [
          {
            "code": "\n\tsecurity = value['security']\n\tcanCreate = False\n\tcanEdit = False\n\tif security['userCRUD'] is not None and security['userId'] is not None:\n\t\tif security['userCRUD']['isGatewayAdmin'] or security['userCRUD']['configureMaintenance']['enabled']: \n\t\t\tcanCreate = True\n\t\t\tcanEdit = True if len(value['data']) > 0 else False\n\t\t\t\n\treturn {\"canCreate\": canCreate, \"canDelete\": canEdit, \"canRead\": True, \"canUpdate\": canEdit}",
            "type": "script"
          }
        ],
        "type": "expr-struct"
      }
    }
  },
  "props": {
    "defaultSize": {
      "height": 707,
      "width": 1278
    }
