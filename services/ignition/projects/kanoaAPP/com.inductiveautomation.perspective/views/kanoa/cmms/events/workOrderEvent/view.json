              "code": "\t\n\tif not value[\u0027params\u0027][\u0027isActive\u0027]: return False\n\tif value[\u0027params\u0027][\u0027dueDate\u0027] \u003c\u003d system.date.now(): return True\n\tif value[\u0027params\u0027][\u0027scheduleTypeName\u0027] \u003d\u003d \u0027Condition\u0027 and value[\u0027condition\u0027][\u0027counterValue\u0027] \u003e value[\u0027condition\u0027][\u0027countThreshold\u0027]: return True\n\t\n\treturn False",
              "type": "script"
            }
          ],
          "type": "expr-struct"
        },
        "onChange": {
          "enabled": null,
          "script": "\t\n\tif self.view.params.values.isActive:\n\t\tself.custom.pulse.backgroundColor \u003d self.custom.pulse.defaultColor\n\t\n\treturn"
        }
      },
      "custom.pulse.timer": {
        "binding": {
          "config": {
            "expression": "now(2000)"
          },
          "type": "expr"
        },
        "onChange": {
          "enabled": null,
          "script": "\n\tpulse \u003d self.custom.pulse\n\tif pulse.has_key(\u0027enabled\u0027) and pulse.enabled:\n\t\tpulse[\u0027backgroundColor\u0027] \u003d pulse[\u0027pulseColor\u0027] if pulse[\u0027backgroundColor\u0027] \u003d\u003d pulse[\u0027defaultColor\u0027] else pulse[\u0027defaultColor\u0027]\n\t\n\treturn"
        }
      },
      "props.style.backgroundColor": {
        "binding": {
          "config": {
            "path": "view.params.values.maintenanceTypeColor"
          },
          "overlayOptOut": true,
          "type": "property"
        }
      }
    },
    "props": {
      "direction": "column",
      "style": {
        "classes": "kanoa/font/default kanoa/border",
        "cursor": "pointer",
        "gap": "5px",
        "overflow": "hidden",
        "padding": "2px"
      }
    },
    "type": "ia.container.flex"
  }
}