          {
            "events": {
              "component": {
                "onActionPerformed": {
                  "config": {
                    "script": "\n\tworkOrderStatusInfo \u003d dict(self.view.custom.workOrderStatusInfo)\n\tuserId \u003d system.kanoa.security.getIDPUserId(self.session.props.auth.user)\n\t\n\tif workOrderStatusInfo[\u0027workOrderStatusId\u0027] is not None: \t#If name has changed, we need to check that it doesn\u0027t already exist\n\t\tcurrentWorkOrderStatusId \u003d system.kanoa.utilities.getFieldValue(\u0027workOrderStatusId\u0027, system.kanoa.cmms.getWorkOrderStatus({\u0027workOrderStatusName\u0027: workOrderStatusInfo[\u0027workOrderStatusName\u0027]}))\n\t\tif currentWorkOrderStatusId is not None and currentWorkOrderStatusId !\u003d workOrderStatusInfo[\u0027workOrderStatusId\u0027]:\n\t\t\tsystem.perspective.sendMessage(\u0027showFailerToast\u0027, {\u0027message\u0027: \u0027This work order status already exists\u0027})\n\t\t\treturn\n\t\t\n\t\tsystem.perspective.sendMessage(\u0027showInfoToast\u0027, {\u0027message\u0027: \u0027Updating work order status %i \u0027%workOrderStatusInfo[\u0027workOrderStatusId\u0027]})\t\t\t\n\t\tretVal, msg \u003d system.kanoa.cmms.updateWorkOrderStatus(workOrderStatusInfo, userId)\n\telse:\n\t\tsystem.perspective.sendMessage(\u0027showInfoToast\u0027, {\u0027message\u0027: \u0027Adding work order status\u0027})\t\n\t\tmaintenanceTypeId, msg \u003d system.kanoa.cmms.addWorkOrderStatus(workOrderStatusInfo, userId)\n\t\t\n\tif msg:\n\t\tsystem.perspective.sendMessage(\u0027showFailerToast\u0027, {\u0027message\u0027: \"Couldn\u0027t save this work order status. %s\"%msg})\n\telse:\n\t\tsystem.perspective.sendMessage(\u0027showSuccessfulToast\u0027, {\u0027message\u0027: \"Work order status has been saved\"})\n\n\tsystem.perspective.sendMessage(\"refreshWorkOrderStatus\", {})\t\n\tsystem.perspective.closePopup(\u0027\u0027)\n\t\n\treturn"
                  },
                  "scope": "G",
                  "type": "script"
                }
              }
            },
            "meta": {
