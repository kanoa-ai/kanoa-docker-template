{
  "custom": {
    "imageData": {
      "chkImageId": null,
      "createdBy": null,
      "createdDate": null,
      "image": null,
      "imageDescription": null,
      "imageName": null,
      "imageType": null,
      "procedureStepCheckId": null,
      "thumbnail": null
    }
  },
  "params": {
    "value": {
      "chkImageId": null
    }
  },
  "propConfig": {
    "custom.imageData": {
      "binding": {
        "config": {
          "path": "view.params.value.chkImageId"
        },
        "overlayOptOut": true,
        "transforms": [
          {
            "code": "\t\t\n\treturn system.kanoa.utilities.convertDatasetRowToJSON(system.kanoa.cmms.getImageData({\u0027chkImageId\u0027: value or -1, \u0027includeThumbnail\u0027: True, \u0027includeImage\u0027: False}),0)",
            "type": "script"
          }
        ],
        "type": "property"
      },
      "persistent": true
    },
    "params.value": {
      "paramDirection": "input",
      "persistent": true
    }
  },
  "props": {
    "defaultSize": {
      "height": 274,
      "width": 479
    }
  },
  "root": {
    "children": [
      {
        "children": [
          {
            "children": [
              {
                "meta": {
                  "domId": "lblImageName",
                  "name": "lblImageName"
                },
                "position": {
                  "shrink": 0
                },
                "propConfig": {
                  "props.text": {
                    "binding": {
                      "config": {
                        "path": "view.custom.imageData.imageName"
                      },
                      "overlayOptOut": true,
                      "transforms": [
                        {
                          "code": "\treturn value or \u0027\u0027",
                          "type": "script"
                        }
                      ],
                      "type": "property"
                    }
                  }
                },
                "type": "ia.display.label"
              },
              {
                "meta": {
                  "domId": "lblImageType",
                  "name": "lblImageType"
                },
                "position": {
                  "grow": 1
                },
                "propConfig": {
                  "props.text": {
                    "binding": {
                      "config": {
                        "path": "view.custom.imageData"
                      },
                      "overlayOptOut": true,
                      "transforms": [
                        {
                          "code": "\treturn value[\u0027imageType\u0027] or \u0027\u0027",
                          "type": "script"
                        }
                      ],
                      "type": "property"
                    }
                  }
                },
                "type": "ia.display.label"
              },
              {
                "events": {
                  "component": {
                    "onActionPerformed": {
                      "config": {
                        "script": "\t\n\tfrom com.inductiveautomation.ignition.common import Base64\n\t\n\timage \u003d system.kanoa.cmms.getImage(self.view.custom.imageData.chkImageId)\t\n\tbytes \u003d Base64.decode(image)\n\tsystem.perspective.download(self.view.custom.imageData.imageName, bytes)\n\t\n\treturn"
                      },
                      "scope": "G",
                      "type": "script"
                    }
                  }
                },
                "meta": {
                  "domId": "btnDownload",
                  "name": "btnDownload",
                  "tooltip": {
                    "delay": 0,
                    "enabled": true,
                    "location": "center-right",
                    "text": "Download image"
                  }
                },
                "position": {
                  "basis": "24px",
                  "shrink": 0
                },
                "propConfig": {
                  "position.display": {
                    "binding": {
                      "config": {
                        "path": "view.params.value.chkImageId"
                      },
                      "overlayOptOut": true,
                      "transforms": [
                        {
                          "code": "\treturn value is not None",
                          "type": "script"
                        }
                      ],
                      "type": "property"
                    }
                  }
                },
                "props": {
                  "image": {
                    "icon": {
                      "path": "material/save_alt"
                    }
                  },
                  "style": {
                    "classes": "kanoa/button/flatIcon",
                    "width": "30px"
                  },
                  "text": ""
                },
                "type": "ia.input.button"
              }
            ],
            "meta": {
              "name": "flxName"
            },
            "position": {
              "shrink": 0
            },
            "props": {
              "style": {
                "gap": "5px",
                "padding": "2px"
              }
            },
            "type": "ia.container.flex"
          },
          {
            "meta": {
              "domId": "lblDescription",
              "name": "lblDescription"
            },
            "position": {
              "shrink": 0
            },
            "propConfig": {
              "props.text": {
                "binding": {
                  "config": {
                    "path": "view.custom.imageData.imageDescription"
                  },
                  "overlayOptOut": true,
                  "transforms": [
                    {
                      "code": "\treturn \u0027Description:\\n\u0027 + str(value) if (value or None) is not None else \u0027\u0027",
                      "type": "script"
                    }
                  ],
                  "type": "property"
                }
              }
            },
            "type": "ia.display.label"
          },
          {
            "meta": {
              "domId": "lblCreatedBy",
              "name": "lblCreatedBy"
            },
            "position": {
              "display": false,
              "shrink": 0
            },
            "propConfig": {
              "props.text": {
                "binding": {
                  "config": {
                    "path": "view.custom.imageData"
                  },
                  "overlayOptOut": true,
                  "transforms": [
                    {
                      "code": "\treturn \u0027Created By: %s\u0027%(value[\u0027createdBy\u0027] or \u0027\u0027)",
                      "type": "script"
                    }
                  ],
                  "type": "property"
                }
              }
            },
            "type": "ia.display.label"
          },
          {
            "meta": {
              "domId": "lblCreatedOn",
              "name": "lblCreatedOn"
            },
            "position": {
              "display": false,
              "shrink": 0
            },
            "propConfig": {
              "props.text": {
                "binding": {
                  "config": {
                    "path": "view.custom.imageData"
                  },
                  "overlayOptOut": true,
                  "transforms": [
                    {
                      "code": "\treturn \u0027Created On: %s\u0027%(value[\u0027createdDate\u0027] or \u0027\u0027)",
                      "type": "script"
                    }
                  ],
                  "type": "property"
                }
              }
            },
            "type": "ia.display.label"
          }
        ],
        "meta": {
          "domId": "flxCntInfo",
          "name": "flxCntInfo"
        },
        "position": {
          "shrink": 0
        },
        "props": {
          "direction": "column",
          "style": {
            "borderColor": "#D5D5D5",
            "classes": "kanoa/border",
            "gap": "5px",
            "padding": "5px"
          }
        },
        "type": "ia.container.flex"
      },
      {
        "children": [
          {
            "events": {
              "dom": {
                "onClick": {
                  "config": {
                    "script": "\t\n\tsystem.perspective.sendMessage(\u0027imageSelected\u0027, {\u0027chkImageId\u0027: self.view.params.value.chkImageId})\n\t\n\treturn"
                  },
                  "scope": "G",
                  "stopPropagation": true,
                  "type": "script"
                },
                "onDoubleClick": {
                  "config": {
                    "script": "\n\timageData \u003d dict(self.view.custom.imageData)\n\timageData.pop(\u0027thumbnail\u0027)\n\timageData.pop(\u0027image\u0027)\n\t\t\n\tparams \u003d {\u0027imageData\u0027: imageData}\n\ttitle \u003d \u0027Image: %s\u0027 % self.view.custom.imageData.imageName\n\t\n\tsystem.perspective.openPopup(\u0027Image Viewer\u0027, \u0027kanoa/cmms/config/images/imageViewer\u0027, params, title, resizable\u003dTrue, draggable\u003dTrue, showCloseIcon\u003dTrue)\n\t\n\treturn"
                  },
                  "scope": "G",
                  "type": "script"
                }
              }
            },
            "meta": {
              "domId": "image",
              "name": "image"
            },
            "position": {
              "grow": 1
            },
            "propConfig": {
              "position.display": {
                "binding": {
                  "config": {
                    "path": "this.props.source"
                  },
                  "overlayOptOut": true,
                  "transforms": [
                    {
                      "code": "\treturn value !\u003d \u0027\u0027",
                      "type": "script"
                    }
                  ],
                  "type": "property"
                }
              },
              "props.source": {
                "binding": {
                  "config": {
                    "path": "view.custom.imageData.thumbnail"
                  },
                  "overlayOptOut": true,
                  "transforms": [
                    {
                      "code": "\t\n\treturn \u0027data:imagef;base64,\u0027 + value if value is not None else \u0027\u0027",
                      "type": "script"
                    }
                  ],
                  "type": "property"
                }
              }
            },
            "props": {
              "fit": {
                "height": 1,
                "mode": "contain",
                "width": 1
              },
              "style": {
                "cursor": "pointer",
                "height": "auto",
                "width": "auto"
              }
            },
            "type": "ia.display.image"
          }
        ],
        "meta": {
          "domId": "flxCntImage",
          "name": "flxCntImage"
        },
        "position": {
          "grow": 1
        },
        "props": {
          "alignContent": "center",
          "alignItems": "center",
          "direction": "column",
          "justify": "center"
        },
        "type": "ia.container.flex"
      }
    ],
    "events": {
      "dom": {
        "onClick": {
          "config": {
            "script": "\t\n\tsystem.perspective.sendMessage(\u0027imageSelected\u0027, {\u0027chkImageId\u0027: self.view.params.value.chkImageId})\n\t\n\treturn"
          },
          "scope": "G",
          "type": "script"
        }
      }
    },
    "meta": {
      "domId": "root",
      "name": "root"
    },
    "propConfig": {
      "props.style.border": {
        "binding": {
          "config": {
            "expression": "now(0)"
          },
          "overlayOptOut": true,
          "transforms": [
            {
              "code": "\treturn \u0027none\u0027",
              "type": "script"
            }
          ],
          "type": "expr"
        }
      }
    },
    "props": {
      "direction": "column",
      "style": {
        "borderWidth": "2px",
        "classes": "kanoa/container kanoa/font/default",
        "gap": "5px",
        "margin": "5px",
        "padding": "5px"
      }
    },
    "scripts": {
      "customMethods": [],
      "extensionFunctions": null,
      "messageHandlers": [
        {
          "messageType": "imageSelected",
          "pageScope": true,
          "script": "\n\tself.props.style.border \u003d \u0027solid\u0027 if payload[\u0027chkImageId\u0027] \u003d\u003d self.view.params.value.chkImageId else \u0027none\u0027\n\t\n\treturn",
          "sessionScope": false,
          "viewScope": false
        }
      ]
    },
    "type": "ia.container.flex"
  }
}