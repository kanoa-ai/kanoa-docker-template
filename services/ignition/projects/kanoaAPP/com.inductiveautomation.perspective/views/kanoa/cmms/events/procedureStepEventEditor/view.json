  "propConfig": {
    "custom.checks": {
      "binding": {
        "config": {
          "path": "view.custom.procedureStepEventInfo"
        },
        "overlayOptOut": true,
        "transforms": [
          {
            "code": "\n\tif value[\u0027procedureStepId\u0027] is None: return []\n\t\n\tchecks \u003d system.kanoa.utilities.convertDatasetToJSON(system.kanoa.cmms.getProcedureStepChecks({\u0027procedureStepId\u0027: value[\u0027procedureStepId\u0027]}))\n\tcheckEventDict \u003d system.kanoa.utilities.convertDatasetToDict(system.kanoa.cmms.getProcedureStepCheckEvents({\u0027procedureStepEventId\u0027: value[\u0027procedureStepEventId\u0027] or -1}), \u0027checkName\u0027, None) or {}\n\n\tfor check in checks:\n\t\tcheckEventInfo \u003d checkEventDict.get(check[\u0027checkName\u0027], {}) or {}\n\t\tcheck[\u0027workOrderEventId\u0027] \u003d self.params.values.workOrderEventId\n\t\tcheck[\u0027procedureStepCheckEventId\u0027] \u003d checkEventInfo.get(\u0027procedureStepCheckEventId\u0027)\n\t\tcheck[\u0027procedureStepEventId\u0027] \u003d self.custom.procedureStepEventInfo.procedureStepEventId\n\t\tcheck[\u0027value\u0027] \u003d checkEventInfo.get(\u0027value\u0027)\n\t\tcheck[\u0027status\u0027] \u003d checkEventInfo.get(\u0027status\u0027)\n\t\tcheck[\u0027chkItemStateName\u0027] \u003d checkEventInfo.get(\u0027chkItemStateName\u0027)\n\t\tcheck[\u0027chkItemStateColor\u0027] \u003d checkEventInfo.get(\u0027chkItemStateColor\u0027)\n\t\tcheck[\u0027comment\u0027] \u003d (checkEventDict.get(check[\u0027checkName\u0027], {}).get(\u0027comment\u0027))\n\t\n\treturn checks",
            "type": "script"
          }
        ],
        "type": "property"
      },
      "persistent": true
    },
    "custom.display": {
      "persistent": true
    },
    "custom.display.showDetail": {
      "binding": {
        "config": {
          "path": "view.custom.procedureStepEventInfo"
        },
        "overlayOptOut": true,
        "transforms": [
          {
            "code": "\treturn not (value[\u0027completed\u0027] or False)",
            "type": "script"
          }
        ],
        "type": "property"
      }
    },
    "custom.procedureStepEventInfo": {
      "binding": {
        "config": {
          "path": "view.params.values"
        },
        "overlayOptOut": true,
        "transforms": [
          {
            "code": "\t\n\tprocedureStepEventInfo \u003d dict(value)\n\tprocedureStepEventInfo[\u0027comment\u0027] \u003d procedureStepEventInfo[\u0027comment\u0027] or \u0027\u0027\n\tprocedureStepEventInfo[\u0027completed\u0027] \u003d procedureStepEventInfo[\u0027completed\u0027] or False\n\t\n\treturn procedureStepEventInfo",
            "type": "script"
          }
        ],
        "type": "property"
      },
      "onChange": {
        "enabled": null,
        "script": "\t\n\tif origin \u003d\u003d \u0027BindingWriteback\u0027:\n\t\tinfo \u003d dict(self.custom.procedureStepEventInfo)\n\t\t\n\t\tkeysToKeep \u003d {\u0027workOrderEventId\u0027, \u0027procedureStepEventId\u0027, \u0027procedureStepId\u0027, \u0027actualMinutes\u0027, \u0027completed\u0027, \u0027comment\u0027}\n\t\tprocedureStepEventInfo \u003d {k: info[k] for k in keysToKeep if k in info}\n\t\t\n\t\tif procedureStepEventInfo[\u0027procedureStepEventId\u0027] is None: retVal, msg \u003d system.kanoa.cmms.addProcedureStepEvent(procedureStepEventInfo, self.custom.security.userId)\n\t\telse: retVal, msg \u003d system.kanoa.cmms.updateProcedureStepEvent(procedureStepEventInfo, self.custom.security.userId)\n\t\t\n\t\tif msg: system.perspective.sendMessage(\u0027showWarningToast\u0027, {\u0027message\u0027: \"Couldn\u0027t update this step. %s\"%msg})\n\t\telse: system.perspective.sendMessage(\u0027showSuccessfulToast\u0027, {\u0027message\u0027: \"Step has been updated\"})\n\t\tsystem.perspective.sendMessage(\u0027procedureStepUpdate\u0027, {})\n\t\t\n\treturn"
      },
      "persistent": true
    },
    "custom.security": {
      "binding": {
        "config": {
          "path": "session.custom.kanoa.security"
        },
        "overlayOptOut": true,
        "type": "property"
      },
      "persistent": true
    },
    "custom.selection": {
      "persistent": true
    },
    "custom.selection.checkName": {
      "binding": {
        "config": {
          "struct": {
            "steps": "{view.custom.procedureStepEvents}",
            "tabs": "{view.custom.tabs}"
          },
          "waitOnAll": true
        },
        "overlayOptOut": true,
        "transforms": [
          {
            "code": "\n\tif len(value[\u0027tabs\u0027][\u0027tabList\u0027]) \u003d\u003d 0: return None\n\treturn value[\u0027tabs\u0027][\u0027tabList\u0027][value[\u0027tabs\u0027][\u0027tabIndex\u0027]]\n",
            "type": "script"
          }
        ],
        "type": "expr-struct"
      }
    },
    "custom.tabs": {
