      {
        "meta": {
          "domId": "pickList",
          "name": "pickList"
        },
        "position": {
          "grow": 1,
          "shrink": 0
        },
        "propConfig": {
          "position.display": {
            "binding": {
              "config": {
                "path": "this.props.instances"
              },
              "transforms": [
                {
                  "code": "\treturn len(value) \u003e 0",
                  "type": "script"
                }
              ],
              "type": "property"
            }
          },
          "props.instances": {
            "binding": {
              "config": {
                "path": "view.custom.values"
              },
              "overlayOptOut": true,
              "transforms": [
                {
                  "code": "\n\t\u0027\u0027\u0027\n\t\tpickListNames are defined as \u0027Number\u0027, \u0027Text\u0027 or \u0027Fraction\u0027\n\t\tFor Number and Fraction box, pickListValues are an integer value that dictate how many buttons should be generated\n\t\u0027\u0027\u0027\n\n\tdef getToleranceLimits(spec):\n\t\t#If we don\u0027t find a tolerance spec, we will default to the specification\n\t\tspecs \u003d {\u0027lel\u0027:None, \u0027lsl\u0027:None, \u0027lcl\u0027:None, \u0027tgt\u0027:None, \u0027ucl\u0027:None, \u0027usl\u0027:None, \u0027uel\u0027:None}\t\t\n\t\tif spec:\t\n\t\t\tif spec[\u0027specType\u0027] \u003d\u003d \u0027attributeTolerance\u0027: #We got our specs from the attributes table\n\t\t\t\ttolerances \u003d self.view.custom.values.tolerances\n\t\t\t\tspecs[\u0027lel\u0027] \u003d tolerances[\u0027lel\u0027]\n\t\t\t\tspecs[\u0027lsl\u0027] \u003d tolerances[\u0027lsl\u0027] or tolerances[\u0027ldl\u0027]\n\t\t\t\tspecs[\u0027lcl\u0027] \u003d tolerances[\u0027lcl\u0027]\n\t\t\t\tspecs[\u0027tgt\u0027] \u003d tolerances[\u0027tgt\u0027]\n\t\t\t\tspecs[\u0027ucl\u0027] \u003d tolerances[\u0027ucl\u0027]\n\t\t\t\tspecs[\u0027usl\u0027] \u003d tolerances[\u0027usl\u0027] or tolerances[\u0027udl\u0027]\n\t\t\t\tspecs[\u0027uel\u0027] \u003d tolerances[\u0027uel\u0027]\n\t\t\telif spec[\u0027specType\u0027] \u003d\u003d \u0027tolerance\u0027:\n\t\t\t\ttolerances \u003d spec[\u0027tolerance\u0027]\n\t\t\t\tspecs[\u0027lel\u0027] \u003d tolerances[\u0027lel\u0027]\n\t\t\t\tspecs[\u0027lsl\u0027] \u003d tolerances[\u0027lsl\u0027] or tolerances[\u0027ldl\u0027]\n\t\t\t\tspecs[\u0027lcl\u0027] \u003d tolerances[\u0027lcl\u0027]\n\t\t\t\tspecs[\u0027tgt\u0027] \u003d tolerances[\u0027tgt\u0027]\n\t\t\t\tspecs[\u0027ucl\u0027] \u003d tolerances[\u0027ucl\u0027]\n\t\t\t\tspecs[\u0027usl\u0027] \u003d tolerances[\u0027usl\u0027] or tolerances[\u0027udl\u0027]\n\t\t\t\tspecs[\u0027uel\u0027] \u003d tolerances[\u0027uel\u0027]\n\t\t\telif spec[\u0027specType\u0027] \u003d\u003d \u0027range\u0027:\n\t\t\t\tspecs[\u0027lel\u0027] \u003d None\n\t\t\t\tspecs[\u0027lsl\u0027] \u003d spec[\u0027range\u0027][\u0027min\u0027]\n\t\t\t\tspecs[\u0027usl\u0027] \u003d spec[\u0027range\u0027][\u0027max\u0027]\n\t\t\telif spec[\u0027specType\u0027] \u003d\u003d \u0027setPoint\u0027:\n\t\t\t\tpass\n\t\t\n\t\tlowerV, target, upperV \u003d [0] * 3\t\n\t\tif len([v for k,v in specs.items() if v is not None]) \u003e 0:\n\t\t\tif (specs[\u0027lel\u0027] or None) is not None: lowerV \u003d specs[\u0027lel\u0027]\n\t\t\telif specs[\u0027lsl\u0027] is not None: lowerV \u003d specs[\u0027lsl\u0027]\t\t\t\n\t\t\tif (specs[\u0027tgt\u0027] or None) is not None: target \u003d specs[\u0027tgt\u0027]\n\t\t\tif (specs[\u0027uel\u0027] or None) is not None: upperV \u003d specs[\u0027uel\u0027]\n\t\t\telif specs[\u0027usl\u0027] is not None and specs[\u0027usl\u0027] !\u003d 0: upperV \u003d specs[\u0027usl\u0027]\n\t\t\telse: upperV \u003d lowerV + 1 #No upper limit set\n\t\telse:\n\t\t\tlowerV \u003d pickListValues.get(\u0027min\u0027) or 0\n\t\t\tupperV \u003d pickListValues.get(\u0027max\u0027) or 0\n\t\t\ttarget \u003d None\n\t\n\t\treturn lowerV, target, upperV\n\n\tif value[\u0027pickListInfo\u0027][\u0027pickListId\u0027] is None: return []\n\tpickListName \u003d value[\u0027pickListInfo\u0027][\u0027data\u0027][\u0027pickListName\u0027] or None\n\t\n\tif pickListName is None: return []\n\tpickListValues \u003d value[\u0027pickListInfo\u0027][\u0027pickListValues\u0027]\n\tif pickListValues is None: return []\n\tdataTypeName \u003d value.dataTypeInfo.dataTypeName\n#\tsystem.perspective.print(\"building picklist with %s %s %s\"%(pickListName, pickListValues, dataTypeName))\t\n\n\tif dataTypeName is None or dataTypeName in (\u0027Datetime\u0027): return [] #shouldn\u0027t be opening this popup if it is a string\n\tif pickListName is None or pickListName in (\u0027Time\u0027, \u0027Tree\u0027): return []\t#show time picker / Tree\n\t\n\timport re\n\tvalues \u003d []\n\n\tif pickListName \u003d\u003d \u0027Text\u0027:\n\t\ttry:\t\t\n\t\t\tpassItems \u003d []\n\t\t\tfailItems \u003d []\n\t\t\totherItems \u003d []\n\t\t\tfor k, v in pickListValues[pickListName].items():\n\t\t\t\tif k \u003d\u003d \u0027multiSelect\u0027: continue\n\t\t\t\tif k \u003d\u003d \u0027PASS\u0027: \n\t\t\t\t\tfor item in v: passItems.append(item)\n\t\t\t\telif k \u003d\u003d \u0027FAIL\u0027: \n\t\t\t\t\tfor item in v: failItems.append(item)\n\t\t\t\telse: \n\t\t\t\t\tfor item in v: otherItems.append(item)\n\t\t\t\tvalues \u003d passItems + failItems + otherItems\n\t\texcept:\n\t\t\tvalues \u003d str(pickListValues)\n\t\n\t\treturn [{\"label\": str(value), \"value\": value} for value in values]\n\telif pickListName \u003d\u003d \u0027Boolean\u0027:\n\t\ttry:\n\t\t\tfor k, v in pickListValues[pickListName].items():\n\t\t\t\tif k \u003d\u003d \u0027TRUE\u0027: \n\t\t\t\t\tfor item in v: values.append({\"label\": item, \"value\": 1})\n\t\t\t\telif k \u003d\u003d \u0027FALSE\u0027:  \n\t\t\t\t\tfor item in v: values.append({\"label\": item, \"value\": 0})\n\t\t\t\telif k \u003d\u003d \u0027enableNA\u0027 and v \u003d\u003d True: values.append({\"label\": \u0027N/A\u0027, \"value\": -1})\n\t\t\treturn values\n\t\texcept:\n\t\t\treturn [{\"label\": str(value), \"value\": value} for value in str(pickListValues)]\n\n\t#we are dealing with numbers from here on in\n\tincrement \u003d float(pickListValues[\u0027Number\u0027].get(\u0027increment\u0027)) or 1.0\t\t#default it to halves if no increment was set\n\tif value[\u0027specInfo\u0027][\u0027specType\u0027] \u003d\u003d \u0027setPoint\u0027:\n\t\ttarget \u003d value[\u0027specInfo\u0027][\u0027setPoint\u0027][\u0027value\u0027]\n\t\tmin \u003d pickListValues[\u0027Number\u0027][\u0027min\u0027]\n\t\tmax \u003d pickListValues[\u0027Number\u0027][\u0027max\u0027]\n\t\tlowerV, target, upperV \u003d min, target, max\n\telse:\n\t\tlowerV, target, upperV \u003d getToleranceLimits(value[\u0027specInfo\u0027])\n\n\tvalueRange \u003d int((upperV - lowerV) / increment)\n\tvalues \u003d [lowerV + float(i) * increment for i in range(valueRange+1)]\n\tif target not in values and target !\u003d 0 and target !\u003d None: values.append(target)\n\n\tif dataTypeName \u003d\u003d \u0027Integer\u0027: values \u003d [int(i) for i in values]\n\tif pickListName \u003d\u003d \u0027Number\u0027: values \u003d [{\u0027value\u0027: value, \u0027label\u0027:str(value)} for value in values]\n\telif pickListName \u003d\u003d \u0027Fraction\u0027: values \u003d [{\u0027value\u0027: value, \u0027label\u0027: str(system.kanoa.utilities.getFraction(value) or 0)} for value in values]\n\n\tvalues \u003d sorted(values, key\u003dlambda x: x[\u0027value\u0027])\n\n\tif len(values) \u003e 50: values \u003d values[:50]\t#Cap out at 50 buttons\n\n\treturn values",
                  "type": "script"
                }
              ],
              "type": "property"
            }
          }
        },
