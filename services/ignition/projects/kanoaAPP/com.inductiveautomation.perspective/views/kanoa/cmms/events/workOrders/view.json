  "propConfig": {
    "custom.selection": {
      "persistent": true
    },
    "custom.selection.selectedState": {
      "binding": {
        "config": {
          "struct": {
            "idx": "{view.custom.selection.tabIndex}",
            "tabs": "{view.custom.selection.tabs}"
          },
          "waitOnAll": true
        },
        "overlayOptOut": true,
        "transforms": [
          {
            "code": "\t\n\tif value[\u0027idx\u0027] \u003d\u003d -1: return None\n\timport re\n\tstate \u003d value[\u0027tabs\u0027][value[\u0027idx\u0027]]\t\n\treturn re.sub(r\u0027\\s*\\(.*\\)$\u0027, \u0027\u0027, state)\n\t\n",
            "type": "script"
          }
        ],
        "type": "expr-struct"
      }
    },
    "custom.selection.tabIndex": {
      "binding": {
        "config": {
          "expression": "now(0)"
        },
        "overlayOptOut": true,
        "transforms": [
          {
            "code": "\treturn 0",
            "type": "script"
          }
        ],
        "type": "expr"
      }
    },
    "custom.selection.tabs": {
      "binding": {
        "config": {
          "path": "view.params.values.filter"
        },
        "overlayOptOut": true,
        "transforms": [
          {
            "code": "\n\tdata \u003d system.kanoa.utilities.convertDatasetToDict(system.kanoa.cmms.getWorkOrderEventCount(value), \u0027workOrderEventStatusName\u0027, \u0027count\u0027)\n\treturn [\"%s (%s)\"%(k,v) for k,v in data.items()]\n",
            "type": "script"
          }
        ],
        "type": "property"
      }
    },
    "custom.states": {
      "binding": {
        "config": {
          "expression": "now(0)"
        },
        "overlayOptOut": true,
        "transforms": [
          {
            "code": "\n\treturn system.kanoa.utilities.convertDatasetToDict(system.kanoa.cmms.getWorkOrderEventStatus({\u0027enabled\u0027: True}), \u0027workOrderEventStatusName\u0027, None)",
            "type": "script"
          }
        ],
        "type": "expr"
      },
      "persistent": true
    },
    "custom.workOrderStatus": {
      "binding": {
        "config": {
          "expression": "now(0)"
        },
        "overlayOptOut": true,
        "transforms": [
          {
            "code": "\n\treturn system.kanoa.utilities.convertDatasetToJSON(system.kanoa.cmms.getWorkOrderEventStatus({\u0027enabled\u0027: True}))",
            "type": "script"
          }
        ],
        "type": "expr"
      },
      "persistent": true
    },
    "custom.workOrders": {
      "binding": {
        "config": {
          "struct": {
            "filters": "{view.params.values.filter}",
            "state": "{view.custom.selection.selectedState}"
          },
          "waitOnAll": true
        },
        "overlayOptOut": true,
        "transforms": [
          {
            "code": "\n\tfilters \u003d dict(value[\u0027filters\u0027])\n\tfilters[\u0027workOrderEventStatusName\u0027] \u003d value[\u0027state\u0027]\n\treturn system.kanoa.utilities.convertDatasetToJSON(system.kanoa.cmms.getWorkOrderEvents(filters))",
            "type": "script"
          }
        ],
        "type": "expr-struct"
      },
      "persistent": true
    },
    "params.values": {
      "paramDirection": "input",
      "persistent": true
    }
  },
