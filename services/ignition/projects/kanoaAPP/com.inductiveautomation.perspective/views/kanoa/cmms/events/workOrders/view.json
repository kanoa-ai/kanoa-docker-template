              "config": {
                "struct": {
                  "workOrders": "{view.custom.workOrders}"
                },
                "waitOnAll": true
              },
              "overlayOptOut": true,
              "transforms": [
                {
                  "code": "\n\treturn [{\u0027values\u0027: workOrder} for workOrder in value[\u0027workOrders\u0027]]",
                  "type": "script"
                }
              ],
              "type": "expr-struct"
            }
          }
        },
        "props": {
          "direction": "column",
          "elementPosition": {
            "basis": "auto",
            "grow": 0,
            "shrink": 0
          },
          "elementStyle": {
            "classes": "kanoa/border"
          },
          "path": "kanoa/cmms/events/workOrderEvent",
          "style": {
            "gap": "5px",
            "padding": "5px"
          },
          "useDefaultViewHeight": false,
          "useDefaultViewWidth": false
        },
        "type": "ia.display.flex-repeater"
      }
    ],
    "meta": {
      "name": "root"
    },
    "props": {
      "direction": "column"
    },
    "scripts": {
      "customMethods": [],
      "extensionFunctions": null,
      "messageHandlers": [
        {
          "messageType": "refreshWorkOrders",
          "pageScope": true,
          "script": "\n\tsystem.perspective.print(\"workOrders view refreshWorkOrders() msg rcvd with %s\"%payload)\n\t\n\tself.view.refreshBinding(\"custom.selection.tabs\")\n\t\n\t#We\u0027ll set the tab to the state that the work order just changed to\n\tname \u003d payload.get(\u0027workOrderEventStatusName\u0027)\n\tif name:\n\t\tstatuses \u003d self.view.custom.selection.tabs\n\t\ttabIdx \u003d next((i for i, s in enumerate(statuses) if s.split(\" (\")[0] \u003d\u003d name), -1)\n\t#\tsystem.perspective.print(\"Setting tabIndex to %s\"%tabIdx)\n\t\tif tabIdx !\u003d -1: self.view.custom.selection.tabIndex \u003d tabIdx\n\t\n\tself.view.refreshBinding(\"custom.workOrders\")\n\t\t\n\treturn",
          "sessionScope": false,
          "viewScope": false
        }
      ]
    },
    "type": "ia.container.flex"
  }
