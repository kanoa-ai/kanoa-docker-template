          {
            "events": {
              "component": {
                "onActionPerformed": {
                  "config": {
                    "script": "\n\ttechnicianInfo \u003d dict(self.view.custom.technicianInfo)\n\tuserId \u003d self.view.custom.security.userId\n\n\tif technicianInfo.get(\u0027workOrderEventTechnicianId\u0027):\n\t\tretVal, msg \u003d system.kanoa.cmms.updateWorkOrderEventTechnician(technicianInfo, userId)\n\telse:\n\t\tretVal, msg \u003d system.kanoa.cmms.addWorkOrderEventTechnician(technicianInfo, userId)\n\n\tif msg:\n\t\tsystem.perspective.sendMessage(\u0027showFailerToast\u0027, {\u0027message\u0027: \"Couldn\u0027t save entry. %s\" % msg})\n\telse:\n\t\tsystem.perspective.sendMessage(\u0027showSuccessfulToast\u0027, {\u0027message\u0027: \u0027Entry saved successfully\u0027})\n\t\tsystem.perspective.sendMessage(\u0027refreshTechnicians\u0027, {})\n\t\tsystem.perspective.closePopup(\u0027\u0027)\n\n\treturn"
                  },
                  "scope": "G",
                  "type": "script"
                }
              }
            },
            "meta": {
              "domId": "btnSave",
              "name": "btnSave",
              "tooltip": {
                "enabled": true,
                "location": "center-right"
              }
            },
            "propConfig": {
              "meta.tooltip.text": {
                "binding": {
                  "config": {
                    "path": "view.custom.validation.validationErrors"
                  },
                  "transforms": [
                    {
                      "code": "\treturn \u0027. \u0027.join(value)",
                      "type": "script"
                    }
                  ],
                  "type": "property"
                }
              },
              "props.enabled": {
                "binding": {
                  "config": {
