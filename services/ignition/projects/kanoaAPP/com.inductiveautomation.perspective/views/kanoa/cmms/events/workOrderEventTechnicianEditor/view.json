  "propConfig": {
    "custom.security": {
      "binding": {
        "config": {
          "path": "session.custom.kanoa.security"
        },
        "overlayOptOut": true,
        "type": "property"
      },
      "persistent": true
    },
    "custom.technicianInfo": {
      "binding": {
        "config": {
          "path": "view.params.values"
        },
        "overlayOptOut": true,
        "transforms": [
          {
            "code": "\t\n\ttechnicianInfo \u003d system.kanoa.utilities.convertDatasetRowToJSON(system.kanoa.cmms.getWorkOrderEventTechnicians({\u0027workOrderEventTechnicianId\u0027: value.get(\u0027workOrderEventTechnicianId\u0027) or -1}), 0)\n\ttechnicianInfo[\u0027workOrderEventTechnicianId\u0027] \u003d value.get(\u0027workOrderEventTechnicianId\u0027)\n\ttechnicianInfo[\u0027workOrderEventId\u0027] \u003d value.get(\u0027workOrderEventId\u0027)\n\n\treturn technicianInfo",
            "type": "script"
          }
        ],
        "type": "property"
      },
      "persistent": true
    },
    "custom.technicians": {
      "binding": {
        "config": {
          "expression": "now(0)"
        },
        "overlayOptOut": true,
        "transforms": [
          {
            "code": "\t\n\tusers \u003d system.kanoa.utilities.convertDatasetToJSON(system.kanoa.security.getUserAssetRoles({\u0027functionName\u0027: \u0027enterWorkOrders\u0027}))\n\t\n\toptions \u003d []\n\tentries \u003d []\n\tfor item in users:\n\t\tif item[\"lastName\"] is None or item[\u0027userName\u0027] in entries: continue\n\t\toptions.append(item)\n\t\tentries.append(item[\u0027userName\u0027])\n\t\t\n\treturn sorted(options, key\u003dlambda x: x[\"firstName\"])",
            "type": "script"
          }
        ],
        "type": "expr"
      },
      "persistent": true
    },
    "custom.validation": {
      "binding": {
        "config": {
          "path": "view.custom.technicianInfo"
        },
        "overlayOptOut": true,
        "transforms": [
          {
            "code": "\t\n\tvalidationErrors \u003d []\n\t\n\tif not value.get(\u0027userId\u0027): validationErrors.append(\u0027Technician is required.\u0027)\n\t\n\tif not value.get(\u0027workTypeId\u0027): validationErrors.append(\u0027Work Type is required.\u0027)\n\t\n\tduration \u003d value.get(\u0027durationMinutes\u0027)\n\tif duration is None: validationErrors.append(\u0027Duration is required.\u0027)\n\telif duration \u003c\u003d 0: validationErrors.append(\u0027Duration must be greater than zero.\u0027)\n\t\n\treturn {\u0027isValid\u0027: len(validationErrors) \u003d\u003d 0, \u0027validationErrors\u0027: validationErrors}",
            "type": "script"
          }
        ],
        "type": "property"
      },
      "persistent": true
    },
    "custom.workTypes": {
      "binding": {
        "config": {
          "expression": "now(0)"
        },
        "overlayOptOut": true,
        "transforms": [
          {
            "code": "\t\n\treturn system.kanoa.utilities.convertDatasetToJSON(system.kanoa.cmms.getWorkTypes({\u0027enabled\u0027: True}))",
            "type": "script"
          }
        ],
        "type": "expr"
      },
      "persistent": true
    },
    "params.values": {
      "paramDirection": "input",
      "persistent": true
    }
  },
