      "customMethods": [
        {
          "name": "clearData",
          "params": [],
          "script": "\t\n\tsystem.perspective.print(\"clearData() called\")\n\t\n\tself.view.custom.workOrderStatus.data \u003d []\n\tself.view.custom.workOrderStatus.row \u003d None\n\tself.view.custom.workOrderStatus.col \u003d None\n\n\treturn"
        },
        {
          "name": "openWorkOrderStatusEditor",
          "params": [
            "workOrderStatusId"
          ],
          "script": "\t\n\tsystem.perspective.openPopup(\"Work Order Status Editor\", \"kanoa/cmms/config/status/workOrderStatusEditor\", params\u003d{\u0027values\u0027: {\u0027workOrderStatusId\u0027:workOrderStatusId}}, overlayDismiss\u003dTrue, title\u003d\u0027Work Order Status Editor\u0027, draggable\u003dTrue, showCloseOption\u003dTrue, resizable\u003dTrue, viewPortBound\u003dTrue)\n\t\n\treturn"
        },
        {
          "name": "deleteWorkOrderStatus",
          "params": [],
          "script": "\n\t\n\tworkOrderStatusInfo \u003d self.view.custom.workOrderStatus.selectedData[0]\n\tif workOrderStatusInfo and workOrderStatusInfo.has_key(\u0027workOrderStatusId\u0027):\n\t\tretVal, msg \u003d system.kanoa.cmms.deleteWorkOrderStatus(workOrderStatusInfo[\u0027workOrderStatusId\u0027], self.view.custom.security.userId)\n\t\tif retVal:\n\t\t\tsystem.perspective.sendMessage(\u0027showSuccessfulToast\u0027, {\u0027message\u0027: \u0027Work Order Status has been deleted\u0027})\n\t\telse:\n\t\t\tif \u0027The DELETE statement conflicted with the REFERENCE constraint\u0027 in str(msg) or \u0027The DELETE statement conflicted with the SAME TABLE REFERENCE constraint\u0027 in str(msg):\n\t\t\t\tmsg \u003d \u0027This work order status has been used and cannot be deleted. Please disable it.\u0027\n\t\t\tsystem.perspective.sendMessage(\u0027showFailerToast\u0027, {\u0027message\u0027: msg})\n\t\n\t\tself.view.refreshBinding(\"custom.workOrderStatus.data\")\n\t\n\treturn"
        }
      ],
      "extensionFunctions": null,
      "messageHandlers": [
        {
          "messageType": "refreshWorkOrderStatus",
          "pageScope": true,
          "script": "\t\n\tsystem.perspective.print(\"refreshWorkOrderStatus msg received\")\n\tself.view.refreshBinding(\"custom.workOrderStatus.data\")\n\t\n\treturn",
          "sessionScope": false,
          "viewScope": false
        }
      ]
