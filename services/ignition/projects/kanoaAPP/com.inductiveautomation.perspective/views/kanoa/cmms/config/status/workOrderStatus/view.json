          "waitOnAll": false
        },
        "overlayOptOut": true,
        "transforms": [
          {
            "code": "\t\n\tsecConfig \u003d system.kanoa.utilities.convertDatasetToDict(system.kanoa.security.getConfig({}), \u0027configName\u0027, \u0027configValue\u0027)\n\tuserId \u003d system.kanoa.security.getIDPUserId(value[\u0027user\u0027])\t\n\tuserCRUD \u003d system.kanoa.security.getUserAssetCRUD(userId)\n\t\n\treturn {\"userId\": userId, \"config\": secConfig, \"userCRUD\": userCRUD}",
            "type": "script"
          }
        ],
        "type": "expr-struct"
      },
      "persistent": true
    },
    "custom.workOrderStatus": {
      "persistent": true
    },
    "custom.workOrderStatus.data": {
      "binding": {
        "config": {
          "expression": "now(0)"
        },
        "overlayOptOut": true,
        "transforms": [
          {
            "code": "\n\treturn system.kanoa.utilities.convertDatasetToJSON(system.kanoa.cmms.getWorkOrderStatus({}))",
            "type": "script"
          }
        ],
        "type": "expr"
      }
    },
    "custom.workOrderStatus.userAction": {
      "binding": {
        "config": {
          "struct": {
            "data": "{view.custom.workOrderStatus.selectedData}",
            "security": "{view.custom.security}"
          },
          "waitOnAll": true
        },
        "overlayOptOut": true,
        "transforms": [
          {
            "code": "\n\tsecurity \u003d value[\u0027security\u0027]\n\tcanCreate \u003d False\n\tcanEdit \u003d False\n\tif security[\u0027userCRUD\u0027] is not None and security[\u0027userId\u0027] is not None:\n\t\tif security[\u0027userCRUD\u0027][\u0027isGatewayAdmin\u0027] or security[\u0027userCRUD\u0027][\u0027configureMaintenance\u0027][\u0027enabled\u0027]: \n\t\t\tcanCreate \u003d True\n\t\t\tcanEdit \u003d True if len(value[\u0027data\u0027]) \u003e 0 else False\n\t\t\t\n\treturn {\"canCreate\": canCreate, \"canDelete\": canEdit, \"canRead\": True, \"canUpdate\": canEdit}",
            "type": "script"
          }
        ],
        "type": "expr-struct"
      }
    }
  },
