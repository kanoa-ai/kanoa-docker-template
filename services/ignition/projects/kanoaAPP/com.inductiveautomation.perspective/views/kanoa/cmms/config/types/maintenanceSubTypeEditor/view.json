            "events": {
              "component": {
                "onActionPerformed": {
                  "config": {
                    "script": "\n\tmaintenanceSubTypeInfo \u003d dict(self.view.custom.maintenanceSubTypeInfo)\n\tuserId \u003d system.kanoa.security.getIDPUserId(self.session.props.auth.user)\n\t\n\tif maintenanceSubTypeInfo[\u0027maintenanceSubTypeId\u0027] is not None: \t#If name has changed, we need to check that it doesn\u0027t already exist\n\t\tcurrentMaintenanceSubTypeId \u003d system.kanoa.utilities.getFieldValue(\u0027maintenanceSubTypeId\u0027, system.kanoa.cmms.getMaintenanceSubTypes({\u0027maintenanceSubTypeName\u0027: maintenanceSubTypeInfo[\u0027maintenanceSubTypeName\u0027], \u0027maintenanceTypeId\u0027: maintenanceSubTypeInfo[\u0027maintenanceTypeId\u0027]}))\n\t\tif currentMaintenanceSubTypeId is not None and currentMaintenanceSubTypeId !\u003d maintenanceSubTypeInfo[\u0027maintenanceTypeId\u0027]:\n\t\t\tsystem.perspective.sendMessage(\u0027showFailerToast\u0027, {\u0027message\u0027: \u0027This maintenance sub type already exists\u0027})\n\t\t\treturn\n\t\t\n\t\tsystem.perspective.sendMessage(\u0027showInfoToast\u0027, {\u0027message\u0027: \u0027Updating work type %i \u0027%maintenanceSubTypeInfo[\u0027maintenanceTypeId\u0027]})\t\t\t\n\t\tretVal, msg \u003d system.kanoa.cmms.updateMaintenanceSubType(maintenanceSubTypeInfo, userId)\n\telse:\n\t\tsystem.perspective.sendMessage(\u0027showInfoToast\u0027, {\u0027message\u0027: \u0027Adding work type\u0027})\t\n\t\tmaintenanceTypeId, msg \u003d system.kanoa.cmms.addMaintenanceSubType(maintenanceSubTypeInfo, userId)\n\t\t\n\tif msg:\n\t\tsystem.perspective.sendMessage(\u0027showFailerToast\u0027, {\u0027message\u0027: \"Couldn\u0027t save this work type. %s\"%msg})\n\telse:\n\t\tsystem.perspective.sendMessage(\u0027showSuccessfulToast\u0027, {\u0027message\u0027: \"Work type has been saved\"})\n\n\tsystem.perspective.sendMessage(\"refreshMaintenanceSubTypes\", {})\t\n\tsystem.perspective.closePopup(\u0027\u0027)\n\t\n\treturn"
                  },
                  "scope": "G",
                  "type": "script"
                }
              }
            },
