        {
          "name": "openEditor",
          "params": [
            "workOrderEventTechnicianId"
          ],
          "script": "\t\n\tsystem.perspective.openPopup(\"Technician Editor\", \"kanoa/cmms/events/workOrderEventTechnicianEditor\", params\u003d{\u0027values\u0027: {\u0027workOrderEventTechnicianId\u0027: workOrderEventTechnicianId, \u0027workOrderEventId\u0027: self.view.params.values.workOrderEventId}}, overlayDismiss\u003dTrue, title\u003d\u0027Technician Editor\u0027, draggable\u003dTrue, showCloseOption\u003dTrue, resizable\u003dTrue, viewPortBound\u003dTrue)\n\n\treturn"
        },
        {
          "name": "delete",
          "params": [],
          "script": "\n\t\n\ttechnicianInfo \u003d self.view.custom.technician.selectedData[0]\n\tif technicianInfo.get(\u0027workOrderEventTechnicianId\u0027):\n\t\tretVal, msg \u003d system.kanoa.cmms.deleteWorkOrderEventTechnician(technicianInfo[\u0027workOrderEventTechnicianId\u0027], self.view.custom.security.userId)\n\t\tif msg is None:\n\t\t\tsystem.perspective.sendMessage(\u0027showSuccessfulToast\u0027, {\u0027message\u0027: \u0027Record has been deleted\u0027})\n\t\telse:\n\t\t\tsystem.perspective.sendMessage(\u0027showFailerToast\u0027, {\u0027message\u0027: msg})\n\n\t\tself.view.refreshBinding(\"custom.technician.data\")\n\t\n\treturn"
        }
      ],
