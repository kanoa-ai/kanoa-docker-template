      "binding": {
        "config": {
          "path": "view.params.values"
        },
        "overlayOptOut": true,
        "transforms": [
          {
            "code": "\t\n\treturn system.kanoa.utilities.convertDatasetToJSON(system.kanoa.cmms.getWorkOrderEventTechnicians({\u0027workOrderEventId\u0027: value.get(\u0027workOrderEventId\u0027,-1) or -1}))",
            "type": "script"
          }
        ],
        "type": "property"
      }
    },
    "custom.technician.userAction": {
      "binding": {
        "config": {
          "struct": {
            "data": "{view.custom.technician.selectedData}",
            "security": "{view.custom.security}"
          },
          "waitOnAll": true
        },
        "overlayOptOut": true,
        "transforms": [
          {
            "code": "\n\tsecurity \u003d value[\u0027security\u0027]\n\tcanCreate \u003d False\n\tcanEdit \u003d False\n\tif security[\u0027userCRUD\u0027] is not None and security[\u0027userId\u0027] is not None:\n\t\tif security[\u0027userCRUD\u0027][\u0027isGatewayAdmin\u0027] or security[\u0027userCRUD\u0027][\u0027enterWorkOrders\u0027][\u0027enabled\u0027]: \n\t\t\tcanCreate \u003d True\n\t\t\tcanEdit \u003d True if len(value[\u0027data\u0027]) \u003e 0 else False\n\t\t\t\n\treturn {\"canCreate\": canCreate, \"canDelete\": canEdit, \"canRead\": True, \"canUpdate\": canEdit}",
            "type": "script"
          }
        ],
        "type": "expr-struct"
      }
    },
    "params.values": {
      "paramDirection": "input",
      "persistent": true
    }
  },
