  "propConfig": {
    "custom.maintenanceTypeInfo": {
      "binding": {
        "config": {
          "path": "view.params.values.maintenanceTypeId"
        },
        "overlayOptOut": true,
        "transforms": [
          {
            "code": "\n\tmaintenanceTypeInfo \u003d system.kanoa.utilities.convertDatasetRowToJSON(system.kanoa.cmms.getMaintenanceTypes({\u0027maintenanceTypeId\u0027:value or -1}),0)\n\tmaintenanceTypeInfo[\u0027maintenanceTypeName\u0027] \u003d maintenanceTypeInfo[\u0027maintenanceTypeName\u0027] or \u0027\u0027\n\tmaintenanceTypeInfo[\u0027maintenanceTypeColor\u0027] \u003d maintenanceTypeInfo[\u0027maintenanceTypeColor\u0027] or \u0027\u0027\n\treturn maintenanceTypeInfo\n",
            "type": "script"
          }
        ],
        "type": "property"
      },
      "persistent": true
    },
    "params.values": {
      "paramDirection": "input",
      "persistent": true
    }
  },
  "props": {
    "defaultSize": {
      "height": 182,
      "width": 350
    }
  },
