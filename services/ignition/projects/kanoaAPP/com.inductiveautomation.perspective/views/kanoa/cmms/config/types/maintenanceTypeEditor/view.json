        "type": "ia.container.flex"
      },
      {
        "children": [
          {
            "events": {
              "component": {
                "onActionPerformed": {
                  "config": {
                    "script": "\n\tmaintenanceTypeInfo \u003d dict(self.view.custom.maintenanceTypeInfo)\n\tuserId \u003d system.kanoa.security.getIDPUserId(self.session.props.auth.user)\n\t\n\tif maintenanceTypeInfo[\u0027maintenanceTypeId\u0027] is not None: \t#If name has changed, we need to check that it doesn\u0027t already exist\n\t\tcurrentMaintenanceTypeId \u003d system.kanoa.utilities.getFieldValue(\u0027maintenanceTypeId\u0027, system.kanoa.cmms.getMaintenanceTypes({\u0027maintenanceTypeName\u0027: maintenanceTypeInfo[\u0027maintenanceTypeName\u0027]}))\n\t\tif currentMaintenanceTypeId is not None and currentMaintenanceTypeId !\u003d maintenanceTypeInfo[\u0027maintenanceTypeId\u0027]:\n\t\t\tsystem.perspective.sendMessage(\u0027showFailerToast\u0027, {\u0027message\u0027: \u0027This maintenance type already exists\u0027})\n\t\t\treturn\n\t\t\n\t\tsystem.perspective.sendMessage(\u0027showInfoToast\u0027, {\u0027message\u0027: \u0027Updating maintenanceTypeId %i \u0027%maintenanceTypeInfo[\u0027maintenanceTypeId\u0027]})\t\t\t\n\t\tretVal, msg \u003d system.kanoa.cmms.updateMaintenanceType(maintenanceTypeInfo, userId)\n\telse:\n\t\tsystem.perspective.sendMessage(\u0027showInfoToast\u0027, {\u0027message\u0027: \u0027Adding maintenance type\u0027})\t\n\t\tmaintenanceTypeId, msg \u003d system.kanoa.cmms.addMaintenanceType(maintenanceTypeInfo, userId)\n\t\t\n\tif msg:\n\t\tsystem.perspective.sendMessage(\u0027showFailerToast\u0027, {\u0027message\u0027: \"Couldn\u0027t save this maintenance type. %s\"%msg})\n\telse:\n\t\tsystem.perspective.sendMessage(\u0027showSuccessfulToast\u0027, {\u0027message\u0027: \"Maintenance type has been saved\"})\n\n\tsystem.perspective.sendMessage(\"refreshMaintenanceTypes\", {})\t\n\tsystem.perspective.closePopup(\u0027\u0027)\n\t\n\treturn"
                  },
                  "scope": "G",
                  "type": "script"
                }
              }
            },
            "meta": {
              "domId": "btnSave",
              "name": "btnSave",
              "tooltip": {
                "enabled": true,
                "location": "bottom-left",
                "text": "Save"
              }
            },
            "position": {
              "shrink": 0
            },
            "propConfig": {
