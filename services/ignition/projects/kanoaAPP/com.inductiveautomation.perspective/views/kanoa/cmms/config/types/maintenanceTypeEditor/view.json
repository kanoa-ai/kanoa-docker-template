        "meta": {
          "domId": "flxmaintenanceTypeColor",
          "name": "flxSerial",
          "tooltip": {
            "enabled": true,
            "location": "center-right",
            "text": "Select a serialization to use when generating workorders of this type. Can leave blank to default to maintenaceWorkOrder"
          }
