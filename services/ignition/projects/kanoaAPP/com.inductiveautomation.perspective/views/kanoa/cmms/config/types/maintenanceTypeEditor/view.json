{
  "custom": {
    "maintenanceTypeInfo": {
      "changedBy": null,
      "changedDate": null,
      "createdBy": null,
      "createdDate": null,
      "enabled": null,
      "lastUpdated": null,
      "lastUpdatedBy": null,
      "maintenanceTypeColor": "",
      "maintenanceTypeId": null,
      "maintenanceTypeName": "",
      "serialId": null,
      "serialName": null
