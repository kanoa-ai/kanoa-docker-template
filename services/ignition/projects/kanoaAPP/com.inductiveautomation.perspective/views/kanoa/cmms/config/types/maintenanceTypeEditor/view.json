            "propConfig": {
              "props.options": {
                "binding": {
                  "config": {
                    "expression": "now(0)"
                  },
                  "overlayOptOut": true,
                  "transforms": [
                    {
                      "code": "\tserials \u003d system.kanoa.utilities.convertDatasetToJSON(system.kanoa.serial.getSerialNumbers({\u0027enabled\u0027: True}))\n\treturn [{\u0027value\u0027: item[\u0027serialId\u0027], \u0027label\u0027: item[\u0027serialName\u0027]} for item in serials]",
                      "type": "script"
                    }
                  ],
                  "type": "expr"
                }
              },
              "props.value": {
                "binding": {
                  "config": {
                    "bidirectional": true,
                    "path": "view.custom.maintenanceTypeInfo.serialId"
                  },
                  "overlayOptOut": true,
                  "type": "property"
                }
              }
            },
            "props": {
              "dropdownOptionStyle": {
                "classes": "kanoa/font/default"
              },
              "placeholder": {
                "text": "Select Type..."
              },
              "showClearIcon": true,
              "style": {
