                  "config": {
                    "script": "\n\tmodelInfo \u003d dict(self.view.custom.modelInfo)\n\tuserId \u003d system.kanoa.security.getIDPUserId(self.session.props.auth.user)\n\t\n\tif modelInfo[\u0027modelId\u0027] is not None: \t#If name has changed, we need to check that it doesn\u0027t already exist\n\t\tcurrentModelId \u003d system.kanoa.utilities.getFieldValue(\u0027modelId\u0027, system.kanoa.inventory.getModels({\u0027modelNumber\u0027: modelInfo[\u0027modelNumber\u0027]}))\n\t\tif currentModelId is not None and currentModelId !\u003d modelInfo[\u0027modelId\u0027]:\n\t\t\tsystem.perspective.sendMessage(\u0027showFailerToast\u0027, {\u0027message\u0027: \u0027This model already exists\u0027})\n\t\t\treturn\n\t\t\n\tsystem.perspective.sendMessage(\u0027showInfoToast\u0027, {\u0027message\u0027: \u0027Saving model %s\u0027%modelInfo[\u0027modelNumber\u0027]})\t\t\t\t\t\n\tmodelId, msg \u003d system.kanoa.inventory.addModel(modelInfo, userId)\n\t\t\n\tif msg: system.perspective.sendMessage(\u0027showFailerToast\u0027, {\u0027message\u0027: \"Couldn\u0027t save this model. %s\"%msg})\n\telse: system.perspective.sendMessage(\u0027showSuccessfulToast\u0027, {\u0027message\u0027: \"Model has been saved\"})\n\n\tsystem.perspective.sendMessage(\"refreshModels\", {})\t\n\tsystem.perspective.closePopup(\u0027\u0027)\n\t\n\treturn"
                  },
                  "scope": "G",
                  "type": "script"
                }
