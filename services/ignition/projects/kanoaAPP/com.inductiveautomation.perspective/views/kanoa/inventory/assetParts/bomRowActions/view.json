{
  "custom": {},
  "params": {
    "value": {
      "assetBomId": null,
      "deleteMsgHandler": "bomItemDelete",
      "editMsgHandler": "bomItemEdit"
    }
  },
  "propConfig": {
    "params.value": {
      "paramDirection": "input",
      "persistent": true
    }
  },
  "props": {
    "defaultSize": {
      "height": 40,
      "width": 80
    }
  },
  "root": {
    "children": [
      {
        "events": {
          "component": {
            "onActionPerformed": {
              "config": {
                "script": "\n\tsystem.perspective.sendMessage(self.view.params.value.editMsgHandler, {\u0027assetBomId\u0027: self.view.params.value.assetBomId}, scope\u003d\u0027page\u0027)\n\t\n\treturn"
              },
              "scope": "G",
              "type": "script"
            }
          }
        },
        "meta": {
          "domId": "btnEdit",
          "name": "btnEdit"
        },
        "position": {
          "basis": "25px",
          "shrink": 0
        },
        "props": {
          "image": {
            "icon": {
              "path": "material/edit"
            }
          },
          "style": {
            "classes": "kanoa/button/flatIcon"
          },
          "text": ""
        },
        "type": "ia.input.button"
      },
      {
        "events": {
          "component": {
            "onActionPerformed": {
              "config": {
                "script": "\n\tsystem.perspective.sendMessage(self.view.params.value.deleteMsgHandler, {\u0027assetBomId\u0027: self.view.params.value.assetBomId}, scope\u003d\u0027page\u0027)\n\t\n\treturn"
              },
              "scope": "G",
              "type": "script"
            }
          }
        },
        "meta": {
          "domId": "btnDelete",
          "name": "btnDelete"
        },
        "position": {
          "basis": "25px",
          "shrink": 0
        },
        "props": {
          "image": {
            "icon": {
              "color": "--kcRed-60",
              "path": "material/delete_forever"
            }
          },
          "style": {
            "classes": "kanoa/button/flatIcon"
          },
          "text": ""
        },
        "type": "ia.input.button"
      }
    ],
    "meta": {
      "domId": "root",
      "name": "root"
    },
    "props": {
      "style": {
        "alignItems": "center",
        "gap": "4px",
        "padding": "2px"
      }
    },
    "type": "ia.container.flex"
  }
}