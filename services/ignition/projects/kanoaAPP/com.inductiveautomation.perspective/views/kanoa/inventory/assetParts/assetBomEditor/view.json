  "propConfig": {
    "custom.bom.data": {
      "binding": {
        "config": {
          "path": "view.params.assetId"
        },
        "overlayOptOut": true,
        "transforms": [
          {
            "code": "\n\tassetId \u003d self.view.params.assetId\n\tif assetId is None: return []\n\n\traw \u003d system.kanoa.inventory.getAssetBom({\u0027assetId\u0027: assetId})\n\trows \u003d []\n\tcurrentModel \u003d None\n\t\n\tfor row in system.dataset.toPyDataSet(raw):\n\t\tsourceModel \u003d row[\u0027sourceModelNumber\u0027] or \u0027\u0027\n\t\tsourceDesc \u003d row[\u0027sourceModelDescription\u0027] or \u0027\u0027\n\t\tsourceMfr \u003d row[\u0027sourceManufacturerName\u0027] or \u0027\u0027\n\n\t\t# Inject model header row when sourceModelNumber changes\n\t\tif sourceModel and sourceModel !\u003d currentModel:\n\t\t\tcurrentModel \u003d sourceModel\n#\t\t\theaderLabel  \u003d sourceMfr + \u0027 — \u0027 + sourceModel if sourceMfr else sourceModel\n\t\t\theaderLabel  \u003d sourceModel if sourceMfr else sourceModel\n\t\t\trows.append({\n\t\t\t\t\u0027assetBomId\u0027:             row[\u0027assetBomId\u0027],\n\t\t\t\t\u0027partNumber\u0027:             headerLabel,\n\t\t\t\t\u0027partDescription\u0027:        sourceDesc,\n\t\t\t\t\u0027sourceModelBomId\u0027:        row[\u0027sourceModelBomId\u0027],\n\t\t\t\t\u0027sourceModelNumber\u0027:      sourceModel,\n\t\t\t\t\u0027sourceModelDescription\u0027: sourceDesc,\n\t\t\t\t\u0027sourceManufacturerName\u0027: sourceMfr,\n\t\t\t\t\u0027quantity\u0027:               None,\n\t\t\t\t\u0027uomCode\u0027:                \u0027\u0027,\n\t\t\t\t\u0027positionName\u0027:           \u0027\u0027,\n\t\t\t\t\u0027partCategoryPath\u0027:       \u0027\u0027,\n\t\t\t\t\u0027depth\u0027:                  1,\n\t\t\t\t\u0027partId\u0027:                 None,\n\t\t\t\t\u0027isHeader\u0027:               True,\n\t\t\t})\n\t\telif not sourceModel: currentModel \u003d None\n\n\t\tdisplay  \u003d str(row[\u0027partNumber\u0027])\n\t\tpartDesc \u003d str(row[\u0027partDescription\u0027]) if row[\u0027partDescription\u0027] else \u0027\u0027\n\n\t\trows.append({\n\t\t\t\u0027assetBomId\u0027:             row[\u0027assetBomId\u0027],\n\t\t\t\u0027partNumber\u0027:             display,\n\t\t\t\u0027partDescription\u0027:        partDesc,\n\t\t\t\u0027sourceModelBomId\u0027:        row[\u0027sourceModelBomId\u0027],\n\t\t\t\u0027sourceModelNumber\u0027:      sourceModel,\n\t\t\t\u0027sourceModelDescription\u0027: sourceDesc,\n\t\t\t\u0027sourceManufacturerName\u0027: sourceMfr,\n\t\t\t\u0027quantity\u0027:               row[\u0027quantity\u0027],\n\t\t\t\u0027uomCode\u0027:                row[\u0027uomCode\u0027] or \u0027\u0027,\n\t\t\t\u0027positionName\u0027:           row[\u0027positionName\u0027] or \u0027\u0027,\n\t\t\t\u0027partCategoryPath\u0027:       row[\u0027partCategoryPath\u0027] or \u0027\u0027,\n\t\t\t\u0027depth\u0027:                  2 if sourceModel else 1,\n\t\t\t\u0027partId\u0027:                 row[\u0027partId\u0027],\n\t\t\t\u0027isHeader\u0027:               False,\n\t\t})\n\t\n\tself.view.custom.bom.data \u003d rows\n\tself.view.custom.bom.row \u003d None\n\tself.view.custom.bom.selectedData \u003d []\n\n\treturn rows\n",
            "type": "script"
          }
        ],
        "type": "property"
      }
    },
    "custom.security": {
      "binding": {
        "config": {
          "struct": {
            "user": "{session.props.auth.user}"
          },
          "waitOnAll": false
        },
        "overlayOptOut": true,
        "transforms": [
          {
            "code": "\t\n\tsecConfig \u003d system.kanoa.utilities.convertDatasetToDict(system.kanoa.security.getConfig({}), \u0027configName\u0027, \u0027configValue\u0027)\n\tuserId \u003d system.kanoa.security.getIDPUserId(value[\u0027user\u0027])\t\n\tuserCRUD \u003d system.kanoa.security.getUserAssetCRUD(userId)\n\t\n\treturn {\"userId\": userId, \"config\": secConfig, \"userCRUD\": userCRUD}",
            "type": "script"
          }
        ],
        "type": "expr-struct"
      },
      "persistent": true
    },
    "custom.userAction": {
      "binding": {
        "config": {
          "struct": {
            "data": "{view.custom.bom.selectedData}",
            "security": "{view.custom.security}"
          },
          "waitOnAll": true
        },
        "overlayOptOut": true,
        "transforms": [
          {
            "code": "\n\tsecurity \u003d value[\u0027security\u0027]\n\tcanCreate \u003d False\n\tcanEdit \u003d False\n\tif security[\u0027userCRUD\u0027] is not None and security[\u0027userId\u0027] is not None:\n\t\tif security[\u0027userCRUD\u0027][\u0027isGatewayAdmin\u0027] or security[\u0027userCRUD\u0027][\u0027configureMaintenance\u0027][\u0027enabled\u0027]: \n\t\t\tcanCreate \u003d True\n\t\t\tcanEdit \u003d True if len(value[\u0027data\u0027]) \u003e 0 else False\n\t\t\t\n\treturn {\"canCreate\": canCreate, \"canDelete\": canEdit, \"canRead\": True, \"canUpdate\": canEdit}",
            "type": "script"
          }
        ],
        "type": "expr-struct"
      },
      "persistent": true
    },
    "params.assetId": {
      "paramDirection": "input",
      "persistent": true
    }
  },
