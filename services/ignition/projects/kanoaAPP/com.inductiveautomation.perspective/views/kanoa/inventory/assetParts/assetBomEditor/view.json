    "scripts": {
      "customMethods": [
        {
          "name": "editItem",
          "params": [],
          "script": "\n\trow \u003d self.view.custom.bom.selectedData[0] if self.view.custom.bom.selectedData else None\n\tif row is None: return\n\tsystem.perspective.openPopup(\u0027bomItemEditor\u0027, \u0027kanoa/inventory/assetParts/bomItemEditor\u0027, params\u003d{\u0027assetBomId\u0027: row[\u0027assetBomId\u0027], \u0027assetId\u0027: self.view.params.assetId, \u0027msgHandler\u0027: \u0027bomItemSaved\u0027}, title\u003d\u0027Edit BOM Item\u0027, modal\u003dTrue, draggable\u003dTrue, showCloseOption\u003dTrue, viewPortBound\u003dTrue)\n\t\n\treturn"
        }
      ],
      "extensionFunctions": null,
      "messageHandlers": [
        {
          "messageType": "bomItemSaved",
          "pageScope": true,
          "script": "\n\tself.view.getChild(\u0027root\u0027).loadData()\n\t\n\treturn",
          "sessionScope": false,
          "viewScope": false
        },
        {
          "messageType": "bomItemEdit",
          "pageScope": true,
          "script": "\n\tself.view.custom.bom.pendingDeleteId \u003d payload.get(\u0027assetBomId\u0027)\n\tself.view.getChild(\u0027root\u0027).editItem()\n\t\n\treturn",
          "sessionScope": false,
          "viewScope": false
        },
        {
          "messageType": "bomItemDelete",
          "pageScope": true,
          "script": "\n\tsystem.perspective.print(\"bomItemDelete() msg rcvd with %s\"%payload)\n\tif payload.get(\u0027userInput\u0027) !\u003d \u0027OK\u0027: return\n\t\n\tuserId \u003d self.session.custom.kanoa.security.userId\n\tsuccess, msg \u003d system.kanoa.inventory.deleteAssetBomItem(self.view.custom.bom.pendingDeleteId, userId)\n\tif not success: system.perspective.sendMessage(\u0027showFailerToast\u0027, {\u0027message\u0027: msg})\n\n\tself.view.refreshBinding(\"custom.bom.data\")\n\n\treturn",
          "sessionScope": false,
          "viewScope": false
        },
        {
          "messageType": "assetBOMUpdated",
          "pageScope": true,
          "script": "\n\tself.view.refreshBinding(\"custom.bom.data\")\n\t\n\treturn",
          "sessionScope": false,
          "viewScope": false
        }
      ]
    },
    "type": "ia.container.flex"
  }
