  "propConfig": {
    "custom.uomInfo": {
      "binding": {
        "config": {
          "path": "view.params.values.uomId"
        },
        "overlayOptOut": true,
        "transforms": [
          {
            "code": "\n\tuomInfo \u003d system.kanoa.utilities.convertDatasetRowToJSON(system.kanoa.inventory.getUnitOfMeasures({\u0027uomId\u0027:value or -1}),0)\n\tif uomInfo[\u0027uomId\u0027] is None:\n\t\tuomInfo[\u0027enabled\u0027] \u003d True\n\t\tuomInfo[\u0027uomName\u0027] \u003d \u0027\u0027\n\t\tuomInfo[\u0027uomCode\u0027] \u003d \u0027\u0027\n\t\t\n\treturn uomInfo\n",
            "type": "script"
          }
        ],
        "type": "property"
      },
      "persistent": true
    },
    "custom.validation": {
      "binding": {
        "config": {
          "path": "view.custom.uomInfo"
        },
        "overlayOptOut": true,
        "transforms": [
          {
            "code": "\t\n\trequiredFields \u003d [\u0027uomCode\u0027, \u0027uomName\u0027]\n\tvalidationErrors \u003d []\n\t\n\tfor field in requiredFields:\n\t\tif value.get(field) in [None, \u0027\u0027]:\n\t\t\tvalidationErrors.append(\u0027%s is required.\u0027 % field)\n\t\n\treturn {\u0027isValid\u0027: len(validationErrors) \u003d\u003d 0, \u0027validationErrors\u0027: validationErrors}",
            "type": "script"
          }
        ],
        "type": "property"
      },
      "persistent": true
    },
    "params.values": {
      "paramDirection": "input",
      "persistent": true
    }
  },
