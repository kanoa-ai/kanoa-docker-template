          {
            "events": {
              "component": {
                "onActionPerformed": {
                  "config": {
                    "script": "\n\tuomInfo \u003d dict(self.view.custom.uomInfo)\n\tuserId \u003d system.kanoa.security.getIDPUserId(self.session.props.auth.user)\n\t\n\tif uomInfo[\u0027uomId\u0027] is not None: \t#If name has changed, we need to check that it doesn\u0027t already exist\n\t\tcurrentuomId \u003d system.kanoa.utilities.getFieldValue(\u0027uomId\u0027, system.kanoa.inventory.getUnitOfMeasures({\u0027uomName\u0027: uomInfo[\u0027uomName\u0027]}))\n\t\tif currentuomId is not None and currentuomId !\u003d uomInfo[\u0027uomId\u0027]:\n\t\t\tsystem.perspective.sendMessage(\u0027showFailerToast\u0027, {\u0027message\u0027: \u0027This record already exists\u0027})\n\t\t\treturn\n\t\t\n\t\tsystem.perspective.sendMessage(\u0027showInfoToast\u0027, {\u0027message\u0027: \u0027Updating record %i \u0027%uomInfo[\u0027uomId\u0027]})\t\t\t\n\t\tretVal, msg \u003d system.kanoa.inventory.updateUnitOfMeasure(uomInfo, userId)\n\telse:\n\t\tsystem.perspective.sendMessage(\u0027showInfoToast\u0027, {\u0027message\u0027: \u0027Adding records\u0027})\t\n\t\tmaintenanceTypeId, msg \u003d system.kanoa.inventory.addUnitOfMeasure(uomInfo, userId)\n\t\t\n\tif msg:\tsystem.perspective.sendMessage(\u0027showFailerToast\u0027, {\u0027message\u0027: \"Couldn\u0027t save this record. %s\"%msg})\n\telse: system.perspective.sendMessage(\u0027showSuccessfulToast\u0027, {\u0027message\u0027: \"Record has been saved\"})\n\n\tsystem.perspective.sendMessage(\"refreshUOM\", {})\t\n\tsystem.perspective.closePopup(\u0027\u0027)\n\t\n\treturn"
                  },
                  "scope": "G",
                  "type": "script"
                }
              }
