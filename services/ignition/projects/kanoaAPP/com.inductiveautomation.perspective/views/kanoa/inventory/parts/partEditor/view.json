          {
            "events": {
              "component": {
                "onActionPerformed": {
                  "config": {
                    "script": "\n\tpartInfo \u003d dict(self.view.custom.partInfo)\n\tuserId \u003d system.kanoa.security.getIDPUserId(self.session.props.auth.user)\n\t\n\tif partInfo[\u0027partId\u0027] is not None: \t#If name has changed, we need to check that it doesn\u0027t already exist\n\t\tcurrentpartId \u003d system.kanoa.utilities.getFieldValue(\u0027partId\u0027, system.kanoa.inventory.getParts({\u0027partNumber\u0027: partInfo[\u0027partNumber\u0027]}))\n\t\tif currentpartId is not None and currentpartId !\u003d partInfo[\u0027partId\u0027]:\n\t\t\tsystem.perspective.sendMessage(\u0027showFailerToast\u0027, {\u0027message\u0027: \u0027This record already exists\u0027})\n\t\t\treturn\n\t\t\n\t\tsystem.perspective.sendMessage(\u0027showInfoToast\u0027, {\u0027message\u0027: \u0027Updating record %i \u0027%partInfo[\u0027partId\u0027]})\t\t\t\n\t\tretVal, msg \u003d system.kanoa.inventory.updatePart(partInfo, userId)\n\telse:\n\t\tsystem.perspective.sendMessage(\u0027showInfoToast\u0027, {\u0027message\u0027: \u0027Adding records\u0027})\t\n\t\tmaintenanceTypeId, msg \u003d system.kanoa.inventory.addPart(partInfo, userId)\n\t\t\n\tif msg:\tsystem.perspective.sendMessage(\u0027showFailerToast\u0027, {\u0027message\u0027: \"Couldn\u0027t save this record. %s\"%msg})\n\telse: system.perspective.sendMessage(\u0027showSuccessfulToast\u0027, {\u0027message\u0027: \"Record has been saved\"})\n\n\tsystem.perspective.sendMessage(\"refreshParts\", {})\t\n\tsystem.perspective.closePopup(\u0027\u0027)\n\t\n\treturn"
                  },
                  "scope": "G",
                  "type": "script"
                }
