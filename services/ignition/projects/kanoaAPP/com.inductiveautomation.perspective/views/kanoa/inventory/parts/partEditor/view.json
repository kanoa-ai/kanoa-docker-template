    "scripts": {
      "customMethods": [
        {
          "name": "isValidURL",
          "params": [
            "url"
          ],
          "script": "\n\tif (url or None) is None: return True\n\t\n\timport re\n\n\turlRegex \u003d (\n\t\tr\u0027^(https?:\\/\\/)?\u0027          # optional http:// or https://\n\t\tr\u0027([a-zA-Z0-9-]+\\.)+\u0027      # domain/subdomain\n\t\tr\u0027[a-zA-Z]{2,}\u0027            # top-level domain\n\t\tr\u0027(\\/[^\\s]*)?$\u0027            # optional path\n\t)\n\n\treturn re.match(urlRegex, str(url).strip()) is not None"
        }
      ],
      "extensionFunctions": null,
      "messageHandlers": [
        {
          "messageType": "colorPicked",
          "pageScope": true,
          "script": "\n\tsystem.perspective.print(\"colorPicked message received with payload \" + str(payload))\t\n\t\n\treturn",
          "sessionScope": false,
          "viewScope": false
        },
        {
          "messageType": "partCategorySelected",
          "pageScope": true,
          "script": "\n\tsystem.perspective.print(\"partCategorySelected message received with payload \" + str(payload))\n\t\n\tif len(payload[\u0027selection\u0027]) \u003d\u003d 0: \n\t\tpartCategoryId \u003d None\n\t\tcategoryPath \u003d \u0027\u0027\n\t\tcategoryName \u003d \u0027\u0027\n\telse:\n\t\tselection \u003d payload[\u0027selection\u0027][0][\u0027value\u0027]\n\t\tpartCategoryId \u003d selection[\u0027partCategoryId\u0027]\n\t\tcategoryPath \u003d selection[\u0027categoryPath\u0027]\n\t\tcategoryName \u003d selection[\u0027categoryName\u0027]\n\t\n\tself.view.custom.partInfo.partCategoryId \u003d partCategoryId\n\tself.view.custom.partInfo.categoryPath \u003d categoryPath\n\tself.view.custom.partInfo.categoryName \u003d categoryName\n\t\n\treturn\n\t",
          "sessionScope": false,
          "viewScope": false
        }
      ]
    },
    "type": "ia.container.flex"
  }
