    },
    "custom.partInfo": {
      "binding": {
        "config": {
          "path": "view.params.values.partId"
        },
        "overlayOptOut": true,
        "transforms": [
          {
            "code": "\n\tpartInfo \u003d system.kanoa.utilities.convertDatasetRowToJSON(system.kanoa.inventory.getParts({\u0027partId\u0027:value or -1}),0)\n\tif partInfo[\u0027partId\u0027] is None:\n\t\tpartInfo[\u0027enabled\u0027] \u003d True\n\n\tpartInfo[\u0027partNumber\u0027] \u003d partInfo[\u0027partNumber\u0027] or \u0027\u0027\n\tpartInfo[\u0027normalizedPartNumber\u0027] \u003d partInfo[\u0027normalizedPartNumber\u0027] or \u0027\u0027\n\tpartInfo[\u0027manufacturerPartNumber\u0027] \u003d partInfo[\u0027manufacturerPartNumber\u0027] or \u0027\u0027\n\tpartInfo[\u0027partDescription\u0027] \u003d partInfo[\u0027partDescription\u0027] or \u0027\u0027\n\t\t\t\t\n\treturn partInfo\n",
            "type": "script"
          }
        ],
        "type": "property"
      },
      "persistent": true
    },
    "custom.uom": {
      "binding": {
        "config": {
          "expression": "now(0)"
        },
        "overlayOptOut": true,
        "transforms": [
          {
            "code": "\t\n\treturn system.kanoa.utilities.convertDatasetToJSON(system.kanoa.inventory.getUnitOfMeasures({\u0027[enabled\u0027: True}))",
            "type": "script"
          }
        ],
        "type": "expr"
      },
      "persistent": true
    },
    "custom.validation": {
      "binding": {
        "config": {
          "path": "view.custom.partInfo"
        },
        "overlayOptOut": true,
        "transforms": [
          {
            "code": "\t\n\trequiredFields \u003d [\u0027partNumber\u0027]\n\tvalidationErrors \u003d []\n\t\n\tfor field in requiredFields:\n\t\tif value.get(field) in [None, \u0027\u0027]:\n\t\t\tvalidationErrors.append(\u0027%s is required.\u0027 % field)\n\t\n\treturn {\u0027isValid\u0027: len(validationErrors) \u003d\u003d 0, \u0027validationErrors\u0027: validationErrors}",
            "type": "script"
          }
        ],
        "type": "property"
      },
      "persistent": true
    },
    "params.values": {
      "paramDirection": "input",
      "persistent": true
    }
  },
