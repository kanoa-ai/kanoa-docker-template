{
  "custom": {},
  "params": {},
  "props": {
    "defaultSize": {
      "width": 1141
    }
  },
  "root": {
    "children": [
      {
        "children": [
          {
            "meta": {
              "name": "evCostCenter"
            },
            "props": {
              "path": "kanoa/inventory/config/costCenter"
            },
            "type": "ia.display.view"
          },
          {
            "meta": {
              "name": "evManufacturers"
            },
            "position": {
              "tabIndex": 1
            },
            "props": {
              "path": "kanoa/inventory/config/manufacturers"
            },
            "type": "ia.display.view"
          },
          {
            "meta": {
              "name": "evSuppliers"
            },
            "position": {
              "tabIndex": 2
            },
            "props": {
              "path": "kanoa/inventory/config/suppliers"
            },
            "type": "ia.display.view"
          },
          {
            "meta": {
              "name": "evUOM"
            },
            "position": {
              "tabIndex": 3
            },
            "props": {
              "path": "kanoa/inventory/config/uom"
            },
            "type": "ia.display.view"
          },
          {
            "meta": {
              "name": "evAssetParts"
            },
            "position": {
              "tabIndex": 2
            },
            "props": {
              "params": {
                "assetId": null
              },
              "path": "kanoa/inventory/assetParts/assetBomEditor"
            },
            "type": "ia.display.view"
          }
        ],
        "meta": {
          "name": "tabs"
        },
        "position": {
          "grow": 1
        },
        "propConfig": {
          "props.currentTabIndex": {
            "binding": {
              "config": {
                "expression": "now(0)"
              },
              "overlayOptOut": true,
              "transforms": [
                {
                  "code": "\treturn 0",
                  "type": "script"
                }
              ],
              "type": "expr"
            }
          }
        },
        "props": {
          "menuType": "modern",
          "style": {
            "borderStyle": "none"
          },
          "tabSize": {
            "width": 120
          },
          "tabStyle": {
            "active": {
              "classes": "kanoa/font/default"
            },
            "inactive": {
              "classes": "kanoa/font/default"
            }
          },
          "tabs": [
            "Cost Centers",
            "Manufacturers",
            "Suppliers",
            "UOM"
          ]
        },
        "type": "ia.container.tab"
      }
    ],
    "meta": {
      "name": "root"
    },
    "props": {
      "direction": "column"
    },
    "type": "ia.container.flex"
  }
}