      "createdBy": null,
      "createdDate": null,
      "defaultUomId": null,
      "enabled": true,
      "iconPath": null,
      "inventoryAssetId": null,
      "isStocked": true,
      "lastUpdated": null,
      "lastUpdatedBy": null,
      "maxQty": null,
      "minQty": null,
      "partCategoryPath": null,
      "partDescription": null,
      "partId": null,
      "partInventoryPolicyId": null,
      "partNumber": null,
      "reorderPointQty": null,
      "reorderQty": null,
      "safetyStockQty": null,
      "uomCode": null,
      "uomName": null
    },
    "validation": {
      "isValid": false,
      "validationErrors": [
        "partNumber is required."
      ]
    }
  },
  "params": {
    "values": {
      "inventoryAssetId": null,
      "partId": null,
      "partInventoryPolicyId": null
    }
  },
  "propConfig": {
    "custom.displayOptions": {
      "persistent": true
    },
    "custom.policyInfo": {
      "binding": {
        "config": {
          "path": "view.params.values"
        },
        "overlayOptOut": true,
        "transforms": [
          {
            "code": "\n\tpartPolicyInfo \u003d system.kanoa.utilities.convertDatasetRowToJSON(system.kanoa.inventory.getPartInventoryPolicies({\u0027partInventoryPolicyId\u0027:value.get(\u0027partInventoryPolicyId\u0027) or -1}),0)\n\n\tif partPolicyInfo[\u0027partInventoryPolicyId\u0027] is None: partPolicyInfo[\u0027enabled\u0027] \u003d True\n\tif partPolicyInfo[\u0027isStocked\u0027] is None: partPolicyInfo[\u0027isStocked\u0027] \u003d True\n\n\tif partPolicyInfo[\u0027partId\u0027] is None and value.get(\u0027inventoryAssetId\u0027):\n\t\tassetInfo \u003d system.kanoa.utilities.convertDatasetRowToJSON(system.kanoa.asset.getAssets({\u0027assetId\u0027: value[\u0027inventoryAssetId\u0027]}), 0)\n\t\tpartPolicyInfo[\u0027assetPath\u0027] \u003d assetInfo[\u0027assetPath\u0027]\n\n\tif partPolicyInfo[\u0027partId\u0027] is None and value[\u0027partId\u0027]:\n\t\tpartInfo \u003d system.kanoa.utilities.convertDatasetRowToJSON(system.kanoa.inventory.getParts({\u0027partId\u0027: value[\u0027partId\u0027]}), 0)\n\t\tpartPolicyInfo[\u0027partId\u0027] \u003d partInfo[\u0027partId\u0027]\n\t\tpartPolicyInfo[\u0027partNumber\u0027] \u003d partInfo[\u0027partNumber\u0027]\n\t\tpartPolicyInfo[\u0027partDescription\u0027] \u003d partInfo[\u0027partDescription\u0027]\n\t\tpartPolicyInfo[\u0027partCategoryPath\u0027] \u003d partInfo[\u0027partCategoryPath\u0027]\n\t\tpartPolicyInfo[\u0027uomCode\u0027] \u003d partInfo[\u0027uomCode\u0027]\n\t\tpartPolicyInfo[\u0027uomName\u0027] \u003d partInfo[\u0027uomName\u0027]\n\t\tpartPolicyInfo[\u0027defaultUomId\u0027] \u003d partInfo[\u0027defaultUomId\u0027]\n\t\t\n\tself.custom.inventoryAssetPath \u003d partPolicyInfo[\u0027assetPath\u0027]\n\t\n\treturn partPolicyInfo\n",
            "type": "script"
          }
        ],
        "type": "property"
      },
      "persistent": true
    },
    "custom.validation": {
      "binding": {
        "config": {
          "path": "view.custom.policyInfo"
        },
        "overlayOptOut": true,
        "transforms": [
          {
            "code": "\t\n\trequiredFields \u003d [\u0027partNumber\u0027]\n\tvalidationErrors \u003d []\n\t\n\tfor field in requiredFields:\n\t\tif value.get(field) in [None, \u0027\u0027]:\n\t\t\tvalidationErrors.append(\u0027%s is required.\u0027 % field)\n\t\n\treturn {\u0027isValid\u0027: len(validationErrors) \u003d\u003d 0, \u0027validationErrors\u0027: validationErrors}",
            "type": "script"
          }
        ],
        "type": "property"
      },
      "persistent": true
    },
    "params.values": {
      "paramDirection": "input",
      "persistent": true
    }
  },
  "props": {
    "defaultSize": {
      "height": 460,
      "width": 567
    }
  },
