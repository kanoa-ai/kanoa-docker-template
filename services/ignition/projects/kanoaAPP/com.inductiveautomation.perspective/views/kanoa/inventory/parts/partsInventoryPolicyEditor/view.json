      "customMethods": [
        {
          "name": "isValidURL",
          "params": [
            "url"
          ],
          "script": "\n\tif (url or None) is None: return True\n\t\n\timport re\n\n\turlRegex \u003d (\n\t\tr\u0027^(https?:\\/\\/)?\u0027          # optional http:// or https://\n\t\tr\u0027([a-zA-Z0-9-]+\\.)+\u0027      # domain/subdomain\n\t\tr\u0027[a-zA-Z]{2,}\u0027            # top-level domain\n\t\tr\u0027(\\/[^\\s]*)?$\u0027            # optional path\n\t)\n\n\treturn re.match(urlRegex, str(url).strip()) is not None"
        }
      ],
      "extensionFunctions": null,
      "messageHandlers": [
        {
          "messageType": "colorPicked",
          "pageScope": true,
          "script": "\n\tsystem.perspective.print(\"colorPicked message received with payload \" + str(payload))\t\n\t\n\treturn",
          "sessionScope": false,
          "viewScope": false
        },
        {
          "messageType": "inventoryAssetSelected",
          "pageScope": true,
          "script": "\n\tsystem.perspective.print(\"inventoryAssetSelected message received with payload \" + str(payload))\n\t\n\tif len(payload[\u0027selection\u0027]) \u003d\u003d 0: \n\t\tinventoryAssetId \u003d None\n\t\tassetPath \u003d \u0027\u0027\n\t\tassetName \u003d \u0027\u0027\n\telse:\n\t\tselection \u003d payload[\u0027selection\u0027][0][\u0027value\u0027]\n\t\tinventoryAssetId \u003d selection[\u0027assetId\u0027]\n\t\tassetPath \u003d selection[\u0027assetPath\u0027]\n\t\tassetName \u003d selection[\u0027assetName\u0027]\n\t\n\tself.view.custom.policyInfo.inventoryAssetId \u003d inventoryAssetId\n\tself.view.custom.policyInfo.assetPath \u003d assetPath\n\tself.view.custom.policyInfo.assetName \u003d assetName\n\t\n\treturn\n\t",
          "sessionScope": false,
          "viewScope": false
        }
      ]
    },
    "type": "ia.container.flex"
  }
