    "scripts": {
      "customMethods": [
        {
          "name": "save",
          "params": [],
          "script": "\n\tassetBOMInfo \u003d self.view.custom.assetBOMInfo\n\tuserId \u003d self.view.custom.security.userId\n\t\n\tsuccess, msg \u003d system.kanoa.inventory.addAssetBomItem(assetBOMInfo, userId)\n\tif not success:\n\t\tsystem.perspective.sendMessage(\u0027showFailerToast\u0027, {\u0027message\u0027: msg})\n\t\treturn\n\t\n\tsystem.perspective.sendMessage(\u0027assetBOMUpdated\u0027)\n\tsystem.perspective.closePopup(\u0027\u0027)\n\t\n\treturn"
        }
      ],
      "extensionFunctions": null,
      "messageHandlers": [
        {
          "messageType": "bomPartSelected",
          "pageScope": true,
          "script": "\n\tsystem.perspective.print(\u0027bomPartSelected message received with payload \u0027 + str(payload))\n\t\n\tself.view.custom.assetBOMInfo.partId \u003d None if len(payload[\u0027selection\u0027]) \u003d\u003d 0 else payload[\u0027selection\u0027][0][\u0027value\u0027][\u0027partId\u0027]\n\tself.view.custom.assetBOMInfo.partNumber \u003d \u0027\u0027 if len(payload[\u0027selection\u0027]) \u003d\u003d 0 else payload[\u0027selection\u0027][0][\u0027value\u0027][\u0027partNumber\u0027]\n\t\n\treturn",
          "sessionScope": false,
          "viewScope": false
        }
      ]
    },
    "type": "ia.container.flex"
  }
