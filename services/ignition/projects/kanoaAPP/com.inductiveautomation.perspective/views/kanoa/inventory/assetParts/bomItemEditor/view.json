  "propConfig": {
    "custom.assetBOM": {
      "binding": {
        "config": {
          "path": "view.params.value"
        },
        "overlayOptOut": true,
        "transforms": [
          {
            "code": "\t\n\treturn system.kanoa.utilities.convertDatasetToJSON(system.kanoa.inventory.getAssetBom({\u0027assetId\u0027: value.get(\u0027assetId\u0027) or -1}))",
            "type": "script"
          }
        ],
        "type": "property"
      },
      "persistent": true
    },
    "custom.assetBOMInfo": {
      "binding": {
        "config": {
          "path": "view.params.value"
        },
        "overlayOptOut": true,
        "transforms": [
          {
            "code": "\t\n\tassetBomInfo \u003d system.kanoa.utilities.convertDatasetRowToJSON(system.kanoa.inventory.getAssetBom({\u0027assetBomId\u0027: value.get(\u0027assetBomId\u0027) or -1}), 0)\n\tassetBomInfo[\u0027assetTypeName\u0027] \u003d assetBomInfo[\u0027assetTypeName\u0027] or \u0027part\u0027\n\tassetBomInfo[\u0027notes\u0027] \u003d assetBomInfo[\u0027notes\u0027] or \u0027\u0027\n\tassetBomInfo[\u0027partNumber\u0027] \u003d assetBomInfo[\u0027partNumber\u0027] or \u0027\u0027\n\tassetBomInfo[\u0027assetId\u0027] \u003dvalue[\u0027assetId\u0027]\n\t\n\treturn assetBomInfo",
            "type": "script"
          }
        ],
        "type": "property"
      },
      "persistent": true
    },
    "custom.display": {
      "persistent": true
    },
    "custom.security": {
      "binding": {
        "config": {
          "path": "session.custom.kanoa.security"
        },
        "overlayOptOut": true,
        "type": "property"
      },
      "persistent": true
    },
    "custom.uoms": {
      "binding": {
        "config": {
          "expression": "now(0)"
        },
        "overlayOptOut": true,
        "transforms": [
          {
            "code": "\t\n\treturn system.kanoa.utilities.convertDatasetToJSON(system.kanoa.inventory.getUnitOfMeasures({\u0027enabled\u0027: True}))",
            "type": "script"
          }
        ],
        "type": "expr"
      }
    },
    "custom.validation": {
      "binding": {
        "config": {
          "path": "view.custom.assetBOMInfo"
        },
        "overlayOptOut": true,
        "transforms": [
          {
            "code": "\t\n\trequiredFields \u003d [\u0027quantity\u0027, \u0027uomId\u0027]\n\tif value[\u0027assetTypeName\u0027] \u003d\u003d \u0027part\u0027: requiredFields.append(\u0027partId\u0027)\n\telse: requiredFields.append(\u0027modelId\u0027)\n\tvalidationErrors \u003d []\n\t\n\tfor field in requiredFields:\n\t\tif value.get(field) in [None, \u0027\u0027]:\n\t\t\tvalidationErrors.append(\u0027%s is required.\u0027 % field)\n\t\n\treturn {\u0027isValid\u0027: len(validationErrors) \u003d\u003d 0, \u0027validationErrors\u0027: validationErrors}",
            "type": "script"
          }
        ],
        "type": "property"
      },
      "persistent": true
    },
    "params.value": {
      "paramDirection": "input",
      "persistent": true
    }
  },
