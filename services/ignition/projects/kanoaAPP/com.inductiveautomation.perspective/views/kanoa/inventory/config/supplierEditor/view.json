{
  "custom": {
    "displayOptions": {
      "lblBasis": "90px"
    },
    "supplierInfo": {
      "accountNumber": "",
      "changedBy": null,
      "changedDate": null,
      "contactName": "",
      "createdBy": null,
      "createdDate": null,
      "email": "",
      "enabled": true,
      "lastUpdated": null,
      "lastUpdatedBy": null,
      "phone": "",
      "supplierId": null,
      "supplierName": "",
      "websiteUrl": ""
    },
    "validation": {
      "isValid": false,
      "validationErrors": [
        "supplierName is required."
      ]
    }
  },
  "params": {
    "values": {
      "supplierId": null
    }
  },
  "propConfig": {
    "custom.displayOptions": {
      "persistent": true
    },
    "custom.supplierInfo": {
      "binding": {
        "config": {
          "path": "view.params.values.supplierId"
        },
        "overlayOptOut": true,
        "transforms": [
          {
            "code": "\n\tsupplierInfo \u003d system.kanoa.utilities.convertDatasetRowToJSON(system.kanoa.inventory.getSuppliers({\u0027supplierId\u0027:value or -1}),0)\n\tif supplierInfo[\u0027supplierId\u0027] is None:\n\t\tsupplierInfo[\u0027enabled\u0027] \u003d True\n\t\tsupplierInfo[\u0027supplierName\u0027] \u003d \u0027\u0027\n\n\tsupplierInfo[\u0027websiteUrl\u0027] \u003d supplierInfo[\u0027websiteUrl\u0027] or \u0027\u0027\n\tsupplierInfo[\u0027accountNumber\u0027] \u003d supplierInfo[\u0027accountNumber\u0027] or \u0027\u0027\n\tsupplierInfo[\u0027contactName\u0027] \u003d supplierInfo[\u0027contactName\u0027] or \u0027\u0027\n\tsupplierInfo[\u0027phone\u0027] \u003d supplierInfo[\u0027phone\u0027] or \u0027\u0027\n\tsupplierInfo[\u0027email\u0027] \u003d supplierInfo[\u0027email\u0027] or \u0027\u0027\n\t\t\n\treturn supplierInfo\n",
            "type": "script"
          }
        ],
        "type": "property"
      },
      "persistent": true
    },
    "custom.validation": {
      "binding": {
        "config": {
          "path": "view.custom.supplierInfo"
        },
        "overlayOptOut": true,
        "transforms": [
          {
            "code": "\t\t\n\trequiredFields \u003d [\u0027supplierName\u0027]\n\tvalidationErrors \u003d []\n\t\n\tif not self.getChild(\"root\").isValidEmail(self.custom.supplierInfo.email): validationErrors.append(\u0027Email address is not valid\u0027)\n\tif not self.getChild(\"root\").isValidURL(self.custom.supplierInfo.websiteUrl): validationErrors.append(\u0027Web site URL is not valid\u0027)\n\tif not self.getChild(\"root\").isValidPhoneNumber(self.custom.supplierInfo.phone): validationErrors.append(\u0027Phone Number is not valid\u0027)\n\t\n\tfor field in requiredFields:\n\t\tif value.get(field) in [None, \u0027\u0027]:\n\t\t\tvalidationErrors.append(\u0027%s is required.\u0027 % field)\n\t\n\treturn {\u0027isValid\u0027: len(validationErrors) \u003d\u003d 0, \u0027validationErrors\u0027: validationErrors}",
            "type": "script"
          }
        ],
        "type": "property"
      },
      "persistent": true
    },
    "params.values": {
      "paramDirection": "input",
      "persistent": true
    }
  },
