      "customMethods": [
        {
          "name": "isValidEmail",
          "params": [
            "email"
          ],
          "script": "\n\tif (email or None) is None: return True\n\t\n\timport re\n\temailRegex \u003d r\u0027^[^\\s@]+@[^\\s@]+\\.[^\\s@]+$\u0027\n\treturn re.match(emailRegex, str(email).strip()) is not None"
        },
        {
          "name": "isValidURL",
          "params": [
            "url"
          ],
          "script": "\n\tif (url or None) is None: return True\n\t\n\timport re\n\n\turlRegex \u003d (\n\t\tr\u0027^(https?:\\/\\/)?\u0027          # optional http:// or https://\n\t\tr\u0027([a-zA-Z0-9-]+\\.)+\u0027      # domain/subdomain\n\t\tr\u0027[a-zA-Z]{2,}\u0027            # top-level domain\n\t\tr\u0027(\\/[^\\s]*)?$\u0027            # optional path\n\t)\n\n\treturn re.match(urlRegex, str(url).strip()) is not None"
        },
        {
          "name": "isValidPhoneNumber",
          "params": [
            "phoneNumber"
          ],
          "script": "\n\tif (phoneNumber or None) is None: return True\n\timport re\n\tphoneRegex \u003d r\u0027^\\+?[\\d\\s\\-\\(\\)\\.]{7,20}$\u0027\n\n\treturn re.match(phoneRegex, str(phoneNumber).strip()) is not None"
        }
      ],
      "extensionFunctions": null,
      "messageHandlers": [
        {
          "messageType": "colorPicked",
          "pageScope": true,
          "script": "\n\tsystem.perspective.print(\"colorPicked message received with payload \" + str(payload))\t\n\tself.view.custom.maintenanceTypeInfo.maintenanceTypeColor \u003d payload[\u0027color\u0027]\n\t\n\treturn",
          "sessionScope": false,
          "viewScope": false
        }
      ]
    },
    "type": "ia.container.flex"
  }
