        "children": [
          {
            "events": {
              "component": {
                "onActionPerformed": {
                  "config": {
                    "script": "\n\tsupplierInfo \u003d dict(self.view.custom.supplierInfo)\n\tuserId \u003d system.kanoa.security.getIDPUserId(self.session.props.auth.user)\n\t\n\tif supplierInfo[\u0027supplierId\u0027] is not None: \t#If name has changed, we need to check that it doesn\u0027t already exist\n\t\tcurrentsupplierId \u003d system.kanoa.utilities.getFieldValue(\u0027supplierId\u0027, system.kanoa.inventory.getSuppliers({\u0027supplierName\u0027: supplierInfo[\u0027supplierName\u0027]}))\n\t\tif currentsupplierId is not None and currentsupplierId !\u003d supplierInfo[\u0027supplierId\u0027]:\n\t\t\tsystem.perspective.sendMessage(\u0027showFailerToast\u0027, {\u0027message\u0027: \u0027This record already exists\u0027})\n\t\t\treturn\n\t\t\n\t\tsystem.perspective.sendMessage(\u0027showInfoToast\u0027, {\u0027message\u0027: \u0027Updating record %i \u0027%supplierInfo[\u0027supplierId\u0027]})\t\t\t\n\t\tretVal, msg \u003d system.kanoa.inventory.updateSupplier(supplierInfo, userId)\n\telse:\n\t\tsystem.perspective.sendMessage(\u0027showInfoToast\u0027, {\u0027message\u0027: \u0027Adding records\u0027})\t\n\t\tmaintenanceTypeId, msg \u003d system.kanoa.inventory.addSupplier(supplierInfo, userId)\n\t\t\n\tif msg:\tsystem.perspective.sendMessage(\u0027showFailerToast\u0027, {\u0027message\u0027: \"Couldn\u0027t save this record. %s\"%msg})\n\telse: system.perspective.sendMessage(\u0027showSuccessfulToast\u0027, {\u0027message\u0027: \"Record has been saved\"})\n\n\tsystem.perspective.sendMessage(\"refreshSupplier\", {})\t\n\tsystem.perspective.closePopup(\u0027\u0027)\n\t\n\treturn"
                  },
                  "scope": "G",
                  "type": "script"
                }
              }
            },
            "meta": {
              "domId": "btnSave",
              "name": "btnSave",
              "tooltip": {
                "enabled": true,
                "location": "center-right"
              }
            },
            "position": {
              "shrink": 0
            },
            "propConfig": {
              "meta.tooltip.text": {
                "binding": {
                  "config": {
