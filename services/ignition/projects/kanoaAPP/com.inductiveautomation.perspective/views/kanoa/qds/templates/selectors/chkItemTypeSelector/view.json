{
  "custom": {},
  "params": {
    "chkItemType": {},
    "chkItemTypeId": null,
    "enabled": false
  },
  "propConfig": {
    "params.chkItemType": {
      "binding": {
        "config": {
          "path": "/root/dropdown.props.value"
        },
        "overlayOptOut": true,
        "transforms": [
          {
            "code": "\tfor item in self.getChild(\"root\").getChild(\"dropdown\").props.options:\n\t\tif item[\u0027value\u0027] \u003d\u003d value: return item\n\treturn {}",
            "type": "script"
          }
        ],
        "type": "property"
      },
      "paramDirection": "output",
      "persistent": true
    },
    "params.chkItemTypeId": {
      "paramDirection": "inout",
      "persistent": true
    },
    "params.enabled": {
      "paramDirection": "input",
      "persistent": true
    }
  },
  "props": {
    "defaultSize": {
      "height": 30,
      "width": 187
    }
  },
  "root": {
    "children": [
      {
        "meta": {
          "domId": "dropdown",
          "name": "dropdown"
        },
        "position": {
          "shrink": 0
        },
        "propConfig": {
          "props.enabled": {
            "binding": {
              "config": {
                "path": "view.params.enabled"
              },
              "overlayOptOut": true,
              "type": "property"
            }
          },
          "props.options": {
            "binding": {
              "config": {
                "expression": "now(0)"
              },
              "transforms": [
                {
                  "code": "\t\t\n\treturn [{\"value\": row[\u0027chkItemTypeId\u0027], \"label\": row[\u0027chkItemTypeName\u0027]} for row in system.kanoa.quality.config.getCheckItemTypes({\u0027enabled\u0027: True})]",
                  "type": "script"
                }
              ],
              "type": "expr"
            }
          },
          "props.value": {
            "binding": {
              "config": {
                "bidirectional": true,
                "path": "view.params.chkItemTypeId"
              },
              "overlayOptOut": true,
              "type": "property"
            }
          }
        },
        "props": {
          "dropdownOptionStyle": {
            "classes": "kanoa/font/default"
          },
          "placeholder": {
            "text": "Select Check Type..."
          },
          "showClearIcon": true,
          "style": {
            "classes": "kanoa/border kanoa/font/default",
            "minWidth": "150px"
          }
        },
        "type": "ia.input.dropdown"
      },
      {
        "events": {
          "dom": {
            "onClick": {
              "config": {
                "script": "\n\tsystem.perspective.navigate(url \u003d \u0027https://docs.kanoa.ai/configuration/quality/checkSheets\u0027, newTab\u003dTrue)\n\t\n\treturn\n\t"
              },
              "scope": "G",
              "type": "script"
            }
          }
        },
        "meta": {
          "domId": "icoHelp",
          "name": "icoHelp",
          "tooltip": {
            "enabled": true,
            "location": "bottom-right",
            "style": {
              "textAlign": "left",
              "whiteSpace": "pre"
            }
          }
        },
        "position": {
          "basis": "24px",
          "shrink": 0
        },
        "propConfig": {
          "meta.tooltip.text": {
            "binding": {
              "config": {
                "expression": "\"Check - Value is manually entered or automatically pulled from a defined data source\\n\" +\r\n\"Calculated - Value is calculated from a list of other check values. Calculated checks can be nested\\n\" +\r\n\"Trigger - Value acts as a trigger used to capture other check values that have an associated data source\" "
              },
              "type": "expr"
            }
          }
        },
        "props": {
          "color": "--kcBlue-60",
          "path": "material/help_center"
        },
        "type": "ia.display.icon"
      }
    ],
    "meta": {
      "domId": "root",
      "name": "root"
    },
    "props": {
      "style": {
        "gap": "5px",
        "overflow": "hidden"
      }
    },
    "type": "ia.container.flex"
  }
}