{
  "custom": {},
  "params": {
    "value": {
      "Metric": null,
      "Severity": null,
      "Value": null
    }
  },
  "propConfig": {
    "params.value": {
      "paramDirection": "input",
      "persistent": true
    }
  },
  "props": {
    "defaultSize": {
      "height": 40,
      "width": 119
    }
  },
  "root": {
    "children": [
      {
        "meta": {
          "name": "lblMetric"
        },
        "propConfig": {
          "props.text": {
            "binding": {
              "config": {
                "path": "view.params.value.Metric"
              },
              "overlayOptOut": true,
              "type": "property"
            }
          }
        },
        "props": {
          "style": {
            "backgroundColor": "--kcSurface",
            "color": "--kcOnPrimaryContainer",
            "fontSize": "10px",
            "marginLeft": "3px",
            "paddingLeft": "5px",
            "paddingRight": "5px",
            "position": "absolute",
            "textAlign": "center",
            "top": -8,
            "width": "auto"
          }
        },
        "type": "ia.display.label"
      },
      {
        "meta": {
          "name": "lblValue"
        },
        "propConfig": {
          "props.text": {
            "binding": {
              "config": {
                "path": "view.params.value.Value"
              },
              "overlayOptOut": true,
              "transforms": [
                {
                  "code": "\tif value is None: return \u0027-\u0027\n\tif isinstance(value, float): return \u0027%.3f\u0027 % value\n\treturn str(value)",
                  "type": "script"
                }
              ],
              "type": "property"
            }
          }
        },
        "type": "ia.display.label"
      }
    ],
    "meta": {
      "name": "root"
    },
    "propConfig": {
      "props.style.borderLeft": {
        "binding": {
          "config": {
            "path": "view.params.value.Severity"
          },
          "overlayOptOut": true,
          "transforms": [
            {
              "code": "\tif value \u003d\u003d \u0027error\u0027: return \u00273px solid #D32F2F\u0027\n\tif value \u003d\u003d \u0027warn\u0027: return \u00273px solid #B8860B\u0027\n\treturn \u00273px solid transparent\u0027",
              "type": "script"
            }
          ],
          "type": "property"
        }
      }
    },
    "props": {
      "direction": "column",
      "style": {
        "classes": "kanoa/font/default kanoa/border",
        "margin": "5px",
        "overflow": "visible",
        "paddingTop": "8px",
        "position": "relative",
        "textAlign": "center"
      }
    },
    "type": "ia.container.flex"
  }
}