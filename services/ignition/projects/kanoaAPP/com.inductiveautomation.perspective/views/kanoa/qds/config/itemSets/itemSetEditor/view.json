    "scripts": {
      "customMethods": [
        {
          "name": "saveData",
          "params": [],
          "script": "\t\n#\tsystem.perspective.print(\"saveData called\")\n\t\t\n \titemSetInfo \u003d system.kanoa.utilities.convertDatasetRowToJSON(self.view.custom.table.data, self.view.custom.table.selection.row)\n \tuserId \u003d system.kanoa.security.getIDPUserId(self.session.props.auth.user) \t\n \t\n \tif itemSetInfo[\u0027itemSetId\u0027]:\n\t\tretVal, msg \u003d system.kanoa.quality.config.updateItemSet(itemSetInfo, userId)\n\telse:\n\t\tretVal, msg \u003d system.kanoa.quality.config.addItemSet(itemSetInfo, userId)\n \t\n\tif retVal: system.perspective.sendMessage(\u0027showSuccessfulToast\u0027, {\u0027message\u0027: msg})\n\telse: system.perspective.sendMessage(\u0027showFailerToast\u0027, {\u0027message\u0027: msg})\n\t\n\tself.view.refreshBinding(\"custom.table.data\")\n\tsystem.perspective.sendMessage(\"refreshItemSets\", {})\n\t\n\treturn"
        },
        {
          "name": "deleteItemSet",
          "params": [],
          "script": "\t\n\tuserId \u003d system.kanoa.security.getIDPUserId(self.session.props.auth.user)\n\t\n\terrors \u003d []\n\tfor row in self.view.custom.table.selection.data:\n\t\tretVal, msg \u003d system.kanoa.quality.config.deleteItemSet(row[\u0027itemSetId\u0027], userId)\n\t\tif msg: errors.append(str(msg))\n\t\t\t\n\tself.view.refreshBinding(\"custom.table.data\")\n\t\n\tif len(errors): system.perspective.sendMessage(\u0027showFailerToast\u0027, {\u0027message\u0027: \". \".join(errors)})\n\telse: system.perspective.sendMessage(\u0027showSuccessfulToast\u0027, {\u0027message\u0027: \u0027Item Set(s) deleted\u0027})\n\n\treturn\t\t\t"
        },
        {
          "name": "addItemSet",
          "params": [],
          "script": "\n#\t\"itemSetId\",\"itemSetName\",\"itemSetDescription\",\"enabled\",\"createdBy\",\"createdDate\",\"changedBy\",\"changedDate\"\n\tself.view.custom.table.data \u003d system.dataset.addRow(self.view.custom.table.data, 0, [None, \u0027\u0027,\u0027\u0027, False, None, None, None, None])\n\t\n\treturn"
        }
      ],
      "extensionFunctions": null,
      "messageHandlers": [
        {
          "messageType": "deleteItemSet",
          "pageScope": true,
          "script": "\n\tself.deleteItemSet()\n\t\n\treturn",
          "sessionScope": false,
          "viewScope": false
        }
