    "custom.primarySeries": {
      "binding": {
        "config": {
          "struct": {
            "display": "{view.custom.display}",
            "spc": "{view.custom.spcResult}"
          },
          "waitOnAll": true
        },
        "overlayOptOut": true,
        "transforms": [
          {
            "code": "\n\tspc \u003d value[\u0027spc\u0027]\n\tdisplay \u003d value[\u0027display\u0027]\n\tpoints \u003d spc.get(\u0027points\u0027) or []\n\tn \u003d len(points)\n\tsetLimits \u003d spc.get(\u0027setLimits\u0027) or {}\n\tyMin \u003d display.get(\u0027yMin\u0027)\n\tyMax \u003d display.get(\u0027yMax\u0027)\n\tusedUsl \u003d spc.get(\u0027usl\u0027)\n\tusedLsl \u003d spc.get(\u0027lsl\u0027)\n\n\tbaseOptions \u003d {\n\t\t\u0027chart\u0027: {\u0027animations\u0027: {\u0027enabled\u0027: False}, \u0027toolbar\u0027: {\u0027show\u0027: False}, \u0027redrawOnParentResize\u0027: False, \u0027redrawOnWindowResize\u0027: False},\n\t\t\u0027dataLabels\u0027: {\u0027enabled\u0027: False},\n\t\t\u0027xaxis\u0027: {\u0027title\u0027: {\u0027text\u0027: \u0027Sample\u0027}, \u0027type\u0027: \u0027numeric\u0027},\n\t}\n\n\tyAnnotations \u003d []\n\trangeValues \u003d []\n\tdef zoneLine(val, label, color, dash\u003d0):\n\t\tif val is None: return\n\t\trangeValues.append(val)\n\t\tyAnnotations.append({\n\t\t\t\t\u0027y\u0027: val,\n\t\t\t\t\u0027borderColor\u0027: color,\n\t\t\t\t\u0027strokeDashArray\u0027: dash,\n\t\t\t\t\u0027label\u0027: {\u0027text\u0027: label, \u0027style\u0027: {\u0027color\u0027: \u0027#fff\u0027, \u0027background\u0027: color}}\n\t\t\t})\n\n\tdef closeEnough(a, b):\n\t\treturn a is not None and b is not None and abs(a - b) \u003c 1e-9\n\n\tif not closeEnough(setLimits.get(\u0027lsl\u0027), usedLsl):\n\t\tzoneLine(setLimits.get(\u0027lsl\u0027), \u0027Set LSL\u0027, \u0027#7B1FA2\u0027, dash\u003d2)\n\tzoneLine(setLimits.get(\u0027lcl\u0027), \u0027Set LCL\u0027, \u0027#7B1FA2\u0027, dash\u003d2)\n\tzoneLine(setLimits.get(\u0027tgt\u0027), \u0027Set Target\u0027, \u0027#7B1FA2\u0027, dash\u003d2)\n\tzoneLine(setLimits.get(\u0027ucl\u0027), \u0027Set UCL\u0027, \u0027#7B1FA2\u0027, dash\u003d2)\n\tif not closeEnough(setLimits.get(\u0027usl\u0027), usedUsl):\n\t\tzoneLine(setLimits.get(\u0027usl\u0027), \u0027Set USL\u0027, \u0027#7B1FA2\u0027, dash\u003d2)\n\n\tdef yAxisWithRange():\n\t\tyaxis \u003d {\u0027title\u0027: {\u0027text\u0027: \u0027Value\u0027}, \u0027decimalsInFloat\u0027: 1}\n\t\tallValues \u003d list(rangeValues) + points\n\t\tif allValues:\n\t\t\tloVal, hiVal \u003d min(allValues), max(allValues)\n\t\t\tpad \u003d (hiVal - loVal) * 0.05 if hiVal \u003e loVal else max(abs(hiVal), 1.0) * 0.05\n\t\t\tyaxis[\u0027min\u0027] \u003d yMin if yMin is not None else loVal - pad\n\t\t\tyaxis[\u0027max\u0027] \u003d yMax if yMax is not None else hiVal + pad\n\t\telse:\n\t\t\tif yMin is not None: yaxis[\u0027min\u0027] \u003d yMin\n\t\t\tif yMax is not None: yaxis[\u0027max\u0027] \u003d yMax\n\t\treturn yaxis\n\n\tif n \u003d\u003d 0:\n\t\toptions \u003d dict(baseOptions)\n\t\toptions[\u0027yaxis\u0027] \u003d yAxisWithRange()\n\t\toptions[\u0027annotations\u0027] \u003d {\u0027yaxis\u0027: yAnnotations}\n\t\treturn {\u0027series\u0027: [], \u0027options\u0027: options}\n\n\tchartType \u003d spc.get(\u0027chartType\u0027)\n\tmainData \u003d [{\u0027x\u0027: i, \u0027y\u0027: points[i]} for i in range(n)]\n\n\tseries \u003d []\n\tcolors \u003d []\n\tstrokeWidths \u003d []\n\tdashArrays \u003d []\n\tmarkerSizes \u003d []\n\n\tdef addSeries(name, seriesType, data, color, strokeWidth\u003d2, dashArray\u003d0, markerSize\u003d0):\n\t\tseries.append({\u0027name\u0027: name, \u0027type\u0027: seriesType, \u0027data\u0027: data})\n\t\tcolors.append(color)\n\t\tstrokeWidths.append(strokeWidth)\n\t\tdashArrays.append(dashArray)\n\t\tmarkerSizes.append(markerSize)\n\n\taddSeries(\u0027Value\u0027, \u0027line\u0027, mainData, \u0027#1E88E5\u0027)\n\n\tif chartType \u003d\u003d \u0027pre_control\u0027:\n\t\tzoneLine(usedUsl, \u0027USL\u0027, \u0027#D32F2F\u0027)\n\t\tzoneLine(usedLsl, \u0027LSL\u0027, \u0027#D32F2F\u0027)\n\t\tzoneLine(spc.get(\u0027greenHigh\u0027), \u0027Green zone (high)\u0027, \u0027#388E3C\u0027, dash\u003d4)\n\t\tzoneLine(spc.get(\u0027greenLow\u0027), \u0027Green zone (low)\u0027, \u0027#388E3C\u0027, dash\u003d4)\n\t\tviolationIdx \u003d sorted(set(\n\t\t\t[p[\u0027index1\u0027] for p in spc.get(\u0027pairSignals\u0027, []) if p[\u0027signal\u0027] !\u003d \u0027run\u0027] +\n\t\t\t[p[\u0027index2\u0027] for p in spc.get(\u0027pairSignals\u0027, []) if p[\u0027signal\u0027] !\u003d \u0027run\u0027]\n\t\t))\n\telse:\n\t\tuclPoints \u003d spc.get(\u0027uclPoints\u0027) or []\n\t\tlclPoints \u003d spc.get(\u0027lclPoints\u0027) or []\n\t\tuclData \u003d [{\u0027x\u0027: i, \u0027y\u0027: uclPoints[i]} for i in range(len(uclPoints)) if uclPoints[i] is not None]\n\t\tlclData \u003d [{\u0027x\u0027: i, \u0027y\u0027: lclPoints[i]} for i in range(len(lclPoints)) if lclPoints[i] is not None]\n\t\tif uclData: addSeries(\u0027UCL\u0027, \u0027line\u0027, uclData, \u0027#9E9E9E\u0027, strokeWidth\u003d1, dashArray\u003d4)\n\t\tif lclData: addSeries(\u0027LCL\u0027, \u0027line\u0027, lclData, \u0027#9E9E9E\u0027, strokeWidth\u003d1, dashArray\u003d4)\n\t\trangeValues.extend(d[\u0027y\u0027] for d in uclData)\n\t\trangeValues.extend(d[\u0027y\u0027] for d in lclData)\n\t\tzoneLine(spc.get(\u0027mean\u0027), \u0027Center Line\u0027, \u0027#616161\u0027, dash\u003d4)\n\t\tzoneLine(usedUsl, \u0027USL\u0027, \u0027#D32F2F\u0027)\n\t\tzoneLine(usedLsl, \u0027LSL\u0027, \u0027#D32F2F\u0027)\n\t\tviolationIdx \u003d sorted(set(sum(spc.get(\u0027violations\u0027, {}).values(), [])))\n\n\tif violationIdx:\n\t\taddSeries(\u0027Rule Violation\u0027, \u0027scatter\u0027, [{\u0027x\u0027: i, \u0027y\u0027: points[i]} for i in violationIdx], \u0027#E53935\u0027, markerSize\u003d6)\n\n\toptions \u003d dict(baseOptions)\n\toptions[\u0027stroke\u0027] \u003d {\u0027curve\u0027: \u0027straight\u0027, \u0027width\u0027: strokeWidths, \u0027dashArray\u0027: dashArrays}\n\toptions[\u0027markers\u0027] \u003d {\u0027size\u0027: markerSizes}\n\toptions[\u0027colors\u0027] \u003d colors\n\toptions[\u0027legend\u0027] \u003d {\u0027show\u0027: True, \u0027fontSize\u0027: \u002712px\u0027}\n\toptions[\u0027yaxis\u0027] \u003d yAxisWithRange()\n\toptions[\u0027annotations\u0027] \u003d {\u0027yaxis\u0027: yAnnotations}\n\toptions[\u0027tooltip\u0027] \u003d {\u0027shared\u0027: False}\n\n\treturn {\u0027series\u0027: series, \u0027options\u0027: options}\n",
            "type": "script"
          }
        ],
        "type": "expr-struct"
      },
      "persistent": true
    },
    "custom.rawData": {
      "binding": {
        "config": {
          "path": "view.custom.filters"
        },
        "overlayOptOut": true,
        "transforms": [
          {
            "code": "\n\tchartType \u003d value[\u0027chartType\u0027]\n\tmasterChkShtId \u003d value[\u0027masterChkShtId\u0027]\n\tchkItemPath \u003d value[\u0027chkItemPath\u0027] or None\n\tstartDate \u003d value[\u0027startDate\u0027]\n\tendDate \u003d value[\u0027endDate\u0027]\n\n\tlimitKeys \u003d (\u0027lcl\u0027, \u0027ldl\u0027, \u0027lel\u0027, \u0027lsl\u0027, \u0027tgt\u0027, \u0027ucl\u0027, \u0027udl\u0027, \u0027uel\u0027, \u0027usl\u0027)\n\tempty \u003d {\u0027values\u0027: [], \u0027sampleSizes\u0027: [], \u0027timestamps\u0027: [], \u0027chartType\u0027: chartType, \u0027setLimits\u0027: {}}\n\tif any(x is None for x in (masterChkShtId, chkItemPath, startDate, endDate, chartType)): return empty\n\n\tif chartType in (\u0027p\u0027, \u0027np\u0027, \u0027c\u0027, \u0027u\u0027):\n\t\tdata \u003d system.kanoa.quality.analysis.getAttributeChartData(masterChkShtId, chkItemPath, startDate, endDate)\n\t\trows \u003d [r for r in system.kanoa.utilities.convertDatasetToJSON(data) if r.get(\u0027defectCount\u0027) is not None]\n\t\tvalues \u003d [r[\u0027defectCount\u0027] for r in rows]\n\t\tsampleSizes \u003d [r[\u0027sampleSize\u0027] for r in rows] if chartType in (\u0027p\u0027, \u0027u\u0027) else []\n\t\ttimestamps \u003d [r[\u0027takenDate\u0027] for r in rows]\n\t\tsetLimits \u003d {k: rows[0].get(k) for k in limitKeys} if rows else {}\n\t\treturn {\u0027values\u0027: values, \u0027sampleSizes\u0027: sampleSizes, \u0027timestamps\u0027: timestamps, \u0027chartType\u0027: chartType, \u0027setLimits\u0027: setLimits}\n\n\tdata \u003d system.kanoa.quality.analysis.getContinuousChartData(masterChkShtId, chkItemPath, startDate, endDate)\n\trows \u003d [r for r in system.kanoa.utilities.convertDatasetToJSON(data) if r.get(\u0027chkItemValue\u0027) is not None]\n\tvalues \u003d [r[\u0027chkItemValue\u0027] for r in rows]\n\ttimestamps \u003d [r[\u0027takenDate\u0027] for r in rows]\n\tsetLimits \u003d {k: rows[0].get(k) for k in limitKeys} if rows else {}\n\treturn {\u0027values\u0027: values, \u0027sampleSizes\u0027: [], \u0027timestamps\u0027: timestamps, \u0027chartType\u0027: chartType, \u0027setLimits\u0027: setLimits}",
            "type": "script"
          }
        ],
        "type": "property"
      },
      "onChange": {
        "enabled": null,
        "script": "\n\tsetLimits \u003d self.custom.rawData.get(\u0027setLimits\u0027) or {}\n\tif self.custom.spcSettings.get(\u0027lsl\u0027) is None: self.custom.spcSettings.lsl \u003d setLimits.get(\u0027lsl\u0027)\n\tif self.custom.spcSettings.get(\u0027usl\u0027) is None: self.custom.spcSettings.usl \u003d setLimits.get(\u0027usl\u0027)\n\t\n\treturn"
      },
      "persistent": true
    },
    "custom.secondarySeries": {
      "binding": {
        "config": {
          "struct": {
            "spc": "{view.custom.spcResult}"
          },
          "waitOnAll": true
        },
        "overlayOptOut": true,
        "transforms": [
          {
            "code": "\n\tspc \u003d value[\u0027spc\u0027]\n\tsecondary \u003d spc.get(\u0027secondary\u0027)\n\n\tbaseOptions \u003d {\n\t\t\u0027chart\u0027: {\u0027animations\u0027: {\u0027enabled\u0027: False}, \u0027toolbar\u0027: {\u0027show\u0027: False}, \u0027redrawOnParentResize\u0027: False, \u0027redrawOnWindowResize\u0027: False},\n\t\t\u0027dataLabels\u0027: {\u0027enabled\u0027: False},\n\t\t\u0027xaxis\u0027: {\u0027title\u0027: {\u0027text\u0027: \u0027Subgroup\u0027}, \u0027type\u0027: \u0027numeric\u0027},\n\t}\n\n\tif secondary is None:\n\t\toptions \u003d dict(baseOptions)\n\t\toptions[\u0027yaxis\u0027] \u003d {\u0027title\u0027: {\u0027text\u0027: \u0027Value\u0027}, \u0027decimalsInFloat\u0027: 1}\n\t\treturn {\u0027series\u0027: [], \u0027options\u0027: options}\n\n\tpoints \u003d secondary.get(\u0027points\u0027) or []\n\tn \u003d len(points)\n\tmainData \u003d [{\u0027x\u0027: i, \u0027y\u0027: points[i]} for i in range(n)]\n\n\tyAnnotations \u003d []\n\trangeValues \u003d []\n\tdef zoneLine(val, label, color, dash\u003d0):\n\t\tif val is None: return\n\t\trangeValues.append(val)\n\t\tyAnnotations.append({\n\t\t\t\t\u0027y\u0027: val,\n\t\t\t\t\u0027borderColor\u0027: color,\n\t\t\t\t\u0027strokeDashArray\u0027: dash,\n\t\t\t\t\u0027label\u0027: {\u0027text\u0027: label, \u0027style\u0027: {\u0027color\u0027: \u0027#fff\u0027, \u0027background\u0027: color}}\n\t\t\t})\n\n\tzoneLine(secondary.get(\u0027centerLine\u0027), \u0027Center Line\u0027, \u0027#616161\u0027, dash\u003d4)\n\tzoneLine(secondary.get(\u0027ucl\u0027), \u0027UCL\u0027, \u0027#9E9E9E\u0027)\n\tzoneLine(secondary.get(\u0027lcl\u0027), \u0027LCL\u0027, \u0027#9E9E9E\u0027)\n\n\tallValues \u003d list(rangeValues) + points\n\tyaxis \u003d {\u0027title\u0027: {\u0027text\u0027: secondary.get(\u0027label\u0027) or \u0027Value\u0027}, \u0027decimalsInFloat\u0027: 1}\n\tif allValues:\n\t\tloVal, hiVal \u003d min(allValues), max(allValues)\n\t\tpad \u003d (hiVal - loVal) * 0.05 if hiVal \u003e loVal else max(abs(hiVal), 1.0) * 0.05\n\t\tyaxis[\u0027min\u0027] \u003d loVal - pad\n\t\tyaxis[\u0027max\u0027] \u003d hiVal + pad\n\n\toptions \u003d dict(baseOptions)\n\toptions[\u0027stroke\u0027] \u003d {\u0027curve\u0027: \u0027straight\u0027, \u0027width\u0027: 2}\n\toptions[\u0027markers\u0027] \u003d {\u0027size\u0027: 0}\n\toptions[\u0027colors\u0027] \u003d [\u0027#1E88E5\u0027]\n\toptions[\u0027legend\u0027] \u003d {\u0027show\u0027: True, \u0027fontSize\u0027: \u002712px\u0027}\n\toptions[\u0027yaxis\u0027] \u003d yaxis\n\toptions[\u0027annotations\u0027] \u003d {\u0027yaxis\u0027: yAnnotations}\n\n\treturn {\u0027series\u0027: [{\u0027name\u0027: secondary.get(\u0027label\u0027), \u0027data\u0027: mainData}], \u0027options\u0027: options}",
            "type": "script"
          }
        ],
        "type": "expr-struct"
      },
      "persistent": true
    },
