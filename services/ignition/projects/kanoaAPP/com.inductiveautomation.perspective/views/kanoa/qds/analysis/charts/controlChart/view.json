                "props": {
                  "alignContent": "flex-start",
                  "alignItems": "flex-start",
                  "elementPosition": {
                    "basis": "auto",
                    "grow": 0,
                    "shrink": 0
                  },
                  "elementStyle": {
                    "borderRadius": 6,
                    "width": 90
                  },
                  "path": "kanoa/qds/analysis/charts/statChip",
                  "style": {
                    "classes": "kanoa/border",
                    "gap": 6
                  },
                  "useDefaultViewHeight": false,
                  "useDefaultViewWidth": false,
                  "wrap": "wrap"
                },
                "type": "ia.display.flex-repeater"
              }
            ],
            "meta": {
              "name": "flxControlChart"
            },
            "position": {
              "grow": 1,
              "tabIndex": 1
            },
            "props": {
              "direction": "column",
              "style": {
                "overflow": "hidden"
              }
            },
            "type": "ia.container.flex"
          },
          {
            "meta": {
              "name": "apexSecondary"
            },
            "propConfig": {
              "position.tabIndex": {
                "binding": {
                  "config": {
                    "path": "parent.props.tabs"
                  },
                  "overlayOptOut": true,
                  "transforms": [
                    {
                      "code": "\t\n\tnames \u003d [t[\u0027name\u0027] for t in value]\n\treturn names.index(\u0027secondary\u0027) if \u0027secondary\u0027 in names else -1",
                      "type": "script"
                    }
                  ],
                  "type": "property"
                }
              },
              "props.options": {
                "binding": {
                  "config": {
                    "path": "view.custom.secondarySeries.options"
                  },
                  "overlayOptOut": true,
                  "type": "property"
                }
              },
              "props.series": {
                "binding": {
                  "config": {
                    "path": "view.custom.secondarySeries.series"
                  },
                  "overlayOptOut": true,
                  "type": "property"
                }
              }
            },
            "type": "kyvislabs.display.apexchart"
          }
        ],
        "meta": {
          "name": "tabCharts"
        },
        "position": {
          "grow": 1
        },
        "propConfig": {
          "props.currentTabIndex": {
            "binding": {
              "config": {
                "expression": "1"
              },
              "overlayOptOut": true,
              "type": "expr"
            }
          },
          "props.tabs": {
            "binding": {
              "config": {
                "path": "view.custom.filters.chartType"
              },
              "overlayOptOut": true,
              "transforms": [
                {
                  "code": "\n\t_SECONDARY_LABELS \u003d {\u0027Individuals\u0027: \u0027Moving Range\u0027, \u0027xbar\u0027: \u0027Range Chart\u0027, \u0027xbar_s\u0027: \u0027Std Dev Chart\u0027}\n\thasSecondary \u003d value in _SECONDARY_LABELS\n\n\ttabs \u003d \t[{\u0027name\u0027: \u0027table\u0027, \u0027text\u0027: \u0027Table\u0027}, {\u0027name\u0027: \u0027primary\u0027, \u0027text\u0027: \u0027Control Chart\u0027}\t]\n\n\tif hasSecondary: tabs.append({\u0027name\u0027: \u0027secondary\u0027, \u0027text\u0027: _SECONDARY_LABELS.get(value, \u0027Range / S / MR Chart\u0027)})\n\n\treturn tabs",
                  "type": "script"
                }
              ],
              "type": "property"
            }
          }
        },
        "props": {
          "contentStyle": {
            "borderStyle": "none"
          },
          "menuType": "modern",
          "tabSize": {
            "width": 150
          },
          "tabStyle": {
            "active": {
              "borderStyle": "none",
              "classes": "kanoa/font/default"
            },
            "inactive": {
              "classes": "kanoa/font/default"
            }
          }
        },
        "type": "ia.container.tab"
      }
    ],
    "meta": {
      "name": "root"
    },
    "props": {
      "direction": "column",
      "style": {
        "classes": "kanoa/font/default",
        "gap": "4px",
        "overflow": "hidden",
        "padding": "4px"
      }
    },
    "type": "ia.container.flex"
  }
}