        "overlayOptOut": true,
        "transforms": [
          {
            "code": "\n\tspc \u003d value\n\tpoints \u003d spc.get(\u0027points\u0027) or []\n\tn \u003d len(points)\n\tif n \u003d\u003d 0: return {\u0027rows\u0027: []}\n\n\tminVal \u003d min(points)\n\tmaxVal \u003d max(points)\n\trangeVal \u003d maxVal - minVal\n\tmeanVal \u003d sum(points) / float(n)\n\tstdDev \u003d (sum((p - meanVal) ** 2 for p in points) / float(n - 1)) ** 0.5 if n \u003e 1 else None\n\n\tsetLimits \u003d spc.get(\u0027setLimits\u0027) or {}\n\tcapability \u003d spc.get(\u0027capability\u0027) or {}\n\tusl \u003d spc.get(\u0027usl\u0027)\n\tlsl \u003d spc.get(\u0027lsl\u0027)\n\n\tdef capSeverity(v):\n\t\tif v is None: return None\n\t\tif v \u003c 1.0: return \u0027error\u0027\n\t\tif v \u003c 1.33: return \u0027warn\u0027\n\t\treturn None\n\n\tdef closeEnough(a, b):\n\t\treturn a is not None and b is not None and abs(a - b) \u003c 1e-9\n\n\titems \u003d [\n\t\t(\u0027Min\u0027, minVal, \u0027error\u0027 if (lsl is not None and minVal \u003c lsl) else None),\n\t\t(\u0027Max\u0027, maxVal, \u0027error\u0027 if (usl is not None and maxVal \u003e usl) else None),\n\t\t(\u0027Range\u0027, rangeVal, None), (\u0027Mean\u0027, meanVal, None), (\u0027Std Dev\u0027, stdDev, None),\n\t\t(\u0027LSL (used)\u0027, lsl, None), (\u0027USL (used)\u0027, usl, None),\n\t\t(\u0027Calculated LCL\u0027, spc.get(\u0027lcl\u0027), None), (\u0027Calculated UCL\u0027, spc.get(\u0027ucl\u0027), None),\n\t\t(\u0027Set LDL\u0027, setLimits.get(\u0027ldl\u0027), None), (\u0027Set LEL\u0027, setLimits.get(\u0027lel\u0027), None),\n\t]\n\tif not closeEnough(setLimits.get(\u0027lsl\u0027), lsl):\n\t\titems.append((\u0027Set LSL\u0027, setLimits.get(\u0027lsl\u0027), None))\n\titems.append((\u0027Set LCL\u0027, setLimits.get(\u0027lcl\u0027), None))\n\titems.append((\u0027Set Target\u0027, setLimits.get(\u0027tgt\u0027), None))\n\titems.append((\u0027Set UCL\u0027, setLimits.get(\u0027ucl\u0027), None))\n\titems.append((\u0027Set UDL\u0027, setLimits.get(\u0027udl\u0027), None))\n\titems.append((\u0027Set UEL\u0027, setLimits.get(\u0027uel\u0027), None))\n\tif not closeEnough(setLimits.get(\u0027usl\u0027), usl):\n\t\titems.append((\u0027Set USL\u0027, setLimits.get(\u0027usl\u0027), None))\n\titems.append((\u0027Cp\u0027, capability.get(\u0027cp\u0027), capSeverity(capability.get(\u0027cp\u0027))))\n\titems.append((\u0027Cpk\u0027, capability.get(\u0027cpk\u0027), capSeverity(capability.get(\u0027cpk\u0027))))\n\titems.append((\u0027Cpu\u0027, capability.get(\u0027cpu\u0027), capSeverity(capability.get(\u0027cpu\u0027))))\n\titems.append((\u0027Cpl\u0027, capability.get(\u0027cpl\u0027), capSeverity(capability.get(\u0027cpl\u0027))))\n\titems.append((\u0027Pp\u0027, capability.get(\u0027pp\u0027), capSeverity(capability.get(\u0027pp\u0027))))\n\titems.append((\u0027Ppk\u0027, capability.get(\u0027ppk\u0027), capSeverity(capability.get(\u0027ppk\u0027))))\n\titems.append((\u0027Ppu\u0027, capability.get(\u0027ppu\u0027), capSeverity(capability.get(\u0027ppu\u0027))))\n\titems.append((\u0027Ppl\u0027, capability.get(\u0027ppl\u0027), capSeverity(capability.get(\u0027ppl\u0027))))\n\titems.append((\u0027Sigma (within)\u0027, capability.get(\u0027sigmaWithin\u0027), None))\n\titems.append((\u0027Sigma (overall)\u0027, capability.get(\u0027sigmaOverall\u0027), None))\n\treturn {\u0027rows\u0027: [{\u0027Metric\u0027: k, \u0027Value\u0027: v, \u0027Severity\u0027: s} for k, v, s in items if v is not None]}",
            "type": "script"
          }
        ],
        "type": "property"
      },
      "persistent": true
    },
