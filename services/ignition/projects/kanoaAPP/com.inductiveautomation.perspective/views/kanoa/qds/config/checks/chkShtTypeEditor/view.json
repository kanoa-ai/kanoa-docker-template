    "scripts": {
      "customMethods": [
        {
          "name": "save",
          "params": [],
          "script": "\n\tsystem.perspective.print(\"save() called\")\n\tinfo \u003d self.view.custom.values\n\tchkShtTypeId \u003d info[\u0027chkShtTypeId\u0027]\n\tuserId \u003d system.kanoa.security.getIDPUserId(self.session.props.auth.user)\n\t\t\n\tif chkShtTypeId is None:\n\t\tif system.kanoa.quality.sheet.getSheets({\u0027chkShtTypeName\u0027: info[\u0027chkShtTypeName\u0027], \u0027parentId\u0027: info[\u0027parentId\u0027]}).rowCount \u003e 0:\n\t\t\tsystem.perspective.sendMessage(\u0027showWarningToast\u0027, {\u0027message\u0027: \u0027This Type already exists\u0027})\n\t\t\treturn\n\t\n\t\tchkShtTypeId \u003d system.kanoa.quality.sheet.addSheetType(info, userId)\n\t\tmsg \u003d \u0027Check Sheet Type added\u0027\n\telse:\n\t\tsystem.kanoa.quality.sheet.updateSheetType(info, userId)\n\t\tmsg \u003d \u0027Check Sheet Type updated\u0027\n\t\t\n\tself.view.params.value.chkShtTypeId \u003d chkShtTypeId\n\tself.view.refreshBinding(\"custom.data\")\t #Update the Tree Selector\n\t\n\tsystem.perspective.sendMessage(\"refreshChkShtTypes\", {})\n\tsystem.perspective.sendMessage(\u0027showSuccessfulToast\u0027, {\u0027message\u0027: msg})\n\t\n\treturn"
        },
        {
          "name": "delete",
          "params": [],
          "script": "\n\tsystem.perspective.print(\"delete() called\")\n\n\tuserId \u003d system.kanoa.security.getIDPUserId(self.session.props.auth.user)\n\tretVal, msg \u003d system.kanoa.quality.sheet.deleteSheetType(self.view.params.value.chkShtTypeId, userId)\n\tif retVal \u003d\u003d False:\n\t\tsystem.perspective.sendMessage(\u0027showFailerToast\u0027, {\u0027message\u0027: msg})\n\telse:\n\t\tself.view.params.value.chkShtTypeId \u003d None\n\t\tsystem.perspective.sendMessage(\u0027showSuccessfulToast\u0027, {\u0027message\u0027: msg})\t\t\n\n\tself.view.refreshBinding(\"custom.data\")\t #Update the Tree Selector\n\tsystem.perspective.sendMessage(\"refreshChkShtTypes\", {})\t\n\t\n\treturn"
        }
      ],
      "extensionFunctions": null,
      "messageHandlers": [
        {
          "messageType": "colorPicked",
          "pageScope": true,
          "script": "\n\tsystem.perspective.print(\"colorPicked message received with payload \" + str(payload))\n\n\tself.view.custom.values.itemClassColor \u003d payload[\u0027color\u0027]\n\n\treturn\n",
          "sessionScope": false,
          "viewScope": false
        },
        {
          "messageType": "refreshChkShtTypes",
          "pageScope": true,
          "script": "\n\tsystem.perspective.print(\"refreshChkShtTypes msg rcvd by chkShtTypeEditor with %s\"%payload)\n\tself.view.refreshBinding(\"custom.data\")\n\n\treturn",
          "sessionScope": false,
          "viewScope": false
        },
        {
          "messageType": "updatePopupSelection",
          "pageScope": true,
          "script": "\n\tsystem.perspective.print(\"updatePopupSelection msg rcvd with %s\"%payload)\n\t\n\tif len(payload[\u0027selection\u0027]) \u003d\u003d 0: return\n\t\n\tself.view.params.value.chkShtTypeId \u003d payload[\u0027selection\u0027][0][\u0027value\u0027][\u0027chkShtTypeId\u0027]\n\n\treturn",
          "sessionScope": false,
