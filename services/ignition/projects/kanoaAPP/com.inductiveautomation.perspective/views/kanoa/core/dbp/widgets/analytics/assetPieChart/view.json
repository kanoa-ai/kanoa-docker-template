  "propConfig": {
    "custom.data": {
      "persistent": true
    },
    "custom.data.modeData": {
      "binding": {
        "config": {
          "path": "view.custom.filters"
        },
        "transforms": [
          {
            "code": "\t\n\tif value[\u0027assetId\u0027] and value.has_key(\u0027assetMetric\u0027) and value[\u0027assetMetric\u0027] \u003d\u003d \u0027mode\u0027:\n\t\treturn system.kanoa.utilities.convertDatasetToJSON(system.kanoa.event.getAssetProductionEventsSummary({\u0027assetId\u0027: value[\u0027assetId\u0027], \u0027startDate\u0027: value[\u0027dateRange\u0027][\u0027startDate\u0027], \u0027endDate\u0027: value[\u0027dateRange\u0027][\u0027endDate\u0027]}))\n\telse:\n\t\treturn []",
            "type": "script"
          }
        ],
        "type": "property"
      }
    },
    "custom.data.stateData": {
      "binding": {
        "config": {
          "path": "view.custom.filters"
        },
        "transforms": [
          {
            "code": "\t\n\tif value[\u0027assetId\u0027] and value.has_key(\u0027assetMetric\u0027) and value[\u0027assetMetric\u0027] \u003d\u003d \u0027state\u0027:\n\t\treturn system.kanoa.utilities.convertDatasetToJSON(system.kanoa.event.getAssetStateEventsSummary({\u0027assetId\u0027: value[\u0027assetId\u0027] or -1, \u0027startDate\u0027: value[\u0027dateRange\u0027][\u0027startDate\u0027], \u0027endDate\u0027: value[\u0027dateRange\u0027][\u0027endDate\u0027]}))\n\telse:\n\t\treturn []",
            "type": "script"
          }
        ],
        "type": "property"
      }
    },
    "custom.filters": {
      "binding": {
        "config": {
          "struct": {
            "viewParams": "{view.params.value}"
          },
          "waitOnAll": true
        },
        "overlayOptOut": true,
        "transforms": [
          {
            "code": "\n\tsystem.perspective.print(\"assetPieChart filter change\")\n\tfilters \u003d system.kanoa.dashboard.getWidgetFilters(self.page.props.pageId, value[\u0027viewParams\u0027], self.session.custom.kanoa, self.session.props.device.timezone.id)\n\tif value[\u0027viewParams\u0027].has_key(\u0027assetPath\u0027) and value[\u0027viewParams\u0027][\u0027assetPath\u0027]: filters[\u0027assetPath\u0027] \u003d value[\u0027viewParams\u0027][\u0027assetPath\u0027]\n\tif not filters.has_key(\u0027showAssetPath\u0027): filters[\u0027showAssetPath\u0027] \u003d True\n\tif not filters.has_key(\u0027assetMetric\u0027): filters[\u0027assetMetric\u0027] \u003d \u0027state\u0027\n\treturn filters",
            "type": "script"
          }
        ],
        "type": "expr-struct"
      },
      "persistent": true
    },
    "params.value": {
      "paramDirection": "input",
      "persistent": true
    }
  },
  "props": {
    "defaultSize": {
      "height": 469,
      "width": 693
    }
  },
