  "propConfig": {
    "custom.optionsList": {
      "binding": {
        "config": {
          "path": "view.custom.values.options"
        },
        "overlayOptOut": true,
        "transforms": [
          {
            "code": "\t\n\tif (value or None) is None: return []\n\treturn [{\u0027label\u0027: item.strip(), \u0027value\u0027: item.strip()} for item in value.split(\u0027,\u0027)]",
            "type": "script"
          }
        ],
        "type": "property"
      },
      "persistent": true
    },
    "custom.type": {
      "binding": {
        "config": {
          "path": "view.params.values"
        },
        "overlayOptOut": true,
        "transforms": [
          {
            "code": "\t\n\tif value[\u0027options\u0027] is not None: return \u0027dropdown\u0027\n\tif value[\u0027type\u0027] \u003d\u003d \u0027Boolean\u0027: return \u0027checkbox\u0027\n\telse: return \u0027textField\u0027",
            "type": "script"
          }
        ],
        "type": "property"
      },
      "persistent": true
    },
    "custom.values": {
      "binding": {
        "config": {
          "path": "view.params.values"
        },
        "overlayOptOut": true,
        "type": "property"
      },
      "persistent": true
    },
    "params.values": {
      "paramDirection": "input",
      "persistent": true
    }
  },
