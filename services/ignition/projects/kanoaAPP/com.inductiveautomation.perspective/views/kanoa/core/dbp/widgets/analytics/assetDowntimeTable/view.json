  "propConfig": {
    "custom.data": {
      "persistent": true
    },
    "custom.data.dtData": {
      "binding": {
        "config": {
          "path": "view.custom.filters"
        },
        "overlayOptOut": true,
        "transforms": [
          {
            "code": "\t\n\tif value[\u0027assetId\u0027] is None: return system.dataset.toPyDataSet(system.dataset.toDataSet([],[]))\n\tparamsDict \u003d {\u0027assetId\u0027: value[\u0027assetId\u0027], \u0027startDate\u0027: value[\u0027dateRange\u0027][\u0027startDate\u0027], \u0027endDate\u0027: value[\u0027dateRange\u0027][\u0027endDate\u0027], \u0027showDowntimeOnly\u0027: True, \u0027showChanged\u0027: None, \u0027durationSecs\u0027: 0}\n\t\n\timport time\t#There may be a bunch of these widgets on a dashboard. We\u0027ll attempt here to stagger the calls to prevent concurrent SQL queries\n\ttime.sleep(0.1)\t\n\t\n\tif value[\u0027downtimeBy\u0027] \u003d\u003d \u0027Events\u0027: data \u003d system.kanoa.event.getAssetStateEvents(paramsDict)\n\telse: data \u003d system.kanoa.event.getAssetStateEventsSummary(paramsDict)\t\t\n\t\t\n\treturn data\t",
            "type": "script"
          }
        ],
        "type": "property"
      }
    },
    "custom.filters": {
      "binding": {
        "config": {
          "struct": {
            "viewParams": "{view.params.value}"
          },
          "waitOnAll": true
        },
        "overlayOptOut": true,
        "transforms": [
          {
            "code": "\n\tsystem.perspective.print(\"assetDowntimeTable filter binding change\")\n\n\tfilters \u003d system.kanoa.dashboard.getWidgetFilters(self.page.props.pageId, value[\u0027viewParams\u0027], self.session.custom.kanoa, self.session.props.device.timezone.id)\n\tif not filters.has_key(\u0027downtimeBy\u0027): filters[\u0027downtimeBy\u0027] \u003d \u0027Reason\u0027\n\tif not filters.has_key(\u0027showAssetPath\u0027): filters[\u0027showAssetPath\u0027] \u003d False\n\tif not filters.has_key(\u0027colorBy\u0027): filters[\u0027colorBy\u0027] \u003d \u0027State\u0027\n\treturn filters",
            "type": "script"
          }
        ],
        "type": "expr-struct"
      },
      "persistent": true
    },
    "custom.table": {
      "persistent": true
    },
    "custom.table.data": {
      "binding": {
        "config": {
          "path": "view.custom.data.dtData"
        },
        "transforms": [
          {
            "code": "\t\n\tif value is None or len(value)\u003c\u003d 0: return None\n\tdowntimeBy \u003d self.custom.filters.downtimeBy\n\tdata \u003d []\n\tdtData \u003d system.kanoa.utilities.convertDatasetToJSON(value)\n\trowStyle \u003d {\"borderBottomRightRadius\": \u00275px\u0027, \"borderTopLeftRadius\": \u00275px\u0027, \"borderTopRightRadius\": \u00275px\u0027, \"borderBottomLeftRadius\": \u00275px\u0027, \"margin\": \u00274px\u0027}\n\tfor row in dtData:\n\t\tentry \u003d dict(row)\n\t\tentry[\u0027durationMins\u0027] \u003d entry[\u0027durationSecs\u0027] / 60.0 if downtimeBy \u003d\u003d \"Summary\" else entry[\u0027stateDurationSecs\u0027] / 60.0\n\t\trowStyle[\u0027backgroundColor\u0027] \u003d row[\"stateColor\"] or row[\"stateTypeColor\"]\n\t\trowStyle[\u0027color\u0027] \u003d system.kanoa.utilities.getContrastingColor(row[\"stateColor\"] or row[\"stateTypeColor\"])\n\t\tentry[\u0027stateName\u0027] \u003d {\u0027value\u0027: row[\u0027stateName\u0027], \u0027style\u0027: dict(rowStyle)}\n\t\trowStyle[\u0027backgroundColor\u0027] \u003d row[\"stateTypeColor\"]\n\t\trowStyle[\u0027color\u0027] \u003d system.kanoa.utilities.getContrastingColor(row[\"stateTypeColor\"])\n\t\tentry[\u0027stateTypeName\u0027] \u003d {\u0027value\u0027: row[\u0027stateTypeName\u0027], \u0027style\u0027: dict(rowStyle)}\n\t\trowStyle[\u0027backgroundColor\u0027] \u003d None\n\t\trowStyle[\u0027color\u0027] \u003d None\n\t\tentry[\u0027stateCategoryName\u0027] \u003d {\u0027value\u0027: row[\u0027stateCategoryName\u0027], \u0027style\u0027: dict(rowStyle)}\t\t\n\t\tdata.append(entry)\n\t\t\n\treturn sorted(data, key\u003dlambda x: x[\u0027durationMins\u0027], reverse \u003d True) if downtimeBy \u003d\u003d \"Summary\" else sorted(data, key\u003dlambda x: x[\u0027startDate\u0027], reverse \u003d False)",
            "type": "script"
          }
        ],
        "type": "property"
      }
    },
    "params.value": {
      "paramDirection": "input",
      "persistent": true
    }
  },
