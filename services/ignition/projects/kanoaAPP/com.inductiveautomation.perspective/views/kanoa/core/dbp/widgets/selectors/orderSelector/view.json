    "meta": {
      "domId": "root",
      "name": "root"
    },
    "propConfig": {
      "custom.assetItems": {
        "binding": {
          "config": {
            "path": "view.custom.filter.assetPath"
          },
          "overlayOptOut": true,
          "transforms": [
            {
              "code": "\t\n\titemSourceId \u003d system.kanoa.utilities.getFieldValue(\u0027itemSourceId\u0027, system.kanoa.item.getItemSource({\u0027itemSourceName\u0027: \u0027Output\u0027}))\n\titems \u003d system.dataset.toPyDataSet(system.kanoa.item.getAssetItems({\u0027itemSourceId\u0027: itemSourceId, \u0027assetPath\u0027: value or \u0027-1\u0027, \u0027enabled\u0027:True}))\n\treturn [item[\u0027itemId\u0027] for item in items]",
              "type": "script"
            }
          ],
          "type": "property"
        }
      },
      "custom.data": {
        "binding": {
          "config": {
            "struct": {
              "activeWorkOrders": "{this.custom.woData}",
              "assetItems": "{this.custom.assetItems}"
            },
            "waitOnAll": true
          },
          "overlayOptOut": true,
          "transforms": [
            {
              "code": "\n\tif len(value[\u0027assetItems\u0027]) \u003d\u003d 0: return []\n\n\tworkOrders \u003d system.dataset.toPyDataSet(value[\u0027activeWorkOrders\u0027])\n\tdeleteRows \u003d [i for i, workOrder in enumerate(workOrders) if workOrder[\u0027itemId\u0027] not in value[\u0027assetItems\u0027]]\n\tdata \u003d system.dataset.deleteRows(value[\u0027activeWorkOrders\u0027], deleteRows)\n\tdata \u003d system.dataset.sort(data, \u0027workOrderName\u0027)\n\treturn system.kanoa.utilities.convertDatasetToJSON(data)",
              "type": "script"
            }
          ],
          "type": "expr-struct"
        }
      },
      "custom.woData": {
        "binding": {
          "config": {
            "fallbackDelay": 2.5,
            "mode": "indirect",
            "references": {
              "1": "{this.custom.mesTagProvider}"
            },
            "tagPath": "{1}kanoa/timers/getActiveOrdersTimer/data"
          },
          "type": "tag"
        }
      }
    },
    "props": {
      "direction": "column",
      "style": {
        "backgroundColor": "--kcSurface",
        "gap": "5px",
        "overflow": "hidden",
        "padding": "5px"
      }
    },
    "scripts": {
      "customMethods": [],
      "extensionFunctions": null,
      "messageHandlers": [
        {
          "messageType": "assetSelectorUpdate",
          "pageScope": true,
          "script": "\n\tself.view.refreshBinding(\"custom.filters\")\n\n\treturn",
          "sessionScope": false,
          "viewScope": false
        },
        {
          "messageType": "dateSelectorUpdate",
          "pageScope": true,
          "script": "\n\tself.view.refreshBinding(\"custom.filters\")\n\n\treturn",
          "sessionScope": false,
          "viewScope": false
        }
      ]
    },
    "type": "ia.container.flex"
  }
}