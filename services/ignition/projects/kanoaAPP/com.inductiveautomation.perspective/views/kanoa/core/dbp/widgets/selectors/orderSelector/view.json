  "root": {
    "children": [
      {
        "children": [
          {
            "events": {
              "component": {
                "onActionPerformed": {
                  "config": {
                    "script": "\n\tassetId \u003d self.view.custom.asset.assetInfo.assetId\n\tmodeSourceId \u003d system.kanoa.asset.getModeSourceId(\u0027Operator\u0027)\n\tmodeCode \u003d system.kanoa.utilities.getFieldValue(\u0027modeCode\u0027, system.kanoa.asset.getAssetModes({\u0027assetId\u0027: assetId, \u0027modeName\u0027: \u0027Idle\u0027}))\t\n\t\n\tassetOperationInfo \u003d {\u0027assetId\u0027: assetId, \u0027modeCode\u0027: modeCode, \u0027workOrderId\u0027: None, \u0027itemId\u0027: None, \u0027standardRate\u0027: None, \u0027modeSourceId\u0027: modeSourceId, \u0027tStamp\u0027: system.date.now(), \u0027includeChildren\u0027: True}\n\tmodeEventId, msg \u003d system.kanoa.event.assetOperationChange(assetOperationInfo, self.view.custom.security.userId)\t\n\tif msg or modeEventId is None: system.perspective.sendMessage(\u0027showWarningToast\u0027, {\u0027message\u0027: \u0027Could not change asset mode. %s\u0027%msg})\n\telse: system.perspective.sendMessage(\u0027showSuccessfulToast\u0027, {\u0027message\u0027: \u0027Asset has been set to Idle\u0027})\n\t\n\treturn"
                  },
                  "scope": "G",
                  "type": "script"
                }
              }
            },
            "meta": {
              "domId": "btnEnd",
              "name": "btnEnd",
              "tooltip": {
                "delay": 0,
                "location": "top",
                "tail": false,
                "text": "End"
              }
            },
            "position": {
              "basis": "125px",
              "shrink": 0
            },
            "propConfig": {
              "position.display": {
                "binding": {
                  "config": {
                    "struct": {
                      "action": "{view.custom.userAction}",
                      "itemSelection": "{view.custom.itemSelection}",
                      "tagOEEInfo": "{view.custom.asset.tagInfo}"
                    },
                    "waitOnAll": true
                  },
                  "overlayOptOut": true,
                  "transforms": [
                    {
                      "code": "\t\n\tif not value[\u0027action\u0027][\u0027canUpdate\u0027]: return False\n\tif value[\u0027itemSelection\u0027][\u0027workOrderId\u0027] is None: return False\n\t\n\ttagInfo \u003d value[\u0027tagOEEInfo\u0027]\n\tif tagInfo[\u0027modeName\u0027] \u003d\u003d \u0027Production\u0027 and tagInfo[\u0027workOrderName\u0027]: return True\n\treturn False\n",
                      "type": "script"
                    }
                  ],
                  "type": "expr-struct"
                }
              },
              "props.enabled": {
                "binding": {
                  "config": {
                    "struct": {
                      "action": "{view.custom.userAction}",
                      "tagOEEInfo": "{view.custom.asset.tagInfo}"
                    },
                    "waitOnAll": true
                  },
                  "overlayOptOut": true,
                  "transforms": [
                    {
                      "code": "\t\n\tif not value[\u0027action\u0027][\u0027canUpdate\u0027]: return False\n\tif value[\u0027tagOEEInfo\u0027] is not None and value[\u0027tagOEEInfo\u0027][\u0027modeName\u0027] not in (\u0027Idle\u0027): return True\n\t\n\treturn False",
                      "type": "script"
                    }
                  ],
                  "type": "expr-struct"
                }
              }
            },
            "props": {
              "image": {
                "icon": {
                  "color": "--kcOnError",
                  "path": "material/stop"
                }
              },
              "style": {
                "classes": "kanoa/button/filled",
                "height": "48px"
              },
              "text": "End",
              "textStyle": {
                "classes": "kanoa/font/labelLarge"
              }
            },
            "type": "ia.input.button"
          },
          {
            "events": {
              "component": {
                "onActionPerformed": {
                  "config": {
                    "script": "\t\n\t#The user selection is stored in session custom properties\n\n\titemSelection \u003d self.view.custom.itemSelection\n\tassetId \u003d self.view.custom.asset.assetInfo.assetId\n\tif itemSelection[\u0027workOrderId\u0027] is None: return\n\tworkOrderId \u003d itemSelection[\u0027workOrderId\u0027]\n\titemId \u003d itemSelection[\u0027itemId\u0027]\n\tmodeName \u003d \u0027Production\u0027\n\tsystem.tag.writeBlocking([system.kanoa.asset.getAssetTagPath({\u0027assetId\u0027:assetId}) + \u0027/Line/OEE/scheduleBlockId\u0027], [None]) #Clear the scheduleBlockId. We should put this in the assetOperationChange, but for now, we\u0027ll call it from here\n\n\tmodeSourceId \u003d system.kanoa.asset.getModeSourceId(\u0027Operator\u0027)\n\tmodeCode \u003d system.kanoa.utilities.getFieldValue(\u0027modeCode\u0027, system.kanoa.asset.getAssetModes({\u0027assetId\u0027: assetId, \u0027modeName\u0027: modeName}))\t\n\t\n\tstandardRate \u003d None\n\tassetOperationInfo \u003d {\u0027assetId\u0027: assetId, \u0027modeCode\u0027: modeCode, \u0027workOrderId\u0027: workOrderId, \u0027itemId\u0027: itemId, \u0027standardRate\u0027: standardRate, \u0027modeSourceId\u0027: modeSourceId, \u0027tStamp\u0027: system.date.now(), \u0027includeChildren\u0027: True}\n\tmodeEventId, msg \u003d system.kanoa.event.assetOperationChange(assetOperationInfo, self.view.custom.security.userId)\n\tif msg: system.perspective.sendMessage(\u0027showWarningToast\u0027, {\u0027message\u0027: \u0027Could not change asset mode. %s\u0027%msg})\n\telse: system.perspective.sendMessage(\u0027showSuccessfulToast\u0027, {\u0027message\u0027: \u0027Asset has been set to %s\u0027%modeName})\n\t\t\n\tsystem.tag.writeBlocking([system.kanoa.asset.getAssetTagPath({\u0027assetId\u0027:assetId}) + \u0027/Line/OEE/refresh\u0027], [True]) #Let\u0027s refresh thie assetTagInfo\n\t\t\n\treturn"
                  },
                  "scope": "G",
                  "type": "script"
                }
              }
            },
            "meta": {
              "domId": "btnStart",
              "name": "btnStart",
              "tooltip": {
                "delay": 0,
                "location": "top",
                "tail": false,
                "text": "Start"
              }
            },
            "position": {
              "basis": "125px",
              "shrink": 0
            },
            "propConfig": {
              "position.display": {
                "binding": {
                  "config": {
                    "struct": {
                      "action": "{view.custom.userAction}",
                      "itemSelection": "{view.custom.itemSelection}",
                      "tagOEEInfo": "{view.custom.asset.tagInfo}"
                    },
                    "waitOnAll": true
                  },
                  "overlayOptOut": true,
                  "transforms": [
                    {
                      "code": "\t\n\tif not value[\u0027action\u0027][\u0027canUpdate\u0027]: return False\n\tif value[\u0027itemSelection\u0027][\u0027workOrderId\u0027] is None: return False\n\t\n\tworkOrderName \u003d system.kanoa.utilities.getFieldValue(\u0027workOrderName\u0027, system.kanoa.order.getProductionOrders({\u0027workOrderId\u0027: value[\u0027itemSelection\u0027][\u0027workOrderId\u0027]}))\n\n\tif workOrderName is None: return False\n\tif value[\u0027tagOEEInfo\u0027][\u0027workOrderName\u0027] !\u003d workOrderName: return True\n\t\n\treturn False\n",
                      "type": "script"
                    }
                  ],
                  "type": "expr-struct"
                }
              }
            },
            "props": {
              "image": {
