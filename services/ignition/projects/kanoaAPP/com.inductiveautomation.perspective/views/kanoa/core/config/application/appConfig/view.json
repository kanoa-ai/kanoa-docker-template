  "propConfig": {
    "custom.configInfo": {
      "binding": {
        "config": {
          "expression": "now(0)"
        },
        "overlayOptOut": true,
        "transforms": [
          {
            "code": "\n\tdef buildConfigDict(ds):\n\t\tconfigDict \u003d {}\n\t\n\t\tfor row in ds:\n\t\t\ttypeName \u003d row[\u0027configTypeName\u0027]\n\t\t\tname \u003d row[\u0027configName\u0027]\n\t\t\tif typeName not in configDict:\tconfigDict[typeName] \u003d {}\n\t\t\tconfigDict[typeName][name] \u003d {\u0027configValue\u0027: parseValue(name, row[\u0027configValue\u0027]), \u0027configId\u0027: row[\u0027configId\u0027], \u0027configTypeId\u0027: row[\u0027configTypeId\u0027], \u0027description\u0027: row[\u0027description\u0027]} \n\t\n\t\treturn configDict\n\t\t\n\tdef parseValue(name, val):\n\t\tif val is None: return None\n\t\n\t\tstrVal \u003d str(val).strip()\n\t\n\t\t# explicit boolean fields\n\t\tif name in booleanKeys: return strVal in (\u00271\u0027, \u0027true\u0027, \u0027True\u0027)\n\t\n\t\t# everything else → int if possible\n\t\ttry:\n\t\t\treturn int(strVal)\n\t\texcept:\n\t\t\treturn val\n\t\t\n\tbooleanKeys \u003d set([\n\t\t\u0027endScheduledProductionRuns\u0027,\n\t\t\u0027editPastScheduleEvents\u0027,\n\t\t\u0027enableKanoaCMMS\u0027,\n\t\t\u0027enableKanoaQDS\u0027,\n\t\t\u0027enableKanoaTrace\u0027,\n\t\t\u0027enableKanoaInv\u0027,\n\t\t\u0027colorScheduleEventsByOrderStatus\u0027,\n\t\t\u0027selectWOQty\u0027\n\t])\t\t\n\n\treturn buildConfigDict(system.kanoa.config.getConfig({}))",
            "type": "script"
          }
        ],
        "type": "expr"
      },
      "onChange": {
        "enabled": null,
        "script": "\n\tdef toDict(value):\n\t\tif value is None: return {}\n\t\tif hasattr(value, \u0027value\u0027): value \u003d value.value\n\t\tif value is None: return {}\n\t\treturn dict(value)\n\t\n\tdef getChangedValues(currentValue, previousValue):\n\t\tcurrentValues \u003d toDict(currentValue)\n\t\tpreviousValues \u003d toDict(previousValue)\n\t\n\t\tchanged \u003d []\n\t\n\t\tfor configTypeName in currentValues:\n\t\t\tconfigs \u003d toDict(currentValues[configTypeName])\n\t\t\tprevConfigs \u003d toDict(previousValues.get(configTypeName))\n\t\n\t\t\tfor configName in configs:\n\t\t\t\tcurrentConfig \u003d toDict(configs[configName])\n\t\t\t\tpreviousConfig \u003d toDict(prevConfigs.get(configName))\n\t\n\t\t\t\tcurrentVal \u003d currentConfig.get(\u0027configValue\u0027)\n\t\t\t\tpreviousVal \u003d previousConfig.get(\u0027configValue\u0027)\n\t\n\t\t\t\tif currentVal !\u003d previousVal:\n\t\t\t\t\tnewValue \u003d currentVal.value\n\t\t\t\t\tif isinstance(newValue , bool): newValue \u003d str(int(newValue))\n\t\t\t\t\tchanged.append({\n\t\t\t\t\t\t\t\t\t\t\u0027configValue\u0027: newValue,\n\t\t\t\t\t\t\t\t\t\t\u0027configId\u0027: currentConfig.get(\u0027configId\u0027).value,\n\t\t\t\t\t\t\t\t\t\t\u0027configTypeId\u0027: currentConfig.get(\u0027configTypeId\u0027).value,\n\t\t\t\t\t\t\t\t\t\t\u0027description\u0027: currentConfig.get(\u0027description\u0027).value\n\t\t\t\t\t\t\t\t\t})\n\t\treturn changed\n\t\n\tif origin not in (\u0027BindingWriteback\u0027, \u0027Script\u0027): return\n\t\t\n\tuserId \u003d self.custom.security.userId\n\tchanges \u003d getChangedValues(currentValue, previousValue)\n\t\n\tfor configInfo in changes:\n\t\tconfigId, msg \u003d system.kanoa.config.saveConfig(configInfo, userId)\n\t\n\tself.refreshBinding(\"custom.configInfo\")\n\tsystem.perspective.sendMessage(\u0027configUpdate\u0027, {})\n\t\n\treturn"
      },
      "persistent": true
    },
    "custom.displayOptions": {
      "persistent": true
    },
    "custom.security": {
      "binding": {
        "config": {
          "path": "session.custom.kanoa.security"
        },
        "overlayOptOut": true,
        "type": "property"
      },
      "persistent": true
    },
    "custom.userAction": {
      "binding": {
        "config": {
          "struct": {
            "security": "{view.custom.security}"
          },
          "waitOnAll": true
        },
        "overlayOptOut": true,
        "transforms": [
          {
            "code": "\t\n\tsecurity \u003d value[\u0027security\u0027]\n\tcanCreate \u003d False\n\tcanEdit \u003d False\n\tif security[\u0027userCRUD\u0027] is not None and security[\u0027userId\u0027] is not None:\n\t\tif security[\u0027userCRUD\u0027][\u0027isGatewayAdmin\u0027]: \n\t\t\tcanCreate \u003d True\n\t\t\tcanEdit \u003d True\t\t\t\n\t\n\treturn {\"canCreate\": canCreate, \"canDelete\": canEdit, \"canRead\": True, \"canUpdate\": canEdit}",
            "type": "script"
          }
        ],
        "type": "expr-struct"
      },
      "persistent": true
    }
  },
