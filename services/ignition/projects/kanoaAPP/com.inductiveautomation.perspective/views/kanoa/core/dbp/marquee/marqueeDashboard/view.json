    "scripts": {
      "customMethods": [
        {
          "name": "getData",
          "params": [],
          "script": "\t\n\tself.view.custom.grid.widgetItems \u003d []\n\t\n\tselectId \u003d self.view.params.selectId\n\tdashboard \u003d self.setDashboard(selectId)\n\t"
        },
        {
          "name": "getDashboard",
          "params": [
            "id\u003d\u0027undefined\u0027"
          ],
          "script": "\t\n\tid \u003d gp.global.scripts.makeInt(id if id !\u003d \u0027undefined\u0027 else self.view.params.selectId)\n\t\n\tres \u003d gp.dashboards.db.getDashboard(id)\n\t\n\tif res[\u0027passed\u0027]:\n\t\tdashboard \u003d res[\u0027data\u0027]\n\telse:\n\t\tdashboard \u003d gp.dashboards.db.getEmptyDashboard()\n\t\n\tdashboard[\u0027name\u0027] \u003d dashboard[\u0027name\u0027] or \u0027\u0027\n\tdashboard[\u0027description\u0027] \u003d dashboard[\u0027description\u0027] or \u0027\u0027\n\tdashboard[\u0027icon\u0027] \u003d dashboard[\u0027icon\u0027] or \u0027\u0027\n\tdashboard[\u0027iconColor\u0027] \u003d dashboard[\u0027iconColor\u0027] or \u0027\u0027\n\tdashboard[\u0027username\u0027] \u003d dashboard[\u0027username\u0027] or \u0027\u0027\n\tdashboard[\u0027roles\u0027] \u003d dashboard[\u0027roles\u0027] or []\n\tdashboard[\u0027divisionCode\u0027] \u003d dashboard[\u0027divisionCode\u0027] or \u0027\u0027\n\tdashboard[\u0027siteCode\u0027] \u003d dashboard[\u0027siteCode\u0027] or \u0027\u0027\n\t\n\treturn dashboard \n\t"
        },
        {
          "name": "setDashboard",
          "params": [
            "id\u003d\u0027undefined\u0027"
          ],
          "script": "\t\n\t### SET DASHBOARDS ###\n\tdashboard \u003d self.getDashboard(id)\n\t\n\tself.view.custom.dashboard.selected \u003d dashboard\n\t\n\t### SET FOLDER ###\n\tfolder \u003d self.setFolder(dashboard)\n\t\n\t### SET ACTIVE BREAKPOINT ###\n\tbreakpoints \u003d dashboard[\u0027breakpoints\u0027]\n\tactiveBreakpoint \u003d self.setActiveBreakpoint(breakpoints, \u0027\u0027)\n\t\n\treturn dashboard\n\t"
        },
        {
          "name": "getActiveBreakpoint",
          "params": [
            "breakpoints\u003d\u0027undefined\u0027",
            "request\u003d\u0027undefined\u0027"
          ],
          "script": "\t\n\tbreakpointDict \u003d breakpoints if breakpoints !\u003d \u0027undefined\u0027 else self.view.custom.dashboard.selected.breakpoints\n\tbreakpointList \u003d [bp for bp in (breakpointDict and breakpointDict.values() or []) if not bp[\u0027state\u0027] in [\u0027deleted\u0027, \u0027dropped\u0027]]\n\tbreakpoints \u003d sorted(breakpointList, key\u003dlambda bp: bp[\u0027upperEnd\u0027])\n\t\n\trequested \u003d (request or None) if request !\u003d \u0027undefined\u0027 else self.view.custom.breakpoint.request\n\t\n\tmaxBreakpoint \u003d breakpoints[-1] if breakpoints else None\n\t\n\tif requested is None:\n\t\t# If there is no breakpoint requested, then get the breakpoint with the larges size.\n\t\treturn maxBreakpoint\n\telif str(requested).isdigit():\n\t\tsize \u003d int(requested)\n\t\tfor breakpoint in breakpoints:\n\t\t\tif size \u003c\u003d breakpoint[\u0027upperEnd\u0027]:\n\t\t\t\treturn breakpoint\n\t\t\t\t\n\t\treturn maxBreakpoint\n\telse:\n\t\trequest \u003d str(requested).lower()\n\t\t\n\t\tfor breakpoint in breakpoints:\n\t\t\tname \u003d str(breakpoint[\u0027name\u0027]).lower()\n\t\t\t\n\t\t\tif name \u003d\u003d request:\n\t\t\t\treturn breakpoint\n\t\t\n\t\treturn maxBreakpoint\n\t"
        },
        {
          "name": "setActiveBreakpoint",
          "params": [
            "breakpoints\u003d\u0027undefined\u0027",
            "request\u003d\u0027undefined\u0027"
          ],
          "script": "\t\n\tif request !\u003d \u0027undefined\u0027:\n\t\tself.view.custom.breakpoint.request \u003d request\n\t\n\tactiveBreakpoint \u003d self.getActiveBreakpoint(breakpoints, request)\n\tself.view.custom.breakpoint.active \u003d activeBreakpoint\n\t\n\t### SET WIDGET ITEMS ###\n\twidgetItems \u003d self.setWidgetItems(breakpoint\u003dactiveBreakpoint)\n\t\n\treturn activeBreakpoint\n\t"
        },
        {
          "name": "getWidgetItems",
          "params": [
            "dashboard\u003d\u0027undefined\u0027",
            "breakpoint\u003d\u0027undefined\u0027"
          ],
          "script": "\t\n\tdashboard \u003d dashboard if dashboard !\u003d \u0027undefined\u0027 else self.view.custom.dashboard.selected\n\twidgets \u003d dashboard[\u0027widgets\u0027]\n\tpositions \u003d dashboard[\u0027positions\u0027]\n\tbreakpoint \u003d breakpoint if breakpoint !\u003d \u0027undefined\u0027 else self.getActiveBreakpoint(dashboard[\u0027breakpoints\u0027])\n\tcallerId \u003d self.view.custom.uuid\n\twraperPath \u003d \u0027kanoa/core/dbp/marquee/embedded/wrapper\u0027\n\t\n\twidgetItems \u003d gp.dashboardWidgets.db.buildWidgetItems(widgets, positions, breakpoint, callerId, wraperPath\u003dwraperPath)\n\t\n\treturn widgetItems\n\t"
        },
        {
          "name": "setWidgetItems",
          "params": [
            "dashboard\u003d\u0027undefined\u0027",
            "breakpoint\u003d\u0027undefined\u0027"
          ],
          "script": "\t\n\twidgetItems \u003d self.getWidgetItems(dashboard, breakpoint)\n\t\n\tself.view.custom.grid.storedItems \u003d widgetItems\n\tself.view.custom.grid.widgetItems \u003d widgetItems\n\t\n\treturn widgetItems\n\t"
        },
        {
          "name": "getFolder",
          "params": [
            "dashboard\u003d\u0027undefined\u0027"
          ],
          "script": "\t\n\tdashboard \u003d dashboard if dashboard !\u003d \u0027undefined\u0027 else self.getDashboard()\n\t\n\tfolderId \u003d dashboard[\u0027folderId\u0027]\n\tres \u003d gp.folders.db.getFolder(folderId)\n\t\n\tfolder \u003d res[\u0027data\u0027]\n\t\n\treturn folder\n\t"
        },
        {
          "name": "setFolder",
          "params": [
            "dashboard\u003d\u0027undefined\u0027"
          ],
          "script": "\t\n\tdashboard \u003d dashboard if dashboard !\u003d \u0027undefined\u0027 else self.getDashboard()\n\tfolder \u003d self.getFolder(dashboard)\n\t\n\tself.view.custom.dashboard.folder \u003d folder\n\t"
        }
      ],
      "extensionFunctions": null,
      "messageHandlers": [
        {
          "messageType": "dashboardViewer.selectId",
          "pageScope": true,
          "script": "\t\n\tif payload[\u0027callerId\u0027] !\u003d self.view.custom.uuid: return\n\t\n\tselectId \u003d gp.global.scripts.makeInt(payload[\u0027selectId\u0027])\n\t\n\tif self.view.params.selectId !\u003d selectId:\n\t\tself.view.params.selectId \u003d selectId\n\telse:\n\t\tself.view.custom.getData \u003d True\n\t",
          "sessionScope": false,
          "viewScope": false
        }
      ]
    },
    "type": "ia.container.flex"
  }
}