  "propConfig": {
    "custom.breakpoint": {
      "persistent": true
    },
    "custom.breakpoint.size": {
      "binding": {
        "config": {
          "struct": {
            "defaultWidth": "{view.props.defaultSize.width}",
            "primaryWidth": "{page.props.dimensions.primaryView.width}"
          },
          "waitOnAll": true
        },
        "overlayOptOut": true,
        "transforms": [
          {
            "code": "\twidth \u003d value.primaryWidth or value.defaultWidth\n\t\n\treturn width",
            "type": "script"
          }
        ],
        "type": "expr-struct"
      }
    },
    "custom.dashboard": {
      "persistent": true
    },
    "custom.getData": {
      "onChange": {
        "enabled": null,
        "script": "\t\n\tif not currentValue.value: return\n\tself.custom.getData \u003d False\n\t\n\tself.getChild(\"root\").getData()\n\t"
      },
      "persistent": true
    },
    "custom.grid": {
      "persistent": true
    },
    "custom.grid.dimentions.height": {
      "binding": {
        "config": {
          "path": "view.custom.breakpoint.active"
        },
        "overlayOptOut": true,
        "transforms": [
          {
            "code": "\tsize \u003d value.rowHeight\n\tgap \u003d value.rowGap\n\tcount \u003d value.rowCount\n\t\n\treturn \u0027100%\u0027 if not size else ((size * count) + (gap * (count + 1)))",
            "type": "script"
          }
        ],
        "type": "property"
      }
    },
    "custom.grid.dimentions.width": {
      "binding": {
        "config": {
          "path": "view.custom.breakpoint.active"
        },
        "overlayOptOut": true,
        "transforms": [
          {
            "code": "\tsize \u003d value.columnWidth\n\tgap \u003d value.columnGap\n\tcount \u003d value.columnCount\n\t\n\treturn \u0027100%\u0027 if not size else ((size * count) + (gap * (count + 1)))",
            "type": "script"
          }
        ],
        "type": "property"
      }
    },
    "custom.onMobile": {
      "binding": {
        "config": {
          "path": "session.custom.pages"
        },
        "overlayOptOut": true,
        "transforms": [
          {
            "code": "\t\n\tpages \u003d value\n\tpageId \u003d self.page.props.pageId\n\tpath \u003d \u0027onMobile\u0027\n\t\n\tonMobile \u003d kanoa.page.getValue(pages, pageId, path)\n\t\n\treturn onMobile",
            "type": "script"
          }
        ],
        "type": "property"
      },
      "persistent": true
    },
    "custom.uuid": {
      "binding": {
        "config": {
          "expression": "0"
        },
        "transforms": [
          {
            "code": "\treturn str(system.kanoa.utilities.getUUID())",
            "type": "script"
          }
        ],
        "type": "expr"
      },
      "persistent": true
    },
    "params.dashboardName": {
      "binding": {
        "config": {
          "path": "view.custom.dashboard.selected.name"
        },
        "overlayOptOut": true,
        "type": "property"
      },
      "paramDirection": "output",
      "persistent": true
    },
    "params.selectId": {
      "onChange": {
        "enabled": null,
        "script": "\t\n\tpValue \u003d gp.global.scripts.makeInt(previousValue and previousValue.value)\n\tcValue \u003d gp.global.scripts.makeInt(currentValue and currentValue.value)\n\tif pValue \u003d\u003d cValue: return\n\t\n\tself.getChild(\"root\").getData()\n\t"
      },
      "paramDirection": "input",
      "persistent": true
    }
  },
