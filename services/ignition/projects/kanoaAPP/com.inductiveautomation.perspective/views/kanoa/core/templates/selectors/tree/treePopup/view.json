  "root": {
    "children": [
      {
        "meta": {
          "domId": "evTreeSelector",
          "name": "evTreeSelector"
        },
        "position": {
          "basis": "320px",
          "grow": 1,
          "shrink": 0
        },
        "propConfig": {
          "props.path": {
            "binding": {
              "config": {
                "expression": "if(isNull({this.props.params.values.data}), \u0027\u0027, \u0027kanoa/core/templates/selectors/tree/treeSelector\u0027)"
              },
              "type": "expr"
            }
          },
          "props.params.values": {
            "binding": {
              "config": {
                "path": "view.params.values"
              },
              "transforms": [
                {
                  "code": "\t\n\tvalue \u003d dict(value)\n\tif value[\u0027msgHandler\u0027] is None: value[\u0027msgHandler\u0027] \u003d \u0027updatePopupSelection\u0027\n\tif not value.has_key(\u0027selectorId\u0027): value[\u0027selectorId\u0027] \u003d None\n\t\n\treturn value",
                  "type": "script"
                }
              ],
              "type": "property"
            }
          }
        },
        "props": {
          "params": {
            "refresh": false
          },
          "path": "kanoa/core/templates/selectors/tree/treeSelector",
          "style": {
            "classes": "kanoa/border"
          }
        },
        "type": "ia.display.view"
      },
      {
        "children": [
          {
            "events": {
              "component": {
                "onActionPerformed": {
                  "config": {
                    "script": "\t\n\tsystem.perspective.print(\"treePopup is sending msg updateSelection() to msgHandler: %s\"%(self.view.params.values.msgHandler))\n\tsystem.perspective.sendMessage(\u0027updateSelection\u0027, payload\u003d{\u0027selectorId\u0027: self.view.params.values.selectorId,\u0027activity\u0027: \u0027nodeSelected\u0027,\u0027selection\u0027: self.view.custom.selection, \u0027msgHandler\u0027: self.view.params.values.msgHandler})\n\tsystem.perspective.closePopup(\u0027\u0027)\n\t\n\treturn"
                  },
                  "scope": "G",
                  "type": "script"
                }
              }
            },
            "meta": {
              "domId": "btnSelect",
              "name": "btnSelect",
              "tooltip": {
                "delay": 0,
                "location": "top",
                "tail": false
              }
            },
            "position": {
              "shrink": 0
            },
            "propConfig": {
              "position.display": {
                "binding": {
                  "config": {
                    "path": "view.custom.selection"
                  },
                  "overlayOptOut": true,
                  "transforms": [
                    {
                      "code": "\treturn len(value) \u003e 0",
                      "type": "script"
                    }
                  ],
                  "type": "property"
                }
              },
              "props.enabled": {
                "binding": {
                  "config": {
                    "path": "view.custom.selection"
                  },
                  "overlayOptOut": true,
                  "transforms": [
                    {
                      "code": "\t#options.selectableKey: only a node whose value has that key set can be picked (eg itemId, so an item class can\u0027t)\n\tvalues \u003d self.view.params.values\n\toptions \u003d values[\u0027options\u0027] if values.has_key(\u0027options\u0027) and values[\u0027options\u0027] else {}\n\tkey \u003d options[\u0027selectableKey\u0027] if options.has_key(\u0027selectableKey\u0027) else None\n\tif not key: return True\n\treturn len(value) \u003e 0 and all(s[\u0027value\u0027].has_key(key) and s[\u0027value\u0027][key] is not None for s in value)",
                      "type": "script"
                    }
                  ],
                  "type": "property"
                }
              },
              "meta.tooltip.enabled": {
                "binding": {
                  "config": {
                    "path": "view.custom.selection"
                  },
                  "overlayOptOut": true,
                  "transforms": [
                    {
                      "code": "\t#options.selectableKey: only a node whose value has that key set can be picked (eg itemId, so an item class can\u0027t)\n\tvalues \u003d self.view.params.values\n\toptions \u003d values[\u0027options\u0027] if values.has_key(\u0027options\u0027) and values[\u0027options\u0027] else {}\n\tkey \u003d options[\u0027selectableKey\u0027] if options.has_key(\u0027selectableKey\u0027) else None\n\tif not key: return False\n\treturn not all(s[\u0027value\u0027].has_key(key) and s[\u0027value\u0027][key] is not None for s in value)",
                      "type": "script"
                    }
                  ],
                  "type": "property"
                }
              },
              "meta.tooltip.text": {
                "binding": {
                  "config": {
                    "path": "view.params.values"
                  },
                  "overlayOptOut": true,
                  "transforms": [
                    {
                      "code": "\toptions \u003d value[\u0027options\u0027] if value.has_key(\u0027options\u0027) and value[\u0027options\u0027] else {}\n\treturn options[\u0027selectableMessage\u0027] if options.has_key(\u0027selectableMessage\u0027) and options[\u0027selectableMessage\u0027] else \u0027This can\\\u0027t be selected.\u0027",
                      "type": "script"
                    }
                  ],
                  "type": "property"
                }
              }
            },
            "props": {
