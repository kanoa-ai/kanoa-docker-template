  "events": {
    "system": {
      "onShutdown": {
        "config": {
          "script": "\ttry: system.perspective.sendMessage(\u0027pauseKeyCapture\u0027, {\u0027paused\u0027: False}, scope\u003d\u0027page\u0027)\n\texcept: pass\t#the session may already have ended (e.g. the browser tab closed)"
        },
        "scope": "G",
        "type": "script"
      },
      "onStartup": {
        "config": {
          "script": "\t#A check sheet editor on this page captures every key for its check entry; pause it while this popup is open,\n\t#so searching or moving through the tree doesn\u0027t type into the selected check\n\tsystem.perspective.sendMessage(\u0027pauseKeyCapture\u0027, {\u0027paused\u0027: True}, scope\u003d\u0027page\u0027)"
        },
        "scope": "G",
        "type": "script"
      }
    }
