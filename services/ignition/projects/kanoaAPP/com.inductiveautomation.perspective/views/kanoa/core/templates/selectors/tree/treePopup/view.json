    "scripts": {
      "customMethods": [],
      "extensionFunctions": null,
      "messageHandlers": [
        {
          "messageType": "updatePopupSelection",
          "pageScope": true,
          "script": "\t\n#\tsystem.perspective.print(\"treePopup recvd updatePopupSelection msg with %s\"%payload)\n\tself.view.custom.selection \u003d payload[\"selection\"]\n\t\n\treturn",
          "sessionScope": false,
          "viewScope": false
        },
        {
          "messageType": "doubleClick",
          "pageScope": true,
          "script": "\n#\tsystem.perspective.print(\"treePopup recvd doubleClick msg with %s\"%payload)\n\t#options.selectableKey: only a node whose value has that key set can be picked (eg itemId, so an item class can\u0027t)\n\tvalues \u003d self.view.params.values\n\toptions \u003d values[\u0027options\u0027] if values.has_key(\u0027options\u0027) and values[\u0027options\u0027] else {}\n\tkey \u003d options[\u0027selectableKey\u0027] if options.has_key(\u0027selectableKey\u0027) else None\n\tif key and not all(s[\u0027value\u0027].has_key(key) and s[\u0027value\u0027][key] is not None for s in payload[\u0027selection\u0027]): return\n\t\n\t#With the selectorId and activity the Select button sends: the selector ignores an update without them (868mw881c)\n\tsystem.perspective.sendMessage(\u0027updateSelection\u0027, {\u0027selectorId\u0027: values.selectorId, \u0027activity\u0027: \u0027nodeSelected\u0027, \u0027selection\u0027: payload[\u0027selection\u0027], \u0027msgHandler\u0027: values.msgHandler})\n\tsystem.perspective.closePopup(\u0027\u0027)\n\n\treturn",
          "sessionScope": false,
          "viewScope": false
        }
      ]
    },
    "type": "ia.container.flex"
  }
}