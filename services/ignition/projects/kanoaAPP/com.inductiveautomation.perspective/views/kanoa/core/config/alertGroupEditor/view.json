    "scripts": {
      "customMethods": [
        {
          "name": "deleteAlertGroup",
          "params": [],
          "script": "\n\tif self.view.custom.userAction.canDelete:\n\t\tgrpInfo \u003d self.view.custom.table.selection.data[0]\n\t\tretVal, msg \u003d system.kanoa.quality.config.deleteAlertGroup(grpInfo[\u0027alertGroupId\u0027], self.view.custom.security.userId)\n\t\t\n\t\tif msg or retVal \u003d\u003d 0: system.perspective.sendMessage(\u0027showWarningToast\u0027, {\u0027message\u0027: \u0027Could not delete this alert group. %s\u0027%msg})\n\t\telse: system.perspective.sendMessage(\u0027showSuccessfulToast\u0027, {\u0027message\u0027: \u0027Alert Group has been deleted\u0027})\t\t\t\n\t\t\n\t\tself.view.custom.table.selection.col \u003d None\n\t\tself.view.custom.table.selection.row \u003d None\n\t\t\n\t\tself.view.refreshBinding(\"custom.alertGroups\")\n\t\t\n\treturn"
        }
      ],
      "extensionFunctions": null,
      "messageHandlers": [
        {
          "messageType": "deleteAlertGroup",
          "pageScope": true,
          "script": "\n\tself.deleteAlertGroup()\n\t\n\treturn",
          "sessionScope": false,
          "viewScope": false
        }
      ]
    },
    "type": "ia.container.flex"
  }
