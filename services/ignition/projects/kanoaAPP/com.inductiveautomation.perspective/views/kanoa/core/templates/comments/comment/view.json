                  "overlayOptOut": true,
                  "transforms": [
                    {
                      "code": "\n\t# Define the base payload for the different comment actions.\n#\tbasePayload \u003d {\u0027commentId\u0027: system.kanoa.utilities.createCheckSum(value[\u0027metaData\u0027])}\n\tbasePayload \u003d {\u0027metaData\u0027: self.view.custom.values.metaData, \u0027commentId\u0027: value[\u0027commentId\u0027]}\n\t\n\t# Define payload for the pin action.\n\tpayloadPin \u003d dict(basePayload)\n\tpayloadPin[\u0027pinned\u0027] \u003d False if value[\u0027pinned\u0027] in [None, False] else True\n\n\t\n\t# Define pin and save text.\n\tpinText \u003d \u0027Pin\u0027 if value[\u0027pinned\u0027] in [None, False] else \u0027Un-pin\u0027\n\t\n\t# Define the available options.\n\tavailableOptions \u003d []\n\tavailableOptions.append({\u0027text\u0027: pinText, \u0027path\u0027: \u0027material/push_pin\u0027, \u0027type\u0027: \u0027message\u0027, \u0027messageType\u0027: \u0027updatePinComment\u0027, \u0027payload\u0027: payloadPin, \u0027scope\u0027: \u0027view\u0027})\n\t\n\t# If the user who created this comment is currently logged-in, then add the edit and delete options.\n\t# Define the payload for the edit action.\n\tpayloadEdit \u003d dict(basePayload)\n\tpayloadEdit[\u0027from\u0027] \u003d value[\u0027userId\u0027]\n\t\n\t# Define the payload for the delete action.\n\tpayloadDelete \u003d dict(basePayload)\t\n\n\t# Define the edit and delete options.\n\teditOptions \u003d [{\u0027text\u0027: \u0027Edit\u0027, \u0027path\u0027: \u0027material/edit\u0027, \u0027type\u0027: \u0027message\u0027, \u0027messageType\u0027: \u0027toggleEdit\u0027, \u0027payload\u0027: payloadEdit, \u0027scope\u0027: \u0027view\u0027}, \n\t\t\t\t\t{\u0027text\u0027: \u0027Delete\u0027, \u0027path\u0027: \u0027material/delete\u0027, \u0027type\u0027: \u0027message\u0027, \u0027messageType\u0027: \u0027deleteComment\u0027, \u0027payload\u0027: payloadDelete, \u0027scope\u0027: \u0027view\u0027,\n\t\t\t\t\t\u0027color\u0027: \u0027var(--error)\u0027}]\n\t\n\t# Add the edit options to the available options list.\n\tavailableOptions.extend(editOptions)\n\t\n\t# Create the items list.\n\titems \u003d []\n\t\n\tfor option in availableOptions:\n\t\t# Get the color for the menu item.\n\t\tcolor \u003d option.get(\u0027color\u0027, \u0027\u0027)\n\t\t\n\t\t# Get the item type.\n\t\titemType \u003d option.get(\u0027type\u0027, \u0027\u0027)\n\t\t\n\t\t# Set the item style based on whether or not the option is a separator.\n\t\titemStyle \u003d {\n\t\t\t\u0027classes\u0027: \u0027kanoa/font/default\u0027,\n\t\t\t\u0027backgroundColor\u0027: \u0027var(--kcSurface)\u0027,\n\t\t\t\u0027color\u0027: color, \n\t\t\t\u0027minHeight\u0027: \u002740px\u0027, \n\t\t\t\u0027width\u0027: \u0027100px\u0027, \n\t\t\t\u0027cursor\u0027: \u0027pointer\u0027,\n\t\t} if itemType !\u003d \u0027separator\u0027 else {\u0027classes\u0027: \u0027\u0027}\n\t\n\t\t# Create the context menu item.\n\t\titem \u003d {\u0027text\u0027: option.get(\u0027text\u0027, \u0027\u0027), \u0027icon\u0027: {\u0027color\u0027: color, \u0027path\u0027: option.get(\u0027path\u0027, \u0027\u0027), \u0027style\u0027: {\u0027classes\u0027: \u0027\u0027, \u0027pointer-events\u0027: \u0027none\u0027, \u0027height\u0027: \u002720px\u0027}}, \n\t\t\t\t\u0027link\u0027: {\u0027target\u0027: \u0027self\u0027, \u0027url\u0027: \u0027\u0027}, \u0027message\u0027: {\u0027payload\u0027: option.get(\u0027payload\u0027, \u0027\u0027), \u0027scope\u0027: \u0027page\u0027, \u0027type\u0027: option.get(\u0027messageType\u0027, \u0027\u0027)},\n\t\t\t\t\u0027style\u0027: itemStyle, \u0027children\u0027: [], \u0027method\u0027: {\u0027name\u0027: \u0027\u0027, \u0027params\u0027: {}}, \u0027type\u0027: itemType}\n\t\t\t\t\n\t\t# Add the item to the list.\n\t\titems.append(item)\n\t\n\treturn items",
                      "type": "script"
