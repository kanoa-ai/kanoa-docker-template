{
  "custom": {},
  "params": {
    "value": {
      "color": "--kcBlue-40",
      "enabled": true,
      "fontColor": "--kcGray-0",
      "iconColor": "--kcGray-0",
      "iconPath": "material/save",
      "label": "Save",
      "msgHandler": "",
      "styleClass": "kanoa/button/outlined"
    }
  },
  "propConfig": {
    "params.value": {
      "paramDirection": "input",
      "persistent": true
    }
  },
  "props": {
    "defaultSize": {
      "height": 40,
      "width": 118
    }
  },
  "root": {
    "children": [
      {
        "events": {
          "component": {
            "onActionPerformed": {
              "config": {
                "script": "\t\n\tsystem.perspective.sendMessage(self.view.params.value.msgHandler, {})\n\t\n\treturn"
              },
              "scope": "G",
              "type": "script"
            }
          }
        },
        "meta": {
          "domId": "button",
          "name": "button",
          "tooltip": {
            "enabled": true,
            "location": "bottom-right"
          }
        },
        "propConfig": {
          "meta.tooltip.text": {
            "binding": {
              "config": {
                "path": "view.params.value.label"
              },
              "overlayOptOut": true,
              "type": "property"
            }
          },
          "props.enabled": {
            "binding": {
              "config": {
                "path": "view.params.value.enabled"
              },
              "overlayOptOut": true,
              "type": "property"
            }
          },
          "props.image.icon.color": {
            "binding": {
              "config": {
                "path": "view.params.value.iconColor"
              },
              "overlayOptOut": true,
              "type": "property"
            }
          },
          "props.image.icon.path": {
            "binding": {
              "config": {
                "path": "view.params.value.iconPath"
              },
              "type": "property"
            }
          },
          "props.style.backgroundColor": {
            "binding": {
              "config": {
                "path": "view.params.value.color"
              },
              "overlayOptOut": true,
              "type": "property"
            }
          },
          "props.style.classes": {
            "binding": {
              "config": {
                "path": "view.params.value.styleClass"
              },
              "overlayOptOut": true,
              "type": "property"
            }
          },
          "props.textStyle.color": {
            "binding": {
              "config": {
                "path": "view.params.value.fontColor"
              },
              "type": "property"
            }
          }
        },
        "props": {
          "image": {
            "icon": {}
          },
          "style": {},
          "text": "Save",
          "textStyle": {
            "classes": "kanoa/font/labelMedium"
          }
        },
        "type": "ia.input.button"
      }
    ],
    "meta": {
      "domId": "root",
      "name": "root"
    },
    "props": {
      "direction": "column"
    },
    "type": "ia.container.flex"
  }
}