{
  "custom": {
    "data": []
  },
  "params": {
    "value": {
      "data": []
    }
  },
  "propConfig": {
    "custom.data": {
      "binding": {
        "config": {
          "path": "view.params.value"
        },
        "overlayOptOut": true,
        "transforms": [
          {
            "code": "\treturn value.get(\u0027data\u0027)",
            "type": "script"
          }
        ],
        "type": "property"
      },
      "persistent": true
    },
    "params.value": {
      "paramDirection": "input",
      "persistent": true
    }
  },
  "props": {
    "defaultSize": {
      "height": 310,
      "width": 1025
    }
  },
  "root": {
    "children": [
      {
        "meta": {
          "name": "tblData"
        },
        "position": {
          "grow": 1
        },
        "propConfig": {
          "props.data": {
            "binding": {
              "config": {
                "path": "view.custom.data"
              },
              "overlayOptOut": true,
              "type": "property"
            }
          }
        },
        "props": {
          "pager": {
            "activeOption": 200,
            "bottom": false
          },
          "rows": {
            "striped": {
              "enabled": false
            }
          },
          "style": {
            "borderStyle": "none"
          }
        },
        "type": "ia.display.table"
      },
      {
        "children": [
          {
            "events": {
              "component": {
                "onActionPerformed": {
                  "config": {
                    "script": "\n\tsystem.perspective.closePopup(\u0027\u0027)\n\t\n\treturn"
                  },
                  "scope": "G",
                  "type": "script"
                }
              }
            },
            "meta": {
              "domId": "btnClose",
              "name": "btnClose",
              "tooltip": {
                "enabled": true,
                "location": "center-right",
                "text": "Close this popup"
              }
            },
            "position": {
              "basis": "100px"
            },
            "props": {
              "image": {
                "icon": {
                  "path": "material/exit_to_app"
                }
              },
              "style": {
                "classes": "kanoa/button/filled"
              },
              "text": "Close"
            },
            "type": "ia.input.button"
          }
        ],
        "meta": {
          "domId": "flxAction",
          "name": "flxAction"
        },
        "position": {
          "shrink": 0
        },
        "props": {
          "justify": "center",
          "style": {
            "padding": "5px",
            "textAlign": "center"
          }
        },
        "type": "ia.container.flex"
      }
    ],
    "meta": {
      "domId": "root",
      "name": "root"
    },
    "props": {
      "direction": "column",
      "style": {
        "backgroundColor": "--kcSurface",
        "gap": 5,
        "padding": 5
      }
    },
    "scripts": {
      "customMethods": [],
      "extensionFunctions": null,
      "messageHandlers": [
        {
          "messageType": "receiveNewLogs",
          "pageScope": true,
          "script": "\t\t\n#\tpayload \u003d {\n#\t\t\u0027msgs\u0027: (list[string]),\n#\t}\n\tnewLogs \u003d payload[\u0027msgs\u0027]\n\tself.view.custom.logs \u003d newLogs\n\t\n\treturn",
          "sessionScope": false,
          "viewScope": false
        }
      ]
    },
    "type": "ia.container.flex"
  }
}