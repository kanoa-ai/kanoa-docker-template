                    {
                      "code": "\treturn (value * 30) + ((value - 1) * 3)",
                      "type": "script"
                    }
                  ],
                  "type": "property"
                }
              }
            },
            "props": {
              "alignContent": "flex-start",
              "alignItems": "center",
              "elementPosition": {
                "basis": "auto",
                "grow": 0,
                "shrink": 0
              },
              "path": "kanoa/core/templates/selectors/icons/icon",
              "style": {
