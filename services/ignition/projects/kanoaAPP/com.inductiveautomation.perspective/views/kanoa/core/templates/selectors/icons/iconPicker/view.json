  "propConfig": {
    "custom.displayIcon": {
      "binding": {
        "config": {
          "struct": {
            "default": "{view.params.default}",
            "selected": "{view.params.icon}"
          },
          "waitOnAll": true
        },
        "overlayOptOut": true,
        "transforms": [
          {
            "code": "\n\tdefault \u003d value.default\n\tselected \u003d value.selected\n\t\n\tdisplay \u003d {\n\t\t\u0027path\u0027: selected.path or \u0027\u0027,\n\t\t\u0027color\u0027: selected.color or default.color,\n\t\t\u0027defaultIconPath\u0027: default.path\n\t}\n\treturn display",
            "type": "script"
          }
        ],
        "type": "expr-struct"
      },
      "persistent": true
    },
    "custom.displayedIcons": {
      "binding": {
        "config": {
          "struct": {
            "filteredIcons": "{this.custom.filteredIcons}",
            "iconsPerPage": "{this.custom.options.iconsPerPage}",
            "page": "{this.custom.options.page}"
          },
          "waitOnAll": true
        },
        "overlayOptOut": true,
        "transforms": [
          {
            "code": "\tfilteredIcons \u003d value.filteredIcons\n\ticonsPerPage \u003d value.iconsPerPage\n\tpage \u003d value.page\n\t\n\tstart \u003d (page - 1) * iconsPerPage\n\tend \u003d start + iconsPerPage\n\t\n\treturn filteredIcons[start:end]",
            "type": "script"
          }
        ],
        "type": "expr-struct"
      },
      "persistent": true
    },
    "custom.filteredIcons": {
      "binding": {
        "config": {
          "struct": {
            "filter": "{this.custom.options.filter}",
            "icons": "{this.custom.icons}"
          },
          "waitOnAll": true
        },
        "transforms": [
          {
            "code": "\ticons \u003d value.icons\n\tfilter \u003d value.filter.lower() if (value.filter or None) is not None else None\n\t\n\tif filter is None: \n\t\treturn icons\n\telse:\n\t\treturn [i for i in icons if filter in i.path.split(\u0027/\u0027)[-1].lower()]",
            "type": "script"
          }
        ],
        "type": "expr-struct"
      },
      "persistent": true
    },
    "custom.icons": {
      "binding": {
        "config": {
          "path": "this.custom.options.group"
        },
        "transforms": [
          {
            "code": "\n\tfrom xml.dom import minidom\n\t\n\tgroup \u003d value or \u0027material\u0027\n\t\n\ticons \u003d []\n\taddress \u003d self.session.props.gateway.address\n\t\n\ttry:\n\t\tres \u003d system.net.httpGet(\"%s/data/perspective/icons/%s.svg\" % (address, group), bypassCertValidation\u003dTrue)\n\texcept:\n\t\tres \u003d system.net.httpGet(\"http://localhost:8088/data/perspective/icons/%s.svg\" % (group))\n\n\tdoc \u003d minidom.parseString(res)\n\tfor g in doc.getElementsByTagName(\"g\"):\n\t      if g.hasAttribute(\"id\"):\n\t              icons.append({\"path\": \u0027%s/%s\u0027 % (group, g.getAttribute(\"id\"))})\n\t\n\treturn icons",
            "type": "script"
          }
        ],
        "type": "property"
      },
      "persistent": true
    },
    "custom.options": {
      "persistent": true
    },
    "custom.options.group": {
      "binding": {
        "config": {
          "path": "view.params.icon.path"
        },
        "overlayOptOut": true,
        "transforms": [
          {
            "code": "\tgroup \u003d value.split(\u0027/\u0027)[0] if (value or None) is not None else \u0027kanoa\u0027\n\t\n\tfor option in self.custom.options.groupOptions:\n\t\tif group \u003d\u003d option.value:\n\t\t\treturn group\n\t\n\treturn \u0027material\u0027",
            "type": "script"
          }
        ],
        "type": "property"
      }
    },
    "custom.options.groupOptions": {
      "binding": {
        "config": {
          "expression": "\"\""
        },
        "transforms": [
          {
            "code": "\treturn [\n\t  {\n\t    \"label\": \"Material\",\n\t    \"value\": \"material\"\n\t  },\n\t  {\n\t    \"label\": \"Kanoa\",\n\t    \"value\": \"kanoa\"\n\t  },\n\t  {\n\t    \"label\": \"Letter Block\",\n\t    \"value\": \"letter_block\"\n\t  },\n  \t  {\n\t    \"label\": \"Lucide\",\n\t    \"value\": \"lucide\"\n\t  }\n\t]",
            "type": "script"
          }
        ],
        "type": "expr"
      }
    },
    "custom.options.iconsPerPage": {
      "binding": {
        "config": {
          "expression": "{this.custom.options.iconsPerRow} * {this.custom.options.rowsOfIcons}"
        },
        "type": "expr"
      }
    },
    "custom.options.page": {
      "binding": {
        "config": {
          "path": "this.custom.options.pageCount"
        },
        "overlayOptOut": true,
        "transforms": [
          {
            "code": "\tpage \u003d self.custom.options.page or 1\n\t\n\treturn min(value, page)",
            "type": "script"
          }
        ],
        "type": "property"
      }
    },
    "custom.options.pageCount": {
      "binding": {
        "config": {
          "struct": {
            "iconsPerPage": "{this.custom.options.iconsPerPage}",
            "totalNumberOfIcons": "{this.custom.options.totalNumberOfIcons}"
          },
          "waitOnAll": true
        },
        "overlayOptOut": true,
        "transforms": [
          {
            "code": "\timport math\n\t\n\ttotalNumberOfIcons \u003d float(value.totalNumberOfIcons)\n\ticonsPerPage \u003d float(value.iconsPerPage)\n\t\n\treturn max(1, int(math.ceil(totalNumberOfIcons / iconsPerPage)))",
            "type": "script"
          }
        ],
        "type": "expr-struct"
      }
    },
    "custom.options.totalNumberOfIcons": {
      "binding": {
        "config": {
          "path": "this.custom.filteredIcons"
        },
        "transforms": [
          {
            "code": "\treturn len(value) if value else 0",
            "type": "script"
          }
        ],
        "type": "property"
      }
    },
    "params.default": {
      "paramDirection": "input",
      "persistent": true
    },
    "params.icon": {
      "paramDirection": "input",
      "persistent": true
    },
    "params.id": {
      "paramDirection": "input",
      "persistent": true
    },
    "params.value": {
      "paramDirection": "input",
      "persistent": true
    }
  },
