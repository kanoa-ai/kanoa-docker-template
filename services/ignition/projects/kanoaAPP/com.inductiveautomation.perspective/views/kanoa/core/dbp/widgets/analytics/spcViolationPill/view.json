{
  "custom": {},
  "params": {
    "color": "--kcOrange-50",
    "description": "",
    "label": ""
  },
  "propConfig": {
    "params.color": {
      "paramDirection": "input",
      "persistent": true
    },
    "params.description": {
      "paramDirection": "input",
      "persistent": true
    },
    "params.label": {
      "paramDirection": "input",
      "persistent": true
    }
  },
  "props": {
    "defaultSize": {
      "height": 26,
      "width": 120
    }
  },
  "root": {
    "children": [
      {
        "meta": {
          "name": "lblPill",
          "tooltip": {
            "enabled": true,
            "location": "top"
          }
        },
        "position": {
          "shrink": 0
        },
        "propConfig": {
          "meta.tooltip.text": {
            "binding": {
              "config": {
                "path": "view.params.description"
              },
              "type": "property"
            }
          },
          "props.style.backgroundColor": {
            "binding": {
              "config": {
                "path": "view.params.color"
              },
              "type": "property"
            }
          },
          "props.text": {
            "binding": {
              "config": {
                "path": "view.params.label"
              },
              "type": "property"
            }
          }
        },
        "props": {
          "style": {
            "borderRadius": "12px",
            "classes": "kanoa/font/bodySmall",
            "color": "#FFFFFF",
            "fontWeight": "bold",
            "padding": "2px 10px",
            "whiteSpace": "nowrap"
          }
        },
        "type": "ia.display.label"
      }
    ],
    "meta": {
      "name": "root"
    },
    "props": {
      "alignItems": "center"
    },
    "type": "ia.container.flex"
  }
}
