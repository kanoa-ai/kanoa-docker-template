  "propConfig": {
    "custom.marqueeDashboardData": {
      "persistent": true
    },
    "custom.marqueeDashboardData.marqueeDashboards": {
      "binding": {
        "config": {
          "path": "view.params.value"
        },
        "transforms": [
          {
            "code": "\treturn system.kanoa.utilities.convertDatasetToJSON(system.kanoa.dashboard.getMarqueeDashboards({\u0027marqueeId\u0027: value[\u0027marqueeId\u0027]}))",
            "type": "script"
          }
        ],
        "type": "property"
      }
    },
    "custom.marqueeDashboardData.selection.marqueDashboardInfo": {
      "binding": {
        "config": {
          "path": "view.custom.marqueeDashboardData.selection.row"
        },
        "overlayOptOut": true,
        "transforms": [
          {
            "code": "\t\n\tmarqueeDashboardId \u003d self.custom.marqueeDashboardData.marqueeDashboards[value].marqueeDashboardId if value is not None else -1\n\treturn system.kanoa.utilities.convertDatasetRowToJSON(system.kanoa.dashboard.getMarqueeDashboards({\u0027marqueeDashboardId\u0027: marqueeDashboardId}),0)",
            "type": "script"
          }
        ],
        "type": "property"
      }
    },
    "custom.security": {
      "binding": {
        "config": {
          "struct": {
            "user": "{session.props.auth.user}"
          },
          "waitOnAll": false
        },
        "overlayOptOut": true,
        "transforms": [
          {
            "code": "\t\n\tsecConfig \u003d system.kanoa.utilities.convertDatasetToDict(system.kanoa.security.getConfig({}), \u0027configName\u0027, \u0027configValue\u0027)\n\tuserId \u003d system.kanoa.security.getIDPUserId(value[\u0027user\u0027])\n\tuserCRUD \u003d system.kanoa.security.getUserAssetCRUD(userId)\n\t\n\treturn {\"userId\": userId, \"config\": secConfig, \"userCRUD\": userCRUD}",
            "type": "script"
          }
        ],
        "type": "expr-struct"
      },
      "persistent": true
    },
    "custom.userAction": {
      "binding": {
        "config": {
          "struct": {
            "marqueeDashboardInfo": "{view.custom.marqueeDashboardData.selection.marqueDashboardInfo}",
            "security": "{view.custom.security}"
          },
          "waitOnAll": true
        },
        "overlayOptOut": true,
        "transforms": [
          {
            "code": "\t\n\tsecurity \u003d value[\u0027security\u0027]\n\tcanCreate \u003d False\n\tcanEdit \u003d False\n\tif security[\u0027userCRUD\u0027] is not None and security[\u0027userId\u0027] is not None:\n\t\tif security[\u0027userCRUD\u0027][\u0027isGatewayAdmin\u0027] or security[\u0027userCRUD\u0027][\u0027operateAssets\u0027][\u0027enabled\u0027]: \n\t\t\tcanCreate \u003d True\n\t\t\tcanEdit \u003d True if (value[\u0027marqueeDashboardInfo\u0027][\u0027marqueeDashboardId\u0027]) is not None else False\n\t\t\t\n\treturn {\"canCreate\": canCreate, \"canDelete\": canEdit, \"canRead\": True, \"canUpdate\": canEdit}",
            "type": "script"
          }
        ],
        "type": "expr-struct"
      },
      "persistent": true
    },
    "params.value": {
      "paramDirection": "input",
      "persistent": true
    }
  },
