    "scripts": {
      "customMethods": [
        {
          "name": "deleteMarqueeDashboard",
          "params": [],
          "script": "\n\n\tsystem.perspective.print(\"deleteMarquee() called\")\n\n\tuserId \u003d self.view.custom.security.userId\n\tmarqueDashboardInfo \u003d self.view.custom.marqueeDashboardData.selection.marqueDashboardInfo\n\n\tif marqueDashboardInfo[\u0027marqueeDashboardId\u0027] is None: \n\t\tsystem.perspective.sendMessage(\u0027showFailerToast\u0027, \u0027No marquee selected\u0027)\n\t\treturn\n\t\t\n\tretVal, msg \u003d system.kanoa.dashboard.deleteMarqueeDashboard(marqueDashboardInfo[\u0027marqueeDashboardId\u0027], userId)\n\n\tself.view.refreshBinding(\"custom.marqueeDashboardData.marqueeDashboards\")\n\t\n\tif msg:\tsystem.perspective.sendMessage(\u0027showFailerToast\u0027, msg)\n\telse: system.perspective.sendMessage(\u0027showSuccessfulToast\u0027, \u0027Marquee has been deleted\u0027)\n\t\n\treturn"
        }
      ],
      "extensionFunctions": null,
      "messageHandlers": [
        {
          "messageType": "marqueeDashboardUpdate",
          "pageScope": true,
          "script": "\n\tself.view.refreshBinding(\"custom.marqueeDashboardData.marqueeDashboards\")\n\t\n\treturn",
          "sessionScope": false,
          "viewScope": false
        }
      ]
    },
    "type": "ia.container.flex"
