    "custom.chart.series": {
      "binding": {
        "config": {
          "path": "view.custom.data.productionEvents"
        },
        "transforms": [
          {
            "code": "\t# Perspective transform for OEE pie (ApexCharts)\n\t# Input:  value -\u003e list[dict] production events (productionEventData.json shape)\n\t# Output: {\"labels\": [...], \"series\": [...], \"colors\": [...]}  (minutes, 2 decimals)\n\t#\n\t# Ordering:\n\t#   1) Non-production modes, most -\u003e least (by duration)\n\t#   2) Good Runtime (if includeProductiveTime)\n\t#   3) Losses: A/P/Q, most -\u003e least\n\t#\n\t# Colors:\n\t#   - Each non-production mode -\u003e its assigned modeColor\n\t#   - Good Runtime -\u003e Production mode color\n\t#   - A/P/Q -\u003e distinct tweakable defaults (constants below)\n\t#\n\t# Notes:\n\t#   - Uses dataset minute totals; skips zero/neg durations\n\t#   - Missing A/P/Q treated as 1.0 (no loss)\n\t#   - Returns minutes for readability\n\t\n\tfrom collections import defaultdict\n\t\n\tlogger \u003d system.util.getLogger(\u0027oeePieChart\u0027)\n\t\n\t# \u003d\u003d\u003d Tweakable defaults for OEE slices \u003d\u003d\u003d\n\tAPX_COLOR_AVAILABILITY \u003d \u0027#ba1a1a\u0027  # A\n\tAPX_COLOR_PERFORMANCE  \u003d \u0027#f4b400\u0027  # P\n\tAPX_COLOR_QUALITY      \u003d \u0027#489fe2\u0027  # Q\n\tAPX_COLOR_FALLBACK     \u003d \u0027#9e9e9e\u0027  # Any missing mode color\n\t\n\tdef safeRate(raw):\n\t\t\"\"\"Coerce availability/performance/quality into [0,1], default 1.0 when None/invalid.\"\"\"\n\t\ttry:\n\t\t\tval \u003d float(raw)\n\t\texcept:\n\t\t\treturn 1.0\n\t\treturn 0.0 if val \u003c 0 else 1.0 if val \u003e 1 else val\n\t\n\tdef mins(x):\n\t\t\"\"\"Seconds -\u003e minutes, rounded to 2 decimals.\"\"\"\n\t\treturn round((x or 0.0) / 60.0, 2)\n\t\n\tdef getModeColorByName(modeName, cache):\n\t\t\"\"\"\n\t\tReturn the configured color for a given modeName.\n\t\tLookup order:\n\t\t  1) Cache hit\n\t\t  2) Live modes -\u003e getFieldValue(\u0027modeColor\u0027, system.kanoa.asset.getModes({\u0027modeName\u0027: modeName}))\n\t\t  3) Fallback\n\t\t\"\"\"\n\t\tif not modeName:\n\t\t\treturn APX_COLOR_FALLBACK\n\t\n\t\tif modeName in cache:\n\t\t\treturn cache[modeName] or APX_COLOR_FALLBACK\n\t\n\t\ttry:\n\t\t\tmodesDs \u003d system.kanoa.asset.getModes({\u0027modeName\u0027: modeName})\n\t\t\tmodeColor \u003d system.kanoa.utilities.getFieldValue(\u0027modeColor\u0027, modesDs)\n\t\t\tcache[modeName] \u003d modeColor or APX_COLOR_FALLBACK\n\t\texcept Exception as ex:\n\t\t\tlogger.warn(\u0027getModeColorByName failed for \"%s\": %s\u0027 % (modeName, ex))\n\t\t\tcache[modeName] \u003d APX_COLOR_FALLBACK\n\t\n\t\treturn cache[modeName]\n\t\n\ttry:\n\t\tif not value:\n\t\t\treturn {\"labels\": [], \"series\": [], \"colors\": []}\n\t\n\t\t# Read flags (default True if absent)\n\t\tfilters \u003d getattr(self.view.custom, \u0027filters\u0027, {}) or {}\n\t\tincludeNonProduction \u003d bool(filters.get(\u0027includeNonProductionModes\u0027, True))\n\t\tincludeProductiveTime \u003d bool(filters.get(\u0027includeProductiveTime\u0027, True))\n\t\n\t\t# Accumulators (seconds)\n\t\tnonProdByMode \u003d defaultdict(float)\n\t\tavailabilityLossSecs \u003d 0.0\n\t\tperformanceLossSecs \u003d 0.0\n\t\tqualityLossSecs \u003d 0.0\n\t\tgoodRuntimeSecs \u003d 0.0\n\t\n\t\t# Color helpers\n\t\tmodeColorCache \u003d {}\n\t\n\t\t# Also capture a \"production color\" for Good Runtime\n\t\tproductionColor \u003d None\n\t\n\t\tfor row in value:\n\t\t\tdurationSecs \u003d float(row.get(\u0027durationSecs\u0027) or 0.0)\n\t\t\tif durationSecs \u003c\u003d 0:\n\t\t\t\tcontinue\n\t\n\t\t\tmodeTypeName \u003d row.get(\u0027modeTypeName\u0027) or \u0027\u0027\n\t\t\tmodeName \u003d row.get(\u0027modeName\u0027) or \u0027Unspecified\u0027\n\t\n\t\t\t# Prefer color from row if present; seed the cache to avoid DB calls\n\t\t\trowModeColor \u003d row.get(\u0027modeColor\u0027) or None\n\t\t\tif rowModeColor and modeName not in modeColorCache:\n\t\t\t\tmodeColorCache[modeName] \u003d rowModeColor\n\t\n\t\t\tif modeTypeName !\u003d \u0027Production\u0027:\n\t\t\t\tnonProdByMode[modeName] +\u003d durationSecs\n\t\t\t\tcontinue\n\t\n\t\t\t# Production: split A/P/Q/Good\n\t\t\ta \u003d safeRate(row.get(\u0027availability\u0027))\n\t\t\tp \u003d safeRate(row.get(\u0027performance\u0027))\n\t\t\tq \u003d safeRate(row.get(\u0027quality\u0027))\n\t\n\t\t\taLost \u003d durationSecs * (1.0 - a)\n\t\t\tremA \u003d durationSecs - aLost\n\t\n\t\t\tpLost \u003d remA * (1.0 - p)\n\t\t\tremAP \u003d remA - pLost\n\t\n\t\t\tqLost \u003d remAP * (1.0 - q)\n\t\t\tgood \u003d remAP - qLost\n\t\n\t\t\tavailabilityLossSecs +\u003d aLost\n\t\t\tperformanceLossSecs +\u003d pLost\n\t\t\tqualityLossSecs +\u003d qLost\n\t\t\tgoodRuntimeSecs +\u003d good\n\t\n\t\t\t# Capture production color once\n\t\t\tif productionColor is None:\n\t\t\t\tproductionColor \u003d getModeColorByName(\u0027Production\u0027, modeColorCache)\n\t\n\t\t# Default production color if lookup never happened\n\t\tif productionColor is None:\n\t\t\tproductionColor \u003d getModeColorByName(\u0027Production\u0027, modeColorCache)\n\t\n\t\t# \u003d\u003d\u003d Build ordered slices \u003d\u003d\u003d\n\t\tlabels \u003d []\n\t\tseries \u003d []\n\t\tcolors \u003d []\n\t\n\t\t# 1) Non-production modes, most -\u003e least\n\t\tif includeNonProduction and nonProdByMode:\n\t\t\tfor name, secs in sorted(nonProdByMode.items(), key\u003dlambda kv: kv[1], reverse\u003dTrue):\n\t\t\t\tlabels.append(name)\n\t\t\t\tseries.append(mins(secs))\n\t\t\t\tcolors.append(getModeColorByName(name, modeColorCache))\n\t\n\t\t# 2) Good Runtime (optional)\n\t\tif includeProductiveTime and goodRuntimeSecs \u003e 0:\n\t\t\tlabels.append(\u0027Good Runtime\u0027)\n\t\t\tseries.append(mins(goodRuntimeSecs))\n\t\t\tcolors.append(productionColor)\n\t\n\t\t# 3) Losses -\u003e compute mins and order by magnitude\n\t\tlossTriples \u003d [\n\t\t\t(\u0027Availability Loss\u0027, availabilityLossSecs, APX_COLOR_AVAILABILITY),\n\t\t\t(\u0027Performance Loss\u0027,  performanceLossSecs,  APX_COLOR_PERFORMANCE),\n\t\t\t(\u0027Quality Loss\u0027,      qualityLossSecs,      APX_COLOR_QUALITY),\n\t\t]\n\t\t# Filter zeros, sort most -\u003e least\n\t\tlossTriples \u003d [(n, s, c) for (n, s, c) in lossTriples if s \u003e 0]\n\t\tlossTriples.sort(key\u003dlambda t: t[1], reverse\u003dTrue)\n\t\n\t\tfor name, secs, color in lossTriples:\n\t\t\tlabels.append(name)\n\t\t\tseries.append(mins(secs))\n\t\t\tcolors.append(color or APX_COLOR_FALLBACK)\n\t\n\t\treturn {\"labels\": labels, \"series\": series, \"colors\": colors}\n\t\n\texcept Exception as ex:\n\t\tlogger.error(\u0027oeePieChart transform failed: %s\u0027 % ex)\n\t\treturn {\"labels\": [], \"series\": [], \"colors\": []}",
            "type": "script"
          }
        ],
        "type": "property"
      }
    },
    "custom.data": {
      "persistent": true
    },
    "custom.data.productionEvents": {
      "binding": {
        "config": {
          "path": "view.custom.filters"
        },
        "transforms": [
          {
            "code": "\tfilter \u003d value\n\n\tif (filter[\u0027assetPath\u0027] or None) is None: return []\n\tassetPath \u003d filter[\u0027assetPath\u0027] + \u0027%\u0027\n\tassetId \u003d filter[\u0027assetId\u0027]\n\tstartDate \u003d filter[\u0027dateRange\u0027][\u0027startDate\u0027]\n\tendDate \u003d filter[\u0027dateRange\u0027][\u0027endDate\u0027]\n\tmodeEventId \u003d None\n\n\tif assetPath is None: return []\n\t\n\tparamsDict \u003d {\u0027assetId\u0027: assetId, \u0027assetPath\u0027: assetPath, \u0027startDate\u0027: startDate, \u0027endDate\u0027: endDate, \u0027modeEventId\u0027: modeEventId}\n\treturn system.kanoa.utilities.convertDatasetToJSON(system.kanoa.event.getAssetProductionEvents(paramsDict))",
            "type": "script"
          }
        ],
        "type": "property"
      }
    },
    "custom.filters": {
      "binding": {
        "config": {
          "struct": {
            "viewParams": "{view.params.value}"
          },
          "waitOnAll": true
        },
        "overlayOptOut": true,
        "transforms": [
          {
            "code": "\n\tfilters \u003d system.kanoa.dashboard.getWidgetFilters(self.page.props.pageId, value[\u0027viewParams\u0027], self.session.custom.kanoa, self.session.props.device.timezone.id)\n\tif not filters.has_key(\u0027showAssetPath\u0027): filters[\u0027showAssetPath\u0027] \u003d True\n\tif not filters.has_key(\u0027includeNonProductionModes\u0027): filters[\u0027includeNonProductionModes\u0027] \u003d True\n\tif not filters.has_key(\u0027includeProductiveTime\u0027): filters[\u0027includeProductiveTime\u0027] \u003d True\n\tif not filters.has_key(\u0027donutMode\u0027): filters[\u0027donutMode\u0027] \u003d False\n\treturn filters",
            "type": "script"
          }
        ],
        "type": "expr-struct"
      },
      "persistent": true
    },
    "params.value": {
      "paramDirection": "input",
      "persistent": true
    }
  },
