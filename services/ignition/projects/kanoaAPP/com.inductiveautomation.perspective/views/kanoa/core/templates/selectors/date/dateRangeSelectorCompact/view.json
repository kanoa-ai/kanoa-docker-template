          "props.params.addValue": {
            "onChange": {
              "enabled": null,
              "script": "\t\n\tincrement \u003d currentValue.value\n\tif increment !\u003d 0:\n\t\tperiod \u003d self.props.params.period\n\t\tstartDate \u003d self.getSibling(\"dpStartDate\").props.value\n\t\tendDate \u003d self.getSibling(\"dpEndDate\").props.value\n\t\t\n\t\tif period \u003d\u003d \u0027Day\u0027:\n\t\t\tstartDate \u003d system.date.addDays(startDate, increment)\n\t\t\tendDate \u003d system.date.addDays(endDate, increment)\n\t\telif period \u003d\u003d \u0027Week\u0027:\n\t\t\tstartDate \u003d system.date.addWeeks(startDate, increment)\n\t\t\tendDate \u003d system.date.addWeeks(endDate, increment)\n\t\telif period \u003d\u003d \u0027Month\u0027:\n\t\t\tstartDate \u003d system.date.addMonths(startDate, increment)\n\t\t\tendDate \u003d system.date.addMonths(endDate, increment)\n\t\telif period \u003d\u003d \u0027Year\u0027:\n\t\t\tstartDate \u003d system.date.addYears(startDate, increment)\n\t\t\tendDate \u003d system.date.addYears(endDate, increment)\n\t\t\t\t\t\t\n\t\tself.getSibling(\"dpStartDate\").props.value\u003d startDate\n\t\tself.getSibling(\"dpEndDate\").props.value\u003d endDate\n\t\t\n\t\tself.getSibling(\"ddDateRange\").props.value \u003d \u0027Custom\u0027\n\t\tself.props.params.addValue \u003d 0"
            }
