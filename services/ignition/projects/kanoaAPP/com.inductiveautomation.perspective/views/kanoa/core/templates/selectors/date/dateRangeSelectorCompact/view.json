    "scripts": {
      "customMethods": [
        {
          "name": "setRange",
          "params": [
            "selectedDateRange",
            "startDate",
            "endDate"
          ],
          "script": "\n\tif selectedDateRange not in (\u0027Custom\u0027, \u0027\u0027) and selectedDateRange is not None:\t\t\n\t\tclientTZ \u003d self.session.props.device.timezone.id\n\t\tstartDate, endDate \u003d system.kanoa.date.getDateRange({\u0027selectedDateRange\u0027: selectedDateRange, \u0027clientTZ\u0027: clientTZ})\n\t\tself.view.params.startDate \u003d startDate\n\t\tself.view.params.endDate \u003d endDate\n\t\tsystem.kanoa.utilities.storeDateRangeSelection(self, startDate, endDate, selectedDateRange)\n\t\t\n\treturn"
        },
        {
          "name": "update",
          "params": [],
          "script": "\n\tsystem.perspective.print(\"dateRangeSelectorCompact update() called. Get dates from session properties\")\n\n\tdateRange \u003d system.kanoa.utilities.getStoredDateRange(self)\n\tselectedRange \u003d dateRange.selectedRange\n\tstartDate \u003d dateRange.startDate\n\tendDate \u003d dateRange.endDate\n\t\n\tsystem.perspective.print(\"getStoredDateRange returned %s %s %s\"%(selectedRange, startDate, endDate))\n\n\tif selectedRange is not None:\n\t\tself.view.params.selectedRange \u003d selectedRange\t\n\t\tself.setRange(selectedRange, None, None)\n\telse:\t\n\t\tself.view.params.startDate \u003d startDate\n\t\tself.view.params.endDate \u003d endDate\t\n\t\n\treturn"
        }
      ],
