{
  "custom": {
    "data": {
      "stockData": []
    },
    "filters": {
      "assetPath": null,
      "showAssetPath": true
    }
  },
  "params": {
    "value": {
      "assetPath": null,
      "showAssetPath": true
    }
  },
  "propConfig": {
    "custom.data": {
      "persistent": true
    },
    "custom.data.stockData": {
      "binding": {
        "config": {
          "path": "view.custom.filters"
        },
        "overlayOptOut": true,
        "transforms": [
          {
            "code": "\n\tif value.has_key('assetPath') and value['assetPath']:\n\t\treturn system.kanoa.utilities.convertDatasetToJSON(system.kanoa.inventory.getPartInventoryStock({'inventoryAssetPath': value['assetPath']}))\n\telse:\n\t\treturn []",
            "type": "script"
          }
        ],
        "type": "property"
      }
    },
    "custom.data.belowReorderCount": {
      "binding": {
        "config": {
          "path": "view.custom.data.stockData"
        },
        "overlayOptOut": true,
        "transforms": [
          {
            "code": "\n\treturn len([row for row in value if row['isBelowReorderThreshold']])",
            "type": "script"
          }
        ],
        "type": "property"
      }
    },
    "custom.filters": {
      "binding": {
        "config": {
          "struct": {
            "viewParams": "{view.params.value}"
          },
          "waitOnAll": true
        },
        "overlayOptOut": true,
        "transforms": [
          {
            "code": "\n\tfilters = system.kanoa.dashboard.getWidgetFilters(self.page.props.pageId, value['viewParams'], self.session.custom.kanoa, self.session.props.device.timezone.id)\n\tif value['viewParams'].has_key('assetPath') and value['viewParams']['assetPath']: filters['assetPath'] = value['viewParams']['assetPath']\n\tif not filters.has_key('showAssetPath'): filters['showAssetPath'] = True\n\treturn filters",
            "type": "script"
          }
        ],
        "type": "expr-struct"
      },
      "persistent": true
    },
    "params.value": {
      "paramDirection": "input",
      "persistent": true
    }
  },
  "props": {
    "defaultSize": {
      "height": 469,
      "width": 693
    }
  },
  "root": {
    "type": "ia.container.flex",
    "meta": {
      "domId": "root",
      "name": "root"
    },
    "props": {
      "direction": "column",
      "style": {
        "backgroundColor": "--kcSurface",
        "overflow": "hidden",
        "padding": "8px",
        "gap": "8px"
      }
    },
    "children": [
      {
        "type": "ia.container.flex",
        "meta": {
          "domId": "flxHeader",
          "name": "flxHeader"
        },
        "props": {
          "alignItems": "center",
          "justify": "space-between",
          "style": {
            "gap": "8px",
            "overflow": "hidden",
            "padding": "4px"
          }
        },
        "propConfig": {
          "position.display": {
            "binding": {
              "config": {
                "path": "view.custom.filters.showAssetPath"
              },
              "overlayOptOut": true,
              "type": "property"
            }
          }
        },
        "children": [
          {
            "type": "ia.display.label",
            "meta": {
              "domId": "lblTitle",
              "name": "lblTitle"
            },
            "props": {
              "textStyle": {
                "classes": "kanoa/font/labelLarge"
              }
            },
            "propConfig": {
              "props.text": {
                "binding": {
                  "config": {
                    "path": "view.custom.filters"
                  },
                  "overlayOptOut": true,
                  "transforms": [
                    {
                      "code": "\n\treturn 'Stock on Hand - %s' % (system.kanoa.utilities.formatPath(value['assetPath'], {}))",
                      "type": "script"
                    }
                  ],
                  "type": "property"
                }
              }
            }
          },
          {
            "type": "ia.display.label",
            "meta": {
              "domId": "lblReorderBadge",
              "name": "lblReorderBadge"
            },
            "props": {
              "style": {
                "borderRadius": 999,
                "padding": "4px 8px",
                "color": "--kcGray-0",
                "classes": "kanoa/font/labelSmall",
                "textTransform": "uppercase",
                "letterSpacing": "0.03em"
              }
            },
            "propConfig": {
              "props.text": {
                "binding": {
                  "config": {
                    "path": "view.custom.data.belowReorderCount"
                  },
                  "overlayOptOut": true,
                  "transforms": [
                    {
                      "code": "\n\t# Short uppercase tag text, matches the Kanoa Badge component spec\n\tcount = value\n\tif count == 0:\n\t\treturn 'Fully Stocked'\n\telif count == 1:\n\t\treturn '1 Low Stock'\n\telse:\n\t\treturn '%s Low Stock' % count",
                      "type": "script"
                    }
                  ],
                  "type": "property"
                }
              },
              "props.style.backgroundColor": {
                "binding": {
                  "config": {
                    "path": "view.custom.data.belowReorderCount"
                  },
                  "overlayOptOut": true,
                  "transforms": [
                    {
                      "code": "\n\treturn 'var(--kcBad)' if value > 0 else 'var(--kcGood)'",
                      "type": "script"
                    }
                  ],
                  "type": "property"
                }
              }
            }
          }
        ]
      },
      {
        "type": "kyvislabs.display.apexchart",
        "meta": {
          "domId": "apexStockBarChart",
          "name": "apexStockBarChart"
        },
        "position": {
          "basis": "200px",
          "grow": 1
        },
        "props": {
          "type": "bar",
          "options": {
            "chart": {
              "type": "bar",
              "toolbar": {
                "show": false
              },
              "events": {
                "animationEnd": false,
                "beforeMount": false,
                "beforeResetZoom": false,
                "beforeZoom": false,
                "brushScrolled": false,
                "click": false,
                "dataPointMouseEnter": false,
                "dataPointMouseLeave": false,
                "dataPointSelection": false,
                "legendClick": false,
                "markerClick": false,
                "mounted": false,
                "mouseLeave": false,
                "mouseMove": false,
                "scrolled": false,
                "selection": false,
                "updated": false,
                "zoomed": false
              }
            },
            "plotOptions": {
              "bar": {
                "distributed": true,
                "borderRadius": 4,
                "columnWidth": "55%"
              }
            },
            "dataLabels": {
              "enabled": true
            },
            "legend": {
              "show": false
            },
            "theme": {},
            "xaxis": {
              "categories": []
            },
            "yaxis": {
              "title": {
                "text": "Quantity On Hand"
              }
            }
          }
        },
        "propConfig": {
          "props.options.xaxis.categories": {
            "binding": {
              "config": {
                "path": "view.custom.data.stockData"
              },
              "overlayOptOut": true,
              "transforms": [
                {
                  "code": "\n\treturn [row['partNumber'] for row in value]",
                  "type": "script"
                }
              ],
              "type": "property"
            }
          },
          "props.options.colors": {
            "binding": {
              "config": {
                "path": "view.custom.data.stockData"
              },
              "overlayOptOut": true,
              "transforms": [
                {
                  "code": "\n\treturn ['var(--kcBad)' if row['isBelowReorderThreshold'] else 'var(--kcChart-01)' for row in value]",
                  "type": "script"
                }
              ],
              "type": "property"
            }
          },
          "props.options.theme.mode": {
            "binding": {
              "config": {
                "path": "session.props.theme"
              },
              "overlayOptOut": true,
              "transforms": [
                {
                  "code": "\n\tif 'dark' in value: return 'dark'\n\telse: return 'light'",
                  "type": "script"
                }
              ],
              "type": "property"
            }
          },
          "props.series": {
            "binding": {
              "config": {
                "path": "view.custom.data.stockData"
              },
              "overlayOptOut": true,
              "transforms": [
                {
                  "code": "\n\treturn [{\n\t\t'name': 'Quantity On Hand',\n\t\t'data': [row['quantityOnHand'] for row in value]\n\t}]",
                  "type": "script"
                }
              ],
              "type": "property"
            }
          }
        }
      }
    ],
    "scripts": {
      "customMethods": [],
      "extensionFunctions": null,
      "messageHandlers": [
        {
          "messageType": "widgetAssetSelected",
          "pageScope": true,
          "script": "\n\tassetPath = payload['selection'][0]['value']['path'] if len(payload['selection']) > 0 else None\n\t\n\tsystem.kanoa.utilities.storeAssetPath(self, assetPath)\n\t\n\treturn",
          "sessionScope": false,
          "viewScope": false
        },
        {
          "messageType": "assetSelectorUpdate",
          "pageScope": true,
          "script": "\n\tself.view.refreshBinding(\"custom.filters\")\n\t\n\treturn",
          "sessionScope": false,
          "viewScope": false
        }
      ]
    }
  }
}