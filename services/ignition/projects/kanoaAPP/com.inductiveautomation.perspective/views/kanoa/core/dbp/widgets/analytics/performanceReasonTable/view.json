              "overlayOptOut": true,
              "transforms": [
                {
                  "code": "\n\tdef buildColumn(field, title, justify, sortable, width, visible):\n\t\treturn {\n\t\t\t\t  \"field\": field,\n\t\t\t\t  \"visible\": visible,\n\t\t\t\t  \"editable\": False,\n\t\t\t\t  \"render\": \"auto\",\n\t\t\t\t  \"justify\": justify,\n\t\t\t\t  \"align\": \"center\",\n\t\t\t\t  \"resizable\": True,\n\t\t\t\t  \"sortable\": sortable,\n\t\t\t\t  \"sort\": \"none\",\n\t\t\t\t  \"filter\": {\"enabled\": False, \"visible\": \"on-hover\", \"string\": {\"condition\": \"\", \"value\": \"\" }, \"number\": {\"condition\": \"\", \"value\": \"\"}, \"boolean\": {\"condition\": \"\"}, \"date\": {\"condition\": \"\", \"value\": \"\"}},\n\t\t\t\t  \"viewPath\": \"\",\n\t\t\t\t  \"viewParams\": \"\",\n\t\t\t\t  \"boolean\": \"checkbox\",\n\t\t\t\t  \"number\": \"value\",\n\t\t\t\t  \"progressBar\": {\"max\": 100, \"min\": 0, \"bar\": {\"color\": \"\", \"style\": {\"classes\": \"\"}}, \"track\": {\"color\": \"\", \"style\": {\"classes\": \"\"}}, \"value\": {\"enabled\": True, \"format\": \"0,0.##\", \"justify\": \"center\", \"style\": {\"classes\": \"\"}}},\n\t\t\t\t  \"toggleSwitch\": {\"color\": {\"selected\": \"\", \"unselected\": \"\"}},\n\t\t\t\t  \"NoneFormat\": {\"includeNoneStrings\": False, \"strict\": False, \"NoneFormatValue\": \"\"},\n\t\t\t\t  \"numberFormat\": \"0,0.##\",\n\t\t\t\t  \"dateFormat\": \"MM/DD/YYYY HH:mm\",\n\t\t\t\t  \"width\": width,\n\t\t\t\t  \"strictWidth\": True,\n\t\t\t\t  \"style\": {\"classes\": \"\"},\n\t\t\t\t  \"header\": {\"title\": title, \"justify\": justify, \"align\": \"center\", \"style\": {\"classes\": \"\"}},\n\t\t\t\t  \"footer\": {\"title\": \"\", \"justify\": \"left\", \"align\": \"center\", \"style\": {\"classes\": \"\" }}\n\t\t\t\t}\n\t\n\tcolumns \u003d []\n\tif not value: columns.append(buildColumn(\u0027startDate\u0027, \u0027Start\u0027, \u0027center\u0027, True, \u0027\u0027, True))\n\tif not value: columns.append(buildColumn(\u0027endDate\u0027, \u0027End\u0027, \u0027center\u0027, True, \u0027\u0027, True))\n\tcolumns.append(buildColumn(\u0027performanceStateName\u0027, \u0027Reason\u0027, \u0027center\u0027, True, \u0027\u0027, True))\n\tcolumns.append(buildColumn(\u0027assetName\u0027, \u0027Asset\u0027, \u0027center\u0027, True, \u0027\u0027, True))\n\tif not value: columns.append(buildColumn(\u0027workOrderName\u0027, \u0027Asset\u0027, \u0027center\u0027, True, \u0027\u0027, True))\n\tif not value: columns.append(buildColumn(\u0027itemName\u0027, \u0027Item\u0027, \u0027center\u0027, True, \u0027\u0027, True))\n\tif not value: columns.append(buildColumn(\u0027note\u0027, \u0027Note\u0027, \u0027left\u0027, True, \u0027\u0027, True))\n\tcolumns.append(buildColumn(\u0027value\u0027, \u0027Loss Time (mins)\u0027, \u0027center\u0027, True, \u0027\u0027, True))\n\t\t\n\treturn columns",
                  "type": "script"
                }
              ],
              "type": "property"
            }
          },
          "props.data": {
