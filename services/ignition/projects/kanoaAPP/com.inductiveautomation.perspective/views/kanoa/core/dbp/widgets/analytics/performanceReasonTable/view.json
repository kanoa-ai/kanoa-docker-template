    "custom.data.perfEvents": {
      "binding": {
        "config": {
          "path": "view.custom.filters"
        },
        "transforms": [
          {
            "code": "\tfilter \u003d value\n\n\tif (filter[\u0027assetPath\u0027] or None) is None: return []\n\tassetPath \u003d filter[\u0027assetPath\u0027] + \u0027%\u0027\n\tstartDate \u003d filter[\u0027dateRange\u0027][\u0027startDate\u0027]\n\tendDate \u003d filter[\u0027dateRange\u0027][\u0027endDate\u0027]\n\tmodeEventId \u003d None\n\n\tif assetPath is None: return []\n\t\n\tparamsDict \u003d {\u0027assetPath\u0027: assetPath, \u0027startDate\u0027: startDate, \u0027endDate\u0027: endDate, \u0027modeEventId\u0027: modeEventId}\n\treturn system.kanoa.utilities.convertDatasetToJSON(system.kanoa.event.getPerformanceEvents(paramsDict))",
            "type": "script"
          }
        ],
        "type": "property"
      }
    },
    "custom.data.summary": {
      "binding": {
        "config": {
          "path": "view.custom.data.perfEvents"
        },
        "transforms": [
          {
            "code": "\tfrom collections import defaultdict\n\n\tif len(value) \u003d\u003d 0:\n\t\treturn []\n\t\n\t# Grouping: (Reason, Asset) → total duration\n\tsummaryMap \u003d defaultdict(float)\n\t\n\tfor entry in value:\n\t\treason \u003d entry.get(\"performanceStateName\") or \"Unspecified\"\n\t\tasset \u003d entry.get(\"assetName\") or \"Unspecified\"\n\t\tkey \u003d (reason, asset)\n\t\n\t\tduration \u003d entry.get(\"value\", 0)\n\t\tsummaryMap[key] +\u003d duration\n\t\n\t# Format for table output\n\tsummary \u003d []\n\tfor (reason, asset), total in summaryMap.items():\n\t\tsummary.append({\n\t\t\t\"performanceStateName\": reason,\n\t\t\t\"assetName\": asset,\n\t\t\t\"value\": round(total, 3)\n\t\t})\n\t\n\t# Optionally sort descending by duration\n\tsummary.sort(key\u003dlambda x: x[\"value\"], reverse\u003dTrue)\n\t\n\treturn summary",
            "type": "script"
          }
        ],
        "type": "property"
      }
    },
    "custom.filters": {
      "binding": {
        "config": {
          "struct": {
            "viewParams": "{view.params.value}"
          },
          "waitOnAll": true
        },
        "overlayOptOut": true,
        "transforms": [
          {
            "code": "\n\tfilters \u003d system.kanoa.dashboard.getWidgetFilters(self.page.props.pageId, value[\u0027viewParams\u0027], self.session.custom.kanoa, self.session.props.device.timezone.id)\n\tif not filters.has_key(\u0027showAssetPath\u0027): filters[\u0027showAssetPath\u0027] \u003d True\n\tif not filters.has_key(\u0027showSummarySelector\u0027): filters[\u0027showSummarySelector\u0027] \u003d True\n\tif not filters.has_key(\u0027showSummary\u0027): filters[\u0027showSummary\u0027] \u003d True\n\treturn filters",
            "type": "script"
          }
        ],
        "type": "expr-struct"
      },
      "persistent": true
    },
    "params.value": {
      "paramDirection": "input",
      "persistent": true
    }
  },
  "props": {
    "defaultSize": {
      "height": 400,
      "width": 995
    }
  },
