{
  "custom": {
    "chart": {},
    "data": {
      "stockData": []
    },
    "filters": {
      "assetPath": null,
      "showAssetPath": true
    }
  },
  "params": {
    "value": {
      "assetPath": null,
      "showAssetPath": true
    }
  },
  "propConfig": {
    "custom.filters": {
      "binding": {
        "config": {
          "struct": {
            "viewParams": "{view.params.value}"
          },
          "waitOnAll": true
        },
        "overlayOptOut": true,
        "transforms": [
          {
            "code": "\n\tfilters = system.kanoa.dashboard.getWidgetFilters(self.page.props.pageId, value['viewParams'], self.session.custom.kanoa, self.session.props.device.timezone.id)\n\tif value['viewParams'].has_key('assetPath') and value['viewParams']['assetPath']: filters['assetPath'] = value['viewParams']['assetPath']\n\tif not filters.has_key('showAssetPath'): filters['showAssetPath'] = True\n\treturn filters",
            "type": "script"
          }
        ],
        "type": "expr-struct"
      },
      "persistent": true
    },
    "params.value": {
      "paramDirection": "input",
      "persistent": true
    },
    "custom.chart": {
      "persistent": true
    },
    "custom.chart.categoryTotals": {
      "binding": {
        "config": {
          "path": "view.custom.data.stockData"
        },
        "overlayOptOut": true,
        "transforms": [
          {
            "code": "\n\t# Group quantity on hand by the top-level part category (first segment of partCategoryPath)\n\tchartColors = ['var(--kcChart-01)','var(--kcChart-02)','var(--kcChart-03)','var(--kcChart-04)',\n\t\t'var(--kcChart-05)','var(--kcChart-06)','var(--kcChart-07)','var(--kcChart-08)']\n\n\ttotals = {}\n\tfor row in value:\n\t\tcategoryPath = row['partCategoryPath'] or 'Uncategorized'\n\t\ttopCategory = categoryPath.split('\\\\')[0]\n\t\ttotals[topCategory] = totals.get(topCategory, 0) + (row['quantityOnHand'] or 0)\n\n\tcategories = sorted(totals.keys())\n\n\treturn {\n\t\t'labels': categories,\n\t\t'series': [totals[c] for c in categories],\n\t\t'colors': [chartColors[i % len(chartColors)] for i in range(len(categories))]\n\t}",
            "type": "script"
          }
        ],
        "type": "property"
      }
    },
    "custom.data": {
      "persistent": true
    },
    "custom.data.stockData": {
      "binding": {
        "config": {
          "path": "view.custom.filters"
        },
        "overlayOptOut": true,
        "transforms": [
          {
            "code": "\n\tif value.has_key('assetPath') and value['assetPath']:\n\t\treturn system.kanoa.utilities.convertDatasetToJSON(system.kanoa.inventory.getPartInventoryStock({'inventoryAssetPath': value['assetPath']}))\n\telse:\n\t\treturn []",
            "type": "script"
          }
        ],
        "type": "property"
      }
    }
  },
  "props": {
    "defaultSize": {
      "height": 450,
      "width": 700
    }
  },
  "root": {
    "type": "ia.container.flex",
    "meta": {
      "domId": "root",
      "name": "root"
    },
    "props": {
      "direction": "column",
      "style": {
        "backgroundColor": "--kcSurface",
        "classes": "kanoa/font/default",
        "overflow": "hidden",
        "padding": "8px",
        "gap": "8px"
      }
    },
    "children": [
      {
        "type": "ia.container.flex",
        "meta": {
          "domId": "flxHeader",
          "name": "flxHeader"
        },
        "props": {
          "alignItems": "center",
          "justify": "flex-start",
          "style": {
            "gap": "8px",
            "overflow": "hidden",
            "padding": "4px"
          }
        },
        "propConfig": {
          "position.display": {
            "binding": {
              "config": {
                "path": "view.custom.filters.showAssetPath"
              },
              "overlayOptOut": true,
              "type": "property"
            }
          }
        },
        "children": [
          {
            "type": "ia.display.label",
            "meta": {
              "domId": "lblTitle",
              "name": "lblTitle"
            },
            "props": {
              "textStyle": {
                "classes": "kanoa/font/labelLarge"
              }
            },
            "propConfig": {
              "props.text": {
                "binding": {
                  "config": {
                    "path": "view.custom.filters"
                  },
                  "overlayOptOut": true,
                  "transforms": [
                    {
                      "code": "\n\treturn 'Inventory Mix by Category - %s' % (system.kanoa.utilities.formatPath(value['assetPath'], {}))",
                      "type": "script"
                    }
                  ],
                  "type": "property"
                }
              }
            }
          }
        ]
      },
      {
        "type": "kyvislabs.display.apexchart",
        "meta": {
          "domId": "apexCategoryMix",
          "name": "apexCategoryMix"
        },
        "position": {
          "basis": "200px",
          "grow": 1
        },
        "props": {
          "type": "bar",
          "options": {
            "chart": {
              "type": "bar",
              "toolbar": {
                "show": false
              },
              "events": {
                "animationEnd": false,
                "beforeMount": false,
                "beforeResetZoom": false,
                "beforeZoom": false,
                "brushScrolled": false,
                "click": false,
                "dataPointMouseEnter": false,
                "dataPointMouseLeave": false,
                "dataPointSelection": false,
                "legendClick": false,
                "markerClick": false,
                "mounted": false,
                "mouseLeave": false,
                "mouseMove": false,
                "scrolled": false,
                "selection": false,
                "updated": false,
                "zoomed": false
              }
            },
            "plotOptions": {
              "bar": {
                "distributed": true,
                "borderRadius": 4,
                "columnWidth": "55%"
              }
            },
            "dataLabels": {
              "enabled": true
            },
            "legend": {
              "show": false
            },
            "theme": {},
            "xaxis": {
              "categories": []
            },
            "yaxis": {
              "title": {
                "text": "Quantity On Hand"
              }
            }
          }
        },
        "propConfig": {
          "props.options.xaxis.categories": {
            "binding": {
              "config": {
                "path": "view.custom.chart.categoryTotals.labels"
              },
              "overlayOptOut": true,
              "type": "property"
            }
          },
          "props.options.colors": {
            "binding": {
              "config": {
                "path": "view.custom.chart.categoryTotals.colors"
              },
              "overlayOptOut": true,
              "type": "property"
            }
          },
          "props.options.theme.mode": {
            "binding": {
              "config": {
                "path": "session.props.theme"
              },
              "overlayOptOut": true,
              "transforms": [
                {
                  "code": "\n\tif 'dark' in value: return 'dark'\n\telse: return 'light'",
                  "type": "script"
                }
              ],
              "type": "property"
            }
          },
          "props.series": {
            "binding": {
              "config": {
                "path": "view.custom.chart.categoryTotals.series"
              },
              "overlayOptOut": true,
              "transforms": [
                {
                  "code": "\n\treturn [{'name': 'Quantity On Hand', 'data': value}]",
                  "type": "script"
                }
              ],
              "type": "property"
            }
          }
        }
      }
    ],
    "scripts": {
      "customMethods": [],
      "extensionFunctions": null,
      "messageHandlers": [
        {
          "messageType": "widgetAssetSelected",
          "pageScope": true,
          "script": "\n\tassetPath = payload['selection'][0]['value']['path'] if len(payload['selection']) > 0 else None\n\n\tsystem.kanoa.utilities.storeAssetPath(self, assetPath)\n\n\treturn",
          "sessionScope": false,
          "viewScope": false
        },
        {
          "messageType": "assetSelectorUpdate",
          "pageScope": true,
          "script": "\n\tself.view.refreshBinding(\"custom.filters\")\n\n\treturn",
          "sessionScope": false,
          "viewScope": false
        }
      ]
    }
  }
}