    "custom.data.productionEvents": {
      "binding": {
        "config": {
          "path": "view.custom.filters"
        },
        "transforms": [
          {
            "code": "\t\n\tsystem.perspective.print(\"data binding change\")\n\t\n\tfilter \u003d value\n\n\tif (filter[\u0027assetPath\u0027] or None) is None: return []\n\tassetPath \u003d filter[\u0027assetPath\u0027] + \u0027%\u0027\n\tassetId \u003d filter[\u0027assetId\u0027]\n\tstartDate \u003d filter[\u0027dateRange\u0027][\u0027startDate\u0027]\n\tendDate \u003d filter[\u0027dateRange\u0027][\u0027endDate\u0027]\n\tmodeEventId \u003d None\n\n\tif assetPath is None: return []\n\t\n\tparamsDict \u003d {\u0027assetId\u0027: assetId, \u0027assetPath\u0027: assetPath, \u0027startDate\u0027: startDate, \u0027endDate\u0027: endDate, \u0027modeEventId\u0027: modeEventId, \u0027strictDates\u0027: False}\n\tprodEvents \u003d system.kanoa.utilities.convertDatasetToJSON(system.kanoa.event.getAssetProductionEvents(paramsDict))\n\t\n\tself.custom.loading[\u0027max\u0027] \u003d len(prodEvents)\n\tself.custom.loading[\u0027msg\u0027] \u003d \u0027loading\u0027\n\t\n\tfor index in range(len(prodEvents)):\n\t\tself.custom.loading[\u0027index\u0027] \u003d index+1\n\t\tself.custom.loading[\u0027msg\u0027] \u003d \u0027{} / {}\u0027.format(index, self.custom.loading[\u0027max\u0027])\n\t\tparamsDict \u003d {\u0027assetId\u0027: prodEvents[index][\u0027assetId\u0027], \u0027startDate\u0027: max(prodEvents[index][\u0027startDate\u0027], startDate), \u0027endDate\u0027: min(prodEvents[index][\u0027endDate\u0027] or system.date.now(), endDate), \u0027strictDates\u0027: True}\n#\t\tprodEvents[index][\u0027countEventSummary\u0027] \u003d system.kanoa.utilities.convertDatasetToJSON(system.kanoa.event.getCounterEventTotals(paramsDict))\n\t\tprodEvents[index][\u0027performanceEventSummary\u0027] \u003d system.kanoa.utilities.convertDatasetToJSON(system.kanoa.event.getPerformanceEvents(paramsDict))\n\t\tprodEvents[index][\u0027downtimeEventSummary\u0027] \u003d system.kanoa.utilities.convertDatasetToJSON(system.kanoa.event.getAssetStateEventsSummary(paramsDict))\n\t\n\tself.custom.loading[\u0027msg\u0027] \u003d None\n\treturn prodEvents",
            "type": "script"
          }
        ],
        "type": "property"
      }
    },
    "custom.filters": {
      "binding": {
        "config": {
          "struct": {
            "viewParams": "{view.params.value}"
