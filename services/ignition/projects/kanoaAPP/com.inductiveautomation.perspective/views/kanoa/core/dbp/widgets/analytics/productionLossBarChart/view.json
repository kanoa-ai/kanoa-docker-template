            "code": "\n\tfilters \u003d system.kanoa.dashboard.getWidgetFilters(self.page.props.pageId, value[\u0027viewParams\u0027], self.session.custom.kanoa, self.session.props.device.timezone.id)\n\tif not filters.has_key(\u0027showAssetPath\u0027): filters[\u0027showAssetPath\u0027] \u003d True\n\t\n\tviewParams \u003d value[\u0027viewParams\u0027]\n\tif viewParams.has_key(\u0027dateRange\u0027) and viewParams[\u0027dateRange\u0027].has_key(\u0027startDate\u0027) and viewParams[\u0027dateRange\u0027].has_key(\u0027endDate\u0027):\n\t\tfilters[\u0027dateRange\u0027] \u003d viewParams[\u0027dateRange\u0027]\n\t\n\treturn filters",
            "type": "script"
          }
        ],
        "type": "expr-struct"
      },
      "persistent": true
    },
    "custom.loading": {
      "persistent": true
    },
    "params.value": {
      "paramDirection": "input",
      "persistent": true
    }
  },
