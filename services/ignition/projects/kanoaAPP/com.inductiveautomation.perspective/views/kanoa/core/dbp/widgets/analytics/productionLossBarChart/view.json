    "custom.chart": {
      "binding": {
        "config": {
          "path": "view.custom.data.productionEvents"
        },
        "transforms": [
          {
            "code": "\tfrom collections import defaultdict\n\t\n\tlogger \u003d system.util.getLogger(\u0027lossReasonBarchart\u0027)\n\t\n\tCAT_COLOR_AVAIL \u003d \u0027#ba1a1a\u0027\n\tCAT_COLOR_PERF  \u003d \u0027#f4b400\u0027\n\tCAT_COLOR_QUAL  \u003d \u0027#489fe2\u0027\n\tFALLBACK_COLOR  \u003d \u0027#9e9e9e\u0027\n\n\tdef toMinutes(valSecs):\n\t\ttry:\n\t\t\treturn round(float(valSecs)/60.0, 4)\n\t\texcept:\n\t\t\treturn 0.0\n\t\n\ttry:\n\t\tif not value:\n\t\t\treturn {\"series\": [], \"colors\": [], \"xLabels\": []}\n\t\n\t\t# Filters\n\t\tfilters \u003d getattr(self.view.custom, \u0027filters\u0027, {}) or {}\n\t\tbarMode \u003d (filters.get(\u0027barMode\u0027) or \u0027byReason\u0027)\n\t\ttopN \u003d int(filters.get(\u0027topN\u0027) or 10)\n\t\n\t\t# Global aggregations\n\t\t# reasonTotals[reason] -\u003e {\"Availability\": mins, \"Performance\": mins, \"Quality\": mins, \"category\": bestGuess}\n\t\treasonTotals \u003d defaultdict(lambda: {\"Availability\":0.0,\"Performance\":0.0,\"Quality\":0.0,\"category\":\"\"})\n\t\n\t\tfor evt in value:\n\t\t\t# Skip non-production for loss math; losses reside in summaries\n\t\t\tdurationSecs \u003d float(evt.get(\u0027durationSecs\u0027) or 0.0)\n\t\t\toutfeedCount \u003d float(evt.get(\u0027outfeedCount\u0027) or 0.0)\n\t\t\tsecondsPerUnit \u003d (durationSecs / outfeedCount) if outfeedCount \u003e 0 else 0.0\n\t\n\t\t\t# --- Availability (Downtime) ---\n\t\t\tfor dt in (evt.get(\u0027downtimeEventSummary\u0027) or []):\n\t\t\t\tstateName \u003d (dt.get(\u0027stateName\u0027) or \u0027\u0027).strip() or \u0027Unspecified\u0027\n\t\t\t\tstateCategoryName \u003d (dt.get(\u0027stateCategoryName\u0027) or \u0027\u0027).strip()\n\t\t\t\tstateTypeName \u003d (dt.get(\u0027stateTypeName\u0027) or \u0027\u0027).strip()\n\t\t\t\tif stateName \u003d\u003d \u0027Running\u0027 or stateCategoryName \u003d\u003d \u0027Running\u0027 or stateTypeName \u003d\u003d \u0027Running\u0027:\n\t\t\t\t\tcontinue\n\t\t\t\tmins \u003d toMinutes(dt.get(\u0027durationSecs\u0027) or 0)\n\t\t\t\tif mins \u003c\u003d 0:\n\t\t\t\t\tcontinue\n\t\t\t\trec \u003d reasonTotals[stateName]\n\t\t\t\trec[\"Availability\"] +\u003d mins\n\t\t\t\tif not rec[\"category\"]:\n\t\t\t\t\trec[\"category\"] \u003d stateCategoryName or stateTypeName or \u0027Availability\u0027\n\t\n\t\t\t# --- Performance ---\n\t\t\tfor pe in (evt.get(\u0027performanceEventSummary\u0027) or []):\n\t\t\t\treason \u003d (pe.get(\u0027performanceStateName\u0027) or \u0027\u0027).strip() or \u0027Unspecified\u0027\n\t\t\t\tpath \u003d (pe.get(\u0027performanceStatePath\u0027) or \u0027\u0027).strip()\n\t\t\t\tcategory \u003d (path.split(\u0027\\\\\u0027)[0] if \u0027\\\\\u0027 in path else path) or \u0027Performance\u0027\n\t\t\t\tmins \u003d float(pe.get(\u0027value\u0027) or 0.0)  # assumed minutes\n\t\t\t\tif mins \u003c\u003d 0:\n\t\t\t\t\tcontinue\n\t\t\t\trec \u003d reasonTotals[reason]\n\t\t\t\trec[\"Performance\"] +\u003d mins\n\t\t\t\tif not rec[\"category\"]:\n\t\t\t\t\trec[\"category\"] \u003d category\n\t\n\t\t\t# --- Quality (Waste units -\u003e minutes) ---\n\t\t\tfor ce in (evt.get(\u0027countEventSummary\u0027) or []):\n\t\t\t\tif (ce.get(\u0027counterTypeName\u0027) or \u0027\u0027).lower() !\u003d \u0027waste\u0027:\n\t\t\t\t\tcontinue\n\t\t\t\treason \u003d (ce.get(\u0027itemStateName\u0027) or \u0027\u0027).strip() or \u0027Unspecified\u0027\n\t\t\t\tcategory \u003d (ce.get(\u0027itemStateClassName\u0027) or \u0027\u0027).strip() or \u0027Quality\u0027\n\t\t\t\tunits \u003d float(ce.get(\u0027value\u0027) or 0.0)\n\t\t\t\tif units \u003c\u003d 0:\n\t\t\t\t\tcontinue\n\t\t\t\tmins \u003d (units * secondsPerUnit) / 60.0 if secondsPerUnit \u003e 0 else 0.0\n\t\t\t\tif mins \u003c\u003d 0:\n\t\t\t\t\tcontinue\n\t\t\t\trec \u003d reasonTotals[reason]\n\t\t\t\trec[\"Quality\"] +\u003d round(mins, 4)\n\t\t\t\tif not rec[\"category\"]:\n\t\t\t\t\trec[\"category\"] \u003d category\n\t\n\t\t# Colors by category (series)\n\t\tseriesColors \u003d [CAT_COLOR_AVAIL, CAT_COLOR_PERF, CAT_COLOR_QUAL]\n\t\n\t\tif barMode \u003d\u003d \u0027byCategory\u0027:\n\t\t\t# x-axis: categories; series: reasons (topN per category)\n\t\t\tcatNames \u003d [\u0027Availability\u0027,\u0027Performance\u0027,\u0027Quality\u0027]\n\t\t\t# Build separate rankings\n\t\t\tcatReasonMaps \u003d {c: [] for c in catNames}\n\t\t\tfor reason, buckets in reasonTotals.items():\n\t\t\t\tfor c in catNames:\n\t\t\t\t\tval \u003d buckets.get(c, 0.0)\n\t\t\t\t\tif val \u003e 0:\n\t\t\t\t\t\tcatReasonMaps[c].append((reason, val))\n\t\n\t\t\t# Pick topN per category\n\t\t\tfor c in catNames:\n\t\t\t\tcatReasonMaps[c].sort(key\u003dlambda t: t[1], reverse\u003dTrue)\n\t\t\t\tcatReasonMaps[c] \u003d catReasonMaps[c][:topN]\n\t\n\t\t\t# Build union of top reasons across categories as series\n\t\t\treasonSet \u003d set()\n\t\t\tfor c in catNames:\n\t\t\t\tfor r, _ in catReasonMaps[c]:\n\t\t\t\t\treasonSet.add(r)\n\t\t\torderedReasons \u003d sorted(list(reasonSet))\n\t\n\t\t\tseries \u003d []\n\t\t\tfor r in orderedReasons:\n\t\t\t\tdata \u003d []\n\t\t\t\tfor c in catNames:\n\t\t\t\t\tval \u003d 0.0\n\t\t\t\t\tfor rr, v in catReasonMaps[c]:\n\t\t\t\t\t\tif rr \u003d\u003d r:\n\t\t\t\t\t\t\tval \u003d v\n\t\t\t\t\t\t\tbreak\n\t\t\t\t\tdata.append({\"x\": c, \"y\": round(val, 2)})\n\t\t\t\tseries.append({\"name\": r, \"data\": data})\n\t\n\t\t\treturn {\"series\": series, \"colors\": None, \"xLabels\": catNames}\n\t\n\t\telse:\n\t\t\t# Default: byReason + TopN support\n\t\t\t# x-axis: reasons (sorted by total minutes desc); series: Availability/Performance/Quality\n\t\t\ttotalByReason \u003d {}\n\t\t\tfor reason, b in reasonTotals.items():\n\t\t\t\ttotal \u003d b[\"Availability\"] + b[\"Performance\"] + b[\"Quality\"]\n\t\t\t\tif total \u003e 0:\n\t\t\t\t\ttotalByReason[reason] \u003d total\n\t\t\n\t\t\t# Sort all reasons by total minutes\n\t\t\tsortedReasons \u003d [r for r, _ in sorted(totalByReason.items(), key\u003dlambda kv: kv[1], reverse\u003dTrue)]\n\t\t\n\t\t\t# Apply TopN; remainder becomes \"Other\"\n\t\t\tn \u003d int(topN or 10)\n\t\t\tuseTopN \u003d n \u003e 0 and len(sortedReasons) \u003e n\n\t\t\tmainReasons \u003d sortedReasons[:n] if useTopN else sortedReasons\n\t\t\totherReasons \u003d sortedReasons[n:] if useTopN else []\n\t\t\n\t\t\t# Prepare \"Other\" buckets (per category)\n\t\t\totherBuckets \u003d {\"Availability\": 0.0, \"Performance\": 0.0, \"Quality\": 0.0}\n\t\t\tif useTopN:\n\t\t\t\tfor r in otherReasons:\n\t\t\t\t\totherBuckets[\"Availability\"] +\u003d reasonTotals[r][\"Availability\"]\n\t\t\t\t\totherBuckets[\"Performance\"]  +\u003d reasonTotals[r][\"Performance\"]\n\t\t\t\t\totherBuckets[\"Quality\"]      +\u003d reasonTotals[r][\"Quality\"]\n\t\t\n\t\t\t# Final x-labels (append \"Other\" if used)\n\t\t\txLabels \u003d list(mainReasons)\n\t\t\tif useTopN:\n\t\t\t\txLabels.append(\"Other\")\n\t\t\n\t\t\tdef mkSeries(name):\n\t\t\t\tdata \u003d []\n\t\t\t\tfor r in mainReasons:\n\t\t\t\t\tdata.append({\"x\": r, \"y\": round(reasonTotals[r][name], 2)})\n\t\t\t\tif useTopN:\n\t\t\t\t\tdata.append({\"x\": \"Other\", \"y\": round(otherBuckets[name], 2)})\n\t\t\t\treturn {\"name\": name, \"data\": data}\n\t\t\n\t\t\tseries \u003d [\n\t\t\t\tmkSeries(\"Availability\"),\n\t\t\t\tmkSeries(\"Performance\"),\n\t\t\t\tmkSeries(\"Quality\")\n\t\t\t]\n\t\t\n\t\t\treturn {\"series\": series, \"colors\": [CAT_COLOR_AVAIL, CAT_COLOR_PERF, CAT_COLOR_QUAL], \"xLabels\": xLabels}\n\t\n\texcept Exception as ex:\n\t\tlogger.error(\u0027lossReasonBarchart transform failed: %s\u0027 % ex)\n\t\treturn {\"series\": [], \"colors\": [], \"xLabels\": []}",
            "type": "script"
          }
        ],
        "type": "property"
      },
      "persistent": true
    },
