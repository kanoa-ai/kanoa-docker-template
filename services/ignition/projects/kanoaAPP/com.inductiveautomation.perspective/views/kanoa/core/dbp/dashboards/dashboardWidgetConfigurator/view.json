        "position": {
          "display": false,
          "shrink": 0
        },
        "props": {
          "alignContent": "flex-start",
          "alignItems": "flex-start",
          "style": {
            "gap": "5px 15px"
          },
          "wrap": "wrap"
        },
        "type": "ia.container.flex"
      }
    ],
    "meta": {
      "domId": "root",
      "name": "root"
    },
    "props": {
      "style": {
        "backgroundColor": "--kcSurface",
        "classes": "kanoa/font/default",
        "gap": "5px",
        "padding": "5px"
      }
    },
    "scripts": {
      "customMethods": [
        {
          "name": "validateViewParams",
          "params": [],
          "script": "\n\n\tsystem.perspective.print(\u0027validateViewParams() called with\u0027)\n\t\n\tviewParams \u003d self.view.custom.dashboardWidgetInfo.viewParams\n\t\n\ttry:\t\n\t\tviewParams.replace(\u0027null\u0027, \u0027None\u0027)\n\t\tviewParams.replace(\u0027true\u0027, \u0027True\u0027)\n\t\tviewParams.replace(\u0027false\u0027, \u0027False\u0027)\n\t\t\n\t\tviewParams \u003d system.util.jsonDecode(viewParams)\n\t\tsystem.perspective.print(\"viewParams are %s\"%viewParams)\n\t\t\n\t\tfor k,v in viewParams.items():\n\t\t\tsystem.perspective.print(\"%s: %s\"%(k,v))\n\t\t\n\t\tsystem.perspective.sendMessage(\u0027showSuccessfulToast\u0027, \u0027viewParams are valid\u0027)\n\texcept:\n\t\tmsg \u003d \u0027viewParams are invalid\u0027\n\t\tsystem.perspective.print(msg)\n\t\tsystem.perspective.sendMessage(\u0027showFailerToast\u0027, msg)\n\t\tviewParams \u003d None\n\t\n\treturn viewParams"
        },
        {
          "name": "saveDashboardWidgetParams",
          "params": [],
          "script": "\n\tsystem.perspective.print(\"saveDashboardWidgetParams() called\")\n\t\t\n\tuserId \u003d system.kanoa.security.getIDPUserId(self.session.props.auth.user)\n\tdashboardWidgetInfo \u003d dict(self.view.custom.dashboardWidgetInfo)\n\n\twidgetParamInfo \u003d dict(self.view.custom.widgetParamInfo)\n\twidgetParamInfo \u003d {k: (None if isinstance(v, basestring) and v.strip() \u003d\u003d \"\" else v) for k, v in widgetParamInfo.items()}\n\tdashboardWidgetInfo[\u0027viewParams\u0027] \u003d system.util.jsonEncode(widgetParamInfo)\n#\tsystem.perspective.print(\u0027dashboardWidgetInfo: %s\u0027 % dashboardWidgetInfo)\n\t\n\tdashboardWidgetId \u003d dashboardWidgetInfo[\u0027dashboardWidgetId\u0027]\n\t\n\tif dashboardWidgetId: \t# Save the widget\n\t\tsuccess, msg \u003d system.kanoa.dashboard.updateDashboardWidget(dashboardWidgetInfo, userId)\n#\t\tsystem.perspective.print(\u0027updateDashboardWidget returned %s %s\u0027%(success, msg))\n\t\tself.view.refreshBinding(\"custom.dashboardWidgetInfo\")\n\telse:\n\t\tdashboardWidgetId, msg \u003d system.kanoa.dashboard.addDashboardWidget(dashboardWidgetInfo, userId)\n#\t\tsystem.perspective.print(\u0027addDashboardWidget returned %s %s\u0027%(dashboardWidgetId, msg))\n\t\tself.view.params.value.dashboardWidgetId \u003d dashboardWidgetId\n\n\tif msg:\tsystem.perspective.sendMessage(\u0027showFailerToast\u0027, msg)\n\telse: system.perspective.sendMessage(\u0027showSuccessfulToast\u0027, \u0027Dashboard Widget has been saved\u0027)\n\t\n\tsystem.perspective.sendMessage(\u0027refreshDashboardWidgetParams\u0027, {\u0027dashboardWidgetId\u0027:dashboardWidgetId})\n\t\n\treturn dashboardWidgetId, msg\t\n\t\n\t"
        }
      ],
      "extensionFunctions": null,
      "messageHandlers": [
        {
          "messageType": "updateWidgetParams",
          "pageScope": true,
          "script": "\t\n\tsystem.perspective.print(\u0027updateWidgetParams() received with: %s\u0027%payload)\n\tkey, valueType, value \u003d payload[\u0027key\u0027], payload[\u0027type\u0027], payload[\u0027value\u0027]\n\t\n\tif valueType \u003d\u003d \u0027Integer\u0027: value \u003d int(value)\n\tself.view.custom.widgetParamInfo[key] \u003d value\n\treturn",
          "sessionScope": false,
          "viewScope": false
        }
      ]
    },
    "type": "ia.container.flex"
  }
}