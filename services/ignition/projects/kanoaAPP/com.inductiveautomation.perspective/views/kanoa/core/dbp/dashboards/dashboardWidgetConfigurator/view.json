  "propConfig": {
    "custom.dashboardWidgetInfo": {
      "binding": {
        "config": {
          "path": "view.params.value"
        },
        "overlayOptOut": true,
        "transforms": [
          {
            "code": "\n\tdashboardWidgetInfo \u003d system.kanoa.utilities.convertDatasetRowToJSON(system.kanoa.dashboard.getDashboardWidgets({\u0027dashboardWidgetId\u0027: value[\u0027dashboardWidgetId\u0027] or -1}),0)\n\tdashboardWidgetInfo[\u0027widgetDescription\u0027] \u003d dashboardWidgetInfo[\u0027widgetDescription\u0027]  or \u0027\u0027\n\tdashboardWidgetInfo[\u0027viewParams\u0027] \u003d dashboardWidgetInfo[\u0027viewParams\u0027]  or \u0027\u0027\n\t\n\treturn dashboardWidgetInfo",
            "type": "script"
          }
        ],
        "type": "property"
      },
      "persistent": true
    },
    "custom.widgetInfo": {
      "binding": {
        "config": {
          "path": "view.params.value.widgetId"
        },
        "overlayOptOut": true,
        "transforms": [
          {
            "code": "\t\n\twidgetInfo \u003d  system.kanoa.utilities.convertDatasetRowToJSON(system.kanoa.dashboard.getWidgets({\u0027widgetId\u0027: value or -1}),0)\n\t\n\tif widgetInfo[\u0027widgetName\u0027] is None: widgetInfo[\u0027widgetName\u0027] \u003d \u0027\u0027\n\tif widgetInfo[\u0027widgetDescription\u0027] is None: widgetInfo[\u0027widgetDescription\u0027] \u003d \u0027\u0027\n\tif widgetInfo[\u0027viewPath\u0027] is None: widgetInfo[\u0027viewPath\u0027] \u003d \u0027\u0027\n\tif widgetInfo[\u0027viewParams\u0027] is None: widgetInfo[\u0027viewParams\u0027] \u003d \u0027\u0027\n\tif widgetInfo[\u0027enabled\u0027] is None: widgetInfo[\u0027enabled\u0027] \u003d True\n\t\n\treturn widgetInfo",
            "type": "script"
          }
        ],
        "type": "property"
      },
      "persistent": true
    },
    "custom.widgetParamInfo": {
      "binding": {
        "config": {
          "path": "view.custom.dashboardWidgetInfo.viewParams"
        },
        "overlayOptOut": true,
        "transforms": [
          {
            "code": "\t\n\treturn system.util.jsonDecode(value)",
            "type": "script"
          }
        ],
        "type": "property"
      },
      "persistent": true
    },
    "custom.widgetParamsList": {
      "binding": {
        "config": {
          "struct": {
            "dashboardWidgetInfo": "{view.custom.dashboardWidgetInfo}",
            "widgetInfo": "{view.custom.widgetInfo}"
          },
          "waitOnAll": true
        },
        "overlayOptOut": true,
        "transforms": [
          {
            "code": "\t\n\tdef parseJsonToList(jsonStr):\n\t\t\"\"\"\n\t\tParses a JSON string and returns a list of dictionaries\n\t\tcontaining key/value/type information.\n\t\tIf a value is a dict, the value is converted to a JSON string.\n\t\t\"\"\"\n\t\n\t\tdata \u003d system.util.jsonDecode(jsonStr)\n\t\tif not isinstance(data, dict): return []\n\t\n\t\tdef getType(value):\n\t\t\tif value is None: return \"null\"\n\t\t\telif isinstance(value, bool): return \"Boolean\"\n\t\t\telif isinstance(value, int): return \"Integer\"\n\t\t\telif isinstance(value, float): return \"Float\"\n\t\t\telif isinstance(value, basestring): return \"String\"\n\t\t\telif isinstance(value, dict): return \"Dictionary\"\n\t\t\telif isinstance(value, list): return \"List\"\n\t\t\telse: return str(type(value))\n\t\n\t\tresults \u003d []\n\t\tfor key, value in data.items():\n\t\t\tvalueType \u003d getType(value)\n\t\t\tif valueType \u003d\u003d \"Dictionary\": value \u003d system.util.jsonEncode(value)\n\t\t\tresults.append({\"key\": key, \"value\": value, \"type\": valueType, \"options\": None})\n\t\n\t\treturn results\n\t\n\t\n\tviewParams \u003d value[\u0027dashboardWidgetInfo\u0027][\u0027viewParams\u0027]\n\tif not viewParams: return None\n\t\n\twidgetParams \u003d parseJsonToList(viewParams)\n\twidgetParamsOptions \u003d value[\u0027widgetInfo\u0027][\u0027viewParamsOptions\u0027]\n\tif not widgetParamsOptions: return widgetParams\n\t\n\twpoInfo \u003d system.util.jsonDecode(widgetParamsOptions)\n\t\n\tfor param in widgetParams:\n\t\tif param[\u0027key\u0027] in wpoInfo: param[\u0027options\u0027] \u003d wpoInfo[param[\u0027key\u0027]].get(\u0027options\u0027)\n\t\n\treturn widgetParams",
            "type": "script"
          }
        ],
        "type": "expr-struct"
      },
      "persistent": true
    },
    "params.value": {
      "paramDirection": "input",
      "persistent": true
    }
  },
  "props": {
    "defaultSize": {
      "height": 650,
      "width": 817
    }
