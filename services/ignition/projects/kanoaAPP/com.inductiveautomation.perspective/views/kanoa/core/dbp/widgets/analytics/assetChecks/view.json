    "custom.asset.tagInfo": {
      "binding": {
        "config": {
          "fallbackDelay": 2.5,
          "mode": "indirect",
          "references": {
            "1": "{view.custom.asset.tagPath}"
          },
          "tagPath": "{1}/Line"
        },
        "overlayOptOut": true,
        "transforms": [
          {
            "code": "\treturn value.OEE",
            "type": "script"
          }
        ],
        "type": "tag"
      }
    },
    "custom.asset.tagPath": {
      "binding": {
        "config": {
          "path": "view.custom.filters.assetPath"
        },
        "transforms": [
          {
            "code": "\t\n\treturn system.kanoa.asset.getAssetTagPath({\u0027assetPath\u0027: value})",
            "type": "script"
          }
        ],
        "type": "property"
      }
    },
    "custom.data": {
      "persistent": true
    },
    "custom.data.chkShtData": {
      "binding": {
        "config": {
          "path": "view.custom.filters.assetPath"
        },
        "transforms": [
          {
            "code": "\t\n\tparamsDict \u003d {\u0027assetPath\u0027: value, \u0027enabled\u0027: True, \u0027chkShtVersionStateName\u0027: \u0027Released\u0027}\n\treturn system.kanoa.utilities.convertDatasetToJSON(system.kanoa.quality.sheet.getSheetsByAsset(paramsDict))",
            "type": "script"
          }
        ],
        "type": "property"
      }
    },
    "custom.filters": {
      "binding": {
        "config": {
          "struct": {
            "viewParams": "{view.params.value}"
          },
          "waitOnAll": true
        },
        "overlayOptOut": true,
        "transforms": [
          {
            "code": "\n\treturn system.kanoa.dashboard.getWidgetFilters(self.page.props.pageId, value[\u0027viewParams\u0027], self.session.custom.kanoa, self.session.props.device.timezone.id)",
            "type": "script"
          }
        ],
        "type": "expr-struct"
      },
      "persistent": true
    },
    "params.value": {
      "paramDirection": "input",
      "persistent": true
    }
  },
