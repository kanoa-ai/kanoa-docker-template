{
  "custom": {
    "display": {
      "showRaw": false
    }
  },
  "params": {
    "value": {
      "displayJSON": null
    }
  },
  "propConfig": {
    "custom.display": {
      "persistent": true
    },
    "params.value": {
      "paramDirection": "input",
      "persistent": true
    }
  },
  "props": {
    "defaultSize": {
      "height": 303,
      "width": 558
    }
  },
  "root": {
    "children": [
      {
        "meta": {
          "name": "mdDisplay"
        },
        "position": {
          "grow": 1
        },
        "propConfig": {
          "props.source": {
            "binding": {
              "config": {
                "struct": {
                  "display": "{view.custom.display}",
                  "params": "{view.params.value}"
                },
                "waitOnAll": true
              },
              "overlayOptOut": true,
              "transforms": [
                {
                  "code": "\n\tdisplayValue \u003d value[\u0027params\u0027].get(\u0027displayJSON\u0027) or \u0027\u0027\n\tif value[\u0027display\u0027][\u0027showRaw\u0027]: return displayValue\n\t\n\tif displayValue: \n\t\timport json\n\t\tdata \u003d json.loads(displayValue)\t\t\n\t\treturn system.kanoa.utilities.jsonToMarkdown(data) or \u0027\u0027\n\t\n\treturn \u0027\u0027",
                  "type": "script"
                }
              ],
              "type": "expr-struct"
            }
          }
        },
        "type": "ia.display.markdown"
      },
      {
        "children": [
          {
            "events": {
              "component": {
                "onActionPerformed": {
                  "config": {
                    "script": "\n\tsystem.perspective.closePopup(\u0027\u0027)\n\t\n\treturn"
                  },
                  "scope": "G",
                  "type": "script"
                }
              }
            },
            "meta": {
              "domId": "btnClose",
              "name": "btnClose"
            },
            "position": {
              "basis": "100px"
            },
            "props": {
              "image": {
                "icon": {
                  "path": "material/exit_to_app"
                }
              },
              "style": {
                "classes": "kanoa/button/filled"
              },
              "text": "Close"
            },
            "type": "ia.input.button"
          },
          {
            "meta": {
              "name": "chkShowRaw",
              "tooltip": {
                "enabled": true,
                "text": "Shows raw json"
              }
            },
            "position": {
              "shrink": 0
            },
            "propConfig": {
              "props.selected": {
                "binding": {
                  "config": {
                    "bidirectional": true,
                    "path": "view.custom.display.showRaw"
                  },
                  "overlayOptOut": true,
                  "type": "property"
                }
              }
            },
            "props": {
              "text": "Show Raw"
            },
            "type": "ia.input.checkbox"
          }
        ],
        "meta": {
          "domId": "flxAction",
          "name": "flxAction"
        },
        "position": {
          "shrink": 0
        },
        "props": {
          "alignItems": "center",
          "justify": "center",
          "style": {
            "textAlign": "center"
          }
        },
        "type": "ia.container.flex"
      },
      {
        "meta": {
          "name": "lblDebug"
        },
        "position": {
          "basis": "32px",
          "display": false
        },
        "propConfig": {
          "props.text": {
            "binding": {
              "config": {
                "path": "view.params.value"
              },
              "overlayOptOut": true,
              "transforms": [
                {
                  "code": "\treturn str(value)",
                  "type": "script"
                }
              ],
              "type": "property"
            }
          }
        },
        "type": "ia.display.label"
      }
    ],
    "meta": {
      "domId": "root",
      "name": "root"
    },
    "props": {
      "direction": "column",
      "justify": "flex-end",
      "style": {
        "classes": "kanoa/font/default",
        "gap": 5,
        "padding": 5
      }
    },
    "type": "ia.container.flex"
  }
}