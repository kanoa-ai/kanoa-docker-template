{
  "custom": {
    "logoPath": "/system/images/Logos/primary_logo.png",
    "programName": "MES"
  },
  "params": {},
  "propConfig": {
    "custom.logoPath": {
      "binding": {
        "config": {
          "expression": "now(0)"
        },
        "overlayOptOut": true,
        "transforms": [
          {
            "code": "\t\n\tdata \u003d system.kanoa.config.getConfig({\u0027project\u0027: system.util.getProjectName(), \u0027configName\u0027:\u0027logo\u0027})\n\tif data.rowCount \u003d\u003d 0:\tdata \u003d system.kanoa.config.getConfig({\u0027project\u0027: \u0027kanoaCore\u0027, \u0027configName\u0027:\u0027logo\u0027})\t\n\treturn \u0027/system/images/\u0027 + data.getValueAt(0, \u0027configValue\u0027) if data and data.rowCount else \u0027/system/images/Logos/primary_logo.png\u0027\n\t",
            "type": "script"
          }
        ],
        "type": "expr"
      },
      "persistent": true
    },
    "custom.programName": {
      "persistent": true
    }
  },
  "props": {
    "defaultSize": {
      "height": 50,
      "width": 300
    }
  },
  "root": {
    "children": [
      {
        "meta": {
          "domId": "icoLogo",
          "name": "icoLogo"
        },
        "position": {
          "shrink": 0
        },
        "propConfig": {
          "props.source": {
            "binding": {
              "config": {
                "path": "view.custom.logoPath"
              },
              "overlayOptOut": true,
              "type": "property"
            }
          }
        },
        "props": {
          "fit": {
            "aspectRatio": 1,
            "height": 0,
            "mode": "contain",
            "width": 0
          },
          "style": {
            "backgroundColor": "White",
            "borderRadius": 100,
            "height": 40,
            "maxWidth": "calc(100% - 5px)",
            "objectFit": "contain",
            "padding": "3px 10px"
          }
        },
        "type": "ia.display.image"
      }
    ],
    "meta": {
      "domId": "root",
      "name": "root"
    },
    "propConfig": {
      "props.style.backgroundColor": {
        "binding": {
          "config": {
            "path": "session.props.theme"
          },
          "enabled": false,
          "transforms": [
            {
              "code": "\t\n\treturn system.kanoa.config.getBackgroundColor(self.session.props.theme)",
              "type": "script"
            }
          ],
          "type": "property"
        }
      }
    },
    "props": {
      "alignContent": "center",
      "alignItems": "center",
      "justify": "center",
      "style": {
        "backgroundColor": "--kcDockBackground",
        "maxWidth": 300,
        "overflow": "hidden",
        "padding": "5px"
      }
    },
    "scripts": {
      "customMethods": [],
      "extensionFunctions": null,
      "messageHandlers": [
        {
          "messageType": "configUpdate",
          "pageScope": true,
          "script": "\n\tself.view.refreshBinding(\"custom.logoPath\")\n\n\treturn",
          "sessionScope": false,
          "viewScope": false
        }
      ]
    },
    "type": "ia.container.flex"
  }
}