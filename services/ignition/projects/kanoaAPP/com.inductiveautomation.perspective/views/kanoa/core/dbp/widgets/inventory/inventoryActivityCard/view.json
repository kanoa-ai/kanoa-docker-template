{
  "custom": {},
  "params": {
    "value": {
      "notes": null,
      "partNumber": null,
      "quantity": 0,
      "quantitySign": 1,
      "transactionDate": null,
      "transactionTypeCode": null,
      "transactionTypeName": null,
      "uomCode": null
    }
  },
  "propConfig": {
    "params.value": {
      "paramDirection": "input",
      "persistent": true
    }
  },
  "props": {
    "defaultSize": {
      "height": 64,
      "width": 400
    }
  },
  "root": {
    "children": [
      {
        "children": [
          {
            "meta": {
              "domId": "icoActivity",
              "name": "icoActivity"
            },
            "propConfig": {
              "props.color": {
                "binding": {
                  "config": {
                    "path": "view.params.value.transactionTypeCode"
                  },
                  "overlayOptOut": true,
                  "transforms": [
                    {
                      "code": "\n\tupTypes \u003d (\u0027RECEIPT\u0027, \u0027RETURN\u0027, \u0027TRANSFER_IN\u0027)\n\tdownTypes \u003d (\u0027ISSUE\u0027, \u0027TRANSFER_OUT\u0027)\n\tif value in upTypes:\n\t\treturn \u0027#3d8b40\u0027  # literal Kanoa success green - var(--kcGood) renders blue in the live theme\n\telif value in downTypes:\n\t\treturn \u0027var(--kcBad)\u0027\n\telse:\n\t\treturn \u0027var(--kcGray-100)\u0027",
                      "type": "script"
                    }
                  ],
                  "type": "property"
                }
              },
              "props.path": {
                "binding": {
                  "config": {
                    "path": "view.params.value.transactionTypeCode"
                  },
                  "overlayOptOut": true,
                  "transforms": [
                    {
                      "code": "\n\t# RECEIPT, RETURN, TRANSFER_IN -\u003e up; ISSUE, TRANSFER_OUT -\u003e down; everything else -\u003e sync\n\tupTypes \u003d (\u0027RECEIPT\u0027, \u0027RETURN\u0027, \u0027TRANSFER_IN\u0027)\n\tdownTypes \u003d (\u0027ISSUE\u0027, \u0027TRANSFER_OUT\u0027)\n\tif value in upTypes:\n\t\treturn \u0027material/arrow_upward\u0027\n\telif value in downTypes:\n\t\treturn \u0027material/arrow_downward\u0027\n\telse:\n\t\treturn \u0027material/sync_alt\u0027",
                      "type": "script"
                    }
                  ],
                  "type": "property"
                }
              }
            },
            "props": {
              "style": {
                "height": "18px",
                "width": "18px"
              }
            },
            "type": "ia.display.icon"
          }
        ],
        "meta": {
          "domId": "flxAvatar",
          "name": "flxAvatar"
        },
        "position": {
          "basis": "34px",
          "shrink": 0
        },
        "propConfig": {
          "props.style.backgroundColor": {
            "binding": {
              "config": {
                "path": "view.params.value.transactionTypeCode"
              },
              "overlayOptOut": true,
              "transforms": [
                {
                  "code": "\n\t# Literal Kanoa brand tint values (design system tokens.colors.css)\n\tupTypes \u003d (\u0027RECEIPT\u0027, \u0027RETURN\u0027, \u0027TRANSFER_IN\u0027)\n\tdownTypes \u003d (\u0027ISSUE\u0027, \u0027TRANSFER_OUT\u0027)\n\tif value in upTypes:\n\t\treturn \u0027#e6f3d5\u0027\n\telif value in downTypes:\n\t\treturn \u0027#fbe6e3\u0027\n\telse:\n\t\treturn \u0027--kcGray-10\u0027",
                  "type": "script"
                }
              ],
              "type": "property"
            }
          }
        },
        "props": {
          "alignItems": "center",
          "justify": "center",
          "style": {
            "borderRadius": "17px",
            "height": "34px",
            "width": "34px"
          }
        },
        "type": "ia.container.flex"
      },
      {
        "children": [
          {
            "meta": {
              "domId": "lblPartQty",
              "name": "lblPartQty"
            },
            "propConfig": {
              "props.text": {
                "binding": {
                  "config": {
                    "path": "view.params.value"
                  },
                  "overlayOptOut": true,
                  "transforms": [
                    {
                      "code": "\n\treturn value[\u0027partNumber\u0027]",
                      "type": "script"
                    }
                  ],
                  "type": "property"
                }
              }
            },
            "props": {
              "style": {
                "color": "--kcGray-100",
                "fontFamily": "Roboto",
                "fontSize": "14px",
                "fontWeight": 600
              }
            },
            "type": "ia.display.label"
          },
          {
            "meta": {
              "domId": "lblSubline",
              "name": "lblSubline"
            },
            "propConfig": {
              "props.text": {
                "binding": {
                  "config": {
                    "path": "view.params.value"
                  },
                  "overlayOptOut": true,
                  "transforms": [
                    {
                      "code": "\n\tdateFormat \u003d system.kanoa.date.localizeDateFormat(\u0027MMM d, h:mm a\u0027, self.session.props.locale)\n\tdateStr \u003d system.date.format(value[\u0027transactionDate\u0027], dateFormat) if value[\u0027transactionDate\u0027] else \u0027\u0027\n\treturn \u0027%s - %s\u0027 % (value[\u0027transactionTypeName\u0027] or value[\u0027transactionTypeCode\u0027], dateStr)",
                      "type": "script"
                    }
                  ],
                  "type": "property"
                }
              }
            },
            "props": {
              "style": {
                "classes": "kanoa/font/labelSmall",
                "color": "--kcGray-60"
              }
            },
            "type": "ia.display.label"
          }
        ],
        "meta": {
          "domId": "flxText",
          "name": "flxText"
        },
        "position": {
          "grow": 1
        },
        "props": {
          "direction": "column",
          "style": {
            "gap": "0px"
          }
        },
        "type": "ia.container.flex"
      },
      {
        "meta": {
          "domId": "lblQty",
          "name": "lblQty"
        },
        "propConfig": {
          "props.style.backgroundColor": {
            "binding": {
              "config": {
                "path": "view.params.value.transactionTypeCode"
              },
              "overlayOptOut": true,
              "transforms": [
                {
                  "code": "\n\tupTypes \u003d (\u0027RECEIPT\u0027, \u0027RETURN\u0027, \u0027TRANSFER_IN\u0027)\n\tdownTypes \u003d (\u0027ISSUE\u0027, \u0027TRANSFER_OUT\u0027)\n\tif value in upTypes:\n\t\treturn \u0027#3d8b40\u0027  # literal Kanoa success green - var(--kcGood) renders blue in the live theme\n\telif value in downTypes:\n\t\treturn \u0027var(--kcBad)\u0027\n\telse:\n\t\treturn \u0027var(--kcGray-100)\u0027",
                  "type": "script"
                }
              ],
              "type": "property"
            }
          },
          "props.text": {
            "binding": {
              "config": {
                "path": "view.params.value"
              },
              "overlayOptOut": true,
              "transforms": [
                {
                  "code": "\n\tsign \u003d \u0027+\u0027 if value[\u0027quantitySign\u0027] \u003e\u003d 0 else \u0027\u0027\n\tsignedQty \u003d value[\u0027quantitySign\u0027] * (value[\u0027quantity\u0027] or 0)\n\treturn \u0027%s%s %s\u0027 % (sign, signedQty, value[\u0027uomCode\u0027] or \u0027\u0027)",
                  "type": "script"
                }
              ],
              "type": "property"
            }
          }
        },
        "props": {
          "style": {
            "borderRadius": 999,
            "color": "--kcGray-0",
            "fontFamily": "Roboto",
            "fontSize": "13px",
            "fontWeight": 700,
            "padding": "4px 10px"
          }
        },
        "type": "ia.display.label"
      }
    ],
    "meta": {
      "domId": "root",
      "name": "root"
    },
    "props": {
      "alignItems": "center",
      "style": {
        "backgroundColor": "--kcSurface",
        "borderRadius": 10,
        "boxShadow": "0 2px 6px rgba(0,36,60,0.12), 0 1px 2px rgba(0,36,60,0.08)",
        "classes": "kanoa/border kanoa/font/default",
        "gap": "10px",
        "padding": "8px 12px"
      }
    },
    "type": "ia.container.flex"
  }
}