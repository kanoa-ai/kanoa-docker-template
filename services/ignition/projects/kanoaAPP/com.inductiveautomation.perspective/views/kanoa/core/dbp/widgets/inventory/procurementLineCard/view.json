{
  "custom": {},
  "params": {
    "value": {
      "partNumber": null,
      "manufacturerName": null,
      "binName": null,
      "quantityOnHand": 0,
      "reorderPointQty": 0,
      "reorderQty": 0,
      "uomCode": null,
      "isBelowSafetyStock": 0
    }
  },
  "propConfig": {
    "params.value": {
      "paramDirection": "input",
      "persistent": true
    }
  },
  "props": {
    "defaultSize": {
      "height": 104,
      "width": 360
    }
  },
  "root": {
    "type": "ia.container.flex",
    "meta": {
      "domId": "root",
      "name": "root"
    },
    "props": {
      "direction": "row",
      "style": {
        "backgroundColor": "--kcSurface",
        "classes": "kanoa/border",
        "borderRadius": 10,
        "boxShadow": "0 2px 8px rgba(0,36,60,0.14), 0 1px 2px rgba(0,36,60,0.08)",
        "overflow": "hidden",
        "padding": "10px",
        "gap": "10px",
        "borderLeftWidth": "6px",
        "borderLeftStyle": "solid"
      }
    },
    "propConfig": {
      "props.style.borderLeftColor": {
        "binding": {
          "config": {
            "path": "view.params.value"
          },
          "overlayOptOut": true,
          "transforms": [
            {
              "code": "\n\tif value['isBelowSafetyStock']:\n\t\treturn 'var(--kcBad)'\n\telse:\n\t\treturn 'var(--kcOK)'",
              "type": "script"
            }
          ],
          "type": "property"
        }
      }
    },
    "children": [
      {
        "type": "ia.container.flex",
        "meta": {
          "domId": "flxContent",
          "name": "flxContent"
        },
        "position": {
          "grow": 1
        },
        "props": {
          "direction": "column",
          "style": {
            "gap": "4px"
          }
        },
        "children": [
          {
            "type": "ia.container.flex",
            "meta": {
              "domId": "flxTop",
              "name": "flxTop"
            },
            "props": {
              "alignItems": "center",
              "justify": "space-between",
              "style": {
                "gap": "8px"
              }
            },
            "children": [
              {
                "type": "ia.display.label",
                "meta": {
                  "domId": "lblPartNumber",
                  "name": "lblPartNumber"
                },
                "props": {
                  "style": {
                    "fontFamily": "Roboto",
                    "fontWeight": 600,
                    "fontSize": "15px",
                    "color": "--kcGray-100"
                  }
                },
                "propConfig": {
                  "props.text": {
                    "binding": {
                      "config": {
                        "path": "view.params.value.partNumber"
                      },
                      "overlayOptOut": true,
                      "type": "property"
                    }
                  }
                }
              },
              {
                "type": "ia.display.label",
                "meta": {
                  "domId": "lblSuggested",
                  "name": "lblSuggested"
                },
                "props": {
                  "style": {
                    "borderRadius": 999,
                    "padding": "4px 8px",
                    "color": "--kcGray-0",
                    "classes": "kanoa/font/labelSmall",
                    "fontFamily": "Roboto",
                    "fontWeight": 700
                  }
                },
                "propConfig": {
                  "props.text": {
                    "binding": {
                      "config": {
                        "path": "view.params.value"
                      },
                      "overlayOptOut": true,
                      "transforms": [
                        {
                          "code": "\n\treturn 'Reorder %s %s' % (value['reorderQty'], value['uomCode'] or '')",
                          "type": "script"
                        }
                      ],
                      "type": "property"
                    }
                  },
                  "props.style.backgroundColor": {
                    "binding": {
                      "config": {
                        "path": "view.params.value"
                      },
                      "overlayOptOut": true,
                      "transforms": [
                        {
                          "code": "\n\tif value['isBelowSafetyStock']:\n\t\treturn 'var(--kcBad)'\n\telse:\n\t\treturn 'var(--kcOK)'",
                          "type": "script"
                        }
                      ],
                      "type": "property"
                    }
                  }
                }
              }
            ]
          },
          {
            "type": "ia.display.label",
            "meta": {
              "domId": "lblDetail",
              "name": "lblDetail"
            },
            "props": {
              "style": {
                "classes": "kanoa/font/labelSmall",
                "color": "--kcGray-60"
              }
            },
            "propConfig": {
              "props.text": {
                "binding": {
                  "config": {
                    "path": "view.params.value"
                  },
                  "overlayOptOut": true,
                  "transforms": [
                    {
                      "code": "\n\treturn '%s - %s on hand (reorder point %s) - %s' % (value['manufacturerName'] or 'Unknown manufacturer', value['quantityOnHand'], value['reorderPointQty'], value['binName'])",
                      "type": "script"
                    }
                  ],
                  "type": "property"
                }
              }
            }
          }
        ]
      }
    ]
  }
}