  "propConfig": {
    "custom.asset": {
      "persistent": true
    },
    "custom.asset.tagInfo": {
      "binding": {
        "config": {
          "fallbackDelay": 2.5,
          "mode": "indirect",
          "references": {
            "1": "{view.custom.asset.tagPath}"
          },
