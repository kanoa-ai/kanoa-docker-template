      }
    },
    "custom.asset.tagPath": {
      "binding": {
        "config": {
          "path": "view.custom.filters.assetId"
        },
        "transforms": [
          {
            "code": "\t\n\treturn system.kanoa.asset.getAssetTagPath({\u0027assetId\u0027: value})",
            "type": "script"
          }
        ],
        "type": "property"
      }
    },
    "custom.dateRangeOEE": {
      "binding": {
        "config": {
          "path": "view.custom.filters"
        },
        "transforms": [
          {
            "code": "\tif self.custom.filters.ignoreDateRange: \n\t\treturn {}\n\tstartDate \u003d value[\u0027dateRange\u0027][\u0027startDate\u0027]\n\tendDate \u003d value[\u0027dateRange\u0027][\u0027endDate\u0027]\n\tprodModeId \u003d system.kanoa.utilities.getFieldValue(\u0027modeId\u0027, system.kanoa.asset.getModes({\u0027modeName\u0027: \u0027Production\u0027}))\n\tpeSummary \u003d system.kanoa.utilities.convertDatasetToJSON(system.kanoa.event.getAssetProductionEventsSummary({\u0027assetId\u0027: value[\u0027assetId\u0027], \u0027startDate\u0027: startDate, \u0027endDate\u0027: endDate, \u0027modeId\u0027: prodModeId, \u0027strictDates\u0027: True}))\n\t\n\toeeData \u003d {\u0027a\u0027: 0, \u0027p\u0027: 0, \u0027q\u0027: 0, \u0027oee\u0027: 0}\n\ttotalRuntime \u003d sum(val[\u0027runtimeSecs\u0027] for val in peSummary)\n\t\n\tfor pe in peSummary:\n\t\toeeData[\u0027a\u0027] +\u003d (pe[\u0027availability\u0027]) * (pe[\u0027runtimeSecs\u0027] / totalRuntime) if pe[\u0027availability\u0027] \u003e 0 else 0\n\t\toeeData[\u0027p\u0027] +\u003d (pe[\u0027performance\u0027]) * (pe[\u0027runtimeSecs\u0027] / totalRuntime) if pe[\u0027performance\u0027] \u003e 0 else 0\n\t\toeeData[\u0027q\u0027] +\u003d (pe[\u0027quality\u0027]) * (pe[\u0027runtimeSecs\u0027] / totalRuntime) if pe[\u0027quality\u0027] \u003e 0 else 0\n\toeeData[\u0027oee\u0027] \u003d oeeData[\u0027a\u0027] * oeeData[\u0027p\u0027] * oeeData[\u0027q\u0027]\n\t\n\treturn oeeData",
            "type": "script"
          }
        ],
        "type": "property"
      },
      "persistent": true
    },
    "custom.displayValue": {
      "binding": {
        "config": {
          "struct": {
            "dateRangeOEE": "{view.custom.dateRangeOEE}",
            "filters": "{view.custom.filters}",
            "tagInfo": "{view.custom.asset.tagInfo}"
          },
          "waitOnAll": false
        },
        "transforms": [
          {
            "code": "\n\toeeBy \u003d value[\u0027filters\u0027][\u0027oeeBy\u0027].lower()\n\tliveDataMode \u003d value[\u0027filters\u0027][\u0027ignoreDateRange\u0027]\n\n\tif value[\u0027tagInfo\u0027] is not None:\n\t\ta \u003d (value[\u0027tagInfo\u0027][\u0027availability\u0027] or 0.0) if liveDataMode else (value[\u0027dateRangeOEE\u0027][\u0027a\u0027] or 0.0)\n\t\tp \u003d (value[\u0027tagInfo\u0027][\u0027performance\u0027] or 0.0) if liveDataMode else (value[\u0027dateRangeOEE\u0027][\u0027p\u0027] or 0.0)\n\t\tq \u003d (value[\u0027tagInfo\u0027][\u0027quality\u0027] or 0.0) if liveDataMode else (value[\u0027dateRangeOEE\u0027][\u0027q\u0027] or 0.0)\n\telse:\n\t\ta, p, q \u003d 0.0, 0.0, 0.0\n\tdisplayValue \u003d 0\n\n\tif oeeBy \u003d\u003d \u0027availability\u0027 or oeeBy \u003d\u003d \u0027a\u0027:\n\t\tdisplayValue \u003d a * 100\n\telif oeeBy \u003d\u003d \u0027performance\u0027 or oeeBy \u003d\u003d \u0027p\u0027:\n\t\tdisplayValue \u003d p * 100\n\telif oeeBy \u003d\u003d \u0027quality\u0027 or oeeBy \u003d\u003d \u0027q\u0027:\n\t\tdisplayValue \u003d q * 100\n\telse:\n\t\tdisplayValue \u003d (a * p * q) * 100 if liveDataMode else value[\u0027dateRangeOEE\u0027][\u0027oee\u0027] * 100\n\n\tmsg \u003d \"oeeDial: asset {} with value {}\".format(value[\u0027filters\u0027][\u0027assetPath\u0027], displayValue)\n\tsystem.perspective.print(msg)\n\n\treturn max(0.0, min(100.0, displayValue))",
            "type": "script"
          }
        ],
        "type": "expr-struct"
      },
      "persistent": true
    },
    "custom.filters": {
      "binding": {
        "config": {
          "struct": {
            "viewParams": "{view.params.value}"
          },
          "waitOnAll": true
        },
        "overlayOptOut": true,
        "transforms": [
          {
            "code": "\n\tfilters \u003d system.kanoa.dashboard.getWidgetFilters(self.page.props.pageId, value[\u0027viewParams\u0027], self.session.custom.kanoa, self.session.props.device.timezone.id)\n\tif not filters.has_key(\u0027ignoreDateRange\u0027):\n\t\tfilters[\u0027ignoreDateRange\u0027] \u003d True\n\t\t\n\tif value[\u0027viewParams\u0027].has_key(\u0027assetPath\u0027) and value[\u0027viewParams\u0027][\u0027assetPath\u0027] is not None:\n\t\tfilters[\u0027assetPath\u0027] \u003d value[\u0027viewParams\u0027][\u0027assetPath\u0027]\n\t\t\n\t#system.perspective.print(\u0027returning oeeDial filters {}\u0027.format(filters))\n\treturn filters",
            "type": "script"
          }
        ],
        "type": "expr-struct"
      },
      "persistent": true
    },
    "params.value": {
      "paramDirection": "input",
      "persistent": true
    }
  },
