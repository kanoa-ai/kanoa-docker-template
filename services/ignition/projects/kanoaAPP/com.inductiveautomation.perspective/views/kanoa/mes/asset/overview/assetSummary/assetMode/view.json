{
  "custom": {
    "status": {}
  },
  "params": {
    "live": {},
    "value": {
      "assetId": null,
      "eqPath": "",
      "name": "",
      "statusPath": ""
    }
  },
  "propConfig": {
    "custom.status.modeColor": {
      "binding": {
        "config": {
          "fallbackDelay": 2.5,
          "mode": "indirect",
          "references": {
            "1": "{view.params.value.statusPath}"
          },
          "tagPath": "{1}/modeColor"
        },
        "overlayOptOut": true,
        "type": "tag"
      }
    },
    "custom.status.modeName": {
      "binding": {
        "config": {
          "fallbackDelay": 2.5,
          "mode": "indirect",
          "references": {
            "1": "{view.params.value.statusPath}"
          },
          "tagPath": "{1}/modeName"
        },
        "overlayOptOut": true,
        "type": "tag"
      }
    },
    "custom.status.modeSourceName": {
      "binding": {
        "config": {
          "fallbackDelay": 2.5,
          "mode": "indirect",
          "references": {
            "1": "{view.params.value.statusPath}"
          },
          "tagPath": "{1}/modeSourceName"
        },
        "overlayOptOut": true,
        "type": "tag"
      }
    },
    "custom.status.stateColor": {
      "binding": {
        "config": {
          "fallbackDelay": 2.5,
          "mode": "indirect",
          "references": {
            "1": "{view.params.value.statusPath}"
          },
          "tagPath": "{1}/stateColor"
        },
        "overlayOptOut": true,
        "type": "tag"
      }
    },
    "custom.status.stateName": {
      "binding": {
        "config": {
          "fallbackDelay": 2.5,
          "mode": "indirect",
          "references": {
            "1": "{view.params.value.statusPath}"
          },
          "tagPath": "{1}/stateName"
        },
        "overlayOptOut": true,
        "type": "tag"
      }
    },
    "custom.status.stateTypeColor": {
      "binding": {
        "config": {
          "fallbackDelay": 2.5,
          "mode": "indirect",
          "references": {
            "1": "{view.params.value.statusPath}"
          },
          "tagPath": "{1}/stateTypeColor"
        },
        "overlayOptOut": true,
        "type": "tag"
      }
    },
    "params.live": {
      "binding": {
        "config": {
          "struct": {
            "assetId": "{view.params.value.assetId}",
            "eqPath": "{view.params.value.eqPath}",
            "modeColor": "{view.custom.status.modeColor}",
            "modeName": "{view.custom.status.modeName}",
            "modeSourceName": "{view.custom.status.modeSourceName}",
            "name": "{view.params.value.name}",
            "stateColor": "{view.custom.status.stateColor}",
            "stateName": "{view.custom.status.stateName}",
            "stateTypeColor": "{view.custom.status.stateTypeColor}"
          },
          "waitOnAll": false
        },
        "overlayOptOut": true,
        "type": "expr-struct"
      },
      "paramDirection": "output",
      "persistent": true
    },
    "params.value": {
      "paramDirection": "input",
      "persistent": true
    }
  },
  "props": {
    "defaultSize": {
      "height": 53,
      "width": 297
    }
  },
  "root": {
    "children": [
      {
        "meta": {
          "domId": "lblName",
          "name": "lblName"
        },
        "position": {
          "basis": "178px",
          "grow": 1
        },
        "propConfig": {
          "props.text": {
            "binding": {
              "config": {
                "path": "view.params.value.name"
              },
              "overlayOptOut": true,
              "type": "property"
            }
          }
        },
        "props": {
          "textStyle": {
            "classes": "kanoa/font/bodyMedium",
            "color": ""
          }
        },
        "type": "ia.display.label"
      },
      {
        "meta": {
          "domId": "Icon",
          "name": "Icon"
        },
        "position": {
          "basis": "30px"
        },
        "propConfig": {
          "props.path": {
            "binding": {
              "config": {
                "path": "view.custom.status.modeSourceName"
              },
              "overlayOptOut": true,
              "transforms": [
                {
                  "code": "\n\tif value \u003d\u003d \u0027Schedule\u0027: icon \u003d \u0027material/calendar_today\u0027\n\telif value \u003d\u003d \u0027PLC\u0027: icon \u003d \u0027kanoa/cell\u0027\n\telif value in (\u0027Operator\u0027, \u0027Operator Run\u0027): icon \u003d \u0027material/engineering\u0027\n\telse: icon \u003d \u0027\u0027\n\t\n\treturn icon",
                  "type": "script"
                }
              ],
              "type": "property"
            }
          },
          "props.style.color": {
            "binding": {
              "config": {
                "path": "view.custom.status.modeColor"
              },
              "overlayOptOut": true,
              "type": "property"
            }
          }
        },
        "props": {
          "style": {
            "borderBottomLeftRadius": 100,
            "borderBottomRightRadius": 100,
            "borderTopLeftRadius": 100,
            "borderTopRightRadius": 100,
            "classes": "",
            "marginRight": "5px"
          }
        },
        "type": "ia.display.icon"
      },
      {
        "meta": {
          "domId": "lblMsg",
          "name": "lblMsg"
        },
        "position": {
          "basis": "150px"
        },
        "propConfig": {
          "props.style.backgroundColor": {
            "binding": {
              "config": {
                "path": "view.custom.status.modeColor"
              },
              "overlayOptOut": true,
              "transforms": [
                {
                  "code": "\treturn value or \u0027\u0027",
                  "type": "script"
                }
              ],
              "type": "property"
            }
          },
          "props.style.color": {
            "binding": {
              "config": {
                "path": "view.custom.status.modeColor"
              },
              "transforms": [
                {
                  "code": "\t\n\tif value is None: return \u0027\u0027\n\treturn system.kanoa.utilities.getContrastingColor(value)",
                  "type": "script"
                }
              ],
              "type": "property"
            }
          },
          "props.text": {
            "binding": {
              "config": {
                "path": "view.custom.status.modeName"
              },
              "overlayOptOut": true,
              "transforms": [
                {
                  "code": "\treturn value or \u0027Unknown\u0027",
                  "type": "script"
                }
              ],
              "type": "property"
            }
          }
        },
        "props": {
          "style": {
            "borderBottomLeftRadius": 20,
            "borderBottomRightRadius": 20,
            "borderTopLeftRadius": 20,
            "borderTopRightRadius": 20,
            "paddingBottom": 10,
            "paddingLeft": 10,
            "paddingRight": 10,
            "paddingTop": 10
          },
          "textStyle": {
            "classes": "kanoa/font/bodyMedium",
            "textAlign": "center"
          }
        },
        "type": "ia.display.label"
      }
    ],
    "events": {
      "dom": {
        "onClick": {
          "config": {
            "script": "\t\n\tsystem.kanoa.utilities.storeAssetPath(self, self.view.params.value.eqPath)\n\tparams\u003d {\"path\": \"kanoa/mes/asset/operation/main\", \"name\": \"Asset Operation\", \"type\": \"view\", \"params\": {}}\n\tsystem.perspective.sendMessage(\"updateNavigation\", payload\u003dparams, scope\u003d\u0027page\u0027)\n\t\n\treturn"
          },
          "scope": "G",
          "type": "script"
        }
      }
    },
    "meta": {
      "domId": "root",
      "name": "root"
    },
    "props": {
      "style": {
        "backgroundColor": "var(--kcSurface)",
        "classes": "kanoa/clickable",
        "padding": 5,
        "borderRadius": "var(--borderRadius)"
      }
    },
    "type": "ia.container.flex"
  }
}