{
  "custom": {
    "stateInfo": {
      "changedBy": null,
      "changedByUser": null,
      "changedDate": null,
      "createdBy": null,
      "createdByUser": null,
      "createdDate": null,
      "enabled": true,
      "lotStateColor": null,
      "lotStateId": null,
      "lotStateName": ""
    }
  },
  "params": {
    "values": {
      "lotStateId": null
    }
  },
  "propConfig": {
    "custom.stateInfo": {
      "binding": {
        "config": {
          "path": "view.params.values"
        },
        "transforms": [
          {
            "code": "\n\tstateInfo \u003d system.kanoa.utilities.convertDatasetRowToJSON(system.kanoa.lot.getLotStates({\u0027lotStateId\u0027:value[\u0027lotStateId\u0027] or -1}),0)\n\tstateInfo[\u0027lotStateName\u0027] \u003d stateInfo[\u0027lotStateName\u0027] or \u0027\u0027\n\tif stateInfo[\u0027lotStateId\u0027] is None: stateInfo[\u0027enabled\u0027] \u003d True\n\t\n\treturn stateInfo\n",
            "type": "script"
          }
        ],
        "type": "property"
      },
      "persistent": true
    },
    "params.values": {
      "paramDirection": "input",
      "persistent": true
    }
  },
  "props": {
    "defaultSize": {
      "height": 157,
      "width": 350
    }
  },
  "root": {
    "children": [
      {
        "children": [
          {
            "meta": {
              "domId": "lblLotStateName",
              "name": "lblLotStateName"
            },
            "position": {
              "basis": "80px",
              "shrink": 0
            },
            "props": {
              "style": {
                "classes": "kanoa/font/default",
                "textAlign": "right"
              },
              "text": "Lot State"
            },
            "type": "ia.display.label"
          },
          {
            "events": {
              "system": {
                "onStartup": {
                  "config": {
                    "script": "\t\n\timport time\n\ttime.sleep(0.2)\n\tself.focus()"
                  },
                  "scope": "G",
                  "type": "script"
                }
              }
            },
            "meta": {
              "domId": "txtLotStateReasonName",
              "name": "txtLotStateName"
            },
            "position": {
              "basis": "150px",
              "grow": 1,
              "shrink": 0
            },
            "propConfig": {
              "props.text": {
                "binding": {
                  "config": {
                    "bidirectional": true,
                    "path": "view.custom.stateInfo.lotStateName"
                  },
                  "overlayOptOut": true,
                  "type": "property"
                }
              }
            },
            "props": {
              "style": {
                "classes": "kanoa/font/default kanoa/border"
              }
            },
            "type": "ia.input.text-field"
          }
        ],
        "meta": {
          "domId": "flxStateName",
          "name": "flxStateName"
        },
        "position": {
          "basis": "30px",
          "shrink": 0
        },
        "props": {
          "style": {
            "gap": 5,
            "overflow": "hidden"
          }
        },
        "type": "ia.container.flex"
      },
      {
        "children": [
          {
            "meta": {
              "domId": "Label",
              "name": "lblEnabled"
            },
            "position": {
              "basis": "80px",
              "shrink": 0
            },
            "props": {
              "style": {
                "classes": "kanoa/font/default",
                "textAlign": "right"
              },
              "text": "Enabled"
            },
            "type": "ia.display.label"
          },
          {
            "meta": {
              "domId": "Checkbox",
              "name": "chkEnabled"
            },
            "position": {
              "shrink": 0
            },
            "propConfig": {
              "props.selected": {
                "binding": {
                  "config": {
                    "bidirectional": true,
                    "path": "view.custom.stateInfo.enabled"
                  },
                  "overlayOptOut": true,
                  "type": "property"
                }
              }
            },
            "props": {
              "checkedIcon": {
                "color": {
                  "enabled": "--kcGray-60"
                }
              },
              "text": ""
            },
            "type": "ia.input.checkbox"
          }
        ],
        "meta": {
          "domId": "flxStateEnabled",
          "name": "flxStateEnabled"
        },
        "position": {
          "basis": "30px",
          "shrink": 0
        },
        "props": {
          "style": {
            "gap": 5,
            "overflow": "hidden"
          }
        },
        "type": "ia.container.flex"
      },
      {
        "children": [
          {
            "meta": {
              "domId": "lbl",
              "name": "lbl"
            },
            "position": {
              "basis": "80px",
              "shrink": 0
            },
            "props": {
              "style": {
                "classes": "kanoa/font/default",
                "textAlign": "right"
              },
              "text": "Color"
            },
            "type": "ia.display.label"
          },
          {
            "events": {
              "dom": {
                "onClick": {
                  "config": {
                    "script": "\t\n\tsystem.perspective.openPopup(\"Color Picker\", \"kanoa/core/templates/colorPicker/main\", {}, overlayDismiss\u003dTrue)\n\t\n\treturn"
                  },
                  "scope": "G",
                  "type": "script"
                }
              }
            },
            "meta": {
              "domId": "lblColor",
              "name": "lblColor"
            },
            "position": {
              "basis": "25px",
              "shrink": 0
            },
            "propConfig": {
              "props.style.backgroundColor": {
                "binding": {
                  "config": {
                    "path": "view.custom.stateInfo"
                  },
                  "transforms": [
                    {
                      "code": "\treturn value[\u0027lotStateColor\u0027] or \u0027#D5D5D5\u0027",
                      "type": "script"
                    }
                  ],
                  "type": "property"
                }
              }
            },
            "props": {
              "style": {
                "classes": "kanoa/input"
              }
            },
            "type": "ia.display.label"
          }
        ],
        "meta": {
          "domId": "flxLotOperationColor",
          "name": "flxLotStateColor"
        },
        "position": {
          "basis": "25px",
          "shrink": 0
        },
        "props": {
          "style": {
            "gap": 5,
            "overflow": "hidden"
          }
        },
        "type": "ia.container.flex"
      },
      {
        "children": [
          {
            "events": {
              "component": {
                "onActionPerformed": {
                  "config": {
                    "script": "\n\tstateInfo \u003d dict(self.view.custom.stateInfo)\n\tuserId \u003d system.kanoa.security.getIDPUserId(self.session.props.auth.user)\n\t\n\tif stateInfo[\u0027lotStateId\u0027] is not None: \t#If state name has changed, we need to check that it doesn\u0027t already exist\n\t\tcurrentStateId \u003d system.kanoa.utilities.getFieldValue(\u0027lotStateId\u0027, system.kanoa.lot.getLotStates({\u0027lotStateName\u0027: stateInfo[\u0027lotStateName\u0027]}))\n\t\tif currentStateId is not None and currentStateId !\u003d stateInfo[\u0027lotStateId\u0027]:\n\t\t\tsystem.perspective.sendMessage(\u0027showFailerToast\u0027, {\u0027message\u0027: \u0027This state already exists\u0027})\n\t\t\treturn\n\t\t\n\t\tsystem.perspective.sendMessage(\u0027showInfoToast\u0027, {\u0027message\u0027: \u0027Updating lotStateId %i \u0027%stateInfo[\u0027lotStateId\u0027]})\t\t\t\n\t\tretVal \u003d system.kanoa.lot.updateLotState(stateInfo, userId)\n\telse:\n\t\tsystem.perspective.sendMessage(\u0027showInfoToast\u0027, {\u0027message\u0027: \u0027Adding lot state\u0027})\t\n\t\tstateId \u003d system.kanoa.lot.addLotState(stateInfo, userId)\n\n\tsystem.perspective.sendMessage(\"updateStates\", {})\t\n\tsystem.perspective.closePopup(\u0027\u0027)\n\t\n\treturn"
                  },
                  "scope": "G",
                  "type": "script"
                }
              }
            },
            "meta": {
              "domId": "btnSave",
              "name": "btnSave",
              "tooltip": {
                "enabled": true,
                "location": "bottom-left",
                "text": "Save"
              }
            },
            "position": {
              "shrink": 0
            },
            "propConfig": {
              "props.enabled": {
                "binding": {
                  "config": {
                    "path": "view.custom.stateInfo"
                  },
                  "overlayOptOut": true,
                  "transforms": [
                    {
                      "code": "\treturn True if (value[\u0027lotStateReasonName\u0027] or None) is not None and value[\u0027lotStateId\u0027] else False",
                      "type": "script"
                    }
                  ],
                  "type": "property"
                }
              }
            },
            "props": {
              "image": {
                "icon": {
                  "path": "material/save"
                }
              },
              "style": {
                "classes": "kanoa/button/filled"
              },
              "text": "Save"
            },
            "type": "ia.input.button"
          },
          {
            "events": {
              "component": {
                "onActionPerformed": {
                  "config": {
                    "script": "\n\tsystem.perspective.closePopup(\u0027\u0027)\n\treturn"
                  },
                  "scope": "G",
                  "type": "script"
                }
              }
            },
            "meta": {
              "domId": "btnClose",
              "name": "btnClose",
              "tooltip": {
                "enabled": true,
                "location": "bottom-left",
                "text": "Close"
              }
            },
            "position": {
              "shrink": 0
            },
            "props": {
              "image": {
                "icon": {
                  "path": "material/exit_to_app"
                }
              },
              "style": {
                "classes": "kanoa/button/outlined",
                "marginLeft": "5px"
              },
              "text": "Close"
            },
            "type": "ia.input.button"
          }
        ],
        "meta": {
          "domId": "flxActions",
          "name": "flxActions"
        },
        "position": {
          "shrink": 0
        },
        "props": {
          "justify": "center",
          "style": {
            "gap": "5px",
            "overflow": "hidden",
            "padding": "5px"
          }
        },
        "type": "ia.container.flex"
      }
    ],
    "meta": {
      "domId": "root",
      "name": "root"
    },
    "props": {
      "direction": "column",
      "style": {
        "classes": "kanoa/container",
        "gap": 5,
        "overflow": "hidden",
        "padding": 5
      }
    },
    "scripts": {
      "customMethods": [],
      "extensionFunctions": null,
      "messageHandlers": [
        {
          "messageType": "colorPicked",
          "pageScope": true,
          "script": "\n\tsystem.perspective.print(\"colorPicked message received with payload \" + str(payload))\t\n\tself.view.custom.stateInfo.lotStateColor \u003d payload[\u0027color\u0027]\n\t\n\treturn",
          "sessionScope": false,
          "viewScope": false
        }
      ]
    },
    "type": "ia.container.flex"
  }
}