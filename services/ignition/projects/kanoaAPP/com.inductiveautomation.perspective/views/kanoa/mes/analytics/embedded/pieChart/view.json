  },
  "root": {
    "children": [
      {
        "meta": {
          "domId": "PieChart",
          "name": "PieChart"
        },
        "position": {
          "shrink": 0
        },
        "propConfig": {
          "position.display": {
            "binding": {
              "config": {
                "path": "this.props.data"
              },
              "overlayOptOut": true,
              "transforms": [
                {
                  "code": "\treturn value.rowCount \u003e 0",
                  "type": "script"
                }
              ],
              "type": "property"
            }
          },
          "props.data": {
            "binding": {
              "config": {
                "path": "view.params.value"
              },
              "overlayOptOut": true,
              "transforms": [
                {
                  "code": "\n#\tsystem.perspective.print(\"buildChart() called\")\n\t\n\thdr \u003d [\u0027label\u0027, \u0027value\u0027]\n\tdata \u003d system.dataset.toPyDataSet(value.data)\n\tlabels \u003d list(set([row[value.labelCol] for row in data]))\n\tnewValues \u003d [[labels[i], 0.0] for i in range(len(labels))]\n\n\tfor row in data:\n\t\tnewValues[labels.index(row[value.labelCol])][1] +\u003d round(row[value.valueCol] / 60.0,1)\n\t\n\treturn system.dataset.toDataSet(hdr, newValues)",
                  "type": "script"
                }
              ],
              "type": "property"
            }
          },
          "props.labels.inside.color": {
            "binding": {
              "config": {
                "path": "session.props.theme"
              },
              "transforms": [
                {
                  "code": "\t\n\treturn kanoaScripts.colors.getCSSColor(\u0027--kcOnSurface\u0027, value)",
                  "type": "script"
                }
              ],
              "type": "property"
            }
          },
          "props.legendLabelColor": {
            "binding": {
              "config": {
                "path": "session.props.theme"
              },
              "transforms": [
                {
                  "code": "\t\n\treturn kanoaScripts.colors.getCSSColor(\u0027--kcOnSurface\u0027, value)",
                  "type": "script"
                }
              ],
              "type": "property"
            }
          },
          "props.title": {
            "binding": {
              "config": {
                "expression": "translate({view.params.value.title})"
              },
              "type": "expr"
            }
          },
          "props.titleColor": {
            "binding": {
              "config": {
                "path": "session.props.theme"
              },
              "transforms": [
                {
                  "code": "\t\n\treturn kanoaScripts.colors.getCSSColor(\u0027--kcOnSurface\u0027, value)",
                  "type": "script"
                }
              ],
              "type": "property"
            }
          }
        },
        "props": {
          "colors": [
            "#117DBE",
            "#BF7611",
            "#BF11BF",
            "#4FBF11",
            "#2D536A",
            "#F16500",
            "#00DEF2",
            "#B5F200",
            "#A700F2",
            "#9D6034"
          ],
          "labels": {
            "bent": true,
            "inside": {
              "radius": 50
            },
            "showName": false,
            "showValue": false
          },
          "legend": {
            "fontSize": 11,
            "icon": {
              "height": 10,
              "width": 10
            },
            "position": "right"
          },
          "style": {
            "fontSize": 12,
            "fontWeight": "bold"
          },
          "tooltipFormat": "{category} : {value.value.formatNumber(\u0027#.0\u0027)} mins ({value.percent.formatNumber(\u0027#.0\u0027)}%)",
          "valueFormat": {
            "showValueAsPercent": false
          }
        },
        "type": "ia.chart.pie"
      }
    ],
    "meta": {
      "domId": "root",
      "name": "root"
    },
    "props": {
      "direction": "column",
      "style": {
        "minHeight": "100px",
        "overflow": "hidden"
      }
    },
    "type": "ia.container.flex"
  }
}