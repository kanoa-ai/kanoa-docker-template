              "overlayOptOut": true,
              "transforms": [
                {
                  "code": "\n\tif value[\u0027userName\u0027] is None or value[\u0027assetId\u0027] is None or value[\u0027startDate\u0027] is None or value[\u0027endDate\u0027] is None: return system.dataset.toDataSet([], [])\n\t\n\tuserId \u003d system.kanoa.security.getIDPUserId({\u0027userName\u0027: value[\u0027userName\u0027]})\n\n\tdata \u003d system.kanoa.operators.getOLEOperatorAssetBreakdown(userId, value[\u0027assetId\u0027], value[\u0027startDate\u0027], value[\u0027endDate\u0027], value[\u0027attributionMode\u0027] or \u0027EvenSplit\u0027)\n\n\theaders \u003d [\u0027assetName\u0027, \u0027assetPath\u0027, \u0027attendance\u0027, \u0027ole\u0027, \u0027pole\u0027, \u0027performance\u0027, \u0027quality\u0027]\n\trows \u003d []\n\tfor row in system.dataset.toPyDataSet(data):\n\t\tscheduledSecs \u003d row[\u0027scheduledSecs\u0027] or 0\n\t\tattendance \u003d ((row[\u0027loggedInSecs\u0027] or 0) / float(scheduledSecs) * 100) if scheduledSecs \u003e 0 else 0\n\t\trows.append([\n\t\t\trow[\u0027assetName\u0027],\n\t\t\trow[\u0027assetPath\u0027],\n\t\t\t\u0027%d%%\u0027 % round(attendance),\n\t\t\t\u0027%d%%\u0027 % round((row[\u0027ole\u0027] or 0) * 100),\n\t\t\t\u0027%d%%\u0027 % round((row[\u0027pole\u0027] or 0) * 100),\n\t\t\t\u0027%d%%\u0027 % round((row[\u0027performance\u0027] or 0) * 100),\n\t\t\t\u0027%d%%\u0027 % round((row[\u0027quality\u0027] or 0) * 100)\n\t\t])\n\n\treturn system.dataset.toDataSet(headers, rows)\n\t",
                  "type": "script"
                }
              ],
              "type": "property"
            }
          }
