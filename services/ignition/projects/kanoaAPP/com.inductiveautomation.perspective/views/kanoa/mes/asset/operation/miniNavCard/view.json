{
  "custom": {}, 
  "params": {
    "value": {
      "title": "Title", 
      "subTitle": "Subtitle", 
      "iconPath": "material/insert_emoticon"
    }
  }, 
  "props": {
    "defaultSize": {
      "width": 360, 
      "height": 80
    }
  }, 
  "root": {
    "type": "ia.container.flex", 
    "props": {
      "alignItems": "center", 
      "justify": "space-between", 
      "style": {
        "classes": "kanoa/clickable kanoa/container", 
        "overflow": "hidden"
      }
    }, 
    "children": [
      {
        "type": "ia.container.flex", 
        "props": {
          "justify": "center", 
          "style": {
            "margin": "8px 12px", 
            "gap": 2, 
            "minWidth": 0, 
            "overflow": "hidden"
          }, 
          "direction": "column"
        }, 
        "children": [
          {
            "type": "ia.display.label", 
            "props": {
              "textStyle": {
                "classes": "kanoa/font/titleMedium", 
                "whiteSpace": "nowrap", 
                "overflow": "hidden", 
                "textOverflow": "ellipsis"
              }, 
              "style": {
                "overflow": "hidden"
              }
            }, 
            "meta": {
              "domId": "lblTitle", 
              "name": "lblTitle", 
              "tooltip": {
                "enabled": true, 
                "delay": 500
              }
            }, 
            "position": {
              "shrink": 0
            }, 
            "propConfig": {
              "props.text": {
                "binding": {
                  "type": "property", 
                  "config": {
                    "path": "view.params.value.title"
                  }
                }
              }, 
              "meta.tooltip.text": {
                "binding": {
                  "type": "property", 
                  "config": {
                    "path": "view.params.value.title"
                  }
                }
              }
            }
          }, 
          {
            "type": "ia.display.label", 
            "props": {
              "textStyle": {
                "classes": "kanoa/font/bodySmall", 
                "display": "-webkit-box", 
                "WebkitLineClamp": 2, 
                "WebkitBoxOrient": "vertical", 
                "overflow": "hidden", 
                "overflowWrap": "anywhere", 
                "lineHeight": "1.25"
              }, 
              "style": {
                "overflow": "hidden"
              }
            }, 
            "meta": {
              "domId": "lblSubtitle", 
              "name": "lblSubtitle", 
              "tooltip": {
                "enabled": true, 
                "delay": 500
              }
            }, 
            "position": {
              "shrink": 1
            }, 
            "propConfig": {
              "props.text": {
                "binding": {
                  "type": "property", 
                  "config": {
                    "path": "view.params.value.subTitle"
                  }
                }
              }, 
              "meta.tooltip.text": {
                "binding": {
                  "type": "property", 
                  "config": {
                    "path": "view.params.value.subTitle"
                  }
                }
              }
            }
          }
        ], 
        "meta": {
          "domId": "flxLabel", 
          "name": "flxLabel"
        }, 
        "position": {
          "grow": 1, 
          "basis": "280px"
        }
      }, 
      {
        "type": "ia.container.flex", 
        "props": {
          "alignItems": "center", 
          "justify": "center", 
          "style": {
            "background": "--kcPrimaryContainer"
          }
        }, 
        "children": [
          {
            "type": "ia.display.icon", 
            "props": {
              "style": {
                "padding": "10px", 
                "color": "--kcOnPrimaryContainer"
              }
            }, 
            "meta": {
              "domId": "icon", 
              "name": "icon"
            }, 
            "position": {
              "grow": 1, 
              "shrink": 0, 
              "basis": "30px"
            }, 
            "propConfig": {
              "props.path": {
                "binding": {
                  "type": "property", 
                  "config": {
                    "path": "view.params.value.iconPath"
                  }
                }
              }
            }
          }
        ], 
        "meta": {
          "domId": "flxIcon", 
          "name": "flxIcon"
        }, 
        "position": {
          "shrink": 0, 
          "basis": "80px"
        }
      }
    ], 
    "meta": {
      "domId": "root", 
      "name": "root"
    }
  }, 
  "propConfig": {
    "params.value": {
      "paramDirection": "input", 
      "persistent": true
    }
  }
}