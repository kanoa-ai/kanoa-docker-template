  "propConfig": {
    "custom.assetInfo": {
      "binding": {
        "config": {
          "path": "view.params.values.linePath"
        },
        "overlayOptOut": true,
        "transforms": [
          {
            "code": "\t\n\tassetPath \u003d value or None\n\tassetInfo \u003d system.kanoa.utilities.convertDatasetRowToJSON(system.kanoa.asset.getAssets({\u0027assetPath\u0027:assetPath or \u0027None\u0027}), 0)\n\tif assetPath:\n\t\ttimezones \u003d system.kanoa.date.getAssetTimeZoneInfo(assetPath)\n\t\ttimezone \u003d timezones[assetPath][\u0027timeZone\u0027] if timezones.has_key(assetPath) else \u0027UTC\u0027\n\telse:\n\t\ttimezone \u003d \u0027UTC\u0027\n\t\n\tassetInfo[\u0027timeZone\u0027] \u003d timezone\n\t\n\treturn assetInfo\t",
            "type": "script"
          }
        ],
        "type": "property"
      },
      "persistent": true
    },
    "custom.info": {
      "persistent": true
    },
    "custom.mesTagProvider": {
      "binding": {
        "config": {
          "expression": "now(0)"
        },
        "transforms": [
          {
            "code": "\treturn system.kanoa.config.getTagProvider(\u0027Core\u0027)",
            "type": "script"
          }
        ],
        "type": "expr"
      },
      "persistent": true
    },
    "custom.scheduleData": {
      "binding": {
        "config": {
          "struct": {
            "assetInfo": "{view.custom.assetInfo}",
            "scheduleEvents": "{view.custom.scheduleEvents}"
          },
          "waitOnAll": true
        },
        "overlayOptOut": true,
        "transforms": [
          {
            "code": "\n\tassetId \u003d value[\u0027assetInfo\u0027][\u0027assetId\u0027] if value[\u0027assetInfo\u0027] else None\n\tif assetId is None: return []\n\tif value[\u0027scheduleEvents\u0027] is None or value[\u0027scheduleEvents\u0027].rowCount \u003d\u003d 0: return []\n\t\n\tself.custom.info \u003d {\"showBar\": True, \"text\": \"Checking schedule for %s\"%value[\u0027assetInfo\u0027][\u0027assetName\u0027], \"type\": \"INFO\"}\n\ttry:\n\t\tdata \u003d system.dataset.sort(value[\u0027scheduleEvents\u0027], \u0027startDate\u0027, False)\n\t\tdata \u003d system.dataset.toPyDataSet(data)\n\t\tdeleteRows \u003d [i for i, row in enumerate(data) if row[\u0027assetId\u0027] !\u003d value[\u0027assetInfo\u0027][\u0027assetId\u0027]]\n\t\tdata \u003d system.dataset.deleteRows(data, deleteRows)\t\n\t\tdata \u003d system.dataset.sort(data, \u0027startDate\u0027, False)\t\n\t\tdata \u003d system.kanoa.utilities.convertDatasetToJSON(data)\n\t\t\n\t\tworkOrderIdList \u003d list(set([row[\u0027workOrderId\u0027] for row in data if row[\u0027workOrderId\u0027]]))\n\t\tif len(workOrderIdList) \u003e 0: \n\t\t\tworkOrderData \u003d system.kanoa.utilities.convertDatasetToDict(system.kanoa.order.getProductionOrders({\u0027workOrderIdList\u0027: workOrderIdList, \u0027ignoreActualQty\u0027: False}), \u0027workOrderId\u0027, None)\n\t\t\n\t\trows \u003d []\n\t\t\n\t\tfor row in data:\n\t\t\tif row[\u0027assetId\u0027] !\u003d value[\u0027assetInfo\u0027][\u0027assetId\u0027]: continue\n\t\t\tif row[\u0027workOrderId\u0027] and not workOrderData[row[\u0027workOrderId\u0027]][\u0027canExecute\u0027]: continue\n\t\t\t\n\t\t\trow[\"enableSelector\"] \u003d self.params.values.enableSelector\n\t\t\trow[\u0027timezone\u0027] \u003d value[\u0027assetInfo\u0027][\u0027timeZone\u0027]\n\t\t\trow[\u0027startDate\u0027] \u003d system.date.addMinutes(row[\u0027startDate\u0027], system.kanoa.date.getTimeZoneOffsetMins(row[\u0027timezone\u0027], row[\u0027startDate\u0027]))\n\t\t\trow[\u0027endDate\u0027] \u003d system.date.addMinutes(row[\u0027endDate\u0027], system.kanoa.date.getTimeZoneOffsetMins(row[\u0027timezone\u0027], row[\u0027startDate\u0027]))\n\t\t\tif row[\u0027workOrderId\u0027]:\n\t\t\t\twoInfo \u003d workOrderData[row[\u0027workOrderId\u0027]]\n\t\t\t\trow[\"scheduleId\"] \u003d row[\u0027scheduleBlockId\u0027]\n\t\t\t\trow[\u0027actualQty\u0027] \u003d woInfo[\u0027actualQty\u0027]\n\t\t\t\trow[\u0027reqdQty\u0027] \u003d woInfo[\u0027reqdQty\u0027]\n\t\t\t\trow[\u0027% Complete\u0027] \u003d woInfo[\u0027reqdQty\u0027] or 0 / woInfo[\u0027actualQty\u0027] if (woInfo[\u0027actualQty\u0027] or 0) \u003e 0 else None\n\t\t\t\trow[\u0027itemUnitName\u0027] \u003d woInfo[\u0027itemUnitName\u0027]\n\t\t\t\trow[\u0027itemColor\u0027] \u003d woInfo[\u0027itemColor\u0027] or woInfo[\u0027itemClassColor\u0027]\n\t\t\t\trow[\u0027workOrderSourceImagePath\u0027] \u003d woInfo[\u0027workOrderSourceImagePath\u0027] if row[\u0027modeName\u0027] \u003d\u003d \u0027Production\u0027 else \u0027No image\u0027\n\t\t\t\trow[\u0027itemUnitName\u0027] \u003d woInfo[\u0027itemUnitName\u0027]\n\t\t\t\tif woInfo[\u0027dueDate\u0027]: row[\u0027dueDate\u0027] \u003d system.date.addMinutes(woInfo[\u0027dueDate\u0027], system.kanoa.date.getTimeZoneOffsetMins(row[\u0027timezone\u0027], woInfo[\u0027dueDate\u0027]))\n\t\t\t\trow[\u0027workOrderStatusName\u0027] \u003d woInfo[\u0027workOrderStatusName\u0027]\n\t\t\t\trow[\u0027statusColor\u0027] \u003d woInfo[\u0027statusColor\u0027]\n\t\t\t\trow[\u0027note\u0027] \u003d woInfo[\u0027note\u0027]\n\t\t\t\trow[\u0027canSchedule\u0027] \u003d woInfo[\u0027canSchedule\u0027]\n\t\t\t\trow[\u0027canExecute\u0027] \u003d woInfo[\u0027canExecute\u0027]\n\t\t\telse:\n\t\t\t\trow[\"scheduleId\"] \u003d row[\u0027scheduleBlockId\u0027]\n\t\t\t\trow[\u0027reqdQty\u0027] \u003d None\n\t\t\t\trow[\u0027actualQty\u0027] \u003d None\n\t\t\t\trow[\u0027% Complete\u0027] \u003d None\n\t\t\t\trow[\u0027itemUnitName\u0027] \u003d None\n\t\t\t\trow[\u0027workOrderSourceImagePath\u0027] \u003d None\n\t\t\t\trow[\u0027itemUnitName\u0027] \u003d None\n\t\t\t\trow[\u0027itemColor\u0027] \u003d None\n\t\t\t\trow[\u0027dueDate\u0027] \u003d None\n\t\t\t\trow[\u0027workOrderStatusName\u0027] \u003d None\n\t\t\t\trow[\u0027statusColor\u0027] \u003d None\n\t\t\t\trow[\u0027note\u0027] \u003d None\n\t\t\t\trow[\u0027canSchedule\u0027] \u003d False\n\t\t\t\trow[\u0027canExecute\u0027] \u003d False\n\t\t\t\n\t\t\trows.append(row)\n\texcept:\n\t\tpass\n\t\n\tself.custom.info \u003d {\"showBar\": False, \"text\": \"\", \"type\": \"INFO\"}\n\treturn rows",
            "type": "script"
          }
        ],
        "type": "expr-struct"
      },
      "persistent": true
    },
