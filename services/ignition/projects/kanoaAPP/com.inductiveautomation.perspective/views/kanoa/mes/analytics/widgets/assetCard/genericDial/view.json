{
  "custom": {},
  "params": {
    "label": "OEE",
    "fontSizeMultiplier": 4,
    "value": 0
  },
  "props": {
    "defaultSize": {
      "width": 247,
      "height": 211
    }
  },
  "root": {
    "type": "ia.container.flex",
    "props": {
      "style": {
        "overflow": "hidden"
      },
      "direction": "column"
    },
    "children": [
      {
        "type": "kanoa.ops.apexchart",
        "props": {
          "type": "radialBar",
          "series": [
            null
          ],
          "options": {
            "plotOptions": {
              "radialBar": {
                "startAngle": -140,
                "endAngle": 140,
                "hollow": {
                  "dropShadow": {
                    "enabled": false
                  },
                  "size": "60%"
                },
                "dataLabels": {
                  "name": {
                    "show": true,
                    "offsetY": 40,
                    "fontSize": "24px"
                  },
                  "value": {
                    "formatter": "function(val) { return Math.round(val); }",
                    "offsetY": -10,
                    "fontWeight": "bold"
                  }
                },
                "track": {
                  "strokeWidth": "97%",
                  "margin": 5,
                  "background": "var(--kcNeutral-50)"
                }
              }
            },
            "stroke": {
              "lineCap": "round"
            },
            "colors": [
              "function({ value, seriesIndex, w }) { \n     if (value < 50) return 'var(--kcBad)'    // Red\n     else if (value < 75) return 'var(--kcOK)'; // Yellow\n     else return 'var(--kcPrimary)';                // Green\n  }"
            ],
            "labels": [
              null
            ],
            "responsive": [
              {
                "breakpoint": 480,
                "options": {
                  "legend": {
                    "position": "bottom"
                  },
                  "chart": {
                    "width": 200
                  }
                }
              }
            ],
            "chart": {
              "type": "pie",
              "width": 380,
              "events": {
                "dataPointSelection": false,
                "beforeResetZoom": false,
                "markerClick": false,
                "mouseMove": false,
                "beforeMount": false,
                "dataPointMouseLeave": false,
                "scrolled": false,
                "click": false,
                "dataPointMouseEnter": false,
                "mounted": false,
                "mouseLeave": false,
                "xAxisLabelClick": false,
                "zoomed": false,
                "animationEnd": false,
                "brushScrolled": false,
                "legendClick": false,
                "selection": false,
                "beforeZoom": false,
                "updated": false
              }
            }
          },
          "style": {
            "overflow": "hidden"
          }
        },
        "meta": {
          "domId": "apexchart",
          "name": "apexchart"
        },
        "position": {
          "grow": 1
        },
        "propConfig": {
          "props.options.plotOptions.radialBar.dataLabels.value.color": {
            "binding": {
              "transforms": [
                {
                  "code": "\tif value < 50:\n\t    return 'var(--kcBad)'\n\telif value < 75:\n\t    return 'var(--kcOK)'\n\telse:\n\t    return 'var(--kcPrimary)'",
                  "type": "script"
                }
              ],
              "type": "property",
              "config": {
                "path": "this.props.series[0]"
              }
            }
          },
          "props.series[0]": {
            "binding": {
              "type": "property",
              "config": {
                "path": "view.params.value"
              }
            }
          },
          "props.options.plotOptions.radialBar.dataLabels.value.fontSize": {
            "binding": {
              "transforms": [
                {
                  "code": "\treturn \"{}vw\".format(value)",
                  "type": "script"
                }
              ],
              "type": "property",
              "overlayOptOut": true,
              "config": {
                "path": "view.params.fontSizeMultiplier"
              }
            }
          },
          "props.options.labels[0]": {
            "binding": {
              "type": "property",
              "config": {
                "path": "view.params.label"
              }
            }
          }
        }
      }
    ],
    "meta": {
      "domId": "root",
      "name": "root"
    }
  },
  "propConfig": {
    "params.label": {
      "paramDirection": "input",
      "persistent": true
    },
    "params.value": {
      "paramDirection": "input",
      "persistent": true
    },
    "params.fontSizeMultiplier": {
      "paramDirection": "input",
      "persistent": true
    }
  }
}