  "propConfig": {
    "custom.filter": {
      "binding": {
        "config": {
          "path": "view.params.values"
        },
        "overlayOptOut": true,
        "transforms": [
          {
            "code": "\n\tfilters \u003d system.kanoa.dashboard.getWidgetFilters(self.page.props.pageId, value, self.session.custom.kanoa, self.session.props.device.timezone.id)\n\tfilters[\u0027startDate\u0027] \u003d filters.get(\u0027dateRange\u0027,{}).get(\u0027startDate\u0027)\n\tfilters[\u0027endDate\u0027] \u003d filters.get(\u0027dateRange\u0027,{}).get(\u0027endDate\u0027)\n\tfilters.pop(\u0027dateRange\u0027)\n\t\n\treturn filters",
            "type": "script"
          }
        ],
        "type": "property"
      },
      "persistent": true
    },
    "custom.security": {
      "binding": {
        "config": {
          "path": "session.custom.kanoa.security"
        },
        "overlayOptOut": true,
        "type": "property"
      },
      "persistent": true
    },
    "custom.sessions": {
      "binding": {
        "config": {
          "path": "view.custom.filter"
        },
        "overlayOptOut": true,
        "transforms": [
          {
            "code": "\n\tif value is None or value[\u0027assetPath\u0027] is None: return []\n\t\n\tdata \u003d system.kanoa.utilities.convertDatasetToJSON(system.kanoa.operators.getOperators({\u0027assetPath\u0027: value[\u0027assetPath\u0027], \u0027startDate\u0027: value[\u0027startDate\u0027], \u0027endDate\u0027: value[\u0027endDate\u0027]}))\n\t\n\tfor item in data:\n\t\tendDate \u003d item[\u0027endDate\u0027] or system.date.now()\n\t\tstartDate \u003d item[\u0027startDate\u0027] if item[\u0027startDate\u0027] \u003e value[\u0027startDate\u0027] else value[\u0027startDate\u0027]\n\t\tendDate \u003d endDate if endDate \u003c value[\u0027endDate\u0027] else value[\u0027endDate\u0027]\n\t\titem[\u0027durationSecs\u0027] \u003d system.date.secondsBetween(startDate, endDate)\n\t\n\treturn data",
            "type": "script"
          }
        ],
        "type": "property"
      },
      "persistent": true
    },
    "custom.userAction": {
      "binding": {
        "config": {
          "struct": {
            "filter": "{view.custom.filter}",
            "security": "{view.custom.security}"
          },
          "waitOnAll": true
        },
        "overlayOptOut": true,
        "transforms": [
          {
            "code": "\n\tsecurity \u003d value[\u0027security\u0027]\n\tcanCreate \u003d False\n\tcanEdit \u003d False\n\tcanDelete \u003d False\n\tif security[\u0027userCRUD\u0027] is not None and security[\u0027userId\u0027] is not None:\n\t\tif security[\u0027userCRUD\u0027][\u0027isGatewayAdmin\u0027] or security[\u0027userCRUD\u0027][\u0027scheduleOperations\u0027][\u0027enabled\u0027]:\n\t\t\toeeEnabled \u003d system.kanoa.utilities.getFieldValue(\u0027oeeEnabled\u0027, system.kanoa.asset.getAssets({\u0027assetPath\u0027: value[\u0027filter\u0027][\u0027assetPath\u0027] or \u0027none\u0027}))\n\t\t\tif oeeEnabled: canCreate \u003d True\n\t\n\treturn {\"canCreate\": canCreate, \"canDelete\": canDelete, \"canRead\": True, \"canUpdate\": canEdit}",
            "type": "script"
          }
        ],
        "type": "expr-struct"
      },
      "persistent": true
    },
    "params.values": {
      "paramDirection": "input",
      "persistent": true
    }
  },
