{
  "custom": {
    "instances": [],
    "userId": null
  },
  "params": {
    "value": {
      "assetId": null,
      "assetName": "",
      "assetPath": "",
      "openOperation": false,
      "showRoot": false
    }
  },
  "propConfig": {
    "custom.instances": {
      "binding": {
        "config": {
          "struct": {
            "params": "{view.params.value}",
            "userId": "{view.custom.userId}"
          },
          "waitOnAll": false
        },
        "overlayOptOut": true,
        "transforms": [
          {
            "code": "\n\t# The assets under the selected one (the enterprises with none) that this user may see, from one lookup. One that\n\t# isn\u0027t OEE-enabled and has nothing under it leads nowhere, so it\u0027s left out (868mwap0a)\n\tparams \u003d value[\u0027params\u0027] or {}\n\tif params.get(\u0027assetId\u0027) is None and not params.get(\u0027showRoot\u0027): return []\n\tdata \u003d system.kanoa.asset.getAssets({\u0027userId\u0027: value[\u0027userId\u0027]})\n\trows \u003d system.kanoa.utilities.convertDatasetToJSON(data) if data is not None else []\n\tcounts \u003d {}\n\tfor row in rows:\n\t\tcounts[row[\u0027parentId\u0027]] \u003d counts.get(row[\u0027parentId\u0027], 0) + 1\n\tinstances \u003d []\n\tfor row in rows:\n\t\tif row[\u0027parentId\u0027] !\u003d params.get(\u0027assetId\u0027): continue\n\t\trow[\u0027childCount\u0027] \u003d counts.get(row[\u0027assetId\u0027], 0)\n\t\tif not row[\u0027oeeEnabled\u0027] and row[\u0027childCount\u0027] \u003d\u003d 0: continue\n\t\trow[\u0027openOperation\u0027] \u003d bool(params.get(\u0027openOperation\u0027))\n\t\tinstances.append({\u0027value\u0027: row})\n\treturn instances",
            "type": "script"
          }
        ],
        "type": "expr-struct"
      }
    },
    "custom.userId": {
      "binding": {
        "config": {
          "path": "session.props.auth.user"
        },
        "overlayOptOut": true,
        "transforms": [
          {
            "code": "\n\treturn system.kanoa.security.getIDPUserId(value)",
            "type": "script"
          }
        ],
        "type": "property"
      }
    },
    "params.value": {
      "paramDirection": "input",
      "persistent": true
    }
  },
  "props": {
    "defaultSize": {
      "height": 600,
      "width": 1000
    }
  },
  "root": {
    "children": [
      {
        "children": [
          {
            "meta": {
              "domId": "lblHeading",
              "name": "lblHeading"
            },
            "position": {
              "shrink": 0
            },
            "propConfig": {
              "props.text": {
                "binding": {
                  "config": {
                    "path": "view.params.value.assetName"
                  },
                  "overlayOptOut": true,
                  "type": "property"
                }
              }
            },
            "props": {
              "textStyle": {
                "classes": "kanoa/font/titleLarge"
              }
            },
            "type": "ia.display.label"
          },
          {
            "events": {
              "component": {
                "onActionPerformed": {
                  "config": {
                    "script": "\n\t# One level up (to the enterprises from one, on kanoaTablet); Asset Operation follows the stored asset path (868mwap0a)\n\tpath \u003d self.view.params.value.assetPath or \u0027\u0027\n\tparent \u003d \u0027\\\\\u0027.join(path.split(\u0027\\\\\u0027)[:-1])\n\tsystem.kanoa.utilities.storeAssetPath(self, parent)\n\tsystem.perspective.sendMessage(\u0027assetNavSelection\u0027, payload\u003d{\u0027value\u0027: {\u0027assetPath\u0027: parent}})\n\treturn"
                  },
                  "scope": "G",
                  "type": "script"
                }
              }
            },
            "meta": {
              "domId": "btnUp",
              "name": "btnUp"
            },
            "position": {
              "shrink": 0
            },
            "propConfig": {
              "meta.visible": {
                "binding": {
                  "config": {
                    "struct": {
                      "path": "{view.params.value.assetPath}",
                      "root": "{view.params.value.showRoot}"
                    },
                    "waitOnAll": false
                  },
                  "overlayOptOut": true,
                  "transforms": [
                    {
                      "code": "\tpath \u003d value[\u0027path\u0027] or \u0027\u0027\n\treturn \u0027\\\\\u0027 in path or (bool(path) and bool(value[\u0027root\u0027]))",
                      "type": "script"
                    }
                  ],
                  "type": "expr-struct"
                }
              },
              "props.text": {
                "binding": {
                  "config": {
                    "struct": {
                      "locale": "{session.props.locale}",
                      "path": "{view.params.value.assetPath}"
                    },
                    "waitOnAll": false
                  },
                  "overlayOptOut": true,
                  "transforms": [
                    {
                      "code": "\n\tpath \u003d value[\u0027path\u0027]\n\tif not path: return \u0027\u0027\n\tif \u0027\\\\\u0027 not in path: return system.util.translate(\u0027Up to all enterprises\u0027, value[\u0027locale\u0027])\n\treturn system.util.translate(\u0027Up to %s\u0027, value[\u0027locale\u0027]) % path.split(\u0027\\\\\u0027)[-2]",
                      "type": "script"
                    }
                  ],
                  "type": "expr-struct"
                }
              }
            },
            "props": {
              "image": {
                "height": 18,
                "icon": {
                  "path": "material/arrow_upward"
                },
                "width": 18
              },
              "primary": false,
              "style": {
                "classes": "kanoa/button/outlined"
              }
            },
            "type": "ia.input.button"
          }
        ],
        "meta": {
          "domId": "flxHeader",
          "name": "flxHeader"
        },
        "position": {
          "shrink": 0
        },
        "propConfig": {
          "position.display": {
            "binding": {
              "config": {
                "path": "view.params.value.assetPath"
              },
              "overlayOptOut": true,
              "transforms": [
                {
                  "code": "\t# Nothing to show at the top (the enterprises on kanoaTablet) (868mwap0a)\n\treturn bool(value)",
                  "type": "script"
                }
              ],
              "type": "property"
            }
          }
        },
        "props": {
          "alignItems": "center",
          "style": {
            "gap": "16px",
            "padding": "4px 8px 8px 8px"
          }
        },
        "type": "ia.container.flex"
      },
      {
        "meta": {
          "domId": "lblEmpty",
          "name": "lblEmpty"
        },
        "position": {
          "shrink": 0
        },
        "propConfig": {
          "position.display": {
            "binding": {
              "config": {
                "path": "view.custom.instances"
              },
              "overlayOptOut": true,
              "transforms": [
                {
                  "code": "\treturn len(value or []) \u003d\u003d 0",
                  "type": "script"
                }
              ],
              "type": "property"
            }
          },
          "props.text": {
            "binding": {
              "config": {
                "path": "session.props.locale"
              },
              "overlayOptOut": true,
              "transforms": [
                {
                  "code": "\treturn system.util.translate(\u0027No assets under this one\u0027, value)",
                  "type": "script"
                }
              ],
              "type": "property"
            }
          }
        },
        "props": {
          "textStyle": {
            "classes": "kanoa/font/bodyMedium",
            "color": "var(--kcOnSurfaceVariant)",
            "padding": "8px"
          }
        },
        "type": "ia.display.label"
      },
      {
        "meta": {
          "domId": "rptAssets",
          "name": "rptAssets"
        },
        "position": {
          "basis": "0",
          "grow": 1
        },
        "propConfig": {
          "props.instances": {
            "binding": {
              "config": {
                "path": "view.custom.instances"
              },
              "overlayOptOut": true,
              "type": "property"
            }
          }
        },
        "props": {
          "alignContent": "flex-start",
          "alignItems": "flex-start",
          "elementPosition": {
            "basis": "340px",
            "grow": 0,
            "shrink": 0
          },
          "elementStyle": {
            "margin": "6px"
          },
          "justify": "flex-start",
          "path": "kanoa/mes/asset/operation/navigation/assetNavCard",
          "style": {
            "overflowY": "auto"
          },
          "useDefaultViewHeight": true,
          "useDefaultViewWidth": false,
          "wrap": "wrap"
        },
        "type": "ia.display.flex-repeater"
      }
    ],
    "meta": {
      "domId": "root",
      "name": "root"
    },
    "props": {
      "direction": "column",
      "style": {
        "padding": "8px"
      }
    },
    "type": "ia.container.flex"
  }
}