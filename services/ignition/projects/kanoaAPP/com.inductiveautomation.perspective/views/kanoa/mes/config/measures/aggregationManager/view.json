    "scripts": {
      "customMethods": [
        {
          "name": "clearSelection",
          "params": [],
          "script": "\n\tself.view.custom.aggregations.row \u003d None\n\tself.view.custom.aggregations.col \u003d None\n\t\n\treturn"
        },
        {
          "name": "openEditor",
          "params": [
            "measureAggregationId"
          ],
          "script": "\n\tsystem.perspective.openPopup(\u0027Aggregation Editor\u0027, \u0027kanoa/mes/config/measures/aggregationEditor\u0027, {\u0027value\u0027: {\u0027measureAggregationId\u0027: measureAggregationId}}, title\u003d \u0027Aggregation Editor\u0027, draggable\u003dTrue, showCloseIcon\u003dTrue)\n\tself.clearSelection()\n\t\n\treturn"
        },
        {
          "name": "delete",
          "params": [
            "aggregationInfo"
          ],
          "script": "\n\tsystem.perspective.print(\"deleteMeasure() called with %s\"%aggregationInfo)\n\tsuccess, msg \u003d system.kanoa.measures.deleteMeasureAggregation(aggregationInfo[\u0027measureAggregationId\u0027], self.view.custom.security.userId)\n\tif not success: system.perspective.sendMessage(\u0027showWarningToast\u0027, {\u0027message\u0027: \u0027Unable to delete record. %s\u0027%msg})\n\telse: system.perspective.sendMessage(\u0027showSuccessfulToast\u0027, {\u0027message\u0027: \u0027Record has been deleted.\u0027})\n\t\n\tself.clearSelection()\n\tself.view.refreshBinding(\"custom.aggregations.data\")\n\t\n\treturn"
        }
      ],
      "extensionFunctions": null,
      "messageHandlers": [
        {
          "messageType": "deleteAggregationMsg",
          "pageScope": true,
          "script": "\n\tsystem.perspective.print(\"deleteAggregationMsg msg rcvd with %s\"%payload)\t\n\tif payload[\u0027userInput\u0027] \u003d\u003d \u0027OK\u0027: self.delete(payload[\u0027inputPayload\u0027][\u0027aggregationInfo\u0027])\n\n\treturn",
          "sessionScope": false,
          "viewScope": false
        },
        {
          "messageType": "aggregationUpdated",
          "pageScope": true,
          "script": "\n\tself.view.refreshBinding(\"custom.aggregations.data\")\n\t\n\treturn",
          "sessionScope": false,
          "viewScope": false
        }
      ]
    },
    "type": "ia.container.flex"
  }
