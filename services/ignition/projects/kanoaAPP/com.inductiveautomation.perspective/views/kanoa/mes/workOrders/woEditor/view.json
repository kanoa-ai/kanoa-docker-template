    "scripts": {
      "customMethods": [
        {
          "name": "saveData",
          "params": [],
          "script": "\n\tinfo \u003d dict(self.view.custom.info)\n\tsystem.perspective.print(\"saveData() called with %s\"%info)\n\n\tif info[\u0027note\u0027] \u003d\u003d \u0027\u0027: info[\u0027note\u0027] \u003d None\n\tif info[\u0027workOrderTitle\u0027] \u003d\u003d \u0027\u0027: info[\u0027workOrderTitle\u0027] \u003d None\n\t\n\tuserId \u003d system.kanoa.security.getIDPUserId(self.session.props.auth.user)\n\t\n\ttry:\t#units dropdown allows custom options to be created. If it is not an int, then user has just created this unit\n\t\tint(info[\u0027itemUnitId\u0027])\n\texcept:\n\t\tif (info[\u0027itemUnitId\u0027] or None) is None: info[\u0027itemUnitId\u0027] \u003d None\t#No units given (e.g. a bulk edit leaving them as they are)\n\t\telse:\n\t\t\t#addItemUnit returns (itemUnitId, msg)\n\t\t\titemUnitId, msg \u003d system.kanoa.item.addItemUnit(info[\u0027itemUnitId\u0027], userId)\n\t\t\tif itemUnitId is None:\n\t\t\t\tself.toast({\u0027type\u0027: \u0027error\u0027, \u0027message\u0027: \u0027Couldn\\\u0027t add unit \"%s\": %s\u0027 % (info[\u0027itemUnitId\u0027], msg)})\n\t\t\t\treturn\n\t\t\tinfo[\u0027itemUnitId\u0027] \u003d itemUnitId\n\t\n\tif len(self.view.params.workOrders) \u003d\u003d 0:\t#Ths is a new WorkOrder\n\t\tif system.kanoa.utilities.getFieldValue(\u0027workOrderId\u0027, system.kanoa.order.getProductionOrders({\u0027workOrderName\u0027: info[\u0027workOrderName\u0027]})) is not None:\n\t\t\tsystem.perspective.print(\"A work order of this name already exists\")\n\t\t\tself.toast({\u0027type\u0027: \u0027warning\u0027, \u0027message\u0027: \u0027An order with this name already exists\u0027})\n\t\t\treturn\n\t\n\t\tworkOrderId \u003d system.kanoa.order.addProductionOrder(info, userId)\t\n\t\tsystem.perspective.print(\"addProductionOrder() returned %s\"%workOrderId)\n\t\tself.view.params.workOrders.append(workOrderId)\n\t\tself.toast({\u0027type\u0027: \u0027success\u0027, \u0027message\u0027: \u0027Order created\u0027})\n\telif len(self.view.params.workOrders) \u003d\u003d 1:\t#We are editing a single workOrder\n\t\tretVal \u003d system.kanoa.order.updateProductionOrder(info, userId)\n\t\tsystem.perspective.print(\"updateProductionOrder() returned %s\"%retVal)\n\t\tself.toast({\u0027type\u0027: \u0027success\u0027, \u0027message\u0027: \u0027Order updated\u0027})\n\telse:\t#This is a bulk workOrder update\n\t\tupdated \u003d set()\t#One toast for the bulk save, not one per field per order (868mvvzbz)\n\t\tfor k,v in info.items():\n\t\t\tif k in (\u0027dueDate\u0027, \u0027startDate\u0027, \u0027itemId\u0027, \u0027modeId\u0027, \u0027reqdQty\u0027, \u0027itemUnitId\u0027, \u0027workOrderStatusId\u0027, \u0027note\u0027, \u0027assetId\u0027):\n\t\t\t\tfor workOrderId in self.view.params.workOrders:\n\t\t\t\t\tif (v or None) is not None:\n\t\t\t\t\t\tretVal \u003d system.kanoa.order.updateProductionOrderField(workOrderId, k, v, userId)\n\t\t\t\t\t\tsystem.perspective.print(\"updateProductionOrderField() returned %s\"%retVal)\n\t\t\t\t\t\tupdated.add(workOrderId)\n\t\tif updated: self.toast({\u0027type\u0027: \u0027success\u0027, \u0027message\u0027: \u0027Updated %s orders\u0027%len(updated)})\n\n\timport time\n\ttime.sleep(1)\t#give a chance for the user to see the success popup\n\n\tsystem.perspective.sendMessage(\u0027workOrderUpdate\u0027, {\u0027dueDate\u0027: info[\u0027dueDate\u0027]})\n\treturn\t"
        },
        {
          "name": "toast",
          "params": [
            "params"
          ],
          "script": "\t\u0027\u0027\u0027One toast at a time on this view. The first one\u0027s id is kept; every later toast updates it while it\u0027s showing, and shows it again under\n\tthe same id once it has closed (a show with the id of a toast still showing is ignored, so the two never stack) (868mvvzbz).\u0027\u0027\u0027\n\tparams \u003d dict(params)\n\ttoastId \u003d self.view.custom.toastId\n\tif toastId:\n\t\tparams[\u0027id\u0027] \u003d toastId\n\t\tsystem.kanoa.toast.update(params)\n\t\tsystem.kanoa.toast.show(params)\n\telse:\n\t\tself.view.custom.toastId \u003d system.kanoa.toast.show(params)"
        }
      ],
      "extensionFunctions": null,
      "messageHandlers": [
        {
          "messageType": "woItemSelected",
          "pageScope": true,
          "script": "\n\tsystem.perspective.print(\"woItemSelected msg rcvd with %s\"%payload)\n\n\t# The selector also sends this when the view loads the order\u0027s item, so the asset is only re-checked on a change.\n\tpreviousItemId \u003d self.view.custom.info.itemId\n\n\tif len(payload[\u0027selection\u0027]) \u003e 0: \n\t\tself.view.custom.info.itemId \u003d payload[\u0027selection\u0027][0][\u0027value\u0027][\u0027itemId\u0027]\n\t\tself.view.custom.info.itemName \u003d payload[\u0027selection\u0027][0][\u0027value\u0027][\u0027itemName\u0027]\n\t\tself.view.custom.info.itemPath \u003d payload[\u0027selection\u0027][0][\u0027value\u0027][\u0027path\u0027]\n\t\tself.view.custom.info.itemColor \u003d payload[\u0027selection\u0027][0][\u0027value\u0027][\u0027itemColor\u0027]\n\telse:\n\t\tself.view.custom.info.itemId \u003d None\n\t\tself.view.custom.info.itemPath \u003d None\n\t\tself.view.custom.info.itemName \u003d None\n\t\tself.view.custom.info.itemColor \u003d None\n\t\n\tassetId \u003d self.view.custom.info.assetId\n\titemId \u003d self.view.custom.info.itemId\n\tif assetId is not None and itemId !\u003d previousItemId:\n\t\tlinks \u003d [] if itemId is None else system.kanoa.item.getAssetItems({\u0027itemId\u0027: itemId, \u0027assetId\u0027: assetId, \u0027includeTooling\u0027: True}) or []\n\t\tif not any(row[\u0027assetRateEnabled\u0027] for row in links):\n\t\t\tself.view.custom.info.assetId \u003d None\n\t\t\tself.view.custom.info.assetPath \u003d None\n\n\treturn",
          "sessionScope": false,
          "viewScope": false
        },
        {
          "messageType": "woAssetSelected",
          "pageScope": true,
          "script": "\n\t# The selector also sends this when the view loads the order\u0027s asset. A site/area node has no assetId, so it\u0027s ignored.\n\tselection \u003d payload[\u0027selection\u0027]\n\tif len(selection) \u003e 0:\n\t\tasset \u003d selection[0][\u0027value\u0027]\n\t\tif asset.get(\u0027assetId\u0027) is None: return\n\t\tself.view.custom.info.assetId \u003d asset[\u0027assetId\u0027]\n\t\tself.view.custom.info.assetPath \u003d asset[\u0027assetPath\u0027]\n\telse:\n\t\tself.view.custom.info.assetId \u003d None\n\t\tself.view.custom.info.assetPath \u003d None\n\treturn",
          "sessionScope": false,
          "viewScope": false
        }
      ]
    },
    "type": "ia.container.flex"
  }
}