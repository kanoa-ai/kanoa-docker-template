  "propConfig": {
    "custom.assetSelectorDisabled": {
      "binding": {
        "config": {
          "struct": {
            "assetId": "{view.custom.info.assetId}",
            "assets": "{view.custom.assets}",
            "itemId": "{view.custom.info.itemId}",
            "workOrders": "{view.params.workOrders}"
          },
          "waitOnAll": true
        },
        "overlayOptOut": true,
        "transforms": [
          {
            "code": "\n\tif value.itemId is None and len(value.workOrders) \u003c\u003d 1: return \u0027Select an item first\u0027\n\t# Stays enabled while the order has an asset, so it can still be cleared\n\tif value.assetId is None and (value.assets is None or value.assets.rowCount \u003d\u003d 0): return \u0027No asset can run this item\u0027\n\treturn None",
            "type": "script"
          }
        ],
        "type": "expr-struct"
      },
      "persistent": true
    },
    "custom.assets": {
      "binding": {
        "config": {
          "struct": {
            "assetId": "{view.custom.info.assetId}",
            "assetPath": "{view.custom.info.assetPath}",
            "itemId": "{view.custom.info.itemId}",
            "workOrders": "{view.params.workOrders}"
          },
          "waitOnAll": true
        },
        "overlayOptOut": true,
        "transforms": [
          {
            "code": "\n\t# Assets with an enabled asset-item link for the item (bulk edit, no item picked: for every selected order\u0027s item).\n\t# An asset already on the order that can\u0027t run the item (e.g. set from the ERP) is kept (canRun False), so a save doesn\u0027t drop it.\n\titemIds \u003d set()\n\tif value.itemId is not None:\n\t\titemIds.add(value.itemId)\n\telif len(value.workOrders) \u003e 1:\n\t\torders \u003d system.kanoa.order.getProductionOrders({\u0027workOrderIdList\u0027: list(value.workOrders)})\n\t\titemIds \u003d set(row[\u0027itemId\u0027] for row in (orders or []))\n\n\tassets \u003d None\n\tfor itemId in itemIds:\n\t\tlinks \u003d {}\n\t\tif itemId is not None:\n\t\t\tfor row in system.kanoa.item.getAssetItems({\u0027itemId\u0027: itemId, \u0027includeTooling\u0027: True}) or []:\n\t\t\t\tif row[\u0027assetRateEnabled\u0027]:\n\t\t\t\t\tlinks[row[\u0027assetId\u0027]] \u003d row[\u0027assetPath\u0027]\n\t\tassets \u003d links if assets is None else dict((k, p) for k, p in assets.items() if k in links)\n\tassets \u003d assets or {}\n\n\trows \u003d [[k, p, True] for k, p in assets.items() if p]\n\tif value.assetId is not None and value.assetId not in assets and value.assetPath:\n\t\trows.append([value.assetId, value.assetPath, False])\n\trows.sort(key\u003dlambda r: r[1].lower())\n\treturn system.dataset.toDataSet([\u0027assetId\u0027, \u0027assetPath\u0027, \u0027canRun\u0027], rows)",
            "type": "script"
          }
        ],
        "type": "expr-struct"
      },
      "persistent": true
    },
    "custom.info": {
      "binding": {
        "config": {
          "path": "view.params.workOrders"
        },
        "overlayOptOut": true,
        "transforms": [
          {
            "code": "\n\t#We\u0027ll only populate the fields if the user is editing a single work order, otherwise we\u0027ll set all fields to null\n\t#And only update those fields that have a value.\n\n\tworkOrderId \u003d value[0] if len(value) \u003d\u003d 1 else -1\n\twoInfo \u003d system.kanoa.utilities.convertDatasetRowToJSON(system.kanoa.order.getProductionOrders({\u0027workOrderId\u0027:workOrderId}), 0)\n\tif woInfo[\u0027note\u0027] is None: woInfo[\u0027note\u0027] \u003d \u0027\u0027\n\t#A new order starts Released (a bulk edit leaves each order\u0027s status as it is)\n\tif len(value) \u003d\u003d 0 and woInfo[\u0027workOrderStatusId\u0027] is None:\n\t\twoInfo[\u0027workOrderStatusId\u0027] \u003d system.kanoa.utilities.getFieldValue(\u0027workOrderStatusId\u0027, system.kanoa.order.getProductionOrderStates({\u0027workOrderStatusName\u0027: \u0027Released\u0027, \u0027enabled\u0027: True}))\n\n\t#A new order defaults to the Production mode (an existing order keeps its mode)\n\tif len(value) \u003d\u003d 0 and woInfo[\u0027modeId\u0027] is None:\n\t\tmodes \u003d system.kanoa.asset.getModes({\u0027modeName\u0027: \u0027Production\u0027, \u0027modeTypeName\u0027: \u0027Production\u0027, \u0027enabled\u0027: True})\n\t\tif modes is not None and modes.rowCount \u003e 0: woInfo[\u0027modeId\u0027] \u003d modes.getValueAt(0, \u0027modeId\u0027)\n\t\n\treturn woInfo",
            "type": "script"
          }
        ],
        "type": "property"
      },
      "persistent": true
    },
    "params.workOrders": {
      "paramDirection": "input",
      "persistent": true
    }
  },
