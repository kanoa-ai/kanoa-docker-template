  "propConfig": {
    "custom.assets": {
      "binding": {
        "config": {
          "path": "view.custom.sortedAssets"
        },
        "overlayOptOut": true,
        "transforms": [
          {
            "code": "\n\t#Only enabled OEE assets have status tags, in the kanoaMES provider at their asset path\n\tassetInfos \u003d [row[\u0027value\u0027][\u0027assetInfo\u0027] for row in value]\n\treturn [{\u0027assetId\u0027: info[\u0027assetId\u0027], \u0027name\u0027: info[\u0027assetName\u0027], \u0027eqPath\u0027: info[\u0027assetPath\u0027],\n\t\t\t\u0027statusPath\u0027: \u0027[kanoaMES]\u0027 + info[\u0027assetPath\u0027].replace(\u0027\\\\\u0027, \u0027/\u0027) + \u0027/OEE/Status\u0027}\n\t\t\tfor info in assetInfos if info.get(\u0027oeeEnabled\u0027) and info.get(\u0027enabled\u0027)]",
            "type": "script"
          }
        ],
        "type": "property"
      },
      "persistent": true
    },
    "custom.data": {
      "persistent": true
    },
    "custom.data.stateData": {
      "binding": {
        "config": {
          "path": "view.custom.live"
        },
        "transforms": [
          {
            "code": "\n\tstateData \u003d []\n\tfor asset in value:\n\t\tif asset[\u0027modeName\u0027] !\u003d \u0027Production\u0027: continue\n\t\t#A Production asset with no state yet is \"Unknown\" (868mvwg9e): a None name showed as the chart\u0027s \"series-3\"\n\t\tstateName \u003d asset[\u0027stateName\u0027] or \u0027Unknown\u0027\n\t\tstate \u003d next((state for state in stateData if state[\u0027stateName\u0027] \u003d\u003d stateName), None)\n\t\tif state is None:\n\t\t\tstateData.append({\u0027stateName\u0027: stateName, \u0027count\u0027: 1, \u0027stateColor\u0027: asset[\u0027stateColor\u0027], \u0027stateTypeColor\u0027: asset[\u0027stateTypeColor\u0027] or \u0027#9E9E9E\u0027})\n\t\telse:\n\t\t\tstate[\u0027count\u0027] +\u003d 1\n\treturn stateData",
            "type": "script"
          }
        ],
        "type": "property"
      }
    },
    "custom.live": {
      "binding": {
        "config": {
          "path": "/root/flxSummary/flxModes/flxRptModes.props.instances"
        },
        "overlayOptOut": true,
        "transforms": [
          {
            "code": "\n\treturn [dict(instance[\u0027live\u0027]) for instance in value if instance[\u0027live\u0027] and instance[\u0027live\u0027][\u0027assetId\u0027] is not None]",
            "type": "script"
          }
        ],
        "type": "property"
      }
    },
    "custom.oeeSummary": {
      "binding": {
        "config": {
          "struct": {
            "live": "{view.custom.live}",
            "minute": "now(60000)",
            "period": "{view.custom.selector.period}"
          },
          "waitOnAll": true
        },
        "overlayOptOut": true,
        "transforms": [
          {
            "code": "\n\timport java.lang\n\n\tperiod \u003d value[\u0027period\u0027]\n\tif period not in (\u0027Current Run\u0027, \u0027Current Shift\u0027):\n\t\treturn self.custom.oeeSummary\n\n\t#Each asset\u0027s current run (assets in Production) or current shift so far, from its kanoaMES OEE tags\n\tfields \u003d [\u0027runtimeSecs\u0027, \u0027unplannedDowntimeSecs\u0027, \u0027targetCount\u0027, \u0027infeedCount\u0027, \u0027outfeedCount\u0027, \u0027wasteCount\u0027]\n\tpaths \u003d []\n\tfor asset in value[\u0027live\u0027] or []:\n\t\tif period \u003d\u003d \u0027Current Run\u0027 and asset[\u0027modeName\u0027] !\u003d \u0027Production\u0027: continue\n\t\tfolder \u003d \u0027[kanoaMES]\u0027 + asset[\u0027eqPath\u0027].replace(\u0027\\\\\u0027, \u0027/\u0027) + \u0027/OEE/\u0027 + period + \u0027/\u0027\n\t\tpaths +\u003d [folder + field for field in fields]\n\ttry:\n\t\tvalues \u003d [qv.value for qv in system.tag.readBlocking(paths)] if paths else []\n\texcept java.lang.Exception, e:\n\t\tsystem.perspective.print(\"Java Error %s\" % (e.getMessage() or e))\n\t\treturn self.custom.oeeSummary\n\n\ttotals \u003d [0.0] * len(fields)\n\tfor i in range(len(values)):\n\t\ttotals[i % len(fields)] +\u003d values[i] or 0\n\truntimeSecs, unplannedDowntimeSecs, targetCount, infeedCount, outfeedCount, wasteCount \u003d totals\n\n\ttotalSecs \u003d runtimeSecs + unplannedDowntimeSecs\n\ta \u003d float(runtimeSecs) / totalSecs if totalSecs \u003e 0 else 0\n\t#As the gateway\u0027s OEE tags: no target is no performance\n\tp \u003d infeedCount / targetCount if targetCount \u003e 0.0 else 0.0\n\tq \u003d (infeedCount - wasteCount) / infeedCount if infeedCount \u003e 0.0 else 1.0\n\toee \u003d a * min(p,1) * q\n\t\n\tself.view.custom.selector.lastSelection \u003d value[\u0027period\u0027]\n\n\treturn {\u0027value\u0027: {\"name\": self.view.params.value.assetName, \"oee\": oee, \"a\": a, \"p\": p, \"q\": q, \"assetPath\": self.view.params.value.assetInfo.assetPath}}",
            "type": "script"
          }
        ],
        "type": "expr-struct"
      },
      "persistent": true
    },
    "custom.selector": {
      "persistent": true
    },
    "custom.selector.lastSelection": {
      "binding": {
        "config": {
          "expression": "now(0)"
        },
        "overlayOptOut": true,
        "transforms": [
          {
            "code": "\treturn None",
            "type": "script"
          }
        ],
        "type": "expr"
      }
    },
    "custom.selector.period": {
      "binding": {
        "config": {
          "expression": "now(0)"
        },
        "overlayOptOut": true,
        "transforms": [
          {
            "code": "\n\treturn \u0027Current Run\u0027",
            "type": "script"
          }
        ],
        "type": "expr"
      }
    },
    "custom.sortedAssets": {
      "binding": {
        "config": {
          "path": "view.params.value"
        },
        "overlayOptOut": true,
        "transforms": [
          {
            "code": "\n\tdef collectAssetInfo(node, result):\n\t\tfor key in node:\n\t\t\tif key \u003d\u003d \u0027assetInfo\u0027: continue\n\t\t\tchild \u003d node[key]\n\t\t\tif len(dict(child)) \u003d\u003d 1:\n\t\t\t\tresult.append(child[\u0027assetInfo\u0027])\n\t\t\telse:\n\t\t\t\tcollectAssetInfo(child, result)\n\n\tassetInfoList \u003d []\n\n\tassets \u003d sorted(value[\u0027assets\u0027], key\u003dlambda x: x[\u0027assetInfo\u0027][\u0027sortOrder\u0027])\t\n\tfor asset in assets: assetInfoList.append(asset[\u0027assetInfo\u0027])\n\n\tchildAssets \u003d sorted(value[\u0027childAssets\u0027], key\u003dlambda x: x[\u0027assetInfo\u0027][\u0027sortOrder\u0027])\t\n\tfor child in childAssets:\n\t\tcollectAssetInfo(child, assetInfoList)\n\t\n\treturn [{\"value\": {\"assetInfo\": item}} for item in assetInfoList]",
            "type": "script"
          }
        ],
        "type": "property"
      },
      "persistent": true
    },
    "params.value": {
      "paramDirection": "input",
      "persistent": true
    }
  },
