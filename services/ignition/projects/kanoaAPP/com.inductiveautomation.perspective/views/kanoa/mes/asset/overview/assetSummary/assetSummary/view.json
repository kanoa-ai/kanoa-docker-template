  "propConfig": {
    "custom.data": {
      "persistent": true
    },
    "custom.data.stateData": {
      "binding": {
        "config": {
          "path": "view.custom.tagInfo"
        },
        "transforms": [
          {
            "code": "\t\n\tif len(value) \u003e 0:\n\t\tstateNameList \u003d []\n\t\tstateData \u003d []\n\t\tfor asset in value:\n\t\t\tif asset is not None: \n\t\t\t\toeeVals \u003d asset[\u0027OEE\u0027]\n\t\t\t\tif oeeVals[\u0027modeName\u0027] \u003d\u003d \"Production\":\n\t\t\t\t\t if oeeVals[\u0027stateName\u0027] not in stateNameList:\n\t\t\t\t\t \tstateNameList.append(oeeVals[\u0027stateName\u0027])\n\t\t\t\t\t \tstateData.append({\u0027stateName\u0027: oeeVals[\u0027stateName\u0027], \u0027count\u0027: 1, \u0027stateColor\u0027: oeeVals[\u0027stateColor\u0027], \u0027stateTypeColor\u0027: oeeVals[\u0027stateTypeColor\u0027]})\n\t\t\t\t\t else:\n\t\t\t\t\t \tfor state in stateData:\n\t\t\t\t\t \t\tif state[\u0027stateName\u0027] \u003d\u003d oeeVals[\u0027stateName\u0027]:\n\t\t\t\t\t \t\t\tstate[\u0027count\u0027] +\u003d 1\n\t\treturn stateData\n\telse:\n\t\treturn []",
            "type": "script"
          }
        ],
        "type": "property"
      }
    },
    "custom.oeeSummary": {
      "binding": {
        "config": {
          "struct": {
            "period": "{view.custom.selector.period}",
            "tagInfo": "{view.custom.tagInfo}"
          },
          "waitOnAll": true
        },
        "overlayOptOut": true,
        "transforms": [
          {
            "code": "\n#\tsystem.perspective.print(\"OEE Summary binding change\")\n\t\n\truntimeSecs \u003d 0\n\tunplannedDowntimeSecs \u003d 0\n\ttargetCount \u003d 0.0\n\tinfeedCount \u003d 0.0\n\toutfeedCount \u003d 0.0\n\twasteCount \u003d 0.0\n\t\n\timport java.lang\n\t\n\tif value[\u0027period\u0027] \u003d\u003d \u0027Current Run\u0027:\n\t\ttagInfo \u003d (value or {}).get(\u0027tagInfo\u0027) or []\n\t\tfor tagValue in tagInfo:\n\t\t\ttry:\n\t\t\t\tif not tagValue: continue\n\t\t\n\t\t\t\toee \u003d tagValue.get(\u0027OEE\u0027) if hasattr(tagValue, \u0027get\u0027) else None\n\t\t\t\tif not oee:\n\t\t\t\t\tsystem.perspective.print(\"Missing OEE for %s\" % (tagValue.get(\u0027eqPath\u0027) if hasattr(tagValue, \u0027get\u0027) else \"unknown\"))\n\t\t\t\t\tcontinue\n\t\t\n\t\t\t\tif oee.get(\u0027modeName\u0027) \u003d\u003d \u0027Production\u0027:\n\t\t\t\t\truntimeSecs +\u003d oee.get(\u0027runtimeSecs\u0027) or 0\n\t\t\t\t\tunplannedDowntimeSecs +\u003d oee.get(\u0027unplannedDowntimeSecs\u0027) or 0\n\t\t\t\t\ttargetCount +\u003d oee.get(\u0027targetCount\u0027) or 0.0\n\t\t\t\t\tinfeedCount +\u003d oee.get(\u0027infeedCount\u0027) or 0.0\n\t\t\t\t\toutfeedCount +\u003d oee.get(\u0027outfeedCount\u0027) or 0.0\n\t\t\t\t\twasteCount +\u003d oee.get(\u0027wasteCount\u0027) or 0.0\n\t\t\texcept java.lang.Exception, e:\n\t\t\t\tsystem.perspective.print(\"Java Error %s\" % (e.getMessage() or e))\n\t\t\t\treturn self.props.params.value\n\t\t\texcept Exception as e:\n\t\t\t\tsystem.perspective.print(\"Error %s\" % e)\n\t\t\t\treturn self.props.params.value\n\t\n\telif value[\u0027period\u0027] \u003d\u003d \u0027Current Shift\u0027 and self.view.custom.selector.lastSelection !\u003d value[\u0027period\u0027]:\n\t\ttry:\n\t\t\tstartDate \u003d system.date.addDays(system.date.now(), -1)\n#\t\t\tendDate \u003d system.date.now()\n\t\t\tendDate \u003d None\t#jfc 4/9/26\n\t\t\tprodEvents \u003d system.kanoa.utilities.convertDatasetToJSON(system.kanoa.event.getAssetProductionEventsByShift({\u0027assetPath\u0027: self.view.params.value.assetInfo.assetPath + \u0027%\u0027, \u0027startDate\u0027: startDate, \u0027endDate\u0027: endDate}))\n\t\t\t\n\t\t\tlatestRecords \u003d list({r[\"assetPath\"]: r for r in sorted(prodEvents, key\u003dlambda r: (r[\"assetPath\"], r[\"shiftStart\"].getTime()))}.values())\n\t\t\tfor item in latestRecords:\n\t\t\t\tif item[\u0027modeName\u0027] !\u003d \u0027Production\u0027: continue\n\t\t\t\truntimeSecs +\u003d item[\u0027runtimeSecs\u0027] or 0\n\t\t\t\tunplannedDowntimeSecs +\u003d item[\u0027unplannedDowntimeSecs\u0027] or 0\n\t\t\t\ttargetCount +\u003d item[\u0027targetCount\u0027] or 0.0\n\t\t\t\tinfeedCount +\u003d item[\u0027infeedCount\u0027] or 0.0\n\t\t\t\toutfeedCount +\u003d item[\u0027outfeedCount\u0027] or 0.0\n\t\t\t\twasteCount +\u003d item[\u0027wasteCount\u0027] or 0.0\n\t\texcept java.lang.Exception, e:\n\t\t\tsystem.perspective.print(\"Error %s\"%e.cause)\n\t\t\treturn {\u0027value\u0027: {\"name\": self.view.params.value.assetName, \"oee\": 0, \"a\": 0, \"p\": 0, \"q\": 0, \"assetPath\": self.view.params.value.assetInfo.assetPath}}\n\t\texcept Exception as e:\n\t\t\tsystem.perspective.print(\"Error %s\"%e)\n\t\t\treturn {\u0027value\u0027: {\"name\": self.view.params.value.assetName, \"oee\": 0, \"a\": 0, \"p\": 0, \"q\": 0, \"assetPath\": self.view.params.value.assetInfo.assetPath}}\n\telse:\n\t\treturn self.custom.oeeSummary\n\n\ttotalSecs \u003d runtimeSecs + unplannedDowntimeSecs\n\ta \u003d float(runtimeSecs) / totalSecs if totalSecs \u003e 0 else 0\n\tp \u003d infeedCount / targetCount if targetCount \u003e 0.0 else 1.0\n\tq \u003d (infeedCount - wasteCount) / infeedCount if infeedCount \u003e 0.0 else 1.0\n\toee \u003d a * min(p,1) * q\n\t\n\tself.view.custom.selector.lastSelection \u003d value[\u0027period\u0027]\n\n\treturn {\u0027value\u0027: {\"name\": self.view.params.value.assetName, \"oee\": oee, \"a\": a, \"p\": p, \"q\": q, \"assetPath\": self.view.params.value.assetInfo.assetPath}}",
            "type": "script"
          }
        ],
        "type": "expr-struct"
      },
      "persistent": true
    },
    "custom.selector": {
      "persistent": true
    },
    "custom.selector.lastSelection": {
      "binding": {
        "config": {
          "expression": "now(0)"
        },
        "overlayOptOut": true,
        "transforms": [
          {
            "code": "\treturn None",
            "type": "script"
          }
        ],
        "type": "expr"
      }
    },
    "custom.selector.period": {
      "binding": {
        "config": {
          "expression": "now(0)"
        },
        "overlayOptOut": true,
        "transforms": [
          {
            "code": "\n\treturn \u0027Current Run\u0027",
            "type": "script"
          }
        ],
        "type": "expr"
      }
    },
    "custom.sortedAssets": {
      "binding": {
        "config": {
          "path": "view.params.value"
        },
        "overlayOptOut": true,
        "transforms": [
          {
            "code": "\n\tdef collectAssetInfo(node, result):\n\t\tfor key in node:\n\t\t\tif key \u003d\u003d \u0027assetInfo\u0027: continue\n\t\t\tchild \u003d node[key]\n\t\t\tif len(dict(child)) \u003d\u003d 1:\n\t\t\t\tresult.append(child[\u0027assetInfo\u0027])\n\t\t\telse:\n\t\t\t\tcollectAssetInfo(child, result)\n\n\tassetInfoList \u003d []\n\n\tassets \u003d sorted(value[\u0027assets\u0027], key\u003dlambda x: x[\u0027assetInfo\u0027][\u0027sortOrder\u0027])\t\n\tfor asset in assets: assetInfoList.append(asset[\u0027assetInfo\u0027])\n\n\tchildAssets \u003d sorted(value[\u0027childAssets\u0027], key\u003dlambda x: x[\u0027assetInfo\u0027][\u0027sortOrder\u0027])\t\n\tfor child in childAssets:\n\t\tcollectAssetInfo(child, assetInfoList)\n\t\n\treturn [{\"value\": {\"assetInfo\": item}} for item in assetInfoList]",
            "type": "script"
          }
        ],
        "type": "property"
      },
      "persistent": true
    },
    "custom.tagInfo": {
      "binding": {
        "config": {
          "path": "view.custom.sortedAssets"
        },
        "overlayOptOut": true,
        "transforms": [
          {
            "code": "\n\ttagInfoPathList \u003d []\n\tfor asset in value:\n\t\ttagPath \u003d asset[\u0027value\u0027][\u0027assetInfo\u0027][\u0027tagPath\u0027]\n\t\tif tagPath is not None:\ttagInfoPathList.append(tagPath +\u0027/Line\u0027)\n\n\tif len(tagInfoPathList) \u003d\u003d 0: return []\n\n\treturn system.tag.readBlocking(tagInfoPathList)",
            "type": "script"
          }
        ],
        "type": "property"
      },
      "persistent": true
    },
    "params.value": {
      "paramDirection": "input",
      "persistent": true
    }
  },
