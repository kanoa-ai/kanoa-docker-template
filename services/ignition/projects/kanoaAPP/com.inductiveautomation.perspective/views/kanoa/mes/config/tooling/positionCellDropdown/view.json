{
  "custom": {},
  "params": {
    "value": null,
    "rowData": {
      "rowKey": null
    },
    "field": "",
    "options": [],
    "msgHandler": "toolPositionCellEdit",
    "clearable": false,
    "placeholder": "Select...",
    "lockedType": "",
    "lockedText": ""
  },
  "propConfig": {
    "params.value": {
      "paramDirection": "input",
      "persistent": true
    },
    "params.rowData": {
      "paramDirection": "input",
      "persistent": true
    },
    "params.field": {
      "paramDirection": "input",
      "persistent": true
    },
    "params.options": {
      "paramDirection": "input",
      "persistent": true
    },
    "params.msgHandler": {
      "paramDirection": "input",
      "persistent": true
    },
    "params.clearable": {
      "paramDirection": "input",
      "persistent": true
    },
    "params.placeholder": {
      "paramDirection": "input",
      "persistent": true
    },
    "params.lockedType": {
      "paramDirection": "input",
      "persistent": true
    },
    "params.lockedText": {
      "paramDirection": "input",
      "persistent": true
    }
  },
  "props": {
    "defaultSize": {
      "height": 32,
      "width": 200
    }
  },
  "root": {
    "meta": {
      "name": "root"
    },
    "props": {
      "style": {
        "padding": "1px 2px"
      }
    },
    "type": "ia.container.flex",
    "children": [
      {
        "meta": {
          "name": "ddValue"
        },
        "position": {
          "grow": 1
        },
        "propConfig": {
          "props.value": {
            "binding": {
              "config": {
                "path": "view.params.value"
              },
              "overlayOptOut": true,
              "type": "property"
            },
            "onChange": {
              "enabled": null,
              "script": "\n\tif origin !\u003d \u0027Browser\u0027 or currentValue.value \u003d\u003d self.view.params.value: return\n\tp \u003d self.view.params\n\tsystem.perspective.sendMessage(p.msgHandler, {\u0027rowKey\u0027: p.rowData[\u0027rowKey\u0027], \u0027field\u0027: p.field, \u0027value\u0027: currentValue.value}, scope\u003d\u0027page\u0027)"
            }
          },
          "props.options": {
            "binding": {
              "config": {
                "path": "view.params.options"
              },
              "overlayOptOut": true,
              "type": "property"
            }
          },
          "props.showClearIcon": {
            "binding": {
              "config": {
                "struct": {
                  "type": "{view.params.rowData.positionType}",
                  "locked": "{view.params.lockedType}",
                  "clearable": "{view.params.clearable}"
                },
                "waitOnAll": true
              },
              "overlayOptOut": true,
              "transforms": [
                {
                  "code": "\n\treturn bool(value[\u0027clearable\u0027]) and not (value[\u0027locked\u0027] and value[\u0027type\u0027] \u003d\u003d value[\u0027locked\u0027])",
                  "type": "script"
                }
              ],
              "type": "expr-struct"
            }
          },
          "props.placeholder.text": {
            "binding": {
              "config": {
                "struct": {
                  "type": "{view.params.rowData.positionType}",
                  "locked": "{view.params.lockedType}",
                  "lockedText": "{view.params.lockedText}",
                  "placeholder": "{view.params.placeholder}"
                },
                "waitOnAll": true
              },
              "overlayOptOut": true,
              "transforms": [
                {
                  "code": "\n\treturn value[\u0027lockedText\u0027] if value[\u0027locked\u0027] and value[\u0027type\u0027] \u003d\u003d value[\u0027locked\u0027] else value[\u0027placeholder\u0027]",
                  "type": "script"
                }
              ],
              "type": "expr-struct"
            }
          },
          "props.enabled": {
            "binding": {
              "config": {
                "struct": {
                  "type": "{view.params.rowData.positionType}",
                  "locked": "{view.params.lockedType}"
                },
                "waitOnAll": true
              },
              "overlayOptOut": true,
              "transforms": [
                {
                  "code": "\n\treturn not value[\u0027locked\u0027] or value[\u0027type\u0027] !\u003d value[\u0027locked\u0027]",
                  "type": "script"
                }
              ],
              "type": "expr-struct"
            }
          }
        },
        "props": {
          "placeholder": {
            "text": "Select..."
          },
          "style": {
            "classes": "kanoa/font/default"
          }
        },
        "type": "ia.input.dropdown"
      }
    ]
  }
}