{
  "custom": {
    "currentState": null,
    "selected": null
  },
  "params": {
    "value": {
      "assetId": null,
      "statusPath": ""
    }
  },
  "propConfig": {
    "custom.currentState": {
      "binding": {
        "config": {
          "expression": "tag({view.params.value.statusPath} + '/stateName')"
        },
        "overlayOptOut": true,
        "type": "expr"
      }
    },
    "custom.selected": {
      "persistent": true
    },
    "params.value": {
      "paramDirection": "input",
      "persistent": true
    }
  },
  "props": {
    "defaultSize": {
      "height": 540,
      "width": 380
    }
  },
  "root": {
    "children": [
      {
        "meta": {
          "name": "lblCurrent"
        },
        "position": {
          "shrink": 0
        },
        "props": {
          "style": {
            "classes": "kanoa/font/default",
            "whiteSpace": "normal"
          },
          "text": ""
        },
        "type": "ia.display.label",
        "propConfig": {
          "props.text": {
            "binding": {
              "config": {
                "path": "view.custom.currentState"
              },
              "overlayOptOut": true,
              "type": "property",
              "transforms": [
                {
                  "code": "\treturn system.util.translate('Current state', self.session.props.locale) + ': %s' % (value or 'Unknown')",
                  "type": "script"
                }
              ]
            }
          }
        }
      },
      {
        "meta": {
          "name": "evStateTree"
        },
        "position": {
          "basis": "200px",
          "grow": 1
        },
        "propConfig": {
          "props.path": {
            "binding": {
              "config": {
                "expression": "if(isNull({this.props.params.values.data}), \u0027\u0027, \u0027kanoa/core/templates/selectors/tree/treeSelector\u0027)"
              },
              "type": "expr"
            }
          },
          "props.params.values.data": {
            "binding": {
              "config": {
                "path": "view.params.value.assetId"
              },
              "overlayOptOut": true,
              "type": "property",
              "transforms": [
                {
                  "code": "\n\t#The states an operator can pick for this asset, in their categories\n\theaders = ['stateId', 'stateName', 'statePath', 'stateCode', 'stateTypeName', 'iconPath', 'iconColor']\n\tif value is None: return system.dataset.toDataSet(headers, [])\n\trows = []\n\tfor row in system.kanoa.utilities.convertDatasetToJSON(system.kanoa.asset.getAssetStates({'assetId': value, 'enabled': True, 'selectable': True})):\n\t\trows.append([row['stateId'], row['stateName'], row['statePath'] or row['stateName'], row['stateCode'], row['stateTypeName'], row['iconPath'], row['stateColor'] or row['stateTypeColor']])\n\treturn system.dataset.toDataSet(headers, rows)",
                  "type": "script"
                }
              ]
            }
          }
        },
        "props": {
          "params": {
            "refresh": false,
            "values": {
              "msgHandler": "assetStateSelected",
              "options": {
                "dragDrop": {
                  "enabled": false,
                  "msgHandler": ""
                },
                "expand": true,
                "multiSelect": false,
                "selectable": []
              },
              "selection": [],
              "style": {
                "backgroundColor": "",
                "icoPath": null,
                "iconColor": ""
              },
              "treePath": "statePath"
            }
          },
          "path": "kanoa/core/templates/selectors/tree/treeSelector",
          "style": {
            "classes": "kanoa/border"
          }
        },
        "type": "ia.display.view"
      },
      {
        "meta": {
          "name": "lblNone"
        },
        "position": {
          "shrink": 0
        },
        "props": {
          "style": {
            "classes": "kanoa/font/default",
            "whiteSpace": "normal"
          },
          "text": "No states can be set on this asset: link them, and make them selectable, in Configuration > Ops > States"
        },
        "type": "ia.display.label",
        "propConfig": {
          "position.display": {
            "binding": {
              "config": {
                "path": "../evStateTree.props.params.values.data"
              },
              "overlayOptOut": true,
              "type": "property",
              "transforms": [
                {
                  "code": "\treturn value is not None and value.getRowCount() == 0",
                  "type": "script"
                }
              ]
            }
          }
        }
      },
      {
        "meta": {
          "name": "flxActions"
        },
        "position": {
          "shrink": 0
        },
        "props": {
          "justify": "center",
          "style": {
            "gap": 5,
            "overflow": "hidden",
            "padding": "5px"
          }
        },
        "type": "ia.container.flex",
        "children": [
          {
            "events": {
              "component": {
                "onActionPerformed": {
                  "config": {
                    "script": "\n\tself.view.getChild('root').setState(self.view.custom.selected)\n\treturn"
                  },
                  "scope": "G",
                  "type": "script"
                }
              }
            },
            "meta": {
              "name": "btnSet"
            },
            "position": {
              "shrink": 0
            },
            "props": {
              "image": {
                "icon": {
                  "path": "material/published_with_changes"
                }
              },
              "style": {
                "classes": "kanoa/button/filled"
              },
              "text": "Set State"
            },
            "type": "ia.input.button",
            "propConfig": {
              "props.enabled": {
                "binding": {
                  "config": {
                    "struct": {
                      "selected": "{view.custom.selected}",
                      "currentState": "{view.custom.currentState}"
                    },
                    "waitOnAll": false
                  },
                  "overlayOptOut": true,
                  "type": "expr-struct",
                  "transforms": [
                    {
                      "code": "\n\tselected = value['selected']\n\treturn bool(selected) and selected.get('stateName') != value['currentState']",
                      "type": "script"
                    }
                  ]
                }
              }
            }
          },
          {
            "events": {
              "component": {
                "onActionPerformed": {
                  "config": {
                    "script": "\n\tsystem.perspective.closePopup('assetStateSelector')\n\treturn"
                  },
                  "scope": "G",
                  "type": "script"
                }
              }
            },
            "meta": {
              "name": "btnClose"
            },
            "position": {
              "shrink": 0
            },
            "props": {
              "image": {
                "icon": {
                  "path": "material/exit_to_app"
                }
              },
              "style": {
                "classes": "kanoa/button/outlined"
              },
              "text": "Close"
            },
            "type": "ia.input.button"
          }
        ]
      }
    ],
    "meta": {
      "name": "root"
    },
    "props": {
      "direction": "column",
      "style": {
        "classes": "kanoa/popup",
        "gap": 5,
        "overflow": "hidden",
        "padding": 5
      }
    },
    "scripts": {
      "customMethods": [
        {
          "name": "setState",
          "params": [
            "state"
          ],
          "script": "\n\t# The same state event the cell card's state buttons add; the OEE tags pick it up on the refresh\n\tif not state or state.get('stateCode') is None or state.get('stateName') == self.view.custom.currentState: return\n\tassetId = self.view.params.value.assetId\n\tuserId = system.kanoa.security.getIDPUserId(self.session.props.auth.user)\n\tstateInfo = {'assetId': assetId, 'assetStateId': assetId, 'stateCode': state['stateCode'], 'tStamp': system.date.now(), 'note': None}\n\tstateEventId = system.kanoa.event.addStateEvent(stateInfo, userId)\n\tif stateEventId is None or isinstance(stateEventId, tuple):\n\t\tmsg = stateEventId[1] if stateEventId else None\n\t\tsystem.kanoa.toast.show({'type': 'error', 'message': 'Could not set the state to %s. %s' % (state['stateName'], msg or '')})\n\t\treturn\n\tsystem.kanoa.event.refreshOEETags(assetId)\n\tsystem.kanoa.toast.show({'type': 'success', 'message': 'State set to %s' % state['stateName']})\n\tsystem.perspective.closePopup('assetStateSelector')\n\treturn"
        }
      ],
      "extensionFunctions": null,
      "messageHandlers": [
        {
          "messageType": "updatePopupSelection",
          "pageScope": true,
          "script": "\n\tif payload.get('msgHandler') != 'assetStateSelected': return\n\t#A category isn't a state: only a leaf can be set\n\tselection = payload['selection'][0]['value'] if payload['selection'] else None\n\tself.view.custom.selected = dict(selection) if selection and selection.get('stateCode') is not None else None\n\treturn",
          "sessionScope": false,
          "viewScope": false
        },
        {
          "messageType": "doubleClick",
          "pageScope": true,
          "script": "\n\tif payload.get('msgHandler') != 'assetStateSelected' or not payload['selection']: return\n\tself.setState(payload['selection'][0]['value'])\n\treturn",
          "sessionScope": false,
          "viewScope": false
        }
      ]
    },
    "type": "ia.container.flex"
  }
}