  "propConfig": {
    "custom.display": {
      "persistent": true
    },
    "custom.display.durationSecs": {
      "binding": {
        "config": {
          "path": "view.params.value"
        },
        "overlayOptOut": true,
        "transforms": [
          {
            "code": "\n\tif value[\u0027endDate\u0027]:\n\t\tdurationSecs \u003d value[\u0027durationSecs\u0027]\n\telse:\n\t\tstartDate \u003d value[\u0027startDate\u0027] if value[\u0027startDate\u0027] \u003e value[\u0027rangeStart\u0027] else value[\u0027rangeStart\u0027]\n\t\tendDate \u003d system.date.now() if system.date.now() \u003c value[\u0027rangeEnd\u0027] else value[\u0027rangeEnd\u0027]\n\t\tdurationSecs \u003d system.date.secondsBetween(startDate, endDate)\n\n\ttry:\n\t\tint(durationSecs)\n\t\tif (durationSecs or 0) \u003c\u003d 0: return \u0027\u0027\n\t\tif durationSecs \u003c\u003d 60: return \u0027\u003c 1 min\u0027\n\t\treturn system.kanoa.utilities.secondsToText(durationSecs, {\u0027showDays\u0027: False, \u0027showSecs\u0027: False, \u0027roundUp\u0027: True})\n\texcept:\n\t\treturn durationSecs",
            "type": "script"
          }
        ],
        "type": "property"
      }
    },
    "custom.display.updateTimer": {
      "binding": {
        "config": {
          "expression": "now(60000)"
        },
        "overlayOptOut": true,
        "transforms": [
          {
            "code": "\t\n\t#If there is no end date, i.e. operator is still badged in, we will update the durationSecs\n\tif self.params.value.endDate: return\n\tif system.date.now() \u003e self.params.value.rangeEnd: return\n\t\n\tself.refreshBinding(\"custom.display.durationSecs\")\n\t\t\n\treturn value\n",
            "type": "script"
          }
        ],
        "type": "expr"
      }
    },
    "custom.security": {
      "binding": {
        "config": {
          "struct": {
            "user": "{session.props.auth.user}"
          },
          "waitOnAll": false
        },
        "overlayOptOut": true,
        "transforms": [
          {
            "code": "\n\tsecConfig \u003d system.kanoa.utilities.convertDatasetToDict(system.kanoa.security.getConfig({}), \u0027configName\u0027, \u0027configValue\u0027)\n\tuserId \u003d system.kanoa.security.getIDPUserId(value[\u0027user\u0027])\n\tuserCRUD \u003d system.kanoa.security.getUserAssetCRUD(userId)\n\t\n\treturn {\"userId\": userId, \"config\": secConfig, \"userCRUD\": userCRUD}",
            "type": "script"
          }
        ],
        "type": "expr-struct"
      },
      "persistent": true
    },
    "custom.userAction": {
      "binding": {
        "config": {
          "struct": {
            "security": "{view.custom.security}"
          },
          "waitOnAll": true
        },
        "overlayOptOut": true,
        "transforms": [
          {
            "code": "\n\tsecurity \u003d value[\u0027security\u0027]\n\tcanCreate \u003d False\n\tcanEdit \u003d False\n\tif security[\u0027userCRUD\u0027] is not None and security[\u0027userId\u0027] is not None:\n\t\tif security[\u0027userCRUD\u0027][\u0027isGatewayAdmin\u0027] or security[\u0027userCRUD\u0027][\u0027editOperations\u0027][\u0027enabled\u0027]: \n\t\t\tcanCreate \u003d True \n\t\t\tcanEdit \u003d True\n\t\n\treturn {\"canCreate\": canCreate, \"canDelete\": canEdit, \"canRead\": True, \"canUpdate\": canEdit}",
            "type": "script"
          }
        ],
        "type": "expr-struct"
      },
      "persistent": true
    },
