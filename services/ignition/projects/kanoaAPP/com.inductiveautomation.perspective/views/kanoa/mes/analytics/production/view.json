  "params": {},
  "propConfig": {
    "custom.assets": {
      "binding": {
        "config": {
          "path": "view.custom.filter.assetId"
        },
        "overlayOptOut": true,
        "transforms": [
          {
            "code": "\t# Every enabled OEE asset at or under the selected asset. A LIKE on the path alone also matches a sibling whose name starts\n\t# the same (Machine 1 would bring Machine 10), so the path is checked again\n\tif value is None: return system.dataset.toDataSet([], [])\n\tassetPath \u003d system.kanoa.utilities.getFieldValue(\u0027assetPath\u0027, system.kanoa.asset.getAssets({\u0027assetId\u0027: value}))\n\tif not assetPath: return system.dataset.toDataSet([], [])\n\tdata \u003d system.kanoa.asset.getAssets({\u0027assetPath\u0027: assetPath + \u0027%\u0027, \u0027oeeEnabled\u0027: True, \u0027enabled\u0027: True})\n\tkeep \u003d [row for row in range(data.rowCount)\n\t\tif data.getValueAt(row, \u0027assetPath\u0027) \u003d\u003d assetPath or data.getValueAt(row, \u0027assetPath\u0027).startswith(assetPath + \u0027\\\\\u0027)]\n\treturn system.dataset.deleteRows(data, [row for row in range(data.rowCount) if row not in keep])",
            "type": "script"
          }
        ],
        "type": "property"
      },
      "persistent": true
    },
    "custom.filter": {
      "onChange": {
        "enabled": null,
        "script": "\t\n\tself.custom.instances \u003d []\t#Clear the charts anytime a filter value changes\n\tself.custom.searched \u003d False\n\tself.custom.overRange \u003d False\n\t# An OEE asset picked from the asset cards loads its chart straight away (assetNavSelection, on the root)\n\t# (once the selector has passed on both its id and its path, which can arrive as separate changes)\n\twant \u003d self.custom.autoLoad\n\tif want and self.custom.filter.assetId \u003d\u003d want[\u0027assetId\u0027] and self.custom.filter.assetPath \u003d\u003d want[\u0027assetPath\u0027]:\n\t\tself.custom.autoLoad \u003d None\n\t\t# The selector has the asset now: let go of the assetPath param that set it, or the selector would keep returning to\n\t\t# it (it doesn\u0027t follow the session\u0027s selection) and clearing it in the breadcrumb would put it straight back\n\t\tself.getChild(\u0027root\u0027).getChild(\u0027flxHeader\u0027).getChild(\u0027evAssetSelector\u0027).props.params.value.assetPath \u003d None\n\t\tself.getChild(\u0027root\u0027).buildInstances()\n\t# A zoom on the date selector (dateRangeZoomed, on the root) loads the chart once the filter has its dates, within 5 seconds\n\tzoom \u003d self.custom.zoomLoad\n\tif zoom and system.date.toMillis(system.date.now()) - (zoom[\u0027at\u0027] or 0) \u003c 5000:\n\t\tsame \u003d lambda a, b: a is not None and b is not None and abs(system.date.toMillis(a) - system.date.toMillis(b)) \u003c 1000\n\t\tif same(self.custom.filter.startDate, zoom[\u0027startDate\u0027]) and same(self.custom.filter.endDate, zoom[\u0027endDate\u0027]):\n\t\t\tself.getChild(\u0027root\u0027).buildInstances()\n\t\n\treturn"
      },
      "persistent": true
    },
    "custom.instances": {
      "persistent": true
    },
    "custom.searched": {
      "persistent": true
    },
    "custom.navAsset": {
      "binding": {
        "type": "property",
        "config": {
          "path": "view.custom.filter.assetId"
        },
        "overlayOptOut": true,
        "transforms": [
          {
            "type": "script",
            "code": "\n\t# The asset picked in the selector; a card that drills into a site or area replaces it (assetNavSelection)\n\tif value is None: return None\n\treturn system.kanoa.utilities.convertDatasetRowToJSON(system.kanoa.asset.getAssets({\u0027assetId\u0027: value}), 0) or None"
          }
        ]
      }
    },
    "custom.overRange": {
