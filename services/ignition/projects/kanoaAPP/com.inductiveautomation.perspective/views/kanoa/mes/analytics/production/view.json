    "scripts": {
      "customMethods": [
        {
          "name": "getExportData",
          "params": [],
          "script": "\n\tsystem.perspective.print(\"exportData() called\")\n\t\n\toeeData \u003d None\n\t\n\tfor instance in self.getChild(\"FlexRepeater\").props.instances:\n\t\tif oeeData is None: oeeData \u003d instance.oeeData\n\t\telse: oeeData \u003d system.dataset.appendDataset(oeeData, instance.oeeData)\n\t\t\t\n\treturn oeeData"
        },
        {
          "name": "buildInstances",
          "params": [],
          "script": "\n\t# One asset at a time: a chart with its summary fills the screen, and a chart for every OEE asset under a site or area\n\t# started all their queries together, which tied up the database for minutes (868mwctaw). The selected asset must be an\n\t# OEE asset; anything else shows Select an asset (lblNoData)\n\tfilter \u003d self.view.custom.filter\n\tstart, end \u003d filter[\u0027startDate\u0027], filter[\u0027endDate\u0027]\n\tinfo \u003d system.kanoa.utilities.convertDatasetRowToJSON(system.kanoa.asset.getAssets({\u0027assetId\u0027: filter[\u0027assetId\u0027] if filter[\u0027assetId\u0027] is not None else -1}), 0)\n\t# Up to 7 days: a longer range reads weeks of events and counts for the chart, which filled the gateway\u0027s memory on the\n\t# demo server (Year To Date, the months and Last 14 Days are off in the date selector; a custom range can still be longer)\n\tover \u003d start is not None and end is not None and system.date.daysBetween(start, end) \u003e 7\n\tself.view.custom.overRange \u003d bool(over and info and info.get(\u0027oeeEnabled\u0027))\n\tif self.view.custom.overRange:\n\t\tsystem.kanoa.toast.show({\u0027id\u0027: \u0027productionRangeCap\u0027, \u0027type\u0027: \u0027warning\u0027, \u0027message\u0027: system.util.translate(\u0027Choose a range of up to 7 days\u0027, self.session.props.locale)})\n\tinstances \u003d []\n\tif info and info.get(\u0027oeeEnabled\u0027) and not over:\n\t\tinstances.append({\u0027values\u0027: {\n\t\t\t\u0027assetId\u0027: info[\u0027assetId\u0027],\n\t\t\t\u0027startDate\u0027: start,\n\t\t\t\u0027endDate\u0027: end,\n\t\t\t\u0027displayOptions\u0027: {\u0027showInfeed\u0027: True, \u0027showOutfeed\u0027: True, \u0027showTarget\u0027: True, \u0027showWaste\u0027: True, \u0027showModes\u0027: True},\n\t\t\t# Auto: the chart\u0027s table and export by hour, day or week from the range\n\t\t\t\u0027interval\u0027: None,\n\t\t\t# A box dragged across the chart sets the range on this page\u0027s date selector (setDateRange)\n\t\t\t\u0027zoomId\u0027: self.view.custom.zoomId}})\n\tself.view.custom.instances \u003d instances\n\tself.view.custom.searched \u003d True"
        }
      ],
      "extensionFunctions": null,
      "messageHandlers": [
        {
          "messageType": "assetNavSelection",
          "pageScope": true,
          "sessionScope": false,
          "viewScope": false,
          "script": "\n\t# A card or Up in the asset cards (evAssetNav): an OEE asset is selected in the selector and its chart loads\n\t# (custom.filter\u0027s onChange, with autoLoad); a site or an area shows the assets under it; Up past the top shows every\n\t# enterprise\n\tvalue \u003d (payload or {}).get(\u0027value\u0027) or {}\n\tpath \u003d value.get(\u0027assetPath\u0027) or \u0027\u0027\n\tinfo \u003d system.kanoa.utilities.convertDatasetRowToJSON(system.kanoa.asset.getAssets({\u0027assetPath\u0027: path}), 0) if path else None\n\tif info and info.get(\u0027oeeEnabled\u0027):\n\t\tself.view.custom.autoLoad \u003d {\u0027assetId\u0027: info[\u0027assetId\u0027], \u0027assetPath\u0027: path}\n\t\tself.getChild(\u0027flxHeader\u0027).getChild(\u0027evAssetSelector\u0027).props.params.value.assetPath \u003d path\n\telse:\n\t\tself.view.custom.navAsset \u003d info or None"
        },
        {
          "messageType": "dateRangeZoomed",
          "pageScope": true,
          "sessionScope": false,
          "viewScope": false,
          "script": "\n\t# A zoom or Zoom out on this page\u0027s date selector: load the chart for the new range without waiting for Get Data. The\n\t# filter\u0027s onChange loads it once both dates have arrived (they can come as separate changes); if they already have, now\n\tif not payload or not self.view.custom.zoomId or payload.get(\u0027id\u0027) !\u003d self.view.custom.zoomId: return\n\tif payload.get(\u0027startDate\u0027) is None or payload.get(\u0027endDate\u0027) is None: return\n\tself.view.custom.zoomLoad \u003d {\u0027startDate\u0027: payload[\u0027startDate\u0027], \u0027endDate\u0027: payload[\u0027endDate\u0027], \u0027at\u0027: system.date.toMillis(system.date.now())}\n\tfilter \u003d self.view.custom.filter\n\tsame \u003d lambda a, b: a is not None and b is not None and abs(system.date.toMillis(a) - system.date.toMillis(b)) \u003c 1000\n\tif same(filter[\u0027startDate\u0027], payload[\u0027startDate\u0027]) and same(filter[\u0027endDate\u0027], payload[\u0027endDate\u0027]): self.buildInstances()"
        }
      ]
    },
    "type": "ia.container.flex"
  }
}