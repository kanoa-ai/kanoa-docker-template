      {
        "meta": {
          "domId": "flxKpiRow",
          "name": "flxKpiRow"
        },
        "position": {
          "shrink": 0
        },
        "propConfig": {
          "props.instances": {
            "binding": {
              "config": {
                "path": "view.custom.filter"
              },
              "overlayOptOut": true,
              "transforms": [
                {
                  "code": "\n\tif value[\u0027assetId\u0027] is None or value[\u0027startDate\u0027] is None or value[\u0027endDate\u0027] is None: return []\n\n\tdata \u003d system.kanoa.operators.getOLEDataAsset(value[\u0027assetId\u0027], value[\u0027startDate\u0027], value[\u0027endDate\u0027])\n\tif data.rowCount \u003d\u003d 0:\n\t\treturn []\n\n\trow \u003d system.dataset.toPyDataSet(data)[0]\n\tscheduledSecs \u003d row[\u0027scheduledSecs\u0027] or 0\n\tloggedInSecs \u003d row[\u0027loggedInSecs\u0027] or 0\n\tattendance \u003d (100.0 * loggedInSecs / scheduledSecs) if scheduledSecs \u003e 0 else 0\n\toleAvailability \u003d (row[\u0027oleAvailability\u0027] or 0) * 100\n\tpoleAvailability \u003d (row[\u0027poleAvailability\u0027] or 0) * 100\n\tole \u003d (row[\u0027ole\u0027] or 0) * 100\n\tpole \u003d (row[\u0027pole\u0027] or 0) * 100\n\tperformance \u003d (row[\u0027performance\u0027] or 0) * 100\n\tquality \u003d (row[\u0027quality\u0027] or 0) * 100\n\tlaborGap \u003d oleAvailability - poleAvailability\n\n\tdef badge(val, goodMin, warnMin, invert\u003dFalse):\n\t\tif invert:\n\t\t\tif val \u003c\u003d goodMin: return \u0027good\u0027\n\t\t\tif val \u003c\u003d warnMin: return \u0027warn\u0027\n\t\t\treturn \u0027bad\u0027\n\t\tif val \u003e\u003d goodMin: return \u0027good\u0027\n\t\tif val \u003e\u003d warnMin: return \u0027warn\u0027\n\t\treturn \u0027bad\u0027\n\t\n\tdef laborGapBadge(val):\n\t\tif val \u003e 15: return \u0027bad\u0027\n\t\tif val \u003e 5: return \u0027warn\u0027\n\t\tif val \u003e\u003d -5: return \u0027good\u0027\n\t\tif val \u003e\u003d -15: return \u0027warn\u0027\n\t\treturn \u0027bad\u0027\n\t\n\tdef laborGapText(val):\n\t\tif val \u003e 5: return \u0027Present, not producing\u0027\n\t\tif val \u003e\u003d -5: return \u0027Tight\u0027\n\t\treturn \u0027Understaffed\u0027\n\t\n\ttiles \u003d [\n\t\t{\u0027label\u0027: \u0027Attendance\u0027, \u0027value\u0027: \u0027%d%%\u0027 % round(attendance), \u0027sub\u0027: \u0027Logged in / Scheduled\u0027, \u0027badgeText\u0027: \u0027On target\u0027 if attendance \u003e\u003d 90 else (\u0027Watch\u0027 if attendance \u003e\u003d 75 else \u0027Low\u0027), \u0027badgeType\u0027: badge(attendance, 90, 75)},\n\t\t{\u0027label\u0027: \u0027OLE\u0027, \u0027value\u0027: \u0027%d%%\u0027 % round(ole), \u0027sub\u0027: \u0027Raw presence-based\u0027, \u0027badgeText\u0027: \u0027Stable\u0027, \u0027badgeType\u0027: badge(ole, 70, 50)},\n\t\t{\u0027label\u0027: \u0027POLE\u0027, \u0027value\u0027: \u0027%d%%\u0027 % round(pole), \u0027sub\u0027: \u0027Productive-time based\u0027, \u0027badgeText\u0027: \u0027Stable\u0027, \u0027badgeType\u0027: badge(pole, 70, 50)},\n\t\t{\u0027label\u0027: \u0027Performance\u0027, \u0027value\u0027: \u0027%d%%\u0027 % round(performance), \u0027sub\u0027: \u0027Rate vs. standard\u0027, \u0027badgeText\u0027: \u0027Stable\u0027, \u0027badgeType\u0027: badge(performance, 85, 70)},\n\t\t{\u0027label\u0027: \u0027Quality\u0027, \u0027value\u0027: \u0027%d%%\u0027 % round(quality), \u0027sub\u0027: \u0027Yield after waste\u0027, \u0027badgeText\u0027: \u0027Stable\u0027, \u0027badgeType\u0027: badge(quality, 95, 90)},\n\t\t{\u0027label\u0027: \u0027Labor Gap\u0027, \u0027value\u0027: \u0027%dpt\u0027 % round(laborGap), \u0027sub\u0027: \u0027OLE - POLE availability\u0027, \u0027badgeText\u0027: laborGapText(laborGap), \u0027badgeType\u0027: laborGapBadge(laborGap)}\n\t]\n\t\n\ttiles \u003d [\n\t\t{\u0027label\u0027: \u0027Attendance\u0027, \u0027value\u0027: \u0027%d%%\u0027 % round(attendance), \u0027sub\u0027: \u0027Logged in / Scheduled\u0027, \u0027badgeText\u0027: \u0027On target\u0027 if attendance \u003e\u003d 90 else (\u0027Watch\u0027 if attendance \u003e\u003d 75 else \u0027Low\u0027), \u0027badgeType\u0027: badge(attendance, 90, 75),\n\t\t\t\u0027tooltip\u0027: \u0027Logged-in labor-hours as a share of scheduled labor-hours for this asset. Below 100% means someone scheduled did not show up (or left early).\u0027},\n\t\t{\u0027label\u0027: \u0027OLE\u0027, \u0027value\u0027: \u0027%d%%\u0027 % round(ole), \u0027sub\u0027: \u0027Raw presence-based\u0027, \u0027badgeText\u0027: \u0027Stable\u0027, \u0027badgeType\u0027: badge(ole, 70, 50),\n\t\t\t\u0027tooltip\u0027: \u0027Operator Labor Effectiveness \u003d Availability (logged-in vs scheduled) x Performance x Quality. Based on raw login time, regardless of whether the asset was actually running.\u0027},\n\t\t{\u0027label\u0027: \u0027POLE\u0027, \u0027value\u0027: \u0027%d%%\u0027 % round(pole), \u0027sub\u0027: \u0027Productive-time based\u0027, \u0027badgeText\u0027: \u0027Stable\u0027, \u0027badgeType\u0027: badge(pole, 70, 50),\n\t\t\t\u0027tooltip\u0027: \u0027Same as OLE, but Availability is based on productive time (asset actually running) instead of raw login time - nets out time someone was logged in while the line was down.\u0027},\n\t\t{\u0027label\u0027: \u0027Performance\u0027, \u0027value\u0027: \u0027%d%%\u0027 % round(performance), \u0027sub\u0027: \u0027Rate vs. standard\u0027, \u0027badgeText\u0027: \u0027Stable\u0027, \u0027badgeType\u0027: badge(performance, 85, 70),\n\t\t\t\u0027tooltip\u0027: \u0027Actual production rate vs. the standard rate for this asset, measured only during productive (running) time.\u0027},\n\t\t{\u0027label\u0027: \u0027Quality\u0027, \u0027value\u0027: \u0027%d%%\u0027 % round(quality), \u0027sub\u0027: \u0027Yield after waste\u0027, \u0027badgeText\u0027: \u0027Stable\u0027, \u0027badgeType\u0027: badge(quality, 95, 90),\n\t\t\t\u0027tooltip\u0027: \u0027Good units produced as a share of total units run, after removing waste/scrap.\u0027},\n\t\t{\u0027label\u0027: \u0027Labor Gap\u0027, \u0027value\u0027: \u0027%dpt\u0027 % round(laborGap), \u0027sub\u0027: \u0027OLE - POLE availability\u0027, \u0027badgeText\u0027: laborGapText(laborGap), \u0027badgeType\u0027: laborGapBadge(laborGap),\n\t\t\t\u0027tooltip\u0027: \u0027OLE Availability minus POLE Availability, in percentage points. Positive: people logged in without the asset producing (present, not producing). Negative: the asset kept producing despite fewer scheduled labor-hours showing up (understaffed, but holding).\u0027}\n\t]\t\n\t\n\treturn [{\u0027value\u0027: t} for t in tiles]",
                  "type": "script"
                }
              ],
              "type": "property"
            },
            "persistent": true
          }
        },
