{
  "custom": {
    "itemId": null,
    "refresh": null,
    "rows": [],
    "security": {},
    "selected": null,
    "selectedRow": null,
    "userAction": {}
  },
  "params": {},
  "propConfig": {
    "custom.security": {
      "binding": {
        "config": {
          "struct": {
            "user": "{session.props.auth.user}"
          },
          "waitOnAll": false
        },
        "overlayOptOut": true,
        "transforms": [
          {
            "code": "\t\n\tsecConfig = system.kanoa.utilities.convertDatasetToDict(system.kanoa.security.getConfig({}), 'configName', 'configValue')\n\tuserId = system.kanoa.security.getIDPUserId(value['user'])\t\n\tuserCRUD = system.kanoa.security.getUserAssetCRUD(userId)\n\t\n\treturn {\"userId\": userId, \"config\": secConfig, \"userCRUD\": userCRUD}",
            "type": "script"
          }
        ],
        "type": "expr-struct"
      },
      "persistent": true
    },
    "custom.userAction": {
      "binding": {
        "config": {
          "path": "view.custom.security"
        },
        "overlayOptOut": true,
        "transforms": [
          {
            "code": "\n\t#Admins and users who configure items\n\tuserCRUD = value['userCRUD'] if value else None\n\tcanEdit = bool(userCRUD) and (userCRUD.get('isGatewayAdmin') or userCRUD.get('configureItems', {}).get('enabled'))\n\treturn {'canCreate': canEdit, 'canUpdate': canEdit, 'canRead': True}",
            "type": "script"
          }
        ],
        "type": "property"
      }
    },
    "custom.rows": {
      "binding": {
        "config": {
          "struct": {
            "itemId": "{view.custom.itemId}",
            "refresh": "{view.custom.refresh}"
          },
          "waitOnAll": true
        },
        "overlayOptOut": true,
        "transforms": [
          {
            "code": "\n\tparams = {} if value['itemId'] is None else {'itemId': value['itemId']}\n\tdata = system.kanoa.tooling.getRequiredTooling(params)\n\tif not hasattr(data, 'getRowCount'): return []\n\trows = system.kanoa.utilities.convertDatasetToJSON(data)\n\tfor r in rows:\n\t\tr['machine'] = r['assetPath'] or 'Any machine'\n\t\tr['tool'] = r['toolingName'] or ('Any %s' % r['toolingTypeName'])\n\t\t#makesItem is False when the tool's output positions are all set to other items (None: nothing to check)\n\t\tr['check'] = {'value': \"Can't make this item: the tool's positions are all set to other items\" if r['makesItem'] is not None and not r['makesItem'] else '', 'style': {'color': '--kcError'}}\n\treturn rows",
            "type": "script"
          }
        ],
        "type": "expr-struct"
      },
      "persistent": true
    },
    "custom.selected": {
      "binding": {
        "config": {
          "struct": {
            "rows": "{view.custom.rows}",
            "row": "{view.custom.selectedRow}"
          },
          "waitOnAll": true
        },
        "overlayOptOut": true,
        "transforms": [
          {
            "code": "\n\trows = value['rows'] or []\n\trow = value['row']\n\tif row is None or row < 0 or row >= len(rows): return None\n\treturn dict(rows[row])",
            "type": "script"
          }
        ],
        "type": "expr-struct"
      },
      "persistent": true
    }
  },
  "props": {
    "defaultSize": {
      "height": 500,
      "width": 900
    }
