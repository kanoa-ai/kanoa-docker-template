{
  "custom": {
    "clearView": false,
    "display": {}
  },
  "params": {
    "value": {
      "assetInfo": {
        "assetGroupColor": null,
        "assetGroupId": 1,
        "assetGroupName": "Packaging",
        "assetId": null,
        "assetName": "Box Line 1",
        "assetPath": null,
        "assetTypeId": 5,
        "assetTypeName": "line",
        "assetTypePath": "enterprise\\site\\area\\line",
        "displayPath": "Kanoa Box Co \u003e Box Plant \u003e Packaging \u003e Box Line 1",
        "enabled": true,
        "iconPath": "kanoa/line",
        "oeeEnabled": true,
        "parentId": 1709,
        "path": "Kanoa Box Co\\Box Plant\\Packaging\\Box Line 1",
        "processTypeId": 1,
        "processTypeName": "continuous",
        "sortOrder": 0,
        "tagPath": "[Kanoa]/Kanoa Box Co/Box Plant/Packaging/Box Line 1",
        "timeZone": "Eastern Standard Time"
      },
      "assetName": "",
      "assets": [],
      "childAssets": [],
      "expand": true,
      "level": 4
    }
  },
  "propConfig": {
    "custom.clearView": {
      "onChange": {
        "enabled": null,
        "script": "\t\n\tif currentValue.value:\n\t\tself.params.value.assets \u003d []\n\t\tself.params.value.childAssets \u003d []\n\t\tself.params.value.assetName \u003d \u0027\u0027\n\t\t\n\t\timport time\n\t\ttime.sleep(0.5)\n\t\tself.custom.clearView \u003d False\n\t\t\n\treturn"
      },
      "persistent": true
    },
    "custom.display": {
      "persistent": true
    },
    "custom.display.expand": {
      "binding": {
        "config": {
          "path": "view.params.value.expand"
        },
        "overlayOptOut": true,
        "type": "property"
      }
    },
    "custom.display.showChildren": {
      "binding": {
        "config": {
          "path": "view.params.value.childAssets"
        },
        "overlayOptOut": true,
        "transforms": [
          {
            "code": "\treturn len(value) \u003e 0",
            "type": "script"
          }
        ],
        "type": "property"
      }
    },
    "custom.display.showInfoLevel": {
      "binding": {
        "config": {
          "expression": "now(0)"
        },
        "overlayOptOut": true,
        "transforms": [
          {
            "code": "\treturn \u0027status\u0027",
            "type": "script"
          }
        ],
        "type": "expr"
      }
    },
    "params.value": {
      "paramDirection": "input",
      "persistent": true
    }
  },
  "props": {
    "defaultSize": {
      "height": 869,
      "width": 850
    }
  },
  "root": {
    "children": [
      {
        "meta": {
          "domId": "evHeader",
          "name": "evHeader"
        },
        "position": {
          "shrink": 0
        },
        "propConfig": {
          "props.params.value": {
            "binding": {
              "config": {
                "path": "view.params.value"
              },
              "overlayOptOut": true,
              "type": "property"
            }
          }
        },
        "props": {
          "path": "kanoa/mes/asset/overview/assetLevelHeader"
        },
        "type": "ia.display.view"
      },
      {
        "meta": {
          "domId": "flxChildAssets",
          "name": "flxChildAssets"
        },
        "position": {
          "shrink": 0
        },
        "propConfig": {
          "position.display": {
            "binding": {
              "config": {
                "path": "view.custom.display"
              },
              "overlayOptOut": true,
              "transforms": [
                {
                  "code": "\t\n\tif value is None or not value.has_key(\u0027expand\u0027) or not value.has_key(\u0027showChildren\u0027): return False\n\treturn value[\u0027expand\u0027] and value[\u0027showChildren\u0027] and value[\u0027showInfoLevel\u0027] \u003d\u003d \u0027status\u0027",
                  "type": "script"
                }
              ],
              "type": "property"
            }
          },
          "props.instances": {
            "binding": {
              "config": {
                "path": "view.params.value.childAssets"
              },
              "overlayOptOut": true,
              "transforms": [
                {
                  "code": "\n\tlevel \u003d self.view.params.value.level + 1\n\texpand \u003d self.view.params.value.expand\n\tinfo \u003d []\n\n\tvalue \u003d sorted(value, key\u003dlambda x: x[\u0027assetInfo\u0027][\u0027sortOrder\u0027])\n\tfor item in value:\n\t\tchildren \u003d []\n\t\tassets \u003d []\t\t\n\t\tfor childAssets in item:\n\t\t\tif childAssets \u003d\u003d \u0027assetInfo\u0027: continue\n\t\t\tchild \u003d item[childAssets]\n\t\t\tif len(dict(child)) \u003d\u003d 1: assets.append(child)\n\t\t\telse:\n\t\t\t\tchildren.append(child)\n\t\t\t\t#A line with cells is a tile among its area\u0027s lines too; its cells get a section of their own below it (868mvwg9e)\n\t\t\t\tif child[\u0027assetInfo\u0027] and child[\u0027assetInfo\u0027][\u0027oeeEnabled\u0027]: assets.append({\u0027assetInfo\u0027: child[\u0027assetInfo\u0027]})\n\t\t\t\t\n\t\tinfo.append({\u0027value\u0027: {\u0027assetName\u0027: item[\u0027assetInfo\u0027][\u0027assetName\u0027], \u0027assetInfo\u0027: item[\u0027assetInfo\u0027], \u0027childAssets\u0027: children, \u0027assets\u0027: assets, \u0027expand\u0027: expand, \u0027level\u0027: level}})\n\t\n\treturn info",
                  "type": "script"
                }
              ],
              "type": "property"
            },
            "persistent": false
          },
          "props.path": {
            "binding": {
              "config": {
                "path": "view.params.value.level"
              },
              "overlayOptOut": true,
              "transforms": [
                {
                  "code": "\tlevel \u003d (value or 0) + 1\n\treturn \u0027kanoa/mes/asset/overview/assetTreeOverviewL\u0027 + str(level)",
                  "type": "script"
                }
              ],
              "type": "property"
            }
          }
        },
        "props": {
          "direction": "column",
          "elementPosition": {
            "basis": "auto",
            "grow": 0,
            "shrink": 0
          },
          "elementStyle": {
            "padding": 0
          },
          "style": {
            "backgroundColor": "transparent",
            "gap": "16px"
          },
          "useDefaultViewHeight": false,
          "useDefaultViewWidth": false
        },
        "type": "ia.display.flex-repeater"
      },
      {
        "meta": {
          "domId": "flxAssetCards",
          "name": "flxAssetCards"
        },
        "position": {
          "shrink": 0
        },
        "propConfig": {
          "position.display": {
            "binding": {
              "config": {
                "path": "view.custom.display"
              },
              "overlayOptOut": true,
              "transforms": [
                {
                  "code": "\n\t#Only while the level is expanded (868mvwg9e): collapsing hid the child groups but left the Detail cards showing\n\tif value is None or not value.has_key(\u0027showInfoLevel\u0027): return False\n\texpanded \u003d value[\u0027expand\u0027] if value.has_key(\u0027expand\u0027) else True\n\treturn bool(expanded) and value[\u0027showInfoLevel\u0027] \u003d\u003d \u0027detail\u0027",
                  "type": "script"
                }
              ],
              "type": "property"
            }
          },
          "props.instances": {
            "binding": {
              "config": {
                "struct": {
                  "params": "{view.params.value}",
                  "showInfoLevel": "{view.custom.display.showInfoLevel}"
                },
                "waitOnAll": true
              },
              "overlayOptOut": true,
              "transforms": [
                {
                  "code": "\n\tif value[\u0027showInfoLevel\u0027] !\u003d \u0027detail\u0027: return []\n\n\tinfo \u003d []\t\n\t#The card names its asset from this group down (868mvwg9e)\n\tgroupPath \u003d value[\u0027params\u0027][\u0027assetInfo\u0027][\u0027assetPath\u0027]\n\tassets \u003d sorted(value[\u0027params\u0027][\u0027assets\u0027], key\u003dlambda x: x[\u0027assetInfo\u0027][\u0027sortOrder\u0027])\n\tfor item in assets:\n\t\tif not item[\u0027assetInfo\u0027][\u0027oeeEnabled\u0027]: continue\n\t\tinfo.append({\u0027value\u0027: {\u0027assetInfo\u0027: item[\u0027assetInfo\u0027], \u0027groupPath\u0027: groupPath}})\n\t\t\n\tfor item in value[\u0027params\u0027][\u0027childAssets\u0027]:\n\t\tfor childAssets in item:\n\t\t\tif childAssets \u003d\u003d \u0027assetInfo\u0027: continue\n\t\t\tif not item[childAssets][\u0027assetInfo\u0027][\u0027oeeEnabled\u0027]: continue\n\t\t\tinfo.append({\u0027value\u0027: {\u0027assetInfo\u0027: item[childAssets][\u0027assetInfo\u0027], \u0027groupPath\u0027: groupPath}})\t\t\n\t\n\treturn info",
                  "type": "script"
                }
              ],
              "type": "expr-struct"
            }
          },
          "props.path": {
            "binding": {
              "config": {
                "path": "view.custom.display.showInfoLevel"
              },
              "overlayOptOut": true,
              "transforms": [
                {
                  "code": "\treturn \u0027kanoa/mes/asset/overview/assetCard/assetCard\u0027 if value \u003d\u003d \u0027detail\u0027 else \u0027\u0027",
                  "type": "script"
                }
              ],
              "type": "property"
            }
          }
        },
        "props": {
          "direction": "column",
          "elementPosition": {
            "basis": "auto",
            "grow": 0,
            "shrink": 0
          },
          "style": {
            "gap": "8px",
            "padding": "8px",
            "backgroundColor": "color-mix(in srgb, var(--kcSurfaceVariant) 45%, var(--kcSurface))",
            "borderRadius": "var(--borderRadius)"
          },
          "useDefaultViewHeight": false,
          "useDefaultViewWidth": false
        },
        "type": "ia.display.flex-repeater"
      },
      {
        "meta": {
          "domId": "evAssetSummary",
          "name": "evAssetSummary"
        },
        "position": {
          "shrink": 0
        },
        "propConfig": {
          "position.display": {
            "binding": {
              "config": {
                "path": "view.custom.display"
              },
              "overlayOptOut": true,
              "transforms": [
                {
                  "code": "\n\t#Only while the level is expanded (868mvwg9e): collapsing hid the child groups but left the Summary showing\n\tif value is None or not value.has_key(\u0027showInfoLevel\u0027): return False\n\texpanded \u003d value[\u0027expand\u0027] if value.has_key(\u0027expand\u0027) else True\n\treturn bool(expanded) and value[\u0027showInfoLevel\u0027] \u003d\u003d \u0027summary\u0027",
                  "type": "script"
                }
              ],
              "type": "property"
            }
          },
          "props.params": {
            "binding": {
              "config": {
                "struct": {
                  "params": "{view.params.value}",
                  "showInfoLevel": "{view.custom.display.showInfoLevel}"
                },
                "waitOnAll": true
              },
              "overlayOptOut": true,
              "transforms": [
                {
                  "code": "\n\tif value[\u0027showInfoLevel\u0027] !\u003d \u0027summary\u0027: return {}\n\treturn {\u0027value\u0027: value[\u0027params\u0027]}",
                  "type": "script"
                }
              ],
              "type": "expr-struct"
            }
          },
          "props.path": {
            "binding": {
              "config": {
                "path": "view.custom.display.showInfoLevel"
              },
              "overlayOptOut": true,
              "transforms": [
                {
                  "code": "\treturn \u0027kanoa/mes/asset/overview/assetSummary/assetSummary\u0027 if value \u003d\u003d \u0027summary\u0027 else \u0027\u0027",
                  "type": "script"
                }
              ],
              "type": "property"
            }
          }
        },
        "type": "ia.display.view"
      }
    ],
    "meta": {
      "domId": "root",
      "name": "root"
    },
    "props": {
      "direction": "column",
      "style": {
        "backgroundColor": "transparent",
        "borderRadius": "var(--borderRadius)",
        "padding": "6px 8px 8px 8px"
      }
    },
    "scripts": {
      "customMethods": [],
      "extensionFunctions": null,
      "messageHandlers": [
        {
          "messageType": "expandAssets",
          "pageScope": true,
          "script": "\n\tif payload[\u0027assetPath\u0027] in self.view.params.value.assetInfo.assetPath: self.view.custom.display.expand \u003d payload[\u0027expand\u0027]\n\t\n\treturn",
          "sessionScope": false,
          "viewScope": false
        },
        {
          "messageType": "showAssetInfo",
          "pageScope": true,
          "script": "\n\t#Only the level whose tab was clicked (868mvwg9e): a substring match also switched every hidden level below it, each loading its own Summary\n\tif payload[\u0027assetPath\u0027] \u003d\u003d self.view.params.value.assetInfo.assetPath: self.view.custom.display.showInfoLevel \u003d payload[\u0027showInfoLevel\u0027]\n\t\n\treturn\n",
          "sessionScope": false,
          "viewScope": false
        }
      ]
    },
    "type": "ia.container.flex",
    "propConfig": {
      "props.style.backgroundColor": {
        "binding": {
          "config": {
            "path": "view.params.value.childAssets"
          },
          "overlayOptOut": true,
          "transforms": [
            {
              "code": "\t#Each section of tiles is a tinted panel, set apart by the space between them; groups of groups stay plain (868mvwg9e)\n\treturn \u0027transparent\u0027 if len(value or []) else \u0027color-mix(in srgb, var(--kcSurfaceVariant) 45%, var(--kcSurface))\u0027",
              "type": "script"
            }
          ],
          "type": "property"
        }
      },
      "props.style.gap": {
        "binding": {
          "config": {
            "path": "view.params.value"
          },
          "overlayOptOut": true,
          "transforms": [
            {
              "code": "\t#A group with lines and groups under it (868mvwg9e): its tinted lines panel and the sections below are spaced like sibling sections\n\treturn \u002716px\u0027 if len(value.get(\u0027childAssets\u0027) or []) and len(value.get(\u0027assets\u0027) or []) else \u00270px\u0027",
              "type": "script"
            }
          ],
          "type": "property"
        }
      }
    }
  }
}