  "propConfig": {
    "custom.changesMade": {
      "binding": {
        "config": {
          "struct": {
            "measureInfo": "{view.custom.measureInfo}",
            "origMeasureInfo": "{view.custom.origMeasureInfo}"
          },
          "waitOnAll": true
        },
        "overlayOptOut": true,
        "transforms": [
          {
            "code": "\t\n\tif value[\u0027measureInfo\u0027][\u0027measureName\u0027] \u003d\u003d \u0027\u0027: return False\n\tif value[\u0027measureInfo\u0027][\u0027assetId\u0027] is None: return False\n\tif value[\u0027measureInfo\u0027][\u0027measureAggregationId\u0027] is None: return False\n\tif value[\u0027measureInfo\u0027][\u0027measureSourceTypeId\u0027] is None: return False\n\t\n\treturn dict(value[\u0027measureInfo\u0027]) !\u003d dict(value[\u0027origMeasureInfo\u0027])",
            "type": "script"
          }
        ],
        "type": "expr-struct"
      },
      "persistent": true
    },
    "custom.measureInfo": {
      "binding": {
        "config": {
          "path": "view.params.value"
        },
        "overlayOptOut": true,
        "transforms": [
          {
            "code": "\t\n\tmeasureInfo \u003d system.kanoa.utilities.convertDatasetRowToJSON(system.kanoa.measures.getMeasures({\u0027measureId\u0027: value[\u0027measureId\u0027] or -1}), 0)\n\tif measureInfo[\u0027measureName\u0027] is None: \n\t\tmeasureInfo[\u0027measureName\u0027] \u003d \u0027\u0027\n\t\tmeasureInfo[\u0027enabled\u0027] \u003d True\n\tmeasureInfo[\u0027tag\u0027] \u003d True if value[\u0027tagPath\u0027] else False\n\tmeasureInfo[\u0027tagPath\u0027] \u003d value[\u0027tagPath\u0027]\n\t\n\tif \u0027attributeId\u0027 not in measureInfo: measureInfo[\u0027attributeId\u0027] \u003d None\n\t\n\treturn measureInfo",
            "type": "script"
          }
        ],
        "type": "property"
      },
      "onChange": {
        "enabled": null,
        "script": "\n\tif origin \u003d\u003d \u0027Binding\u0027: \n\t\tif self.custom.measureInfo: self.custom.origMeasureInfo \u003d dict(self.custom.measureInfo)\n\t\n\treturn"
      },
      "persistent": true
    },
    "custom.security": {
      "binding": {
        "config": {
          "path": "session.custom.kanoa.security"
        },
        "overlayOptOut": true,
        "type": "property"
      },
      "persistent": true
    },
    "params.value": {
      "paramDirection": "input",
      "persistent": true
    }
  },
