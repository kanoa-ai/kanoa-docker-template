      {
        "events": {
          "component": {
            "onActionPerformed": {
              "config": {
                "script": "\n\tuserId \u003d system.kanoa.security.getIDPUserId(self.session.props.auth.user)\n\toperatorAssetSessionId \u003d self.view.params.value.operatorAssetSessionId\n\n\tretVal, msg \u003d system.kanoa.operators.deleteOperatorSession(operatorAssetSessionId, userId)\n\tif msg: \n\t\tsystem.perspective.sendMessage(\u0027showFailerToast\u0027, \u0027Failed to remove operator session. %s\u0027%msg)\n\t\tsystem.perspective.print(\"Delete failed: %s\" % str(msg))\n\telse:\n\t\tsystem.perspective.sendMessage(\u0027showSuccessfulToast\u0027, \u0027Operator session removed\u0027)\n\t\t\n\tsystem.perspective.sendMessage(\u0027operatorLoginUpdated\u0027)\n\t\t\n\treturn"
