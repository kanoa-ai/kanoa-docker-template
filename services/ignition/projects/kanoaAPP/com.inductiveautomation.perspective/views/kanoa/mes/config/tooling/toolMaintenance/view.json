                  "transforms": [
                    {
                      "code": "\n\t#How far the tool is through each of its limits, as on the Life tab\n\tif not value: return ''\n\tparts = []\n\tfor key, name in [('pmPct', 'PM'), ('refurbPct', 'Refurbishment'), ('lifetimePct', 'Lifetime'), ('calibrationPct', 'Calibration')]:\n\t\tif value.get(key) is not None: parts.append('%s %d%%' % (name, round(value[key])))\n\ttext = (value.get('status') or '') + (': ' if parts else '') + u' · '.join(parts)\n\treturn text",
                      "type": "script"
                    }
                  ],
                  "type": "property"
                }
              }
            },
            "props": {
              "style": {
