{
  "custom": {
    "events": [],
    "life": {},
    "refresh": null,
    "toolingAssetId": null,
    "workOrders": []
  },
  "params": {
    "value": {
      "toolingAssetId": null
    }
  },
  "propConfig": {
    "custom.events": {
      "binding": {
        "config": {
          "struct": {
            "toolingAssetId": "{view.custom.toolingAssetId}",
            "refresh": "{view.custom.refresh}"
          },
          "waitOnAll": true
        },
        "overlayOptOut": true,
        "transforms": [
          {
            "code": "\n\t#The tool's maintenance work orders: open ones first, then the latest 50 closed\n\tif value['toolingAssetId'] is None: return []\n\tdata = system.kanoa.cmms.getWorkOrderEvents({'assetId': value['toolingAssetId']})\n\tif not hasattr(data, 'getRowCount'): return []\n\trows = system.kanoa.utilities.convertDatasetToJSON(data)\n\trows.sort(key=lambda r: (not r['isActive'], -(r['dueDate'].getTime() if r['dueDate'] else 0)))\n\tout = []\n\tfor r in [r for r in rows if r['isActive']] + [r for r in rows if not r['isActive']][:50]:\n\t\tcavities = ''\n\t\tpositions = system.kanoa.cmms.getWorkOrderPositions({'workOrderEventId': r['workOrderEventId']})\n\t\tif hasattr(positions, 'getRowCount'):\n\t\t\tcavities = ', '.join(str(p['positionNumber']) + ('' if p['isBlocking'] else ' (running)') for p in system.kanoa.utilities.convertDatasetToJSON(positions))\n\t\tout.append({'workOrderEventId': r['workOrderEventId'], 'workOrderEventName': r['workOrderEventName'], 'title': r['title'] or '',\n\t\t\t'status': r['workOrderEventStatusName'], 'dueDate': r['dueDate'], 'cavities': cavities,\n\t\t\t'type': r['maintenanceTypeName'] or ''})\n\treturn out",
            "type": "script"
          }
        ],
        "type": "expr-struct"
      },
      "persistent": true
    },
    "custom.life": {
      "binding": {
        "config": {
          "struct": {
            "toolingAssetId": "{view.custom.toolingAssetId}",
            "refresh": "{view.custom.refresh}"
          },
          "waitOnAll": true
        },
        "overlayOptOut": true,
        "transforms": [
          {
            "code": "\n\tif value['toolingAssetId'] is None: return {}\n\tdata = system.kanoa.tooling.getCounters({'toolingAssetId': value['toolingAssetId']})\n\tif not hasattr(data, 'getRowCount') or data.getRowCount() == 0: return {}\n\treturn system.kanoa.utilities.convertDatasetRowToJSON(data, 0)",
            "type": "script"
          }
        ],
        "type": "expr-struct"
      },
      "persistent": true
    },
    "custom.toolingAssetId": {
      "binding": {
        "config": {
          "path": "view.params.value"
        },
        "overlayOptOut": true,
        "transforms": [
          {
            "code": "\n\treturn value.get('toolingAssetId') if value else None",
            "type": "script"
          }
        ],
        "type": "property"
      },
      "persistent": true
    },
    "custom.workOrders": {
      "binding": {
        "config": {
          "struct": {
            "toolingAssetId": "{view.custom.toolingAssetId}",
            "refresh": "{view.custom.refresh}"
          },
          "waitOnAll": true
        },
        "overlayOptOut": true,
        "transforms": [
          {
            "code": "\n\t#The work orders (templates) on the tool and what generates their maintenance work orders\n\tif value['toolingAssetId'] is None: return []\n\tdata = system.kanoa.cmms.getWorkOrders({'assetId': value['toolingAssetId']})\n\tif not hasattr(data, 'getRowCount'): return []\n\tlimits = {'pm': 'PM', 'refurb': 'refurbishment', 'calibration': 'calibration'}\n\tout = []\n\tfor r in system.kanoa.utilities.convertDatasetToJSON(data):\n\t\tschedule = r.get('scheduleTypeName') or ''\n\t\tlast = r.get('lastGeneratedDate')\n\t\tif schedule == 'Recurring' and r.get('rruleStr'):\n\t\t\tschedule = 'Recurring: %s' % r['rruleStr']\n\t\telif schedule == 'Condition':\n\t\t\tconditions = system.kanoa.cmms.getWorkOrderConditions({'workOrderId': r['workOrderId']})\n\t\t\tif hasattr(conditions, 'getRowCount') and conditions.getRowCount():\n\t\t\t\tc = system.kanoa.utilities.convertDatasetRowToJSON(conditions, 0)\n\t\t\t\tinfo = system.util.jsonDecode(c['conditionInfo']) or {}\n\t\t\t\tlast = c['lastGeneratedDate']\n\t\t\t\tif c['conditionName'] == 'toolLife':\n\t\t\t\t\tschedule = 'Tool Life: when %s reaches its warning %%' % limits.get(info.get('counter'), info.get('counter'))\n\t\t\t\telif c['conditionName'] == 'counter':\n\t\t\t\t\tschedule = 'Counter: every %s counts' % info.get('valueThreshold')\n\t\t\t\telif c['conditionName'] == 'runHour':\n\t\t\t\t\tschedule = 'Run hours: every %s hours' % info.get('valueThreshold')\n\t\tout.append({'workOrderId': r['workOrderId'], 'title': r['title'] or '', 'schedule': schedule,\n\t\t\t'status': r.get('workOrderStatusName') or '', 'lastGeneratedDate': last})\n\treturn out",
            "type": "script"
          }
        ],
        "type": "expr-struct"
      },
      "persistent": true
    },
    "params.value": {
      "paramDirection": "input",
      "persistent": true
    }
  },
  "props": {
    "defaultSize": {
      "height": 500,
      "width": 950
    }
  },
