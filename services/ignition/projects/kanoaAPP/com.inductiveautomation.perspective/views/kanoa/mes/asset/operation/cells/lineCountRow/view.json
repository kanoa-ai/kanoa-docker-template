{
  "custom": {},
  "params": {
    "value": {
      "assetId": "",
      "assetPath": "",
      "counterId": "",
      "counterName": "",
      "counterTypeName": "",
      "itemClassName": "",
      "itemClassPath": "",
      "itemId": "",
      "itemPath": "",
      "itemStateId": "",
      "itemStatePath": "",
      "value": 8,
      "workOrderId": null,
      "workOrderName": null
    }
  },
  "propConfig": {
    "params.value": {
      "paramDirection": "input",
      "persistent": true
    }
  },
  "props": {
    "defaultSize": {
      "height": 24,
      "width": 356
    }
  },
  "root": {
    "children": [
      {
        "children": [
          {
            "meta": {
              "domId": "lblItemName",
              "name": "lblItemName",
              "tooltip": {
                "enabled": true
              }
            },
            "position": {
              "basis": "80px",
              "shrink": 0
            },
            "propConfig": {
              "props.style.color": {
                "binding": {
                  "config": {
                    "path": "view.params.value.counterName"
                  },
                  "overlayOptOut": true,
                  "transforms": [
                    {
                      "code": "\treturn \u0027--kcRed-60\u0027 if value \u003d\u003d \u0027waste\u0027 else \u0027\u0027",
                      "type": "script"
                    }
                  ],
                  "type": "property"
                }
              },
              "props.text": {
                "binding": {
                  "config": {
                    "path": "view.params.value"
                  },
                  "overlayOptOut": true,
                  "transforms": [
                    {
                      "code": "\t\n\titemName \u003d value[\u0027itemPath\u0027].split(\"\\\\\")[-1]\n\treturn \"{}\".format(itemName)",
                      "type": "script"
                    }
                  ],
                  "type": "property"
                }
              }
            },
            "type": "ia.display.label"
          },
          {
            "meta": {
              "domId": "lblItemState",
              "name": "lblItemState",
              "tooltip": {
                "enabled": true
              }
            },
            "propConfig": {
              "props.style.color": {
                "binding": {
                  "config": {
                    "path": "view.params.value.counterName"
                  },
                  "overlayOptOut": true,
                  "transforms": [
                    {
                      "code": "\treturn \u0027--kcRed-60\u0027 if value \u003d\u003d \u0027waste\u0027 else \u0027\u0027",
                      "type": "script"
                    }
                  ],
                  "type": "property"
                }
              },
              "props.text": {
                "binding": {
                  "config": {
                    "path": "view.params.value"
                  },
                  "overlayOptOut": true,
                  "transforms": [
                    {
                      "code": "\t\n\titemStateName \u003d value[\u0027itemStatePath\u0027].split(\"\\\\\")[-1] if value[\u0027itemStatePath\u0027] else None\n\tlabel \u003d \"%s - %s\"%(value[\u0027counterName\u0027].title(), itemStateName) if itemStateName else \"%s\"%(value[\u0027counterName\u0027].title())\n\treturn \"{}\".format(label)",
                      "type": "script"
                    }
                  ],
                  "type": "property"
                }
              }
            },
            "type": "ia.display.label"
          },
          {
            "meta": {
              "domId": "lblItemQty",
              "name": "lblItemQty",
              "tooltip": {
                "enabled": true
              }
            },
            "position": {
              "grow": 1,
              "shrink": 0
            },
            "propConfig": {
              "props.style.color": {
                "binding": {
                  "config": {
                    "path": "view.params.value.counterName"
                  },
                  "overlayOptOut": true,
                  "transforms": [
                    {
                      "code": "\treturn \u0027--kcRed-60\u0027 if value \u003d\u003d \u0027waste\u0027 else \u0027\u0027",
                      "type": "script"
                    }
                  ],
                  "type": "property"
                }
              },
              "props.text": {
                "binding": {
                  "config": {
                    "path": "view.params.value"
                  },
                  "overlayOptOut": true,
                  "transforms": [
                    {
                      "code": "\t\n\tunits \u003d \u0027units\u0027 if value[\u0027value\u0027] !\u003d 1 else \u0027unit \u0027\n\titemName \u003d value[\u0027itemPath\u0027].split(\"\\\\\")[-1]\n\t\n\treturn \"{:,} {}\".format(value[\u0027value\u0027], units)",
                      "type": "script"
                    }
                  ],
                  "type": "property"
                }
              }
            },
            "props": {
              "style": {
                "textAlign": "right"
              }
            },
            "type": "ia.display.label"
          }
        ],
        "meta": {
          "domId": "flxRow1",
          "name": "flxRow1"
        },
        "position": {
          "grow": 1
        },
        "props": {
          "style": {
            "gap": "5px",
            "overflow": "hidden"
          }
        },
        "type": "ia.container.flex"
      }
    ],
    "meta": {
      "domId": "root",
      "name": "root"
    },
    "props": {
      "direction": "column",
      "justify": "space-between",
      "style": {
        "overflow": "hidden",
        "padding": "2px"
      }
    },
    "type": "ia.container.flex"
  }
}