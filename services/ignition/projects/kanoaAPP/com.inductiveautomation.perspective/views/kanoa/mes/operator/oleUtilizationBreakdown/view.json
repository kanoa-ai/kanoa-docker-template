  "propConfig": {
    "custom.absentPct": {
      "binding": {
        "config": {
          "path": "view.custom.oleRow"
        },
        "overlayOptOut": true,
        "transforms": [
          {
            "code": "\n\tscheduledSecs \u003d value.get(\u0027scheduledSecs\u0027) or 0\n\tif scheduledSecs \u003c\u003d 0: return 0\n\tloggedInSecs \u003d value.get(\u0027loggedInSecs\u0027) or 0\n\treturn 100.0 * max(0, scheduledSecs - loggedInSecs) / scheduledSecs\n\t",
            "type": "script"
          }
        ],
        "type": "property"
      }
    },
    "custom.loggedInPct": {
      "binding": {
        "config": {
          "path": "view.custom.oleRow"
        },
        "overlayOptOut": true,
        "transforms": [
          {
            "code": "\n\tscheduledSecs \u003d value.get(\u0027scheduledSecs\u0027) or 0\n\tif scheduledSecs \u003c\u003d 0: return 0\n\treturn 100.0 * (value.get(\u0027loggedInSecs\u0027) or 0) / scheduledSecs\n\t",
            "type": "script"
          }
        ],
        "type": "property"
      }
    },
    "custom.oleRow": {
      "binding": {
        "config": {
          "path": "view.params.value"
        },
        "overlayOptOut": true,
        "transforms": [
          {
            "code": "\n\tif value[\u0027assetId\u0027] is None or value[\u0027startDate\u0027] is None or value[\u0027endDate\u0027] is None: return {}\n\n\tdata \u003d system.kanoa.operators.getOLEDataAsset(value[\u0027assetId\u0027], value[\u0027startDate\u0027], value[\u0027endDate\u0027])\n\tif data.rowCount \u003d\u003d 0: \treturn {}\n\n\trow \u003d system.dataset.toPyDataSet(data)[0]\n\treturn {\n\t\t\u0027scheduledSecs\u0027: row[\u0027scheduledSecs\u0027],\n\t\t\u0027loggedInSecs\u0027: row[\u0027loggedInSecs\u0027],\n\t\t\u0027productiveSecs\u0027: row[\u0027productiveSecs\u0027],\n\t\t\u0027unplannedDowntimeSecs\u0027: row[\u0027unplannedDowntimeSecs\u0027],\n\t\t\u0027plannedDowntimeSecs\u0027: row[\u0027plannedDowntimeSecs\u0027]\n\t}\n\t",
            "type": "script"
          }
        ],
        "type": "property"
      }
    },
    "custom.plannedPct": {
      "binding": {
        "config": {
          "path": "view.custom.oleRow"
        },
        "overlayOptOut": true,
        "transforms": [
          {
            "code": "\n\tscheduledSecs \u003d value.get(\u0027scheduledSecs\u0027) or 0\n\tif scheduledSecs \u003c\u003d 0: return 0\n\treturn 100.0 * (value.get(\u0027plannedDowntimeSecs\u0027) or 0) / scheduledSecs\n\t",
            "type": "script"
          }
        ],
        "type": "property"
      }
    },
    "custom.productivePct": {
      "binding": {
        "config": {
          "path": "view.custom.oleRow"
        },
        "overlayOptOut": true,
        "transforms": [
          {
            "code": "\n\tscheduledSecs \u003d value.get(\u0027scheduledSecs\u0027) or 0\n\tif scheduledSecs \u003c\u003d 0: return 0\n\treturn 100.0 * (value.get(\u0027productiveSecs\u0027) or 0) / scheduledSecs\n\t",
