          "pageScope": true,
          "script": "\n\tif payload[\u0027itemStateInfo\u0027][\u0027counterId\u0027] !\u003d self.view.params.value.counter.counterId: return\n\t\n#\tsystem.perspective.print(\u0027countButtonRow - itemStateSelected msg rcvd for counterId %s by %s\u0027%(payload[\u0027itemStateInfo\u0027][\u0027counterId\u0027], self.view.params.value.counter.counterId))\n\n\tcountInfo \u003d dict(self.view.params.value.counter)\n\tcountInfo[\u0027value\u0027] \u003d self.view.custom.countIncrement\n\tcountInfo[\u0027itemStateId\u0027] \u003d payload[\u0027itemStateInfo\u0027][\u0027itemStateId\u0027]\n\tcountInfo[\u0027itemId\u0027] \u003d None\n\tcountInfo[\u0027workOrderId\u0027] \u003d None\n#\tsystem.perspective.print(\u0027Counter %s Sending msg itemStateCountUpdated with %s\u0027%(self.view.params.value.counter.counterId, {\u0027value\u0027: countInfo}))\n\tsystem.perspective.sendMessage(\u0027itemStateCountUpdated\u0027, {\u0027change\u0027: \u0027add\u0027, \u0027value\u0027: countInfo})\n\t\n\treturn\n\t",
          "sessionScope": false,
