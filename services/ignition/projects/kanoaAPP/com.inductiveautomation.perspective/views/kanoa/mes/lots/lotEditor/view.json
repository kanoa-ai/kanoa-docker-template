  "propConfig": {
    "custom.locationOptions": {
      "binding": {
        "config": {
          "expression": "now(0)"
        },
        "transforms": [
          {
            "code": "\t# Places stock can be: enabled assets that aren\u0027t transports\n\trows \u003d system.kanoa.utilities.convertDatasetToJSON(system.kanoa.asset.getAssets({\u0027enabled\u0027: True}))\n\treturn sorted([{\u0027label\u0027: r[\u0027displayPath\u0027] or r[\u0027assetPath\u0027], \u0027value\u0027: r[\u0027assetPath\u0027]} for r in rows if not r[\u0027mobile\u0027]], key\u003dlambda o: o[\u0027label\u0027])",
            "type": "script"
          }
        ],
        "type": "expr"
      }
    },
    "custom.lotChanged": {
      "binding": {
        "config": {
          "expression": "coalesce({view.custom.lotInfo.lotName}, \u0027\u0027) !\u003d coalesce({view.custom.original.lotName}, \u0027\u0027) || coalesce({view.custom.lotInfo.itemId}, -1) !\u003d coalesce({view.custom.original.itemId}, -1) || coalesce({view.custom.lotInfo.itemUnitId}, -1) !\u003d coalesce({view.custom.original.itemUnitId}, -1)"
        },
        "type": "expr"
      }
    },
    "custom.lotInfo": {
      "binding": {
        "config": {
          "path": "view.params.value"
        },
        "overlayOptOut": true,
        "transforms": [
          {
            "code": "\t\n\tlotInfo \u003d system.kanoa.utilities.convertDatasetRowToJSON(system.kanoa.lot.getLots({\u0027lotId\u0027: value[\u0027lotId\u0027] or -1}), 0)\n\t\n\treturn lotInfo\n\t\t",
            "type": "script"
          }
        ],
        "type": "property"
      },
      "persistent": true
    },
    "custom.original": {
      "binding": {
        "config": {
          "path": "view.params.value"
        },
        "overlayOptOut": true,
        "transforms": [
          {
            "code": "\t\n\tlotInfo \u003d system.kanoa.utilities.convertDatasetRowToJSON(system.kanoa.lot.getLots({\u0027lotId\u0027: value[\u0027lotId\u0027] or -1}), 0)\n\t\n\treturn lotInfo\n\t\t",
            "type": "script"
          }
        ],
        "type": "property"
      },
      "persistent": true
    },
    "custom.stock": {
      "binding": {
        "config": {
          "path": "view.params.stock"
        },
        "transforms": [
          {
            "code": "\t# Where the lot\u0027s stock the editor was opened on is, and how much: the starting values of the Stock fields\n\tif not value:\n\t\treturn None\n\treturn {\u0027assetPath\u0027: value[\u0027assetPath\u0027], \u0027qty\u0027: value[\u0027qty\u0027], \u0027comment\u0027: \u0027\u0027}",
            "type": "script"
          }
        ],
        "type": "property"
      },
      "persistent": true
    },
    "custom.stockChanged": {
      "binding": {
        "config": {
          "expression": "!isNull({view.params.stock}) \u0026\u0026 (coalesce({view.custom.stock.qty}, 0) !\u003d coalesce({view.params.stock.qty}, 0) || coalesce({view.custom.stock.assetPath}, \u0027\u0027) !\u003d coalesce({view.params.stock.assetPath}, \u0027\u0027))"
        },
        "type": "expr"
      }
    },
    "params.stock": {
      "paramDirection": "input",
      "persistent": true
    },
    "params.value": {
      "paramDirection": "input",
      "persistent": true
    }
  },
