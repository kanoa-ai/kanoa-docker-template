          "name": "save",
          "params": [],
          "script": "\t# Save the lot, then any change to its stock: a new quantity as an Adjust operation, a new location as a Transfer\n\tuserId \u003d system.kanoa.security.getIDPUserId(self.session.props.auth.user)\n\tdef toast(kind, message):\n\t\tsystem.kanoa.toast.show({\u0027type\u0027: kind, \u0027message\u0027: message})\n\n\tlotInfo \u003d self.view.custom.lotInfo\n\tlotChanged \u003d self.view.custom.lotChanged\n\tmsg \u003d None\n\tif not lotInfo[\u0027lotId\u0027]:\n\t\tlotId, msg \u003d system.kanoa.lot.addLot(lotInfo, userId)\n\telif lotChanged:\n\t\tretVal, msg \u003d system.kanoa.lot.updateLot(lotInfo, userId)\n\tif msg:\n\t\ttoast(\u0027warning\u0027, \u0027Lot was not saved. %s\u0027 % msg)\n\t\treturn False\n\n\tmsg, adjusted, selectLot \u003d self.adjustStock(userId)\n\tsystem.perspective.sendMessage(\u0027lotUpdate\u0027, {\u0027selectLot\u0027: selectLot})\n\tif msg:\n\t\ttoast(\u0027warning\u0027, \u0027The lot was saved, but its stock was not fully updated. %s\u0027 % msg)\n\t\treturn False\n\tif lotChanged and adjusted:\n\t\ttoast(\u0027success\u0027, \u0027Lot has been saved, and its stock updated\u0027)\n\telif adjusted:\n\t\ttoast(\u0027success\u0027, \u0027Stock has been updated\u0027)\n\telif lotChanged or not lotInfo[\u0027lotId\u0027]:\n\t\ttoast(\u0027success\u0027, \u0027Lot has been saved\u0027)\n\telse:\n\t\ttoast(\u0027info\u0027, \u0027Nothing changed\u0027)\n\treturn True"
        },
        {
          "name": "adjustStock",
          "params": [
            "userId"
          ],
          "script": "\t# Record a change to the stock the editor was opened on: a new quantity as an Adjust operation where the lot is (an\n\t# input takes stock out, an output puts it in), then a new location as a Transfer of what\u0027s left there. The lot state\n\t# and reason stay as they are. Returns (error or None, whether anything changed, the lot and place for the lot table to select).\n\tstock \u003d self.view.params.stock\n\tif not stock:\n\t\treturn None, False, None\n\tlotInfo \u003d self.view.custom.lotInfo\n\tfields \u003d self.view.custom.stock\n\tqty \u003d fields[\u0027qty\u0027] if fields[\u0027qty\u0027] is not None else 0\n\tpath \u003d fields[\u0027assetPath\u0027] or stock[\u0027assetPath\u0027]\n\thad \u003d stock[\u0027qty\u0027] or 0\n\tmoved \u003d path !\u003d stock[\u0027assetPath\u0027] and qty \u003e 0   # nothing left to move when it\u0027s adjusted to 0\n\tselectLot \u003d {\u0027lotId\u0027: stock[\u0027lotId\u0027], \u0027assetPath\u0027: path if moved else stock[\u0027assetPath\u0027]}\n\tif qty \u003c 0:\n\t\treturn \"The quantity can\u0027t be negative.\", False, selectLot\n\tif not moved and qty \u003d\u003d had:\n\t\treturn None, False, selectLot\n\n\tsources \u003d system.kanoa.utilities.convertDatasetToDict(system.kanoa.item.getItemSource({}), \u0027itemSourceName\u0027, \u0027itemSourceId\u0027)\n\ttStamp \u003d system.date.now()\n\tcomment \u003d (fields[\u0027comment\u0027] or \u0027\u0027).strip() or None\n\tdef event(source, eventQty, eventAssetId, transportId):\n\t\treturn {\n\t\t\t\u0027lotEventId\u0027: None, \u0027lotOperationEventId\u0027: None,\n\t\t\t\u0027lotId\u0027: stock[\u0027lotId\u0027], \u0027lotName\u0027: lotInfo[\u0027lotName\u0027], \u0027itemId\u0027: lotInfo[\u0027itemId\u0027], \u0027itemUnitId\u0027: lotInfo[\u0027itemUnitId\u0027],\n\t\t\t\u0027lotEventQty\u0027: eventQty, \u0027assetId\u0027: eventAssetId, \u0027itemSourceId\u0027: sources[source],\n\t\t\t\u0027lotStateId\u0027: stock[\u0027lotStateId\u0027], \u0027lotStateReasonId\u0027: stock[\u0027lotStateReasonId\u0027],\n\t\t\t\u0027workOrderId\u0027: None, \u0027shiftId\u0027: None, \u0027tStamp\u0027: tStamp, \u0027comment\u0027: comment, \u0027assetTransportId\u0027: transportId,\n\t\t}\n\tdef run(opName, assetId, inputs, outputs):\n\t\top \u003d system.kanoa.utilities.convertDatasetToJSON(system.kanoa.lot.getLotOperations({\u0027lotOperationName\u0027: opName}))\n\t\tif not op:\n\t\t\treturn \"There\u0027s no %s lot operation.\" % opName\n\t\toperation \u003d {\u0027lotOperationEventId\u0027: None, \u0027lotOperationId\u0027: op[0][\u0027lotOperationId\u0027], \u0027assetId\u0027: assetId, \u0027tStamp\u0027: tStamp, \u0027enabled\u0027: True}\n\t\tlotOperationEventId, msg \u003d system.kanoa.lot.executeLotOperation(operation, inputs, outputs, userId)\n\t\treturn msg\n\n\t# The new quantity, where the lot is now\n\tif qty !\u003d had:\n\t\tif qty \u003e had:\n\t\t\tmsg \u003d run(\u0027Adjust\u0027, stock[\u0027assetId\u0027], [], [event(\u0027output\u0027, qty - had, stock[\u0027assetId\u0027], stock[\u0027assetTransportId\u0027])])\n\t\telse:\n\t\t\tmsg \u003d run(\u0027Adjust\u0027, stock[\u0027assetId\u0027], [event(\u0027input\u0027, had - qty, stock[\u0027assetId\u0027], stock[\u0027assetTransportId\u0027])], [])\n\t\tif msg:\n\t\t\treturn msg, False, {\u0027lotId\u0027: stock[\u0027lotId\u0027], \u0027assetPath\u0027: stock[\u0027assetPath\u0027]}\n\t# Then all of it to the new location\n\tif moved:\n\t\tassetId \u003d system.kanoa.utilities.getFieldValue(\u0027assetId\u0027, system.kanoa.asset.getAssets({\u0027assetPath\u0027: path}))\n\t\tif assetId is None:\n\t\t\treturn \u0027There is no asset %s.\u0027 % path, qty !\u003d had, {\u0027lotId\u0027: stock[\u0027lotId\u0027], \u0027assetPath\u0027: stock[\u0027assetPath\u0027]}\n\t\tmsg \u003d run(\u0027Transfer\u0027, assetId, [event(\u0027input\u0027, qty, stock[\u0027assetId\u0027], stock[\u0027assetTransportId\u0027])], [event(\u0027output\u0027, qty, assetId, None)])\n\t\tif msg:\n\t\t\treturn (\u0027The quantity was adjusted, but the lot was not moved. %s\u0027 % msg) if qty !\u003d had else msg, qty !\u003d had, {\u0027lotId\u0027: stock[\u0027lotId\u0027], \u0027assetPath\u0027: stock[\u0027assetPath\u0027]}\n\treturn None, True, selectLot"
        }
      ],
      "extensionFunctions": null,
      "messageHandlers": [
        {
          "messageType": "lotItemSelected",
          "pageScope": true,
          "script": "\n\tsystem.perspective.print(\"lotItemSelected() msg rcvd with %s\"%payload)\n\t\n\tlotInfo \u003d dict(self.view.custom.lotInfo)\n\t\n\tif len(payload[\u0027selection\u0027]) \u003d\u003d 0: \n\t\tlotInfo[\u0027itemId\u0027] \u003d None\n\t\tlotInfo[\u0027itemPath\u0027] \u003d None\n\t\tlotInfo[\u0027itemUnitId\u0027] \u003d None\n\telse:\n\t\tsystem.perspective.print(\"Setting itemId to %s\"%payload[\u0027selection\u0027][0][\u0027value\u0027][\u0027itemId\u0027] if payload[\u0027selection\u0027][0][\u0027value\u0027].has_key(\u0027itemId\u0027) else None)\n\t\tlotInfo[\u0027itemId\u0027] \u003d payload[\u0027selection\u0027][0][\u0027value\u0027][\u0027itemId\u0027] if payload[\u0027selection\u0027][0][\u0027value\u0027].has_key(\u0027itemId\u0027) else None\n\t\tlotInfo[\u0027itemPath\u0027] \u003d payload[\u0027selection\u0027][0][\u0027value\u0027][\u0027itemPath\u0027] if payload[\u0027selection\u0027][0][\u0027value\u0027].has_key(\u0027itemPath\u0027) else None\n\n\tself.view.custom.lotInfo \u003d lotInfo\n\t\n\treturn",
          "sessionScope": false,
          "viewScope": false
        }
      ]
    },
    "type": "ia.container.flex"
  }
}