      {
        "children": [
          {
            "events": {
              "component": {
                "onActionPerformed": {
                  "config": {
                    "script": "\n\tstateInfo \u003d dict(self.view.custom.stateInfo)\n\tstateId \u003d stateInfo[\u0027stateId\u0027]\n\tstateCategoryId \u003d stateInfo[\u0027stateCategoryId\u0027]\n\tassetGroupId \u003d stateInfo[\u0027assetGroupId\u0027]\n\tuserId \u003d system.kanoa.security.getIDPUserId(self.session.props.auth.user)\n\t\n\tif stateInfo[\u0027assetGroupId\u0027] is not None:\n\t\ttry:\n\t\t\tint(stateInfo[\u0027assetGroupId\u0027])\n\t\texcept:\n\t\t\tnewAssetGroupId \u003d system.kanoa.asset.addAssetGroup(stateInfo[\u0027assetGroupId\u0027], userId)\n\t\t\tstateInfo[\u0027assetGroupId\u0027] \u003d newAssetGroupId\n\t\t\tsystem.perspective.sendMessage(\"refresh-ddAssetGroup-options\")\n\t\t\tself.view.custom.stateInfo.assetGroupId \u003d newAssetGroupId\n\t\n\tif stateId is not None: \t#If state name has changed, we need to check that it doesn\u0027t already exist\n\t\tcurrentStateId \u003d system.kanoa.utilities.getFieldValue(\u0027stateId\u0027, system.kanoa.asset.getStates({\u0027stateName\u0027: stateInfo[\u0027stateName\u0027], \u0027stateCategoryId\u0027 :stateInfo[\u0027stateCategoryId\u0027], \u0027assetGroupId\u0027: stateInfo[\u0027assetGroupId\u0027]}))\n\t\tif currentStateId is not None and currentStateId !\u003d stateId:\n\t\t\tsystem.kanoa.toast.show({\u0027type\u0027: \u0027error\u0027, \u0027message\u0027: \u0027This state already exists for this category\u0027})\n\t\t\treturn\n\t\t\n\t\tretVal, msg \u003d system.kanoa.asset.updateState(stateInfo, userId)\n\telse:\n\t\tstateId, msg \u003d system.kanoa.asset.addState(stateInfo, userId)\n\n\tsystem.perspective.sendMessage(\"updateStates\", {})\n\n\tif msg: system.kanoa.toast.show({\u0027type\u0027: \u0027error\u0027, \u0027message\u0027: \u0027Couldn\\\u0027t save state \"%s\": %s\u0027 % (stateInfo[\u0027stateName\u0027], msg)})\n\telse:\n\t\tsystem.kanoa.toast.show({\u0027type\u0027: \u0027success\u0027, \u0027message\u0027: \u0027State \"%s\" saved\u0027 % stateInfo[\u0027stateName\u0027]})\n\t\t#Clear the editor for the next state, keeping its category\n\t\tself.view.params.values \u003d {\u0027stateId\u0027: None, \u0027stateCategoryPath\u0027: stateInfo[\u0027stateCategoryPath\u0027]}\n\t\n\treturn"
                  },
                  "scope": "G",
                  "type": "script"
                }
              }
