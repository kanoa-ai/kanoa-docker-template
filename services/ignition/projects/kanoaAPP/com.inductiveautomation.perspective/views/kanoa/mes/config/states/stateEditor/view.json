            "events": {
              "component": {
                "onActionPerformed": {
                  "config": {
                    "script": "\n\tstateInfo \u003d dict(self.view.custom.stateInfo)\n\tstateId \u003d stateInfo[\u0027stateId\u0027]\n\tstateCategoryId \u003d stateInfo[\u0027stateCategoryId\u0027]\n\tassetGroupId \u003d stateInfo[\u0027assetGroupId\u0027]\n\tuserId \u003d system.kanoa.security.getIDPUserId(self.session.props.auth.user)\n\t\n\tif stateInfo[\u0027assetGroupId\u0027] is not None:\n\t\ttry:\n\t\t\tint(stateInfo[\u0027assetGroupId\u0027])\n\t\texcept:\n\t\t\tnewAssetGroupId \u003d system.kanoa.asset.addAssetGroup(stateInfo[\u0027assetGroupId\u0027], userId)\n\t\t\tstateInfo[\u0027assetGroupId\u0027] \u003d newAssetGroupId\n\t\t\tsystem.perspective.sendMessage(\"refresh-ddAssetGroup-options\")\n\t\t\tself.view.custom.stateInfo.assetGroupId \u003d newAssetGroupId\n\t\n\tif stateId is not None: \t#If state name has changed, we need to check that it doesn\u0027t already exist\n\t\tcurrentStateId \u003d system.kanoa.utilities.getFieldValue(\u0027stateId\u0027, system.kanoa.asset.getStates({\u0027stateName\u0027: stateInfo[\u0027stateName\u0027], \u0027stateCategoryId\u0027 :stateInfo[\u0027stateCategoryId\u0027], \u0027assetGroupId\u0027: stateInfo[\u0027assetGroupId\u0027]}))\n\t\tif currentStateId is not None and currentStateId !\u003d stateId:\n\t\t\tsystem.perspective.sendMessage(\u0027showFailerToast\u0027, {\u0027message\u0027: \u0027This state already exists for this category\u0027})\n\t\t\treturn\n\t\t\n\t\tsystem.perspective.sendMessage(\u0027showInfoToast\u0027, {\u0027message\u0027: \u0027Updating state Id %i \u0027%stateId})\t\t\t\n\t\tretVal, msg \u003d system.kanoa.asset.updateState(stateInfo, userId)\n\telse:\n\t\tsystem.perspective.sendMessage(\u0027showInfoToast\u0027, {\u0027message\u0027: \u0027Adding state\u0027})\t\n\t\tstateId, msg \u003d system.kanoa.asset.addState(stateInfo, userId)\n\n\tsystem.perspective.sendMessage(\"updateStates\", {})\n\n\tif msg: system.perspective.sendMessage(\u0027showFailerToast\u0027, {\u0027message\u0027: \"Couldn\u0027t save state. %s\"%msg})\n\telse:\n\t\tsystem.perspective.sendMessage(\u0027showSuccessfulToast\u0027, {\u0027message\u0027: \u0027State has been saved.\u0027})\n\t\tself.view.params.values.stateId \u003d stateId\n\t\n\treturn"
                  },
