{
  "custom": {
    "errorMessage": "No name provided.",
    "hasName": false,
    "isSelfPath": false,
    "newPath": "",
    "oldPath": "",
    "pathCorrect": true,
    "unique": false
  },
  "params": {
    "assetId": null,
    "assetPath": "",
    "mode": "import"
  },
  "propConfig": {
    "custom.errorMessage": {
      "binding": {
        "config": {
          "struct": {
            "hasName": "{view.custom.hasName}",
            "pathCorrect": "{view.custom.pathCorrect}",
            "unique": "{view.custom.unique}",
            "isSelfPath": "{view.custom.isSelfPath}",
            "mode": "{view.params.mode}"
          },
          "waitOnAll": true
        },
        "transforms": [
          {
            "code": "\t\n\tif not value.hasName: return 'No name provided.'\n\t\n\tif not value.pathCorrect: return 'The parent path must be at the same level as the imported file.'\n\t\n\tif not value.unique and value.isSelfPath and value.mode == 'duplicate': return 'Please provide a new name to duplicate this asset.'\n\t\n\treturn ''",
            "type": "script"
          }
        ],
        "type": "expr-struct"
      },
      "persistent": true
    },
    "custom.folder": {
      "binding": {
        "config": {
          "path": "view.custom.oldPath"
        },
        "overlayOptOut": true,
        "transforms": [
          {
            "code": "\t\n\treturn '\\\\'.join(value.split('\\\\')[:-1])\n\t",
            "type": "script"
          }
        ],
        "type": "property"
      }
    },
    "custom.hasName": {
      "binding": {
        "config": {
          "path": "view.custom.name"
        },
        "overlayOptOut": true,
        "transforms": [
          {
            "code": "\t\n\tname = value or None\n\t\n\treturn name is not None\n\t",
            "type": "script"
          }
        ],
        "type": "property"
      },
      "persistent": true
    },
    "custom.isSelfPath": {
      "binding": {
        "config": {
          "struct": {
            "newPath": "{view.custom.newPath}",
            "oldPath": "{view.custom.oldPath}"
          },
          "waitOnAll": true
        },
        "overlayOptOut": true,
        "transforms": [
          {
            "code": "\treturn value.newPath == value.oldPath",
            "type": "script"
          }
        ],
        "type": "expr-struct"
      },
      "persistent": true
    },
    "custom.name": {
      "binding": {
        "config": {
          "path": "view.custom.oldPath"
        },
        "overlayOptOut": true,
        "transforms": [
          {
            "code": "\t\n\treturn value.split('\\\\')[-1]\n\t",
            "type": "script"
          }
        ],
        "type": "property"
      }
    },
    "custom.newPath": {
      "binding": {
        "config": {
          "struct": {
            "folder": "{view.custom.folder}",
            "name": "{view.custom.name}"
          },
          "waitOnAll": true
        },
        "overlayOptOut": true,
        "transforms": [
          {
            "code": "\treturn '\\\\'.join(value.folder.split('\\\\') + [value.name]) if value.folder else value.name",
            "type": "script"
          }
        ],
        "type": "expr-struct"
      },
      "persistent": true
    },
    "custom.oldPath": {
      "binding": {
        "config": {
          "path": "view.params.assetPath"
        },
        "overlayOptOut": true,
        "type": "property"
      },
      "persistent": true
    },
    "custom.pathCorrect": {
      "binding": {
        "config": {
          "struct": {
            "newPath": "{view.custom.newPath}",
            "oldPath": "{view.custom.oldPath}"
          },
          "waitOnAll": true
        },
        "overlayOptOut": true,
        "transforms": [
          {
            "code": "\treturn len(value.oldPath.split('\\\\')) == len(value.newPath.split('\\\\'))",
            "type": "script"
          }
        ],
        "type": "expr-struct"
      },
      "persistent": true
    },
    "custom.unique": {
      "binding": {
        "config": {
          "path": "view.custom.newPath"
        },
        "overlayOptOut": true,
        "transforms": [
          {
            "code": "\t\n\tnewPath = value or None\n\t\n\tif newPath is None: return False\n\t\n\tunique = len(system.kanoa.asset.getAssets({'assetPath': newPath})) == 0\n\t\n\treturn unique\n\t",
            "type": "script"
          }
        ],
        "type": "property"
      },
      "persistent": true
    },
    "params.assetId": {
      "paramDirection": "input",
      "persistent": true
    },
    "params.assetPath": {
      "paramDirection": "input",
      "persistent": true
    },
    "params.mode": {
      "paramDirection": "input",
      "persistent": true
    }
  },
  "props": {
    "defaultSize": {
      "height": 199,
      "width": 350
    }
  },
  "root": {
    "children": [
      {
        "meta": {
          "domId": "lblInfo",
          "name": "lblInfo"
        },
        "position": {
          "shrink": 0
        },
        "props": {
          "style": {
            "marginBottom": 5
          },
          "text": "Provide a name for this asset. If the name already exists, you'll be asked to confirm overwriting it.",
          "textStyle": {
            "fontWeight": "bold"
          }
        },
        "type": "ia.display.label"
      },
      {
        "children": [
          {
            "meta": {
              "domId": "label",
              "name": "label"
            },
            "position": {
              "basis": "80px",
              "shrink": 0
            },
            "props": {
              "text": "Name",
              "textStyle": {
                "textAlignLast": "right"
              }
            },
            "type": "ia.display.label"
          },
          {
            "meta": {
              "domId": "textBox",
              "name": "textBox"
            },
            "position": {
              "grow": 1
            },
            "propConfig": {
              "props.text": {
                "binding": {
                  "config": {
                    "bidirectional": true,
                    "path": "view.custom.name"
                  },
                  "overlayOptOut": true,
                  "type": "property"
                }
              }
            },
            "props": {
              "deferUpdates": false
            },
            "type": "ia.input.text-field"
          }
        ],
        "meta": {
          "domId": "flxName",
          "name": "flxName"
        },
        "position": {
          "shrink": 0
        },
        "props": {
          "style": {
            "gap": 5
          }
        },
        "type": "ia.container.flex"
      },
      {
        "children": [
          {
            "meta": {
              "domId": "label-1",
              "name": "label"
            },
            "position": {
              "basis": "80px",
              "shrink": 0
            },
            "props": {
              "text": "Parent Path",
              "textStyle": {
                "textAlignLast": "right"
              }
            },
            "type": "ia.display.label"
          },
          {
            "meta": {
              "domId": "textBox-1",
              "name": "textBox",
              "tooltip": {
                "delay": 0,
                "location": "top",
                "sustain": 0,
                "tail": false,
                "text": "The asset is a root element. It cannot have a parent."
              }
            },
            "position": {
              "grow": 1
            },
            "propConfig": {
              "meta.tooltip.enabled": {
                "binding": {
                  "config": {
                    "path": "this.props.enabled"
                  },
                  "overlayOptOut": true,
                  "transforms": [
                    {
                      "code": "\treturn not value",
                      "type": "script"
                    }
                  ],
                  "type": "property"
                }
              },
              "props.enabled": {
                "binding": {
                  "config": {
                    "path": "view.custom.oldPath"
                  },
                  "overlayOptOut": true,
                  "transforms": [
                    {
                      "code": "\treturn value and len(value.split('\\\\')) > 1",
                      "type": "script"
                    }
                  ],
                  "type": "property"
                }
              },
              "props.text": {
                "binding": {
                  "config": {
                    "bidirectional": true,
                    "path": "view.custom.folder"
                  },
                  "overlayOptOut": true,
                  "type": "property"
                }
              }
            },
            "type": "ia.input.text-field"
          }
        ],
        "meta": {
          "domId": "flxParent",
          "name": "flxParent"
        },
        "position": {
          "shrink": 0
        },
        "props": {
          "style": {
            "gap": 5
          }
        },
        "type": "ia.container.flex"
      },
      {
        "children": [
          {
            "events": {
              "component": {
                "onActionPerformed": {
                  "config": {
                    "script": "\t\n\tif not self.view.custom.hasName:\n\t\tsystem.perspective.sendMessage('ShowWarningToast', 'No name was provided.')\n\t\treturn\n\t\n\tif not self.view.custom.pathCorrect:\n\t\tsystem.perspective.sendMessage('ShowWarningToast', 'The parent path must be at the same level as the imported file.')\n\t\treturn\n\t\n\tif not self.view.custom.unique and self.view.custom.isSelfPath and self.view.params.mode == 'duplicate':\n\t\tsystem.perspective.sendMessage('ShowWarningToast', 'Please provide a new name to duplicate this asset.')\n\t\treturn\n\t\n\tnewPath = self.view.custom.newPath\n\toldPath = self.view.custom.oldPath\n\toverwrite = not self.view.custom.unique\n\t\n\tsystem.perspective.sendMessage(\n\t\tmessageType='assetImportUpdate',\n\t\tpayload={\n\t\t\t'oldPath': oldPath,\n\t\t\t'newPath': newPath,\n\t\t\t'mode': self.view.params.mode,\n\t\t\t'assetId': self.view.params.assetId,\n\t\t\t'overwrite': overwrite,\n\t\t}\n\t)\n\t\n\tsystem.perspective.closePopup('')\n\t\n\treturn\n\t"
                  },
                  "scope": "G",
                  "type": "script"
                }
              }
            },
            "meta": {
              "domId": "btnConfirm",
              "name": "btnConfirm",
              "tooltip": {
                "delay": 0,
                "enabled": true,
                "location": "top",
                "sustain": 0,
                "tail": false
              }
            },
            "position": {
              "shrink": 0
            },
            "propConfig": {
              "meta.tooltip.text": {
                "binding": {
                  "config": {
                    "bidirectional": true,
                    "path": "view.custom.errorMessage"
                  },
                  "overlayOptOut": true,
                  "type": "property"
                }
              },
              "props.enabled": {
                "binding": {
                  "config": {
                    "path": "view.custom.errorMessage"
                  },
                  "overlayOptOut": true,
                  "transforms": [
                    {
                      "code": "\treturn value == ''",
                      "type": "script"
                    }
                  ],
                  "type": "property"
                }
              },
              "props.text": {
                "binding": {
                  "config": {
                    "path": "view.custom.unique"
                  },
                  "overlayOptOut": true,
                  "transforms": [
                    {
                      "code": "\treturn 'Confirm' if value else 'Overwrite'",
                      "type": "script"
                    }
                  ],
                  "type": "property"
                }
              }
            },
            "props": {
              "image": {
                "icon": {
                  "path": "material/check"
                }
              },
              "style": {
                "classes": "kanoa/button/filled"
              },
              "text": "Confirm"
            },
            "type": "ia.input.button"
          },
          {
            "events": {
              "component": {
                "onActionPerformed": {
                  "config": {
                    "script": "\t\n\tsystem.perspective.closePopup('')\n\t"
                  },
                  "scope": "G",
                  "type": "script"
                }
              }
            },
            "meta": {
              "domId": "btnClose",
              "name": "btnClose"
            },
            "position": {
              "shrink": 0
            },
            "props": {
              "image": {
                "icon": {
                  "path": "material/exit_to_app"
                }
              },
              "primary": false,
              "style": {
                "classes": "kanoa/button/outlined"
              },
              "text": "Close"
            },
            "type": "ia.input.button"
          }
        ],
        "meta": {
          "domId": "flxActions",
          "name": "flxActions"
        },
        "position": {
          "shrink": 0
        },
        "props": {
          "justify": "center",
          "style": {
            "gap": 5,
            "marginTop": "auto"
          }
        },
        "type": "ia.container.flex"
      }
    ],
    "meta": {
      "domId": "root",
      "name": "root"
    },
    "props": {
      "direction": "column",
      "style": {
        "backgroundColor": "",
        "classes": "kanoa/font/default",
        "gap": 5,
        "padding": 5
      }
    },
    "type": "ia.container.flex"
  }
}
