            "gap": "5px",
            "overflow": "hidden",
            "padding": "5px"
          }
        },
        "type": "ia.container.flex",
        "children": [
          {
            "events": {
              "component": {
                "onActionPerformed": {
                  "config": {
                    "script": "\n\ttoolingAssetId \u003d self.view.custom.toolingAssetId\n\tresult, msg \u003d system.kanoa.tooling.resetCounter({\u0027toolingAssetId\u0027: toolingAssetId, \u0027kind\u0027: \u0027pm\u0027, \u0027note\u0027: self.view.custom.note or None}, self.view.custom.security.userId)\n\tif msg: system.kanoa.toast.show({\u0027type\u0027: \u0027error\u0027, \u0027message\u0027: msg})\n\telse: system.kanoa.toast.show({\u0027type\u0027: \u0027success\u0027, \u0027message\u0027: \u0027PM done recorded\u0027})\n\tself.view.custom.refresh \u003d system.date.now()\n\tsystem.perspective.sendMessage(\u0027toolUpdated\u0027, {})\n\treturn"
                  },
                  "scope": "G",
                  "type": "script"
                }
              }
            },
            "meta": {
              "name": "btnPm"
            },
            "position": {
              "shrink": 0
            },
            "propConfig": {
              "position.display": {
                "binding": {
                  "config": {
                    "path": "view.custom.userAction"
                  },
                  "overlayOptOut": true,
                  "transforms": [
                    {
                      "code": "\n\treturn value[\u0027canUpdate\u0027]",
                      "type": "script"
                    }
                  ],
                  "type": "property"
                }
              }
            },
            "props": {
              "image": {
                "icon": {
                  "path": "material/replay"
                }
              },
              "style": {
                "classes": "kanoa/button/outlined"
              },
              "text": "PM done"
            },
            "type": "ia.input.button"
          },
          {
            "events": {
              "component": {
