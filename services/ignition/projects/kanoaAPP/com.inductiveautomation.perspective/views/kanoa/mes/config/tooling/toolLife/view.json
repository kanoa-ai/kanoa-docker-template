{
  "custom": {
    "adjust": {
      "counterName": null,
      "delta": null
    },
    "counters": {},
    "newStatus": null,
    "note": "",
    "refresh": null,
    "summary": [],
    "toolingAssetId": null,
    "userAction": {
      "canCreate": false,
      "canRead": true,
      "canUpdate": false
    }
  },
  "params": {
    "value": {
      "toolingAssetId": null
    }
  },
  "propConfig": {
    "custom.security": {
      "binding": {
        "config": {
          "path": "session.custom.kanoa.security"
        },
        "overlayOptOut": true,
        "type": "property"
      },
      "persistent": true
    },
    "params.value": {
      "paramDirection": "input",
      "persistent": true
    },
    "custom.toolingAssetId": {
      "binding": {
        "config": {
          "path": "view.params.value"
        },
        "overlayOptOut": true,
        "transforms": [
          {
            "code": "\n\treturn value.get(\u0027toolingAssetId\u0027) if value else None",
            "type": "script"
          }
        ],
        "type": "property"
      },
      "persistent": true
    },
    "custom.counters": {
      "binding": {
        "config": {
          "struct": {
            "toolingAssetId": "{view.custom.toolingAssetId}",
            "refresh": "{view.custom.refresh}"
          },
          "waitOnAll": true
        },
        "overlayOptOut": true,
        "transforms": [
          {
            "code": "\n\tif value[\u0027toolingAssetId\u0027] is None: return {}\n\trows \u003d system.kanoa.utilities.convertDatasetToJSON(system.kanoa.tooling.getCounters({\u0027toolingAssetId\u0027: value[\u0027toolingAssetId\u0027]}) or [])\n\treturn rows[0] if rows else {}",
            "type": "script"
          }
        ],
        "type": "expr-struct"
      }
    },
    "custom.summary": {
      "binding": {
        "config": {
          "path": "view.custom.counters"
        },
        "overlayOptOut": true,
        "transforms": [
          {
            "code": "\n\tc \u003d value\n\tif not c: return []\n\tunit \u003d {\u0027cycles\u0027: \u0027cycles\u0027, \u0027runMinutes\u0027: \u0027run minutes\u0027, \u0027calendarDays\u0027: \u0027days\u0027}.get(c[\u0027lifeUnit\u0027], \u0027\u0027)\n\tdef used(key): return c.get(key)\n\treturn [\n\t\t{\u0027count\u0027: \u0027Lifetime\u0027, \u0027cycles\u0027: c[\u0027lifetimeCycles\u0027], \u0027runMinutes\u0027: c[\u0027lifetimeRunMinutes\u0027], \u0027used\u0027: c[\u0027lifetimeUsed\u0027], \u0027limit\u0027: c[\u0027lifetimeLimit\u0027], \u0027pct\u0027: c[\u0027lifetimePct\u0027], \u0027unit\u0027: unit, \u0027since\u0027: None},\n\t\t{\u0027count\u0027: \u0027Since PM\u0027, \u0027cycles\u0027: c[\u0027cyclesSincePm\u0027], \u0027runMinutes\u0027: c[\u0027runMinutesSincePm\u0027], \u0027used\u0027: c[\u0027pmUsed\u0027], \u0027limit\u0027: c[\u0027pmInterval\u0027], \u0027pct\u0027: c[\u0027pmPct\u0027], \u0027unit\u0027: unit, \u0027since\u0027: c[\u0027lastPmDate\u0027]},\n\t\t{\u0027count\u0027: \u0027Since refurbishment\u0027, \u0027cycles\u0027: c[\u0027cyclesSinceRefurb\u0027], \u0027runMinutes\u0027: c[\u0027runMinutesSinceRefurb\u0027], \u0027used\u0027: c[\u0027refurbUsed\u0027], \u0027limit\u0027: c[\u0027refurbInterval\u0027], \u0027pct\u0027: c[\u0027refurbPct\u0027], \u0027unit\u0027: unit, \u0027since\u0027: c[\u0027lastRefurbDate\u0027]},\n\t\t{\u0027count\u0027: \u0027Refurbishments\u0027, \u0027cycles\u0027: None, \u0027runMinutes\u0027: None, \u0027used\u0027: c[\u0027refurbCount\u0027], \u0027limit\u0027: c[\u0027refurbLimit\u0027], \u0027pct\u0027: c[\u0027refurbCountPct\u0027], \u0027unit\u0027: \u0027\u0027, \u0027since\u0027: None},\n\t\t{\u0027count\u0027: \u0027Calibration\u0027, \u0027cycles\u0027: None, \u0027runMinutes\u0027: None, \u0027used\u0027: None, \u0027limit\u0027: c[\u0027calibrationIntervalDays\u0027], \u0027pct\u0027: c[\u0027calibrationPct\u0027], \u0027unit\u0027: \u0027days\u0027, \u0027since\u0027: c[\u0027lastCalibrationDate\u0027]}]",
            "type": "script"
          }
        ],
        "type": "property"
      }
    },
    "custom.userAction": {
      "binding": {
        "config": {
          "struct": {
            "security": "{view.custom.security}"
          },
          "waitOnAll": true
        },
        "overlayOptOut": true,
        "transforms": [
          {
            "code": "\n\tsecurity \u003d value[\u0027security\u0027]\n\tuserCRUD \u003d security[\u0027userCRUD\u0027] if security else {}\n\tcanEdit \u003d bool(userCRUD) and (userCRUD.get(\u0027isGatewayAdmin\u0027) or userCRUD.get(\u0027configureAssets\u0027, {}).get(\u0027enabled\u0027))\n\treturn {\u0027canCreate\u0027: canEdit, \u0027canUpdate\u0027: canEdit, \u0027canRead\u0027: True}",
            "type": "script"
          }
        ],
        "type": "expr-struct"
      }
    }
  },
