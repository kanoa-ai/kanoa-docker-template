{
  "custom": {
    "operatorStatus": [],
    "operators": {
      "selectedUserId": null
    }
  },
  "params": {
    "values": {
      "assetId": null
    }
  },
  "propConfig": {
    "custom.operatorStatus": {
      "binding": {
        "config": {
          "path": "view.custom.operators.selectedUserId"
        },
        "overlayOptOut": true,
        "transforms": [
          {
            "code": "\n\tif value is None: return []\n\treturn system.kanoa.utilities.convertDatasetToJSON(system.kanoa.operators.getOperators({\u0027userId\u0027: value, \u0027active\u0027: True}))",
            "type": "script"
          }
        ],
        "type": "property"
      },
      "persistent": true
    },
    "custom.operators": {
      "persistent": true
    },
    "custom.operators.data": {
      "binding": {
        "config": {
          "path": "view.params.values"
        },
        "overlayOptOut": true,
        "transforms": [
          {
            "code": "\t\n\tif value[\u0027assetId\u0027] is None: return []\n\treturn system.kanoa.utilities.convertDatasetToJSON(system.kanoa.security.getUsers({\u0027assetId\u0027: [value[\u0027assetId\u0027]], \u0027function\u0027: \u0027operateAssets\u0027}))",
            "type": "script"
          }
        ],
        "type": "property"
      }
    },
    "params.values": {
      "paramDirection": "input",
      "persistent": true
    }
  },
  "props": {
    "defaultSize": {
      "height": 36,
      "width": 590
    }
  },
  "root": {
    "children": [
      {
        "meta": {
          "name": "ddOperators"
        },
        "position": {
          "basis": "180px",
          "shrink": 0
        },
        "propConfig": {
          "props.options": {
            "binding": {
              "config": {
                "path": "view.custom.operators.data"
              },
              "overlayOptOut": true,
              "transforms": [
                {
                  "code": "\t\n\tif value is None: return []\n\treturn sorted({item[\u0027userId\u0027]: {\u0027value\u0027: item[\u0027userId\u0027], \u0027label\u0027: item[\u0027userName\u0027]} for item in value}.values(), key\u003dlambda user: user[\u0027label\u0027].lower())\n",
                  "type": "script"
                }
              ],
              "type": "property"
            }
          },
          "props.value": {
            "binding": {
              "config": {
                "bidirectional": true,
                "path": "view.custom.operators.selectedUserId"
              },
              "overlayOptOut": true,
              "type": "property"
            }
          }
        },
        "props": {
          "dropdownOptionStyle": {
            "classes": "kanoa/font/default"
          },
          "placeholder": {
            "text": "Select Operator..."
          },
          "showClearIcon": true,
          "style": {
            "classes": "kanoa/font/default",
            "height": "25px"
          }
        },
        "type": "ia.input.dropdown"
      },
      {
        "events": {
          "component": {
            "onActionPerformed": {
              "config": {
                "script": "\t\t\n\tuserId \u003d system.kanoa.security.getIDPUserId(self.session.props.auth.user)\n\tsessionInfo \u003d {\n\t\t\u0027userId\u0027: self.view.custom.operators.selectedUserId,\n\t\t\u0027assetId\u0027: self.view.params.values.assetId,\n\t\t\u0027workOrderId\u0027: None,\n\t\t\u0027tStamp\u0027: system.date.now()\n\t}\n\toperatorAssetSessionId, msg \u003d system.kanoa.operators.operatorLogin(sessionInfo, userId)\n\tif msg: \n\t\tsystem.perspective.sendMessage(\u0027showFailerToast\u0027, \u0027Operator Login failed %s\u0027%msg)\n\t\tsystem.perspective.print(\"Login failed: %s\" % str(msg))\n\telse:\n\t\tsystem.perspective.sendMessage(\u0027showSuccessfulToast\u0027, \u0027Operator Logged in\u0027)\n\t\t\n\tself.view.refreshBinding(\"custom.operatorStatus\")\n\tsystem.perspective.sendMessage(\u0027operatorLoginUpdated\u0027)\n\t\t\n\treturn"
              },
              "scope": "G",
              "type": "script"
            }
          }
        },
        "meta": {
          "name": "btnLogin"
        },
        "position": {
          "basis": "100px",
          "shrink": 0
        },
        "propConfig": {
          "position.display": {
            "binding": {
              "config": {
                "struct": {
                  "operatorStatus": "{view.custom.operatorStatus}",
                  "userId": "{view.custom.operators.selectedUserId}"
                },
                "waitOnAll": true
              },
              "overlayOptOut": true,
              "transforms": [
                {
                  "code": "\t\n\tif value[\u0027userId\u0027] is None: return False\n\treturn len(value[\u0027operatorStatus\u0027]) \u003d\u003d 0",
                  "type": "script"
                }
              ],
              "type": "expr-struct"
            }
          }
        },
        "props": {
          "image": {
            "icon": {
              "path": "material/login"
            }
          },
          "style": {
            "classes": "kanoa/button/filled",
            "height": "25px"
          },
          "text": "Login"
        },
        "type": "ia.input.button"
      },
      {
        "events": {
          "component": {
            "onActionPerformed": {
              "config": {
                "script": "\n\tuserId \u003d self.view.custom.operators.selectedUserId\n\tsessionInfo \u003d {\n\t\t\u0027userId\u0027: userId,\n\t\t\u0027assetId\u0027: self.view.custom.operatorStatus[0].assetId,\n\t\t\u0027tStamp\u0027: system.date.now()\n\t}\n\t\n\toperatorAssetSessionId, msg \u003d system.kanoa.operators.operatorLogout(sessionInfo, userId)\n\tif msg: \n\t\tsystem.perspective.sendMessage(\u0027showFailerToast\u0027, \u0027Operator Logout failed %s\u0027%msg)\n\t\tsystem.perspective.print(\"Logout failed: %s\" % str(msg))\n\telse:\n\t\tsystem.perspective.sendMessage(\u0027showSuccessfulToast\u0027, \u0027Operator Logged out\u0027)\n\t\t\n\tself.view.refreshBinding(\"custom.operatorStatus\")\n\tsystem.perspective.sendMessage(\u0027operatorLoginUpdated\u0027)\n\t\t\n\treturn"
              },
              "scope": "G",
              "type": "script"
            }
          }
        },
        "meta": {
          "name": "btnLogout"
        },
        "position": {
          "basis": "100px",
          "shrink": 0
        },
        "propConfig": {
          "position.display": {
            "binding": {
              "config": {
                "struct": {
                  "operatorStatus": "{view.custom.operatorStatus}",
                  "userId": "{view.custom.operators.selectedUserId}"
                },
                "waitOnAll": true
              },
              "overlayOptOut": true,
              "transforms": [
                {
                  "code": "\t\n\tif value[\u0027userId\u0027] is None: return False\n\treturn len(value[\u0027operatorStatus\u0027]) \u003e 0",
                  "type": "script"
                }
              ],
              "type": "expr-struct"
            }
          }
        },
        "props": {
          "image": {
            "icon": {
              "path": "material/exit_to_app"
            }
          },
          "style": {
            "classes": "kanoa/button/outlined",
            "height": "25px"
          },
          "text": "Logout"
        },
        "type": "ia.input.button"
      },
      {
        "meta": {
          "name": "lblInfo"
        },
        "position": {
          "grow": 1
        },
        "propConfig": {
          "props.text": {
            "binding": {
              "config": {
                "path": "view.custom.operatorStatus"
              },
              "overlayOptOut": true,
              "transforms": [
                {
                  "code": "\t\n\tif value is None or len(value) \u003d\u003d 0: return \u0027\u0027\n\treturn \u0027Currently logged in to %s\u0027%value[0][\u0027assetPath\u0027].split(\u0027\\\\\u0027)[-1]",
                  "type": "script"
                }
              ],
              "type": "property"
            }
          }
        },
        "type": "ia.display.label"
      }
    ],
    "meta": {
      "name": "root"
    },
    "props": {
      "alignItems": "center",
      "style": {
        "classes": "kanoa/font/default",
        "gap": "5px",
        "overflow": "hidden"
      }
    },
    "scripts": {
      "customMethods": [],
      "extensionFunctions": null,
      "messageHandlers": [
        {
          "messageType": "operatorLoginUpdated",
          "pageScope": true,
          "script": "\n\tself.view.refreshBinding(\"custom.operatorStatus\")\n\t\n\treturn",
          "sessionScope": false,
          "viewScope": false
        }
      ]
    },
    "type": "ia.container.flex"
  }
}