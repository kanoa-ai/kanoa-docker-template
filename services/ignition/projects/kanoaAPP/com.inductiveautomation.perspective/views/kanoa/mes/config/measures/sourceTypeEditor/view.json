      {
        "children": [
          {
            "events": {
              "component": {
                "onActionPerformed": {
                  "config": {
                    "script": "\n\tmeasureSourceTypeInfo \u003d dict(self.view.custom.sourceTypeInfo)\n\tuserId \u003d self.view.custom.security.userId\n\tmsg \u003d None\n\t\n\tsourceTypeId \u003d measureSourceTypeInfo[\u0027measureSourceTypeId\u0027]\n\t\n\tif sourceTypeId is not None:\n\t\tretVal, msg \u003d system.kanoa.measures.updateMeasureSourceType(measureSourceTypeInfo, userId)\n\telse: \n\t\tsourceTypeId \u003d system.kanoa.utilities.getFieldValue(\u0027measureSourceTypeId\u0027, system.kanoa.measures.getMeasureSourceTypes(measureSourceTypeInfo))\n\t\tif sourceTypeId: msg \u003d \u0027This measure already exists for this asset\u0027\n\t\telse:\n\t\t\tsourceTypeId, msg \u003d system.kanoa.measures.addMeasureSourceType(measureSourceTypeInfo, userId)\n\t\t\tmeasureSourceTypeInfo[\u0027measureSourceTypeId\u0027] \u003d sourceTypeId\n\t\t\t\n\tif msg:\t\n\t\tsystem.perspective.sendMessage(\u0027showFailerToast\u0027, {\u0027message\u0027: msg})\n\t\treturn\n\t\n\tsystem.perspective.sendMessage(\u0027showSuccessfulToast\u0027, {\u0027message\u0027: \u0027Measure Source Type saved\u0027})\n\n\tself.view.custom.sourceTypeInfo \u003d measureSourceTypeInfo\n\tself.view.custom.origSourceTypeInfo \u003d measureSourceTypeInfo\n\tsystem.perspective.sendMessage(\u0027measureSourceTypeUpdated\u0027, {})\n\t\n\treturn"
                  },
                  "scope": "G",
                  "type": "script"
                }
              }
            },
