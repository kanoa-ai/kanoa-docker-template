  "propConfig": {
    "custom.changesMade": {
      "binding": {
        "config": {
          "struct": {
            "info": "{view.custom.sourceTypeInfo}",
            "origInfo": "{view.custom.origSourceTypeInfo}"
          },
          "waitOnAll": true
        },
        "overlayOptOut": true,
        "transforms": [
          {
            "code": "\t\n\tif value[\u0027info\u0027][\u0027measureSourceTypeName\u0027] \u003d\u003d \u0027\u0027: return False\n\t\n\treturn dict(value[\u0027info\u0027]) !\u003d dict(value[\u0027origInfo\u0027])",
            "type": "script"
          }
        ],
        "type": "expr-struct"
      },
      "persistent": true
    },
    "custom.security": {
      "binding": {
        "config": {
          "path": "session.custom.kanoa.security"
        },
        "overlayOptOut": true,
        "type": "property"
      },
      "persistent": true
    },
    "custom.sourceTypeInfo": {
      "binding": {
        "config": {
          "path": "view.params.value"
        },
        "overlayOptOut": true,
        "transforms": [
          {
            "code": "\t\n\tinfo \u003d system.kanoa.utilities.convertDatasetRowToJSON(system.kanoa.measures.getMeasureSourceTypes({\u0027measureSourceTypeId\u0027: value.get(\u0027measureSourceTypeId\u0027,-1) or -1}), 0)\n\tinfo[\u0027measureSourceTypeName\u0027] \u003d info[\u0027measureSourceTypeName\u0027]  or \u0027\u0027\n\tinfo[\u0027description\u0027] \u003d info[\u0027description\u0027]  or \u0027\u0027\n\tif info[\u0027measureSourceTypeId\u0027] is None: info[\u0027enabled\u0027] \u003d True\n\t\n\treturn info",
            "type": "script"
          }
        ],
        "type": "property"
      },
      "onChange": {
        "enabled": null,
        "script": "\n\tif origin \u003d\u003d \u0027Binding\u0027: \n\t\tif self.custom.sourceTypeInfo: self.custom.origSourceTypeInfo \u003d dict(self.custom.sourceTypeInfo)\n\t\n\treturn"
      },
      "persistent": true
    },
    "params.value": {
      "paramDirection": "input",
      "persistent": true
    }
  },
  "props": {
    "defaultSize": {
      "height": 225,
      "width": 591
