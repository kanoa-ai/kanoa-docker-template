                          "code": "\t\n\ttagValues \u003d value.tagValues\n\tlocale \u003d self.session.props.locale\n\n\tif tagValues is None: return \u0027\u0027\n\tif tagValues[\u0027modeName\u0027] !\u003d \u0027Production\u0027: return \u0027\u0027\n\tworkOrder \u003d tagValues[\u0027workOrderTitle\u0027] if tagValues.has_key(\u0027workOrderTitle\u0027) else tagValues[\u0027workOrderName\u0027]\n\tvalues \u003d [workOrder, tagValues[\u0027itemName\u0027], tagValues[\u0027itemDescription\u0027]]\n\treturn \" \".join(v for v in values if v not in (None, \"\"))\n",
