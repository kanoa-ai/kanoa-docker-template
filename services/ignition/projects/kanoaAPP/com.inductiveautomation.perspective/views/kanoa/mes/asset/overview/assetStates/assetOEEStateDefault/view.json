          "transforms": [
            {
              "code": "\n\t#One tooltip for the whole cell, a line each: the state (or the mode outside production), who set the mode, the\n\t#order and item, and OEE against its target in production. Blank lines are left out\n\tinfo \u003d value[\u0027tagValues\u0027]\n\t#The saved placeholder (custom.tagOEEInfo.loading) until the asset\u0027s own data arrives: show nothing rather than \u0027No mode set\u0027\n\ttry: loading \u003d bool(info[\u0027loading\u0027])\n\texcept: loading \u003d False\n\tif info is not None and loading: return \u0027\u0027\n\t#\"Injection Press 1 is Running\", \"Machine 2 is Idle\", \"Machine 5 is in Maintenance\"\n\tt \u003d lambda s: system.util.translate(s, self.session.props.locale)\n\tname \u003d value[\u0027assetName\u0027] or t(\u0027Asset\u0027)\n\tif info is None: return t(\u0027%s is off line\u0027) % name\n\tlines \u003d []\n\tif info[\u0027modeName\u0027] is None: lines.append(t(\u0027%s has no mode set\u0027) % name)\n\telif info[\u0027modeName\u0027] \u003d\u003d \u0027Production\u0027: lines.append(t(\u0027%s is %s\u0027) % (name, t(info[\u0027stateName\u0027] or \u0027in an unknown state\u0027)))\n\telif info[\u0027modeName\u0027] \u003d\u003d \u0027Idle\u0027: lines.append(t(\u0027%s is Idle\u0027) % name)\n\telse: lines.append(t(\u0027%s is in %s\u0027) % (name, t(info[\u0027modeName\u0027])))\n\tsetBy \u003d info[\u0027userName\u0027] if info[\u0027userName\u0027] not in (None, \u0027\u0027, \u0027tagChange\u0027) else info[\u0027modeSourceName\u0027]\n\t#The mode by name, in production too (the line above names the state there), and who set it: \u0027Mode: Idle, set by Jason\u0027\n\tlines.append(t(\u0027Mode: %s%s\u0027) % (t(info[\u0027modeName\u0027] or \u0027none\u0027), (t(\u0027, set by %s\u0027) % setBy) if setBy else \u0027\u0027))\n\tif info[\u0027modeName\u0027] \u003d\u003d \u0027Production\u0027:\n\t\tworkOrder \u003d info[\u0027workOrderTitle\u0027] if info.has_key(\u0027workOrderTitle\u0027) else info[\u0027workOrderName\u0027]\n\t\torderItem \u003d \u0027 \u0027.join(v for v in (workOrder, info[\u0027itemName\u0027], info[\u0027itemDescription\u0027]) if v not in (None, \u0027\u0027))\n\t\tif orderItem: lines.append(orderItem)\n\tcolors \u003d value[\u0027oeeColors\u0027]\n\tif colors is not None and info[\u0027modeTypeName\u0027] \u003d\u003d \u0027Production\u0027:\n\t\toee \u003d round((info[\u0027availability\u0027] or 0.0) * (info[\u0027performance\u0027] or 0.0) * (info[\u0027quality\u0027] or 0.0) * 100.0, 1)\n\t\ttext \u003d {\u0027--kcGood\u0027: \u0027OEE on target\u0027, \u0027--kcOk\u0027: \u0027OEE within threshold\u0027, \u0027--kcBad\u0027: \u0027OEE below target\u0027}.get(colors[\u0027oee\u0027])\n\t\tif text: lines.append(\u0027%s: %s%%\u0027 % (t(text), oee))\n\treturn \u0027\\n\u0027.join(lines)",
              "type": "script"
            }
          ],
          "type": "expr-struct"
        }
      },
      "meta.visible": {
        "binding": {
          "config": {
            "path": "view.params.value.assetInfo.assetPath"
          },
          "overlayOptOut": true,
          "transforms": [
            {
              "code": "\treturn (value or None) is not None",
              "type": "script"
            }
          ],
          "type": "property"
        }
      },
      "props.style.borderLeftColor": {
        "binding": {
          "config": {
