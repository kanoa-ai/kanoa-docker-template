          },
          "overlayOptOut": true,
          "transforms": [
            {
              "code": "\n\t#The stripe on the card\u0027s left edge is the mode\u0027s colour; the outline colour with no mode\n\tif value is None: return \u0027var(--border)\u0027\n\treturn value[\u0027modeColor\u0027] or \u0027var(--border)\u0027",
              "type": "script"
            }
          ],
          "type": "property"
        }
      }
