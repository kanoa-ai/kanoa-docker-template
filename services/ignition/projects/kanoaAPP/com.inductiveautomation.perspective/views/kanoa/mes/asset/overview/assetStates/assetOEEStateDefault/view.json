                          "transforms": [
                            {
                              "code": "\n\tif value is None: return \u0027\u0027\n\treturn \u0027kanoa/animation/flashRed\u0027 if value[\u0027stateTypeName\u0027] \u003d\u003d \u0027Unplanned Downtime\u0027 and value[\u0027modeName\u0027] \u003d\u003d \u0027Production\u0027 else \u0027\u0027",
                              "type": "script"
