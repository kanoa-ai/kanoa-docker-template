  "propConfig": {
    "custom.canAdd": {
      "persistent": true
    },
    "custom.canSave": {
      "binding": {
        "config": {
          "struct": {
            "assetName": "{view.custom.values.assetName}",
            "duplicate": "{view.custom.customAttributes.duplicate}"
          },
          "waitOnAll": true
        },
        "overlayOptOut": true,
        "transforms": [
          {
            "code": "\treturn value.assetName !\u003d \u0027\u0027 and not value.duplicate",
            "type": "script"
          }
        ],
        "type": "expr-struct"
      },
      "persistent": true
    },
    "custom.currentTabIndex": {
      "binding": {
        "config": {
          "expression": "0"
        },
        "overlayOptOut": true,
        "type": "expr"
      }
    },
    "custom.data": {
      "binding": {
        "config": {
          "expression": "now(0)"
        },
        "transforms": [
          {
            "code": "\t\n\treturn system.kanoa.item.getItemClasses({})",
            "type": "script"
          }
        ],
        "type": "expr"
      },
      "persistent": true
    },
    "custom.values": {
      "binding": {
        "config": {
          "path": "view.params.value.itemClassId"
        },
        "overlayOptOut": true,
        "transforms": [
          {
            "code": "\n\tdata \u003d system.kanoa.utilities.convertDatasetRowToJSON(system.kanoa.item.getItemClasses({\u0027itemClassId\u0027: value or -1}), 0)\n\tif value is None:\n\t\tdata[\u0027enabled\u0027] \u003d True\n\t\tdata[\u0027itemClassName\u0027] \u003d \u0027\u0027\n\t\t\n\t\t\n\treturn data",
            "type": "script"
          }
        ],
        "type": "property"
      },
      "persistent": true
    },
    "params.equipId": {
      "paramDirection": "input",
      "persistent": true
    },
    "params.value": {
      "onChange": {
        "enabled": null,
        "script": "\t\n\tself.custom.canAdd \u003d True\n\t\n\treturn"
      },
      "paramDirection": "input",
      "persistent": true
    }
  },
