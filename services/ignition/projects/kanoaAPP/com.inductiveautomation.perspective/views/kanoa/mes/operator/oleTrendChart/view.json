              "overlayOptOut": true,
              "transforms": [
                {
                  "code": "\n\tinterval \u003d self.view.params[\u0027value\u0027][\u0027interval\u0027]\n\t\n\tlabelCol \u003d \u0027hourTimeStamp\u0027 if \u0027hourTimeStamp\u0027 in value.getColumnNames() else \u0027bucketStart\u0027\n\trows \u003d system.dataset.toPyDataSet(value)\n\t\n\tif interval is None and len(rows) \u003e\u003d 2:\n\t\tgapHours \u003d (rows[1][labelCol].getTime() - rows[0][labelCol].getTime()) / 3600000.0\n\t\tif gapHours \u003e\u003d 100: interval \u003d \u0027Week\u0027\n\t\telif gapHours \u003e\u003d 20: interval \u003d \u0027Day\u0027\n\t\telse: interval \u003d \u0027Hour\u0027\n\t\n\tformatPattern \u003d {\u0027Hour\u0027: \u0027MM-dd-yy HH:mm\u0027, \u0027Day\u0027: \u0027dd/MM/yy\u0027, \u0027Week\u0027: \u0027dd/MM/yy\u0027}.get(interval, \u0027MM-dd-yy HH:mm\u0027)\n\t\n\tdef formatLabel(ts):\n\t\treturn system.date.format(ts, formatPattern) if ts is not None else \u0027\u0027\n\t\n\treturn [\n\t\t{\n\t\t\t\u0027name\u0027: \u0027OLE Availability\u0027,\n\t\t\t\u0027data\u0027: [{\u0027x\u0027: formatLabel(row[labelCol]), \u0027y\u0027: round((row[\u0027oleAvailability\u0027] or 0) * 100, 1)} for row in rows]\n\t\t},\n\t\t{\n\t\t\t\u0027name\u0027: \u0027POLE Availability\u0027,\n\t\t\t\u0027data\u0027: [{\u0027x\u0027: formatLabel(row[labelCol]), \u0027y\u0027: round((row[\u0027poleAvailability\u0027] or 0) * 100, 1)} for row in rows]\n\t\t}\n\t]",
                  "type": "script"
                }
              ],
              "type": "property"
            }
          }
        },
        "props": {
