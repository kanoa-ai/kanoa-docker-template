          "script": "\n\tinfo \u003d dict(self.view.custom.values)\n\t\n\tsystem.perspective.print(\"save() called with %s\"%info)\t\n\t\n\titemStateClassId \u003d info[\u0027itemStateClassId\u0027]\n\tuserId \u003d system.kanoa.security.getIDPUserId(self.session.props.auth.user)\n\tif info[\u0027itemStateClassId\u0027] is None:\n\t\tif system.kanoa.utilities.getFieldValue(\u0027itemStateClassId\u0027, system.kanoa.item.getItemStateClasses({\u0027itemStateClassName\u0027: info[\u0027itemStateClassName\u0027], \u0027parentId\u0027: info[\u0027parentId\u0027]})) is not None:\n\t\t\tsystem.perspective.sendMessage(\u0027showWarningToast\u0027, {\u0027message\u0027: \u0027This item state class already exists\u0027})\n\t\t\treturn\n\t\t\n\t\titemStateClassId, msg \u003d system.kanoa.item.addItemStateClass(info, userId)\n\t\tsystem.perspective.print(\"addItemStateClass() returned %s %s\"%(itemStateClassId, msg)) \n\t\tif msg: system.perspective.sendMessage(\u0027showWarningToast\u0027, {\u0027message\u0027: \"Couldn\u0027t add item state class. %s\"%msg})\n\t\telse: system.perspective.sendMessage(\u0027showSuccessfulToast\u0027, {\u0027message\u0027: \u0027Item State Class added\u0027})\n\telse: \n\t\tretVal, msg \u003d system.kanoa.item.updateItemStateClass(info, userId)\n\t\tsystem.perspective.print(\"updateItemStateClass() returned %s %s\"%(retVal, msg)) \n\t\tif msg: system.perspective.sendMessage(\u0027showWarningToast\u0027, {\u0027message\u0027: \"Couldn\u0027t update item state class. %s\"%msg})\n\t\telse: system.perspective.sendMessage(\u0027showSuccessfulToast\u0027, {\u0027message\u0027: \u0027Item State Class updated\u0027})\n\t\t\n\tself.view.params.value.itemStateClassId \u003d itemStateClassId\n\tself.view.refreshBinding(\"custom.data\")\t #Update the Tree Selector\n\t\n\tsystem.perspective.sendMessage(\"refreshItemStateClasses\", {})\n\t\n\treturn"
        },
        {
          "name": "delete",
          "params": [],
          "script": "\n\tsystem.perspective.print(\"delete() called\")\n\n\tuserId \u003d system.kanoa.security.getIDPUserId(self.session.props.auth.user)\n\tretVal, msg \u003d system.kanoa.item.deleteItemStateClass(self.view.params.value.itemStateClassId, userId)\n\tif retVal is False or msg: system.perspective.sendMessage(\u0027showFailerToast\u0027, {\u0027message\u0027: \"Couldn\u0027t delete item state class. Check it has no child classes and isn\u0027t linked to any items. %s\"%(msg or \u0027\u0027)})\n\telse:\n\t\tself.view.params.value.itemStateClassId \u003d None\n\t\tsystem.perspective.sendMessage(\u0027clearTreeSelection\u0027, {\u0027msgHandler\u0027: \u0027itemStateClassEditor\u0027})\n\t\tsystem.perspective.sendMessage(\u0027showSuccessfulToast\u0027, {\u0027message\u0027: \u0027Item State Class deleted\u0027})\t\t\n\n\tself.view.refreshBinding(\"custom.data\")\t #Update the Tree Selector\n\tsystem.perspective.sendMessage(\"refreshItemStateClasses\", {})\t\n\t\n\treturn"
        }
      ],
      "extensionFunctions": null,
      "messageHandlers": [
        {
          "messageType": "updatePopupSelection",
          "pageScope": true,
          "script": "\n#\tsystem.perspective.print(\"updatePopupSelection msg rcvd with %s\"%payload)\n\n\tif len(payload[\u0027selection\u0027]) \u003d\u003d 0: return\n\t\n\tself.view.params.value.itemStateClassId \u003d payload[\u0027selection\u0027][0][\u0027value\u0027][\u0027itemStateClassId\u0027]\n\n\treturn",
          "sessionScope": false,
          "viewScope": false
        },
        {
          "messageType": "itemStateClassDropped",
          "pageScope": true,
          "script": "\n#\tsystem.perspective.print(\"itemStateClassDropped() msg rcvd with %s\"%payload)\n\tdraggedItem \u003d payload[\u0027draggedItem\u0027]\n\tdroppedItem \u003d payload[\u0027droppedItem\u0027]\n\t\n\tdef rejectDrop(message):\n\t\tsystem.perspective.sendMessage(\u0027showWarningToast\u0027, {\u0027message\u0027: message})\n\t\tself.view.refreshBinding(\u0027custom.data\u0027)\t#Undo the move the tree has already shown\n\t\n\titemStateClassId \u003d draggedItem.get(\u0027itemStateClassId\u0027)\n\tif itemStateClassId is None:\n\t\tself.view.refreshBinding(\u0027custom.data\u0027)\n\t\treturn\n\t\n\tif droppedItem is not None and droppedItem.get(\u0027itemStateClassId\u0027) is None:\t#e.g. a parent node only shown because of the search filter\n\t\trejectDrop(\u0027Cannot move an item state class there\u0027)\n\t\treturn\n\t\n\tparentId \u003d droppedItem[\u0027itemStateClassId\u0027] if droppedItem is not None else None\n\tif draggedItem[\u0027parentId\u0027] \u003d\u003d parentId:\t#Dropped onto its current parent. Item state classes have no sort order, so there is nothing to change\n\t\tself.view.refreshBinding(\u0027custom.data\u0027)\n\t\treturn\n\t\n\tdraggedPath \u003d draggedItem[\u0027path\u0027] or \u0027\u0027\n\tdroppedPath \u003d (droppedItem[\u0027path\u0027] or \u0027\u0027) if droppedItem is not None else \u0027\u0027\n\tif droppedItem is not None and droppedPath.startswith(draggedPath + \u0027\\\\\u0027):\n\t\trejectDrop(\u0027Cannot move an item state class into one of its own children\u0027)\n\t\treturn\n\t\n\titemStateClassName \u003d (draggedItem[\u0027itemStateClassName\u0027] or \u0027\u0027).lower()\n\tfor sibling in system.dataset.toPyDataSet(system.kanoa.item.getItemStateClasses({})):\t#A None parentId isn\u0027t filtered on, so check it here\n\t\tif sibling[\u0027parentId\u0027] \u003d\u003d parentId and (sibling[\u0027itemStateClassName\u0027] or \u0027\u0027).lower() \u003d\u003d itemStateClassName:\n\t\t\trejectDrop(\u0027An item state class named %s already exists there\u0027%draggedItem[\u0027itemStateClassName\u0027])\n\t\t\treturn\n\t\n\titemStateClassPath \u003d system.kanoa.utilities.formatPath(draggedPath, {})\n\tparentPath \u003d system.kanoa.utilities.formatPath(droppedPath, {}) if droppedItem is not None else \u0027the top level\u0027\n\tmsg \u003d \"Are you sure you want to move %s to %s\"%(itemStateClassPath, parentPath)\n\tsystem.perspective.openPopup(\u0027moveItemStateClass\u0027, \u0027kanoa/core/templates/inputs/confirm\u0027, {\u0027text\u0027: msg, \u0027messageHandler\u0027: \u0027confirmMoveItemStateClass\u0027, \u0027inputPayload\u0027: {\u0027itemStateClassId\u0027: itemStateClassId, \u0027parentId\u0027: parentId}}, title\u003d\u0027Move Item State Class?\u0027, draggable\u003dTrue)\n\t\n\treturn\n",
          "sessionScope": false,
          "viewScope": false
        },
        {
          "messageType": "confirmMoveItemStateClass",
          "pageScope": true,
          "script": "\n#\tsystem.perspective.print(\"confirmMoveItemStateClass() msg rcvd with %s\"%payload)\n\titemStateClassId \u003d payload[\u0027inputPayload\u0027][\u0027itemStateClassId\u0027]\n\t\n\tif payload[\u0027userInput\u0027] \u003d\u003d \u0027OK\u0027:\n\t\tinfo \u003d system.kanoa.utilities.convertDatasetRowToJSON(system.kanoa.item.getItemStateClasses({\u0027itemStateClassId\u0027: itemStateClassId}), 0)\n\t\tif info[\u0027itemStateClassId\u0027] is None:\n\t\t\tsystem.perspective.sendMessage(\u0027showFailerToast\u0027, {\u0027message\u0027: \u0027Item state class was not moved. It no longer exists\u0027})\n\t\telse:\n\t\t\tinfo[\u0027parentId\u0027] \u003d payload[\u0027inputPayload\u0027][\u0027parentId\u0027]\n\t\t\tuserId \u003d system.kanoa.security.getIDPUserId(self.session.props.auth.user)\n\t\t\tretVal, msg \u003d system.kanoa.item.updateItemStateClass(info, userId)\n\t\t\tif msg: system.perspective.sendMessage(\u0027showFailerToast\u0027, {\u0027message\u0027: \u0027Item state class was not moved. %s\u0027%msg})\n\t\t\telse:\n\t\t\t\tsystem.perspective.sendMessage(\u0027showSuccessfulToast\u0027, {\u0027message\u0027: \u0027Item state class has been moved\u0027})\n\t\t\t\tsystem.perspective.sendMessage(\"refreshItemStateClasses\", {})\n\t\t\n\t\tself.view.params.value.itemStateClassId \u003d itemStateClassId\n\t\tself.view.refreshBinding(\u0027custom.values\u0027)\t#Its path has changed even if it was already selected\n\t\n\tself.view.refreshBinding(\u0027custom.data\u0027)\t#Update the Tree Selector (and undo the move it showed if cancelled)\n\t\n\treturn\n",
          "sessionScope": false,
          "viewScope": false
        },
        {
          "messageType": "confirmDeleteItemStateClass",
          "pageScope": true,
          "script": "\n\tif payload[\u0027userInput\u0027] \u003d\u003d \u0027OK\u0027: self.delete()\n\t\n\treturn\n",
          "sessionScope": false,
          "viewScope": false
        }
      ]
    },
    "type": "ia.container.flex"
  }
