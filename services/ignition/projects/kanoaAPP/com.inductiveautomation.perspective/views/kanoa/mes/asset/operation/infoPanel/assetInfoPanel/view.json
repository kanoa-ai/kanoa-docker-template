{
  "custom": {
    "display": {},
    "stripHover": false
  },
  "params": {
    "value": {
      "assetId": null
    }
  },
  "propConfig": {
    "custom.display": {
      "persistent": true
    },
    "custom.display.showNavigation": {
      "binding": {
        "config": {
          "path": "view.params.value.assetId"
        },
        "overlayOptOut": true,
        "transforms": [
          {
            "code": "\t\n\tif not value: return False\n\tassetPath \u003d system.kanoa.utilities.getFieldValue(\u0027assetPath\u0027, system.kanoa.asset.getAssets({\u0027assetId\u0027: value}))\n\treturn True if system.kanoa.asset.getClosestAncestorAttribute(assetPath, \u0027_assetOperationNavLocation\u0027) \u003d\u003d \u0027Left Panel\u0027 else False",
            "type": "script"
          }
        ],
        "type": "property"
      }
    },
    "params.value": {
      "paramDirection": "input",
      "persistent": true
    }
  },
  "props": {
    "defaultSize": {
      "width": 471
    }
  },
  "root": {
    "children": [
      {
        "children": [
          {
            "events": {
              "dom": {
                "onClick": {
                  "config": {
                    "script": "\n\t#Collapse the info panel to its icon strip: a session-wide setting, kept across assets and pages (main reads it to\n\t#size the split). Resting the pointer on the strip expands it again (root onMouseEnter) (868mw9nd7)\n\tself.session.custom.kanoa.infoPanelCollapsed \u003d True\n\treturn"
                  },
                  "scope": "G",
                  "type": "script"
                }
              }
            },
            "meta": {
              "name": "icoCollapse",
              "tooltip": {
                "enabled": true,
                "text": "Collapse the panel"
              }
            },
            "position": {
              "basis": "24px",
              "shrink": 0
            },
            "props": {
              "color": "var(--kcOnSurfaceVariant)",
              "path": "material/double_arrow",
              "style": {
                "classes": "kanoa/panelSectionLink",
                "height": "24px",
                "transform": "scaleX(-1)",
                "width": "24px"
              }
            },
            "type": "ia.display.icon"
          }
        ],
        "meta": {
          "name": "flxPanelTop"
        },
        "position": {
          "shrink": 0
        },
        "props": {
          "alignItems": "center",
          "justify": "flex-start",
          "style": {
            "classes": "kanoa/stripHide",
            "paddingLeft": "8px",
            "paddingRight": "3px"
          }
        },
        "type": "ia.container.flex"
      },
      {
        "children": [
          {
            "meta": {
              "domId": "evAssetInfo",
              "name": "evAssetInfo"
            },
            "position": {
              "grow": 1
            },
            "propConfig": {
              "props.params.value.assetId": {
                "binding": {
                  "config": {
                    "path": "view.params.value.assetId"
                  },
                  "overlayOptOut": true,
                  "type": "property"
                }
              }
            },
            "props": {
              "params": {
                "value": {}
              },
              "path": "kanoa/mes/asset/operation/infoPanel/embedded/assetInfo"
            },
            "type": "ia.display.view"
          }
        ],
        "meta": {
          "domId": "flxAssetInfo",
          "name": "flxAssetInfo"
        },
        "position": {
          "grow": 1,
          "shrink": 0
        },
        "props": {
          "direction": "column"
        },
        "type": "ia.container.flex"
      },
      {
        "children": [
          {
            "meta": {
              "domId": "evNavitems",
              "name": "evNavitems"
            },
            "position": {
              "grow": 1
            },
            "propConfig": {
              "position.display": {
                "binding": {
                  "config": {
                    "path": "view.custom.display"
                  },
                  "overlayOptOut": true,
                  "transforms": [
                    {
                      "code": "\ttry:\n\t\treturn value[\u0027showNavigation\u0027] or False\n\texcept:\n\t\tFalse",
                      "type": "script"
                    }
                  ],
                  "type": "property"
                }
              },
              "props.params.value.assetPath": {
                "binding": {
                  "config": {
                    "path": "view.params.value.assetId"
                  },
                  "overlayOptOut": true,
                  "transforms": [
                    {
                      "code": "\treturn system.kanoa.utilities.getFieldValue(\u0027assetPath\u0027, system.kanoa.asset.getAssets({\u0027assetId\u0027: value or -1}))",
                      "type": "script"
                    }
                  ],
                  "type": "property"
                }
              }
            },
            "props": {
              "params": {
                "value": {}
              },
              "path": "kanoa/mes/asset/operation/navigation/navSelector"
            },
            "type": "ia.display.view"
          }
        ],
        "meta": {
          "domId": "flxNavItems",
          "name": "flxNavItems"
        },
        "position": {
          "grow": 1
        },
        "propConfig": {
          "position.display": {
            "binding": {
              "config": {
                "path": "view.custom.display"
              },
              "overlayOptOut": true,
              "transforms": [
                {
                  "code": "\t\n\tif not value.has_key(\u0027showNavigation\u0027): return False\n\treturn value[\u0027showNavigation\u0027] or False",
                  "type": "script"
                }
              ],
              "type": "property"
            }
          }
        },
        "type": "ia.container.flex",
        "props": {
          "style": {
            "classes": "kanoa/stripHide"
          }
        }
      }
    ],
    "events": {
      "dom": {
        "onMouseEnter": {
          "config": {
            "script": "\n\t#Collapsed: resting the pointer on the strip for 0.3 s expands the panel in place, and it stays (as pressing the chevron\n\t#does), so passing over the strip on the way to the dashboard leaves it collapsed. The wait runs on its own thread, so\n\t#onMouseLeave can clear stripHover meanwhile (868mw9nd7)\n\tfrom java.lang import Thread\n\tsession \u003d self.session\n\tview \u003d self.view\n\ttry:\n\t\tcollapsed \u003d bool(session.custom.kanoa.infoPanelCollapsed)\n\texcept:\n\t\tcollapsed \u003d False\n\tif not collapsed: return\n\tview.custom.stripHover \u003d True\n\n\tdef expand():\n\t\tThread.sleep(300)\n\t\ttry:\n\t\t\tif view.custom.stripHover:\n\t\t\t\tsession.custom.kanoa.infoPanelCollapsed \u003d False\n\t\texcept:\n\t\t\tpass\n\n\tsystem.util.invokeAsynchronous(expand)\n\treturn"
          },
          "scope": "G",
          "type": "script"
        },
        "onMouseLeave": {
          "config": {
            "script": "\n\tself.view.custom.stripHover \u003d False\n\treturn"
          },
          "scope": "G",
          "type": "script"
        }
      }
    },
    "meta": {
      "domId": "root",
      "name": "root"
    },
    "props": {
      "direction": "column"
    },
    "scripts": {
      "customMethods": [],
      "extensionFunctions": null,
      "messageHandlers": [
        {
          "messageType": "navLocationUpdated",
          "pageScope": true,
          "script": "\t\n\tself.view.refreshBinding(\"custom.display.showNavigation\")\n\t\n\treturn",
          "sessionScope": true,
          "viewScope": false
        }
      ]
    },
    "type": "ia.container.flex"
  }
}