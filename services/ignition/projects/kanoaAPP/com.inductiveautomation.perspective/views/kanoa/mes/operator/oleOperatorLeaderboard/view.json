                {
                  "code": "\n\tif value[\u0027assetId\u0027] is None or value[\u0027startDate\u0027] is None or value[\u0027endDate\u0027] is None:\n\t\treturn []\n\n\tdata \u003d system.kanoa.operators.getOLEOperatorLeaderboard(\n\t\tvalue[\u0027assetId\u0027], value[\u0027startDate\u0027], value[\u0027endDate\u0027], value[\u0027attributionMode\u0027] or \u0027EvenSplit\u0027\n\t)\n\n\tinstances \u003d []\n\trank \u003d 0\n\tfor row in system.dataset.toPyDataSet(data):\n\t\trank +\u003d 1\n\t\tscheduledSecs \u003d row[\u0027scheduledSecs\u0027] or 0\n\t\tattendance \u003d ((row[\u0027loggedInSecs\u0027] or 0) / float(scheduledSecs)) if scheduledSecs \u003e 0 else 0\n\t\tinstances.append({\u0027value\u0027: {\n\t\t\t\u0027rank\u0027: rank,\n\t\t\t\u0027userName\u0027: row[\u0027userName\u0027],\n\t\t\t\u0027attendance\u0027: round(attendance, 3),\n\t\t\t\u0027ole\u0027: round(row[\u0027ole\u0027] or 0, 3),\n\t\t\t\u0027pole\u0027: round(row[\u0027pole\u0027] or 0, 3),\n\t\t\t\u0027performance\u0027: round(row[\u0027performance\u0027] or 0, 3),\n\t\t\t\u0027quality\u0027: round(row[\u0027quality\u0027] or 0, 3)\n\t\t}})\n\n\treturn instances\n\t",
                  "type": "script"
                }
              ],
