{
  "custom": {
    "assetShiftOEEData": [],
    "displayOptions": {},
    "filters": {
      "assetId": null,
      "assetPath": null,
      "dateRange": {
        "endDate": null,
        "selectedRange": null,
        "startDate": null
      },
      "fontSizeMultiplier": 2,
      "selectedRange": null,
      "shiftIndex": 0,
      "woInfo": {
        "product": null,
        "scheduleId": null,
        "woId": null
      }
    },
    "oeeColors": {
      "availability": "--kcBad",
      "oee": "--kcBad",
      "performance": "--kcBad",
      "quality": "--kcBad"
    },
    "oeeInfo": {
      "a": 0,
      "assetName": "",
      "oee": 0,
      "p": 0,
      "q": 0,
      "shift": "",
      "shiftStart": null
    },
    "oeePath": "",
    "currentShift": {}
  },
  "params": {
    "value": {
      "assetPath": null,
      "fontSizeMultiplier": 2,
      "shiftIndex": 0
    }
  },
  "propConfig": {
    "custom.assetShiftOEEData": {
      "binding": {
        "config": {
          "fallbackDelay": 2.5,
          "mode": "indirect",
          "references": {
            "oeePath": "{view.custom.oeePath}"
          },
          "tagPath": "[kanoaMES]{oeePath}/OEE/Previous Shifts"
        },
        "overlayOptOut": true,
        "transforms": [
          {
            "code": "\n\t#The shifts that ended in the last day, newest first (OeeTags writes them at each recount)\n\treturn system.kanoa.utilities.convertDatasetToJSON(value) if value else []",
            "type": "script"
          }
        ],
        "type": "tag"
      },
      "persistent": true
    },
    "custom.displayOptions": {
      "persistent": true
    },
    "custom.displayOptions.fontSize": {
      "binding": {
        "config": {
          "path": "view.params.value"
        },
        "overlayOptOut": true,
        "transforms": [
          {
            "code": "\t\n\tif value.has_key('fontSizeMultiplier'): return '{}vw'.format(value['fontSizeMultiplier'])\n\t\n\treturn '2vw'",
            "type": "script"
          }
        ],
        "type": "property"
      }
    },
    "custom.filters": {
      "binding": {
        "config": {
          "struct": {
            "viewParams": "{view.params.value}"
          },
          "waitOnAll": true
        },
        "overlayOptOut": true,
        "transforms": [
          {
            "code": "\n\tif value['viewParams'] is None: return {}\n\t\n\tfilters = system.kanoa.dashboard.getWidgetFilters(self.page.props.pageId, value['viewParams'], self.session.custom.kanoa, self.session.props.device.timezone.id)\n\tfilters['selectedRange'] = value['viewParams']['selectedRange'] if value['viewParams'].has_key('selectedRange') else None\n\t\t\n\treturn filters",
            "type": "script"
          }
        ],
        "type": "expr-struct"
      },
      "persistent": true
    },
    "custom.oeeColors": {
      "binding": {
        "config": {
          "path": "view.custom.oeeInfo"
        },
        "overlayOptOut": true,
        "transforms": [
          {
            "code": "\n\treturn system.kanoa.event.getOEEColors({'assetPath': self.custom.filters.assetPath}, value['oee'], value['a'], value['p'], value['q'])",
            "type": "script"
          }
        ],
        "type": "property"
      },
      "persistent": true
    },
    "custom.oeeInfo": {
      "binding": {
        "config": {
          "struct": {
            "current": "{view.custom.currentShift}",
            "filters": "{view.custom.filters}",
            "params": "{view.params.value}",
            "previous": "{view.custom.assetShiftOEEData}"
          },
          "waitOnAll": true
        },
        "overlayOptOut": true,
        "transforms": [
          {
            "code": "\n\t#The asset's shift by shiftIndex: 0 the current shift (OEE/info, kept up to date as counts and states come in), 1 the\n\t#one before it and so on (OEE/Previous Shifts). Both worked out by OeeTags, so the widget shows what the operation\n\t#views show; it read every asset's last day from the getAssetShiftOEETimer tag timer and summed its asset's (868mub5zn)\n\tassetName = value['params']['assetPath'].split('\\\\')[-1] if value['params']['assetPath'] else ''\n\toeeInfo = {'a': 0.0, 'p': 0.0, 'q': 0.0, 'oee': 0.0, 'shift': '', 'shiftName': '', 'shiftStart': None, 'assetName': assetName}\n\tshiftIndex = value['params']['shiftIndex']\n\tif value['filters'].get('assetId') is None or shiftIndex is None: return oeeInfo\n\tif shiftIndex == 0:\n\t\trow = value['current'] or {}\n\t\tstart = row.get('shiftStart')\n\t\tstart = system.date.fromMillis(long(start)) if start is not None else None\n\telse:\n\t\tprevious = value['previous'] or []\n\t\tif len(previous) < shiftIndex: return oeeInfo\n\t\trow = previous[shiftIndex - 1]\n\t\tstart = row.get('shiftStart')\n\t\trow = {'a': row.get('availability'), 'p': row.get('performance'), 'q': row.get('quality'), 'oee': row.get('oee'), 'shiftName': row.get('shiftName')}\n\tif row.get('oee') is None and row.get('a') is None: return oeeInfo\n\tfor key in ['a', 'p', 'q', 'oee']:\n\t\toeeInfo[key] = float(row.get(key) or 0.0)\n\toeeInfo['shiftName'] = row.get('shiftName') or ''\n\toeeInfo['shift'] = oeeInfo['shiftName']\n\toeeInfo['shiftStart'] = start\n\treturn oeeInfo",
            "type": "script"
          }
        ],
        "type": "expr-struct"
      },
      "persistent": true
    },
    "params.value": {
      "paramDirection": "input",
      "persistent": true
    },
    "custom.oeePath": {
      "binding": {
        "config": {
          "expression": "replace(try({view.custom.filters.assetPath}, \"\"), \"\\\\\", \"/\")"
        },
        "overlayOptOut": true,
        "type": "expr"
      },
      "persistent": true
    },
    "custom.currentShift": {
      "binding": {
        "config": {
          "fallbackDelay": 2.5,
          "mode": "indirect",
          "references": {
            "oeePath": "{view.custom.oeePath}"
          },
          "tagPath": "[kanoaMES]{oeePath}/OEE/info"
        },
        "overlayOptOut": true,
        "transforms": [
          {
            "code": "\n\tif not value: return {}\n\tinfo = system.util.jsonDecode(str(value))\n\tshift = info.get('Current Shift') or {}\n\tstatus = info.get('Status') or {}\n\treturn {'a': shift.get('availability'), 'p': shift.get('performance'), 'q': shift.get('quality'), 'oee': shift.get('oee'),\n\t\t\t'shiftName': status.get('shiftName'), 'shiftStart': shift.get('startDate')}",
            "type": "script"
          }
        ],
        "type": "tag"
      },
      "persistent": true
    }
  },
