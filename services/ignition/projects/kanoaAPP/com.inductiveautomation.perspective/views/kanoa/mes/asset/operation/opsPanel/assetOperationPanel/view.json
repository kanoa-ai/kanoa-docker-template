      }
    },
    "custom.display.screenDashboard": {
      "binding": {
        "config": {
          "path": "view.custom.display.dashboardFilter"
        },
        "overlayOptOut": true,
        "transforms": [
          {
            "code": "\n\tsystem.perspective.print(\"dashboardfilter change %s\"%value)\n\tif value[\u0027dashboardId\u0027]:\n\t\tdata \u003d system.kanoa.utilities.convertDatasetRowToJSON(system.kanoa.dashboard.getDashboards({\u0027dashboardId\u0027: value[\u0027dashboardId\u0027]}),0)\n\t\tdata[\u0027screenDashboardId\u0027] \u003d None\n\t\tdata[\u0027assetId\u0027] \u003d value[\u0027assetId\u0027]\n\t\tdata[\u0027screenName\u0027] \u003d self.custom.display.screenName\n\telif value[\u0027assetId\u0027] is None: return {}\n\telse: data \u003d system.kanoa.utilities.convertDatasetRowToJSON(system.kanoa.dashboard.getScreenDashboards({\u0027assetId\u0027: value[\u0027assetId\u0027] or -1, \u0027screenName\u0027: self.custom.display.screenName or \u0027none\u0027}),0)\n\n\tdata[\u0027screenName\u0027] \u003d self.custom.display.screenName\n\tdata[\u0027edited\u0027] \u003d value[\u0027edited\u0027]\t#if the user changes the dashboard and wants to set it as default, we\u0027ll use this flag to display the default button\n\t\n\treturn data",
            "type": "script"
          }
        ],
        "type": "property"
      }
    },
    "custom.display.showNavigation": {
      "binding": {
        "config": {
          "path": "view.params.value.assetId"
        },
        "overlayOptOut": true,
        "transforms": [
          {
            "code": "\t\n\tif not value: return False\n\tassetPath \u003d system.kanoa.utilities.getFieldValue(\u0027assetPath\u0027, system.kanoa.asset.getAssets({\u0027assetId\u0027: value}))\n\treturn True if (system.kanoa.asset.getClosestAncestorAttribute(assetPath, \u0027_assetOperationNavLocation\u0027) or \u0027Right Panel\u0027) \u003d\u003d \u0027Right Panel\u0027 else False",
            "type": "script"
          }
        ],
        "type": "property"
      }
    },
    "custom.filter": {
      "binding": {
        "config": {
          "struct": {
            "viewParams": "{view.params.value}"
          },
          "waitOnAll": true
        },
        "overlayOptOut": true,
        "transforms": [
          {
            "code": "\n\tfilter \u003d system.kanoa.dashboard.getWidgetFilters(self.page.props.pageId, value[\u0027viewParams\u0027], self.session.custom.kanoa, self.session.props.device.timezone.id)\n\t\t\n\tif value[\u0027viewParams\u0027].has_key(\u0027assetId\u0027) and value[\u0027viewParams\u0027][\u0027assetId\u0027]: filter[\u0027assetId\u0027] \u003d value[\u0027viewParams\u0027][\u0027assetId\u0027]\n\tif filter[\u0027dateRange\u0027][\u0027startDate\u0027] is None:\n\t\tselectedDateRange \u003d \u0027Today\u0027\n\t\tstartDate,endDate \u003d system.kanoa.date.getDateRange({\u0027selectedDateRange\u0027:selectedDateRange,\u0027clientTimeZone\u0027:self.session.props.device.timezone.id,\u0027assetPath\u0027:filter[\u0027assetPath\u0027]})\n\t\tsystem.kanoa.utilities.storeDateRangeSelection(self, startDate, endDate, selectedDateRange)\n\t\tfilter[\u0027dateRange\u0027][\u0027startDate\u0027] \u003d startDate\n\t\tfilter[\u0027dateRange\u0027][\u0027endDate\u0027] \u003d endDate\n\t\tfilter[\u0027dateRange\u0027][\u0027selectedDateRange\u0027] \u003d selectedDateRange\n\t\t\n\tfilter[\u0027assetPath\u0027] \u003d system.kanoa.utilities.getFieldValue(\u0027assetPath\u0027, system.kanoa.asset.getAssets({\u0027assetId\u0027: filter[\u0027assetId\u0027] or -1}))\n\tfilter[\u0027assetId\u0027] \u003d value[\u0027viewParams\u0027][\u0027assetId\u0027]\n\t\t\n\treturn filter",
            "type": "script"
          }
        ],
        "type": "expr-struct"
      },
      "persistent": true
    },
    "custom.screenDashboards": {
      "binding": {
        "config": {
          "path": "view.custom.display.dashboardFilter.assetId"
        },
        "overlayOptOut": true,
        "transforms": [
          {
            "code": "\n\treturn system.kanoa.utilities.convertDatasetToJSON(system.kanoa.dashboard.getScreenDashboards({\u0027assetId\u0027: value or -1, \u0027screenName\u0027: self.custom.display.screenName}))",
            "type": "script"
          }
        ],
        "type": "property"
      },
      "persistent": true
    },
    "custom.security": {
      "binding": {
        "config": {
          "struct": {
            "user": "{session.props.auth.user}"
          },
          "waitOnAll": false
        },
        "overlayOptOut": true,
        "transforms": [
          {
            "code": "\n\tsecConfig \u003d system.kanoa.utilities.convertDatasetToDict(system.kanoa.security.getConfig({}), \u0027configName\u0027, \u0027configValue\u0027)\n\tuserId \u003d system.kanoa.security.getIDPUserId(value[\u0027user\u0027])\n\tuserCRUD \u003d system.kanoa.security.getUserAssetCRUD(userId)\n\t\n\treturn {\u0027userId\u0027: userId, \u0027userName\u0027: value[\u0027user\u0027][\u0027userName\u0027], \u0027config\u0027: secConfig, \u0027userCRUD\u0027: userCRUD}",
            "type": "script"
          }
        ],
        "type": "expr-struct"
      },
      "persistent": true
    },
    "custom.userAction": {
      "binding": {
        "config": {
          "struct": {
            "dashboard": "{view.custom.display.screenDashboard}",
            "security": "{view.custom.security}"
          },
          "waitOnAll": true
        },
        "overlayOptOut": true,
        "transforms": [
          {
            "code": "\t\n\tsecurity \u003d value[\u0027security\u0027]\n\tcanCreate \u003d False\n\tcanEdit \u003d False\n\tif security[\u0027userCRUD\u0027] is not None and security[\u0027userId\u0027] is not None:\n\t\tif security[\u0027userCRUD\u0027][\u0027isGatewayAdmin\u0027] or security[\u0027userCRUD\u0027][\u0027operateAssets\u0027][\u0027enabled\u0027]: \n\t\t\tcanCreate \u003d True\n\t\t\tcanEdit \u003d True if value[\u0027dashboard\u0027].get(\u0027dashboardId\u0027) is not None else False\n\t\t\t\n\treturn {\"canCreate\": canCreate, \"canDelete\": canEdit, \"canRead\": True, \"canUpdate\": canEdit}",
            "type": "script"
          }
        ],
        "type": "expr-struct"
      },
      "persistent": true
    },
    "params.value": {
      "paramDirection": "input",
      "persistent": true
    }
  },
