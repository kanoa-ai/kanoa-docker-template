                          "code": "\n#\tsystem.perspective.print(\"assetOperationPanel screenDashboard has changed. Setting dashboard selector path to %s\"%(value.get(\u0027path\u0027)))\n#\t#ScreenDashboard has changed. We\u0027ll clear the current selection\n\tpath \u003d value.get(\u0027path\u0027)\n\tif self.props.params.values.path and path is None: system.perspective.sendMessage(\u0027resetSelector\u0027, {\u0027msgHandler\u0027: self.props.params.values.msgHandler})\n\n#\tsystem.perspective.print(\"assetOperationPanel screenDashboard has changed. Setting dashboard selector path to %s\"%(value.get(\u0027path\u0027)))\n\n\treturn path",
