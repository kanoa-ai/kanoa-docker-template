  "propConfig": {
    "custom.dashboards": {
      "binding": {
        "config": {
          "path": "session.props.auth.user"
        },
        "overlayOptOut": true,
        "transforms": [
          {
            "code": "\t\t\n\tuserId \u003d system.kanoa.security.getIDPUserId(value)\n\treturn system.kanoa.dashboard.getDashboards({\u0027enabled\u0027: True, \u0027userId\u0027: userId})",
