    "events": {
      "system": {
        "onStartup": {
          "config": {
            "script": "\t# A widget saved before the mode overlay has no displayOptions, or none with showModes: the chart treats showModes as on,\n\t# so the checkbox matches. Without displayOptions there\u0027s nothing to set (868mwaypk)\n\tvalue \u003d self.view.params.value\n\tif value is None or not value.has_key(\u0027displayOptions\u0027) or value.displayOptions is None: return\n\ttry:\n\t\tshowModes \u003d value.displayOptions[\u0027showModes\u0027]\n\texcept:\n\t\tshowModes \u003d None\n\tif showModes is None:\n\t\tvalue.displayOptions.showModes \u003d True"
          },
          "scope": "G",
          "type": "script"
        }
      }
