          "name": "flxCountBars"
        },
        "position": {
          "grow": 1,
          "shrink": 0
        },
        "propConfig": {
          "props.instances": {
            "binding": {
              "config": {
                "struct": {
                  "filter": "{view.custom.filter}",
                  "dates": "{view.custom.dates}",
                  "show": "{view.params.value.showDateRange}",
                  "pct": "{view.params.value.uncodedScrapPercent}",
                  "zoomId": "{view.custom.zoomId}"
                },
                "waitOnAll": false
              },
              "overlayOptOut": true,
              "transforms": [
                {
                  "code": "\t# The date range: the widget\u0027s own selector when it shows (showDateRange), else the dashboard\u0027s filter; today when\n\t# neither has dates (the operator station passes none)\n\tdates, show, value_zoomId \u003d value[\u0027dates\u0027] or {}, value[\u0027show\u0027], value[\u0027zoomId\u0027]\n\t# Uncoded scrap is marked in an hour when it is at least this % of the infeed (5 when not set)\n\tpct \u003d value[\u0027pct\u0027] if value[\u0027pct\u0027] is not None else 5\n\tvalue \u003d value[\u0027filter\u0027]\n\t# The filter can come through part-built as the view opens\n\tif value is None or value.get(\u0027displayOptions\u0027) is None: return []\n\tdr \u003d value.get(\u0027dateRange\u0027) or {}\n\tif show is not False and dates.get(\u0027startDate\u0027) is not None and dates.get(\u0027endDate\u0027) is not None: start, end \u003d dates[\u0027startDate\u0027], dates[\u0027endDate\u0027]\n\telif dr.get(\u0027startDate\u0027) is not None and dr.get(\u0027endDate\u0027) is not None: start, end \u003d dr[\u0027startDate\u0027], dr[\u0027endDate\u0027]\n\telse: start, end \u003d system.date.midnight(system.date.now()), system.date.addDays(system.date.midnight(system.date.now()), 1)\n\t# Up to 7 days: a longer range reads weeks of events and counts for each chart, which filled the gateway\u0027s memory on the\n\t# demo server (Year To Date, the months and Last 14 Days are off in the date selector; a custom range or the dashboard\u0027s filter can still be longer)\n\tover \u003d system.date.daysBetween(start, end) \u003e 7\n\tif self.view.custom.overRange !\u003d over: self.view.custom.overRange \u003d over\n\tif over:\n\t\tsystem.kanoa.toast.show({\u0027id\u0027: \u0027productionRangeCap\u0027, \u0027type\u0027: \u0027warning\u0027, \u0027message\u0027: system.util.translate(\u0027Choose a range of up to 7 days\u0027, self.session.props.locale)})\n\t\treturn []\n\tassetPath \u003d value.get(\u0027assetPath\u0027) if (value.get(\u0027assetPath\u0027) or None) is not None else \u0027xxx\u0027\n\tparamsDict \u003d {\u0027assetPath\u0027: assetPath, \u0027oeeEnabled\u0027: True, \u0027enabled\u0027: True}\n\tshowLevels \u003d value[\u0027displayOptions\u0027][\u0027showLevels\u0027]\n\tif showLevels \u003d\u003d -1: \n\t\tparamsDict[\u0027assetPath\u0027] \u003d assetPath + \u0027%\u0027\n\t\tassets \u003d system.kanoa.asset.getAssets(paramsDict)\n\telif showLevels \u003d\u003d 1: \n\t\tparentAsset \u003d system.kanoa.asset.getAssets(paramsDict)\n\t\tparentId \u003d self.view.custom.filter.assetId\n\t\tchildAssets \u003d system.kanoa.asset.getAssets({\u0027parentId\u0027: parentId})\n\t\tassets \u003d system.dataset.appendDataset(parentAsset, childAssets)\n\t\tassets \u003d system.dataset.toPyDataSet(assets)\n\telse:\n\t\tassets \u003d system.kanoa.asset.getAssets(paramsDict)\n\t\t\n\treturn [{\u0027values\u0027: {\n\t\t\"assetId\": row[\u0027assetId\u0027], \n\t\t\"startDate\": start,\n\t\t\"endDate\": end,\n\t\t\"displayOptions\": value[\u0027displayOptions\u0027],\n\t\t\"interval\": None,\n\t\t# The asset name over each chart: off unless the widget\u0027s showAssetName is on\n\t\t\"showAssetName\": bool(self.view.params.value.get(\u0027showAssetName\u0027)),\n\t\t\"uncodedScrapPercent\": pct,\n\t\t# Dragging across the chart sets the range on this widget\u0027s own date selector, so only when it shows\n\t\t\"zoomId\": value_zoomId if show is not False else None}\n\t} for row in assets]",
                  "type": "script"
                }
              ],
              "type": "expr-struct"
            },
            "persistent": true
          }
        },
        "props": {
