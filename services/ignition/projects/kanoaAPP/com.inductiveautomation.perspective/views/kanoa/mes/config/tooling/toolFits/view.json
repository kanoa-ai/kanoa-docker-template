        "type": "ia.container.flex",
        "children": [
          {
            "events": {
              "component": {
                "onRowClick": {
                  "config": {
                    "script": "\n\tr \u003d self.props.data[event.row]\n\tkind \u003d r[\u0027parentKind\u0027]\n\tparentId \u003d r[\u0027parentAssetId\u0027] if kind \u003d\u003d \u0027asset\u0027 else r[\u0027parentToolingAssetId\u0027] if kind \u003d\u003d \u0027tool\u0027 else r[\u0027parentAssetTypeId\u0027]\n\tchild \u003d \u0027tool:%s\u0027 % r[\u0027childToolingAssetId\u0027] if r[\u0027ruleFor\u0027] \u003d\u003d \u0027tool\u0027 else \u0027type:%s\u0027 % r[\u0027childAssetTypeId\u0027]\n\tself.view.custom.edit \u003d {\u0027toolingCompatibilityId\u0027: r[\u0027toolingCompatibilityId\u0027], \u0027child\u0027: child, \u0027kind\u0027: kind, \u0027parentId\u0027: parentId,\n\t\t\t\t\t\t\t \u0027enabled\u0027: r[\u0027enabled\u0027]}\n\treturn"
                  },
                  "scope": "G",
                  "type": "script"
                }
              }
            },
