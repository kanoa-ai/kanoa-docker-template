{
  "custom": {
    "edit": {
      "toolingCompatibilityId": null,
      "child": null,
      "kind": "asset",
      "parentId": null,
      "enabled": true
    },
    "refresh": null,
    "rules": [],
    "selectedData": [],
    "selectedRow": null,
    "toolingAssetId": null,
    "userAction": {
      "canCreate": false,
      "canRead": true,
      "canUpdate": false
    },
    "targets": [],
    "toastId": null
  },
  "params": {
    "value": {
      "toolingAssetId": null
    }
  },
  "propConfig": {
    "custom.security": {
      "binding": {
        "config": {
          "path": "session.custom.kanoa.security"
        },
        "overlayOptOut": true,
        "type": "property"
      },
      "persistent": true
    },
    "params.value": {
      "paramDirection": "input",
      "persistent": true
    },
    "custom.toolingAssetId": {
      "binding": {
        "config": {
          "path": "view.params.value"
        },
        "overlayOptOut": true,
        "type": "property",
        "transforms": [
          {
            "code": "\n\treturn value.get(\u0027toolingAssetId\u0027) if value else None",
            "type": "script"
          }
        ]
      },
      "persistent": true
    },
    "custom.rules": {
      "binding": {
        "config": {
          "struct": {
            "toolingAssetId": "{view.custom.toolingAssetId}",
            "refresh": "{view.custom.refresh}"
          },
          "waitOnAll": true
        },
        "overlayOptOut": true,
        "transforms": [
          {
            "code": "\n\ttid \u003d value[\u0027toolingAssetId\u0027]\n\tif tid is None: return []\n\trows \u003d (system.kanoa.utilities.convertDatasetToJSON(system.kanoa.tooling.getCompatibilityRules({\u0027toolingAssetId\u0027: tid}) or []) or [])\n\tfmt \u003d lambda p: system.kanoa.utilities.formatPath(p, {}) if p else \u0027\u0027\n\tout \u003d []\n\tfor r in rows:\n\t\tif r[\u0027parentKind\u0027] \u003d\u003d \u0027asset\u0027: fits \u003d \u0027Machine: \u0027 + (fmt(r[\u0027parentAssetPath\u0027]) or r[\u0027parentName\u0027])\n\t\telif r[\u0027parentKind\u0027] \u003d\u003d \u0027tool\u0027: fits \u003d \u0027In the pockets of \u0027 + r[\u0027parentName\u0027]\n\t\telse: fits \u003d \u0027Any \u0027 + r[\u0027parentName\u0027]\n\t\tif r[\u0027ruleFor\u0027] \u003d\u003d \u0027tool\u0027: who \u003d \u0027This tool\u0027\n\t\telse: who \u003d \u0027Every \u0027 + r[\u0027childName\u0027]\n\t\tr \u003d dict(r)\n\t\tr.update({\u0027forLabel\u0027: who, \u0027fitsLabel\u0027: fits})\n\t\tout.append(r)\n\treturn out",
            "type": "script"
          }
        ],
        "type": "expr-struct"
      }
    },
    "custom.selectedData": {
      "binding": {
        "config": {
          "struct": {
            "rows": "{view.custom.rules}",
            "row": "{view.custom.selectedRow}"
          },
          "waitOnAll": true
        },
        "overlayOptOut": true,
        "transforms": [
          {
            "code": "\n\trows \u003d value[\u0027rows\u0027] or []\n\trow \u003d value[\u0027row\u0027]\n\tif row is None or row \u003c 0 or row \u003e\u003d len(rows): return []\n\treturn [dict(rows[row])]",
            "type": "script"
          }
        ],
        "type": "expr-struct"
      }
    },
    "custom.userAction": {
      "binding": {
        "config": {
          "struct": {
            "security": "{view.custom.security}"
          },
          "waitOnAll": true
        },
        "overlayOptOut": true,
        "transforms": [
          {
            "code": "\n\tsecurity \u003d value[\u0027security\u0027]\n\tuserCRUD \u003d security[\u0027userCRUD\u0027] if security else {}\n\tcanEdit \u003d bool(userCRUD) and (userCRUD.get(\u0027isGatewayAdmin\u0027) or userCRUD.get(\u0027configureAssets\u0027, {}).get(\u0027enabled\u0027))\n\treturn {\u0027canCreate\u0027: canEdit, \u0027canUpdate\u0027: canEdit, \u0027canRead\u0027: True}",
            "type": "script"
          }
        ],
        "type": "expr-struct"
      }
    },
    "custom.targets": {
      "binding": {
        "config": {
          "struct": {
            "kind": "{view.custom.edit.kind}",
            "child": "{view.custom.edit.child}",
            "toolingAssetId": "{view.custom.toolingAssetId}"
          },
          "waitOnAll": true
        },
        "overlayOptOut": true,
        "transforms": [
          {
            "code": "\n\tkind \u003d value[\u0027kind\u0027]\n\tchild \u003d value[\u0027child\u0027]\n\ttoolId \u003d value[\u0027toolingAssetId\u0027]\n\tif kind \u003d\u003d \u0027tool\u0027:\n\t\t# Tools with pockets, other than this one\n\t\ttools \u003d system.kanoa.utilities.convertDatasetToJSON(system.kanoa.tooling.getTools({\u0027enabled\u0027: True}) or []) or []\n\t\treturn [{\u0027assetId\u0027: r[\u0027toolingAssetId\u0027], \u0027assetPath\u0027: r[\u0027assetPath\u0027]} for r in tools if r[\u0027holdsInserts\u0027] and r[\u0027toolingAssetId\u0027] !\u003d toolId]\n\tif kind !\u003d \u0027asset\u0027: return []\n\t# A rule for the type applies to its tools in every site\n\tif child and child.startswith(\u0027type:\u0027): toolId \u003d None\n\trows \u003d system.kanoa.utilities.convertDatasetToJSON(system.kanoa.asset.getAssets({\u0027usesTooling\u0027: True}) or []) or []\n\ttools \u003d (system.kanoa.utilities.convertDatasetToJSON(system.kanoa.tooling.getTools({\u0027toolingAssetId\u0027: toolId}) or []) or []) if toolId else []\n\tsiteId \u003d tools[0][\u0027siteId\u0027] if tools else None\n\tif siteId is not None:\n\t\tsites \u003d system.kanoa.utilities.convertDatasetToJSON(system.kanoa.asset.getAssets({\u0027assetId\u0027: siteId}) or []) or []\n\t\tsitePath \u003d sites[0][\u0027assetPath\u0027] + \u0027\\\\\u0027 if sites else None\n\t\trows \u003d [r for r in rows if sitePath and (r[\u0027assetPath\u0027] or \u0027\u0027).startswith(sitePath)]\n\treturn [{\u0027assetId\u0027: r[\u0027assetId\u0027], \u0027assetPath\u0027: r[\u0027assetPath\u0027]} for r in rows]",
            "type": "script"
          }
        ],
        "type": "expr-struct"
      }
    }
  },
  "props": {
    "defaultSize": {
      "height": 500,
      "width": 950
    }
  },
  "root": {
    "meta": {
      "name": "root"
    },
    "props": {
      "direction": "column",
      "style": {
        "classes": "kanoa/font/default",
        "gap": 5,
