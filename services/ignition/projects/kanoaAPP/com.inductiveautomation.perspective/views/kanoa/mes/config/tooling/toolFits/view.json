    "scripts": {
      "customMethods": [
        {
          "name": "toast",
          "params": [
            "params"
          ],
          "script": "\t\u0027\u0027\u0027One toast at a time on this view. The first one\u0027s id is kept; every later toast updates it while it\u0027s showing, and shows it again under\n\tthe same id once it has closed (a show with the id of a toast still showing is ignored, so the two never stack) (868mvvzbz).\u0027\u0027\u0027\n\tparams \u003d dict(params)\n\ttoastId \u003d self.view.custom.toastId\n\tif toastId:\n\t\tparams[\u0027id\u0027] \u003d toastId\n\t\tsystem.kanoa.toast.update(params)\n\t\tsystem.kanoa.toast.show(params)\n\telse:\n\t\tself.view.custom.toastId \u003d system.kanoa.toast.show(params)\n"
        }
      ],
      "extensionFunctions": null,
      "messageHandlers": [
        {
          "messageType": "toolFitTargetSelected",
          "pageScope": true,
          "script": "\n\t# The machine or tool picked (or cleared) in the selector\n\tpath \u003d payload[\u0027assetPath\u0027]\n\tparentId \u003d ([t[\u0027assetId\u0027] for t in self.view.custom.targets or [] if t[\u0027assetPath\u0027] \u003d\u003d path] or [None])[0]\n\tif self.view.custom.edit.parentId !\u003d parentId:\n\t\tself.view.custom.edit.parentId \u003d parentId",
          "sessionScope": false,
          "viewScope": false
        }
