              {
                "events": {
                  "component": {
                    "onActionPerformed": {
                      "config": {
                        "script": "\n\tedit \u003d self.view.custom.edit\n\ttoolId \u003d self.view.custom.toolingAssetId\n\tchild \u003d edit.child or \u0027tool:%s\u0027 % toolId\n\tif edit.kind \u003d\u003d \u0027type\u0027:\n\t\tallowed \u003d [o[\u0027value\u0027] for o in (self.parent.parent.getChild(\u0027flxTarget\u0027).getChild(\u0027ddTarget\u0027).props.options or [])]\n\telse:\n\t\tallowed \u003d [t[\u0027assetId\u0027] for t in (self.view.custom.targets or [])]\n\tif edit.parentId is None or edit.parentId not in allowed:\n\t\tself.view.rootContainer.toast({\u0027type\u0027: \u0027warning\u0027, \u0027message\u0027: \u0027Pick where it fits\u0027})\n\t\treturn\n\tchildKind, childId \u003d child.split(\u0027:\u0027)\n\tinfo \u003d {\u0027toolingCompatibilityId\u0027: edit.toolingCompatibilityId, \u0027enabled\u0027: edit.enabled}\n\tinfo[\u0027childToolingAssetId\u0027 if childKind \u003d\u003d \u0027tool\u0027 else \u0027childAssetTypeId\u0027] \u003d int(childId)\n\tinfo[{\u0027asset\u0027: \u0027parentAssetId\u0027, \u0027tool\u0027: \u0027parentToolingAssetId\u0027, \u0027type\u0027: \u0027parentAssetTypeId\u0027}[edit.kind]] \u003d edit.parentId\n\tfirst \u003d edit.toolingCompatibilityId is None and not [r for r in (self.view.custom.rules or []) if r[\u0027enabled\u0027]]\n\tresult \u003d system.kanoa.tooling.saveCompatibilityRule(info, self.view.custom.security.userId)\n\tif not result:\n\t\tsystem.util.getLogger(\u0027toolFits\u0027).warn(\u0027saveCompatibilityRule returned %r for %r\u0027 % (result, info))\n\t\tresult \u003d (None, \"Couldn\u0027t save the rule; see the gateway log\")\n\truleId, msg \u003d result\n\tif msg:\n\t\tself.view.rootContainer.toast({\u0027type\u0027: \u0027error\u0027, \u0027message\u0027: msg})\n\t\treturn\n\tmessage \u003d \u0027Fit rule saved. This tool now only mounts where its rules allow\u0027 if first else \u0027Fit rule saved\u0027\n\tself.view.rootContainer.toast({\u0027type\u0027: \u0027success\u0027, \u0027message\u0027: message})\n\tself.view.custom.edit \u003d {\u0027toolingCompatibilityId\u0027: None, \u0027child\u0027: None, \u0027kind\u0027: \u0027asset\u0027, \u0027parentId\u0027: None, \u0027enabled\u0027: True}\n\tself.view.custom.selectedRow \u003d None\n\tself.view.custom.refresh \u003d system.date.now()\n\treturn"
                      },
