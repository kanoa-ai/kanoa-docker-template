      {
        "meta": {
          "name": "lblHint"
        },
        "position": {
          "shrink": 0
        },
        "props": {
          "style": {
            "classes": "kanoa/font/default",
            "fontSize": "12px",
            "paddingLeft": "5px",
            "whiteSpace": "normal"
          },
          "text": "A machine rule lets the tool on that machine; a tool rule, into that tool\u0027s pockets (a mold base or frame that holds inserts); a type rule, on any machine or into any tool of that type. Mounting anywhere else is refused, and the scheduler won\u0027t reserve the tool there. Tools already mounted stay mounted; a new rule applies from the next mount."
        },
        "type": "ia.display.label"
      },
      {
        "meta": {
          "name": "flxForm"
        },
        "position": {
          "shrink": 0
        },
        "props": {
          "direction": "column",
          "style": {
            "gap": "5px",
            "overflow": "hidden"
          }
        },
        "type": "ia.container.flex",
        "propConfig": {
          "position.display": {
            "binding": {
              "config": {
                "struct": {
                  "id": "{view.custom.toolingAssetId}",
                  "action": "{view.custom.userAction}"
                },
                "waitOnAll": true
              },
              "overlayOptOut": true,
              "transforms": [
                {
                  "code": "\n\treturn value[\u0027id\u0027] is not None and value[\u0027action\u0027][\u0027canUpdate\u0027]",
                  "type": "script"
                }
              ],
              "type": "expr-struct"
            }
          }
        },
        "children": [
          {
            "meta": {
              "name": "lblEditing"
            },
            "position": {
              "shrink": 0
            },
            "propConfig": {
              "props.text": {
                "binding": {
                  "config": {
                    "struct": {
                      "edit": "{view.custom.edit}",
                      "rules": "{view.custom.rules}"
                    },
                    "waitOnAll": false
                  },
                  "overlayOptOut": true,
                  "transforms": [
                    {
                      "code": "\n\tedit \u003d value[\u0027edit\u0027]\n\truleId \u003d edit[\u0027toolingCompatibilityId\u0027] if edit else None\n\tif ruleId is None: return \u0027New rule: Save adds it.\u0027\n\tfor r in (value[\u0027rules\u0027] or []):\n\t\tif r[\u0027toolingCompatibilityId\u0027] \u003d\u003d ruleId:\n\t\t\treturn system.util.translate(\u0027Editing\u0027, self.session.props.locale) + \u0027: %s, %s. Save changes it; Clear starts a new rule.\u0027 % (r[\u0027forLabel\u0027], r[\u0027fitsLabel\u0027])\n\treturn \u0027Editing a rule. Save changes it; Clear starts a new rule.\u0027",
                      "type": "script"
                    }
                  ],
                  "type": "expr-struct"
                }
              }
            },
            "props": {
              "style": {
                "classes": "kanoa/font/default",
                "fontWeight": "bold",
                "paddingLeft": "145px",
                "whiteSpace": "normal"
              }
            },
            "type": "ia.display.label"
          },
          {
            "meta": {
              "name": "flxFor"
            },
            "position": {
              "basis": "32px",
              "shrink": 0
            },
            "props": {
              "style": {
                "gap": "5px",
                "overflow": "hidden"
              }
            },
            "type": "ia.container.flex",
            "children": [
              {
                "meta": {
                  "name": "lblFor"
                },
                "position": {
                  "basis": "140px",
                  "shrink": 0
                },
                "props": {
                  "style": {
                    "classes": "kanoa/font/default",
                    "textAlign": "right"
                  },
                  "text": "For"
                },
                "type": "ia.display.label"
              },
              {
                "meta": {
                  "name": "ddFor"
                },
                "position": {
                  "grow": 1
                },
                "propConfig": {
                  "props.value": {
                    "binding": {
                      "config": {
                        "path": "view.custom.edit.child",
                        "bidirectional": true
                      },
                      "overlayOptOut": true,
                      "type": "property"
                    }
                  },
                  "props.options": {
                    "binding": {
                      "config": {
                        "struct": {
                          "toolingAssetId": "{view.custom.toolingAssetId}"
                        },
                        "waitOnAll": true
                      },
                      "overlayOptOut": true,
                      "transforms": [
                        {
                          "code": "\n\ttid \u003d value[\u0027toolingAssetId\u0027]\n\ttools \u003d (system.kanoa.utilities.convertDatasetToJSON(system.kanoa.tooling.getTools({\u0027toolingAssetId\u0027: tid}) or []) or []) if tid else []\n\tif not tools: return []\n\toptions \u003d [{\u0027value\u0027: \u0027tool:%s\u0027 % tid, \u0027label\u0027: \u0027This tool\u0027}]\n\tif tools[0][\u0027assetTypeId\u0027] is not None:\n\t\toptions.append({\u0027value\u0027: \u0027type:%s\u0027 % tools[0][\u0027assetTypeId\u0027], \u0027label\u0027: \u0027Every %s (every tool of this type)\u0027 % tools[0][\u0027assetTypeName\u0027]})\n\treturn options",
                          "type": "script"
                        }
                      ],
                      "type": "expr-struct"
                    }
                  }
                },
                "props": {
                  "placeholder": {
                    "text": "This tool"
                  },
                  "showClearIcon": false,
                  "search": {
                    "enabled": true
                  },
                  "style": {
                    "classes": "kanoa/font/default"
                  }
                },
                "type": "ia.input.dropdown"
              }
            ]
          },
          {
            "meta": {
              "name": "flxKind"
            },
            "position": {
              "basis": "32px",
              "shrink": 0
            },
            "props": {
              "style": {
                "gap": "5px",
                "overflow": "hidden"
              }
            },
            "type": "ia.container.flex",
            "children": [
              {
                "meta": {
                  "name": "lblKind"
                },
                "position": {
                  "basis": "140px",
                  "shrink": 0
                },
                "props": {
                  "style": {
                    "classes": "kanoa/font/default",
                    "textAlign": "right"
                  },
                  "text": "Fits"
                },
                "type": "ia.display.label"
              },
              {
                "meta": {
                  "name": "ddKind"
                },
                "position": {
                  "grow": 1
                },
                "propConfig": {
                  "props.value": {
                    "binding": {
                      "config": {
                        "path": "view.custom.edit.kind",
                        "bidirectional": true
                      },
                      "overlayOptOut": true,
                      "type": "property"
                    }
                  },
                  "props.options": {
                    "binding": {
                      "config": {
                        "expression": "1"
                      },
                      "overlayOptOut": true,
                      "transforms": [
                        {
                          "code": "\n\treturn [{\u0027value\u0027: \u0027asset\u0027, \u0027label\u0027: \u0027A machine\u0027}, {\u0027value\u0027: \u0027tool\u0027, \u0027label\u0027: \"In a tool\u0027s pockets (a mold base or frame)\"},\n\t\t\t{\u0027value\u0027: \u0027type\u0027, \u0027label\u0027: \u0027Any asset of a type (machines or tools)\u0027}]",
                          "type": "script"
                        }
                      ],
                      "type": "expr"
                    }
                  }
                },
                "props": {
                  "placeholder": {
                    "text": "Where it fits"
                  },
                  "showClearIcon": false,
                  "search": {
                    "enabled": true
