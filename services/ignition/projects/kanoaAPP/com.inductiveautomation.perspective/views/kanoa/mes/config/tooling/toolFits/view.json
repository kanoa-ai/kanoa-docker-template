        "propConfig": {
          "props.text": {
            "binding": {
              "config": {
                "struct": {
                  "rules": "{view.custom.rules}",
                  "toolingAssetId": "{view.custom.toolingAssetId}"
                },
                "waitOnAll": true
              },
              "overlayOptOut": true,
              "transforms": [
                {
                  "code": "\n\tif value[\u0027toolingAssetId\u0027] is None: return \u0027\u0027\n\trules \u003d [r for r in (value[\u0027rules\u0027] or []) if r[\u0027enabled\u0027]]\n\tif not rules:\n\t\treturn \"No rules: this tool fits any machine in its site that uses tooling. Add a rule to limit where it can be mounted.\"\n\tif any(r[\u0027ruleFor\u0027] \u003d\u003d \u0027type\u0027 for r in rules):\n\t\treturn (\"This tool only mounts where one of these rules allows. A rule for \u0027Every \u003ctype\u003e\u0027 applies to every tool of that type, \"\n\t\t\t\t\"so changing it changes them all.\")\n\treturn \"This tool only mounts where one of these rules allows.\"",
                  "type": "script"
                }
              ],
              "type": "expr-struct"
            }
          }
        },
        "props": {
          "style": {
            "classes": "kanoa/font/default",
            "paddingLeft": "5px",
            "whiteSpace": "normal"
          }
        },
        "type": "ia.display.label"
      },
