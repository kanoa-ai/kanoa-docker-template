{
  "custom": {
    "correction": {
      "endDate": null,
      "reason": "",
      "startDate": null,
      "toolingAssignmentId": null
    },
    "history": [],
    "refresh": null,
    "selectedData": [],
    "selectedRow": null,
    "toolingAssetId": null,
    "userAction": {
      "canCreate": false,
      "canRead": true,
      "canUpdate": false
    }
  },
  "params": {
    "value": {
      "toolingAssetId": null
    }
  },
  "propConfig": {
    "custom.security": {
      "binding": {
        "config": {
          "path": "session.custom.kanoa.security"
        },
        "overlayOptOut": true,
        "type": "property"
      },
      "persistent": true
    },
    "params.value": {
      "paramDirection": "input",
      "persistent": true
    },
    "custom.toolingAssetId": {
      "binding": {
        "config": {
          "path": "view.params.value"
        },
        "overlayOptOut": true,
        "transforms": [
          {
            "code": "\n\treturn value.get(\u0027toolingAssetId\u0027) if value else None",
            "type": "script"
          }
        ],
        "type": "property"
      },
      "persistent": true
    },
    "custom.history": {
      "binding": {
        "config": {
          "struct": {
            "toolingAssetId": "{view.custom.toolingAssetId}",
            "refresh": "{view.custom.refresh}"
          },
          "waitOnAll": true
        },
        "overlayOptOut": true,
        "transforms": [
          {
            "code": "\n\tif value[\u0027toolingAssetId\u0027] is None: return []\n\trows \u003d system.kanoa.utilities.convertDatasetToJSON(system.kanoa.tooling.getHistory({\u0027toolingAssetId\u0027: value[\u0027toolingAssetId\u0027]}) or [])\n\tfor r in rows:\n\t\tr[\u0027mountedOn\u0027] \u003d r[\u0027assetName\u0027] or (\u0027%s, pocket %s\u0027 % (r[\u0027parentToolingName\u0027], r[\u0027parentPositionNumber\u0027]))\n\t\tr[\u0027host\u0027] \u003d r[\u0027hostAssetName\u0027] or \u0027\u0027\n\treturn list(reversed(rows))",
            "type": "script"
          }
        ],
        "type": "expr-struct"
      }
    },
    "custom.selectedData": {
      "binding": {
        "config": {
          "struct": {
            "rows": "{view.custom.history}",
            "row": "{view.custom.selectedRow}"
          },
          "waitOnAll": true
        },
        "overlayOptOut": true,
        "transforms": [
          {
            "code": "\n\trows \u003d value[\u0027rows\u0027] or []\n\trow \u003d value[\u0027row\u0027]\n\tif row is None or row \u003c 0 or row \u003e\u003d len(rows): return []\n\treturn [dict(rows[row])]",
            "type": "script"
          }
        ],
        "type": "expr-struct"
      }
    },
    "custom.userAction": {
      "binding": {
        "config": {
          "struct": {
            "security": "{view.custom.security}"
          },
          "waitOnAll": true
        },
        "overlayOptOut": true,
        "transforms": [
          {
            "code": "\n\tsecurity \u003d value[\u0027security\u0027]\n\tuserCRUD \u003d security[\u0027userCRUD\u0027] if security else {}\n\tcanEdit \u003d bool(userCRUD) and (userCRUD.get(\u0027isGatewayAdmin\u0027) or userCRUD.get(\u0027configureAssets\u0027, {}).get(\u0027enabled\u0027))\n\treturn {\u0027canCreate\u0027: canEdit, \u0027canUpdate\u0027: canEdit, \u0027canRead\u0027: True}",
            "type": "script"
          }
        ],
        "type": "expr-struct"
      }
    }
  },
