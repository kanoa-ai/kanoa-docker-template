            },
            "props": {
              "justify": "center",
              "style": {
                "gap": "5px",
                "overflow": "hidden",
                "padding": "5px"
              }
            },
            "type": "ia.container.flex",
            "children": [
              {
                "events": {
                  "component": {
                    "onActionPerformed": {
                      "config": {
                        "script": "\n\tc \u003d dict(self.view.custom.correction)\n\toriginal \u003d [r for r in self.view.custom.history if r[\u0027toolingAssignmentId\u0027] \u003d\u003d c[\u0027toolingAssignmentId\u0027]]\n\tif not original: return\n\tstart \u003d c[\u0027startDate\u0027] if c[\u0027startDate\u0027] !\u003d original[0][\u0027startDate\u0027] else None\n\tend \u003d c[\u0027endDate\u0027] if original[0][\u0027endDate\u0027] is not None and c[\u0027endDate\u0027] !\u003d original[0][\u0027endDate\u0027] else None\n\tresult, msg \u003d system.kanoa.tooling.correctAssignment(c[\u0027toolingAssignmentId\u0027], start, end, c[\u0027reason\u0027], self.view.custom.security.userId)\n\tif msg: system.kanoa.toast.show({\u0027type\u0027: \u0027error\u0027, \u0027message\u0027: msg})\n\telse: system.kanoa.toast.show({\u0027type\u0027: \u0027success\u0027, \u0027message\u0027: \u0027Mount corrected\u0027 if result else \u0027Nothing changed\u0027})\n\tself.view.custom.refresh \u003d system.date.now()\n\tsystem.perspective.sendMessage(\u0027toolUpdated\u0027, {})\n\treturn"
                      },
                      "scope": "G",
                      "type": "script"
                    }
                  }
                },
                "meta": {
                  "name": "btnCorrect"
                },
                "position": {
                  "shrink": 0
                },
                "props": {
                  "image": {
                    "icon": {
                      "path": "material/edit_calendar"
                    }
