    "custom.oeeData": {
      "binding": {
        "config": {
          "struct": {
            "a": "{view.custom.kpi.availability}",
            "assetPath": "{view.params.value.assetInfo.assetPath}",
            "oee": "{view.custom.kpi.oee}",
            "p": "{view.custom.kpi.performance}",
            "q": "{view.custom.kpi.quality}"
          },
          "waitOnAll": false
        },
        "overlayOptOut": true,
        "transforms": [
          {
            "code": "\n\ta \u003d value[\u0027a\u0027] or 0.0\n\tp \u003d value[\u0027p\u0027] or 0.0\n\tq \u003d value[\u0027q\u0027] or 0.0\n\toee \u003d value[\u0027oee\u0027] or 0.0\n\toeeColors \u003d system.kanoa.event.getOEEColors({\u0027assetPath\u0027: value[\u0027assetPath\u0027]}, oee, a, p, q)\n\treturn {\u0027oee\u0027: {\u0027a\u0027: a, \u0027p\u0027: p, \u0027q\u0027: q, \u0027oee\u0027: oee}, \u0027colors\u0027: oeeColors}",
            "type": "script"
          }
        ],
        "type": "expr-struct"
      },
      "persistent": true
    },
    "custom.oeePath": {
      "binding": {
        "config": {
          "path": "view.params.value"
        },
        "overlayOptOut": true,
        "transforms": [
          {
            "code": "\n\t#The asset\u0027s OEE tags are in the kanoaMES tag provider, at its asset path\n\tassetPath \u003d value[\u0027assetInfo\u0027][\u0027assetPath\u0027] if value[\u0027assetInfo\u0027] else None\n\tif not assetPath: return \u0027\u0027\n\tperiod \u003d value[\u0027period\u0027] if value.has_key(\u0027period\u0027) and value[\u0027period\u0027] else \u0027Current Run\u0027\n\treturn \u0027[kanoaMES]\u0027 + assetPath.replace(\u0027\\\\\u0027, \u0027/\u0027) + \u0027/OEE/\u0027 + period",
            "type": "script"
          }
        ],
        "type": "property"
      }
    },
    "params.value": {
      "paramDirection": "input",
      "persistent": true
    }
  },
