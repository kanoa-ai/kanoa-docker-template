{
  "custom": {
    "clearView": false,
    "expand": true,
    "showInfolevel": "status",
    "size": 24,
    "leaf": false,
    "stacked": false,
    "mixed": false,
    "hover": false
  },
  "params": {
    "value": {
      "assetInfo": {
        "assetGroupColor": null,
        "assetGroupId": null,
        "assetGroupName": null,
        "assetId": null,
        "assetName": null,
        "assetPath": null,
        "assetTypeId": null,
        "assetTypeName": null,
        "assetTypePath": null,
        "displayPath": null,
        "enabled": null,
        "iconPath": null,
        "oeeEnabled": null,
        "parentId": null,
        "path": null,
        "processTypeId": null,
        "processTypeName": null,
        "sortOrder": null,
        "tagPath": null,
        "timeZone": null
      },
      "assetName": "",
      "assets": [],
      "childAssets": [],
      "expand": true,
      "level": 3
    }
  },
  "propConfig": {
    "custom.clearView": {
      "onChange": {
        "enabled": null,
        "script": "\n\tif currentValue.value:\n\t\tself.params.value.assetInfo.oeeEnabled \u003d False\n\t\tself.params.value.assets \u003d []\n\t\tself.params.value.childAssets \u003d []\n\t\tself.params.value.assetName \u003d \u0027\u0027\n\t\tself.params.value.assetInfo \u003d system.kanoa.utilities.convertDatasetRowToJSON(system.kanoa.asset.getAssets({\u0027assetId\u0027: -1}), 0)\n\t\t\n\t\timport time\n\t\ttime.sleep(0.5)\n\t\tself.custom.clearView \u003d False\n\t\t\n\treturn"
      },
      "persistent": true
    },
    "custom.expand": {
      "binding": {
        "config": {
          "path": "view.params.value.expand"
        },
        "overlayOptOut": true,
        "type": "property"
      },
      "persistent": true
    },
    "custom.showInfolevel": {
      "binding": {
        "config": {
          "expression": "now(0)"
        },
        "overlayOptOut": true,
        "transforms": [
          {
            "code": "\treturn \u0027status\u0027",
            "type": "script"
          }
        ],
        "type": "expr"
      },
      "onChange": {
        "enabled": null,
        "script": "\t\t\n\tif self.view.params.value.assetInfo.assetPath:\n\t\tpayload \u003d {\u0027showInfoLevel\u0027: currentValue.value, \u0027assetPath\u0027: self.view.params.value.assetInfo.assetPath}\n\t\tsystem.perspective.sendMessage(\"showAssetInfo\", payload)\n\t\t\n\treturn\t\t"
      },
      "persistent": true
    },
    "custom.size": {
      "binding": {
        "config": {
          "path": "view.params.value.assetInfo"
        },
        "overlayOptOut": true,
        "transforms": [
          {
            "code": "\n\tif value[\u0027assetPath\u0027] is None: return 24\n\tlevel \u003d len(value[\u0027assetPath\u0027].split(\"\\\\\"))\n\tlevel \u003d 24 - level*3\n\tif level \u003c 10: level \u003d 10\n\treturn level",
            "type": "script"
          }
        ],
        "type": "property"
      },
      "persistent": true
    },
    "params.value": {
      "paramDirection": "input",
      "persistent": true
    },
    "custom.leaf": {
      "binding": {
        "config": {
          "path": "view.params.value.childAssets"
        },
        "overlayOptOut": true,
        "transforms": [
          {
            "code": "\n\t#A group of assets with no groups under it (Mixing, Machining...): its name is a slim title over its cards, which get the\n\t#full width, instead of a 400px column beside them; the levels above keep their header and expand arrow\n\treturn len(value or []) \u003d\u003d 0",
            "type": "script"
          }
        ],
        "type": "property"
      }
    },
    "custom.stacked": {
      "binding": {
        "config": {
          "path": "view.params.value"
        },
        "overlayOptOut": true,
        "transforms": [
          {
            "code": "\n\t#Title over full-width tiles whenever the group has lines of its own, even with groups under it too (868mvwg9e);\n\t#only a group of groups keeps its header in a row\n\tif not len(value.get(\u0027childAssets\u0027) or []): return True\n\treturn len(value.get(\u0027assets\u0027) or []) \u003e 0",
            "type": "script"
          }
        ],
        "type": "property"
      },
      "persistent": true
    },
    "custom.mixed": {
      "binding": {
        "config": {
          "path": "view.params.value"
        },
        "overlayOptOut": true,
        "transforms": [
          {
            "code": "\n\t#Lines and groups under one group (868mvwg9e): its own lines get the tinted panel, its groups follow below it\n\treturn len(value.get(\u0027childAssets\u0027) or []) \u003e 0 and len(value.get(\u0027assets\u0027) or []) \u003e 0",
            "type": "script"
          }
        ],
        "type": "property"
      },
      "persistent": true
    },
    "custom.hover": {
      "persistent": true
    }
  },
  "props": {
    "defaultSize": {
      "height": 76,
      "width": 1561
    }
  },
  "root": {
    "children": [
      {
        "children": [
          {
            "meta": {
              "domId": "evAssetStatus",
              "name": "evAssetStatus"
            },
            "position": {
              "shrink": 0
            },
            "propConfig": {
              "position.display": {
                "binding": {
                  "config": {
                    "path": "view.params.value"
                  },
                  "overlayOptOut": true,
                  "transforms": [
                    {
                      "code": "\t#A section\u0027s header is its title (868mvwg9e): an OEE line with cells has its card among its area\u0027s tiles, so not again here\n\treturn False",
                      "type": "script"
                    }
                  ],
                  "type": "property"
                }
              },
              "props.params.value.assetInfo": {
                "binding": {
                  "config": {
                    "path": "view.params.value.assetInfo"
                  },
                  "overlayOptOut": true,
                  "type": "property"
                }
              },
              "props.path": {
                "binding": {
                  "config": {
                    "path": "view.params.value"
                  },
                  "overlayOptOut": true,
                  "transforms": [
                    {
                      "code": "\t\n#\tif value.get(\u0027assetInfo\u0027) is None or not value[\u0027assetInfo\u0027][\u0027oeeEnabled\u0027] or value[\u0027assetInfo\u0027].get(\u0027_assetOEEStateDisplay\u0027) is None: return \u0027kanoa/core/dbp/blankView\u0027\n\tif value.get(\u0027assetInfo\u0027) is None or not value[\u0027assetInfo\u0027][\u0027oeeEnabled\u0027]: return \u0027kanoa/core/dbp/blankView\u0027\n\treturn  value[\u0027assetInfo\u0027].get(\u0027_assetOEEStateDisplay\u0027) or \u0027kanoa/mes/asset/overview/assetOEEState\u0027",
                      "type": "script"
                    }
                  ],
                  "type": "property"
                }
              }
            },
            "props": {
              "params": {
                "value": {}
              },
              "style": {
                "overflow": "visible"
              },
              "useDefaultViewWidth": true
            },
            "type": "ia.display.view"
          },
          {
            "events": {
              "dom": {
                "onClick": {
                  "config": {
                    "script": "\n\texpandMsg \u003d {\u0027expand\u0027: not self.view.custom.expand, \u0027assetPath\u0027: self.view.params.value.assetInfo.assetPath}\n\tsystem.perspective.sendMessage(\u0027expandAssets\u0027, expandMsg)\n\tself.view.custom.expand \u003d not self.view.custom.expand\n\t\n\treturn"
                  },
                  "scope": "G",
                  "type": "script"
                }
              }
            },
            "meta": {
              "domId": "icoExpand",
              "name": "icoExpand"
            },
            "position": {
              "basis": "30px",
              "shrink": 0
            },
            "propConfig": {
              "meta.visible": {
                "binding": {
                  "config": {
                    "path": "view.params.value.childAssets"
                  },
                  "overlayOptOut": true,
                  "transforms": [
                    {
                      "code": "\t\n\treturn len(value) \u003e 0",
                      "type": "script"
                    }
                  ],
                  "type": "property"
                }
              },
              "position.display": {
                "binding": {
                  "config": {
                    "path": "view.params.value"
                  },
                  "overlayOptOut": true,
                  "transforms": [
                    {
                      "code": "\t#Only where there are child groups to expand (868mvwg9e): a hidden arrow still took its 30px and indented the areas\n\tif value.get(\u0027assetInfo\u0027) is None: return False\n\treturn len(value.get(\u0027childAssets\u0027) or []) \u003e 0",
                      "type": "script"
                    }
                  ],
                  "type": "property"
                }
              },
              "props.path": {
                "binding": {
                  "config": {
                    "struct": {
                      "expand": "{view.custom.expand}",
                      "timeNow": "now(0)"
                    },
                    "waitOnAll": true
                  },
                  "overlayOptOut": true,
                  "transforms": [
                    {
                      "code": "\n\treturn \u0027material/keyboard_arrow_down\u0027 if value[\u0027expand\u0027] else \u0027material/keyboard_arrow_right\u0027",
                      "type": "script"
                    }
                  ],
                  "type": "expr-struct"
                }
              }
            },
            "props": {
              "color": "--kcOnSurface",
              "style": {
                "classes": "kanoa/button/flatIcon",
                "height": 30,
                "width": 30
              }
            },
            "type": "ia.display.icon"
          },
          {
            "children": [
              {
                "meta": {
                  "domId": "lblLevel",
                  "name": "lblLevel"
                },
