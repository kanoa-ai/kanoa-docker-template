                        "borderLeftStyle": "none",
                        "borderRightStyle": "none",
                        "borderBottomStyle": "solid",
                        "borderBottomWidth": "2px",
                        "borderRadius": "0px",
                        "height": "22px",
                        "padding": "0px 4px",
                        "borderLeftWidth": "0px",
                        "borderRightWidth": "0px",
                        "borderTopWidth": "0px",
                        "boxShadow": "none",
                        "outline": "none"
                      },
                      "text": "",
                      "textStyle": {
                        "classes": "kanoa/font/labelSmall"
                      }
                    },
                    "type": "ia.input.button"
                  }
                ],
                "meta": {
                  "domId": "flxButtons",
                  "name": "flxButtons"
                },
                "position": {
                  "basis": "auto"
                },
                "propConfig": {
                  "position.display": {
                    "binding": {
                      "config": {
                        "struct": {
                          "expand": "{view.custom.expand}",
                          "level": "{view.params.value.level}"
                        },
                        "waitOnAll": true
                      },
                      "overlayOptOut": true,
                      "transforms": [
                        {
                          "code": "\t\n\treturn value[\u0027level\u0027] \u003e 0 and value[\u0027expand\u0027] \u003d\u003d True",
                          "type": "script"
                        }
                      ],
                      "type": "expr-struct"
                    }
                  },
                  "props.style.opacity": {
                    "binding": {
                      "config": {
                        "struct": {
                          "hover": "{view.custom.hover}",
                          "level": "{view.custom.showInfolevel}"
                        },
                        "waitOnAll": true
                      },
                      "overlayOptOut": true,
                      "transforms": [
                        {
                          "code": "\t#Hidden until the pointer is on the section\u0027s name, so the page isn\u0027t full of tab icons (868mvwg9e);\n\t#a section on Asset details or Summary keeps them, to show which tab it\u0027s on\n\treturn 1 if value[\u0027hover\u0027] or value[\u0027level\u0027] !\u003d \u0027status\u0027 else 0",
                          "type": "script"
                        }
                      ],
                      "type": "expr-struct"
                    }
                  }
                },
                "props": {
                  "justify": "flex-end",
                  "style": {
                    "gap": "2px",
                    "transition": "opacity 0.15s"
                  }
                },
                "type": "ia.container.flex"
              }
            ],
            "meta": {
              "domId": "flxTitle",
              "name": "flxTitle"
            },
            "position": {
              "basis": "auto",
              "shrink": 0
            },
            "propConfig": {
              "position.display": {
                "binding": {
                  "config": {
                    "path": "view.params.value.assetInfo.oeeEnabled"
                  },
                  "overlayOptOut": true,
                  "transforms": [
                    {
                      "code": "\treturn True",
                      "type": "script"
                    }
                  ],
                  "type": "property"
                }
              },
              "props.style.height": {
                "binding": {
                  "config": {
                    "path": "view.custom.leaf"
                  },
                  "overlayOptOut": true,
                  "transforms": [
                    {
                      "code": "\treturn \u002722px\u0027 if value else \u002740px\u0027",
                      "type": "script"
                    }
                  ],
                  "type": "property"
                }
              },
              "props.style.cursor": {
                "binding": {
                  "config": {
                    "path": "view.params.value.assetInfo.oeeEnabled"
                  },
                  "overlayOptOut": true,
                  "transforms": [
                    {
                      "code": "\treturn \u0027pointer\u0027 if value else \u0027default\u0027",
                      "type": "script"
                    }
                  ],
                  "type": "property"
                }
              }
            },
            "props": {
              "alignItems": "center",
              "style": {
                "gap": "5px",
                "height": "40px",
                "overflow": "hidden"
              }
            },
            "type": "ia.container.flex",
            "events": {
              "dom": {
                "onClick": {
                  "config": {
                    "script": "\t#A line\u0027s section title opens the line, as its card does (868mvwg9e)\n\tif not self.view.params.value.assetInfo.oeeEnabled: return\n\tsystem.kanoa.utilities.storeAssetPath(self, self.view.params.value.assetInfo.assetPath)\n\tparams \u003d {\"path\": \"kanoa/mes/asset/operation/main\", \"name\": \"Asset Operation\", \"type\": \"view\", \"params\": {}}\n\tsystem.perspective.sendMessage(\"updateNavigation\", payload\u003dparams)"
                  },
                  "scope": "G",
                  "type": "script"
                },
                "onMouseEnter": {
                  "config": {
                    "script": "\t#The tabs show while the pointer is on the section\u0027s name (868mvwg9e)\n\tself.view.custom.hover \u003d True"
                  },
                  "scope": "G",
                  "type": "script"
                },
                "onMouseLeave": {
                  "config": {
                    "script": "\t#The tabs show while the pointer is on the section\u0027s name (868mvwg9e)\n\tself.view.custom.hover \u003d False"
                  },
                  "scope": "G",
                  "type": "script"
                }
              }
            }
          }
        ],
        "meta": {
          "domId": "flxHeader",
          "name": "flxHeader"
        },
        "position": {
          "basis": "auto",
          "shrink": 0
        },
        "props": {
          "alignContent": "flex-start",
          "alignItems": "center",
          "style": {
            "backgroundColor": "transparent",
            "gap": "5px",
            "overflow": "hidden"
          },
          "wrap": "wrap"
        },
        "type": "ia.container.flex",
        "propConfig": {}
      },
      {
        "children": [
          {
            "meta": {
              "domId": "flxChildAssetStatus",
              "name": "flxChildAssetStatus"
            },
            "propConfig": {
              "position.display": {
                "binding": {
                  "config": {
                    "path": "view.custom.showInfolevel"
                  },
                  "overlayOptOut": true,
                  "transforms": [
                    {
                      "code": "\treturn value \u003d\u003d \u0027status\u0027",
                      "type": "script"
                    }
                  ],
                  "type": "property"
                }
              },
              "props.instances": {
                "binding": {
                  "config": {
                    "path": "view.params.value.assets"
                  },
                  "overlayOptOut": true,
                  "transforms": [
                    {
                      "code": "\n\tinstances \u003d sorted(value, key\u003dlambda x: x[\u0027assetInfo\u0027][\u0027sortOrder\u0027])\n\treturn [{\u0027value\u0027: {\u0027assetInfo\u0027: item[\u0027assetInfo\u0027]}} for item in instances if item[\u0027assetInfo\u0027] is not None]",
                      "type": "script"
                    }
                  ],
                  "type": "property"
                }
              }
            },
            "props": {
              "alignContent": "center",
              "alignItems": "flex-start",
              "elementPosition": {
                "basis": "auto",
                "grow": 0,
                "shrink": 0
              },
              "path": "kanoa/mes/asset/overview/assetOEEState",
              "style": {
                "gap": "0px",
                "overflow": "visible"
              },
              "useDefaultViewHeight": false,
              "wrap": "wrap"
            },
            "type": "ia.display.flex-repeater"
          }
        ],
        "meta": {
          "domId": "flxContent",
          "name": "flxContent"
        },
        "position": {
          "basis": "400px",
          "grow": 1,
          "shrink": 0
        },
        "props": {
          "direction": "column",
          "justify": "center",
          "style": {
            "gap": 5,
            "overflow": "hidden"
          }
        },
        "type": "ia.container.flex",
        "propConfig": {
          "position.basis": {
            "binding": {
              "config": {
                "path": "view.custom.stacked"
              },
              "overlayOptOut": true,
              "transforms": [
                {
                  "code": "\treturn \u0027auto\u0027 if value else \u0027400px\u0027",
                  "type": "script"
                }
              ],
              "type": "property"
            }
          }
        }
      }
    ],
    "meta": {
      "domId": "root",
      "name": "root"
    },
    "props": {
      "alignItems": "center",
      "style": {
        "backgroundColor": "transparent",
        "gap": 5,
        "padding": "3px",
        "borderRadius": "var(--borderRadius)"
      },
      "wrap": "wrap"
    },
    "type": "ia.container.flex",
    "propConfig": {
      "props.direction": {
        "binding": {
          "config": {
            "path": "view.custom.stacked"
          },
          "overlayOptOut": true,
          "transforms": [
            {
              "code": "\treturn \u0027column\u0027 if value else \u0027row\u0027",
              "type": "script"
            }
          ],
          "type": "property"
        }
      },
      "props.alignItems": {
        "binding": {
          "config": {
            "path": "view.custom.stacked"
          },
          "overlayOptOut": true,
          "transforms": [
            {
              "code": "\treturn \u0027stretch\u0027 if value else \u0027center\u0027",
              "type": "script"
            }
          ],
          "type": "property"
        }
      },
      "props.style.backgroundColor": {
        "binding": {
          "config": {
            "path": "view.custom.mixed"
          },
          "overlayOptOut": true,
          "transforms": [
            {
              "code": "\treturn \u0027color-mix(in srgb, var(--kcSurfaceVariant) 45%, var(--kcSurface))\u0027 if value else \u0027transparent\u0027",
              "type": "script"
            }
          ],
          "type": "property"
        }
      }
    }
  }
}