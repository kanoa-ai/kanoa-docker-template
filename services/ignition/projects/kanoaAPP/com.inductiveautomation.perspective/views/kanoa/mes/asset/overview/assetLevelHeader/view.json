                    "binding": {
                      "config": {
                        "path": "view.params.value"
                      },
                      "overlayOptOut": true,
                      "transforms": [
                        {
                          "code": "\t\n\tif value[\u0027assetInfo\u0027][\u0027assetPath\u0027] is None: return \u0027\u0027\n\tif value[\u0027level\u0027] \u003e 2: return \" \u003e \".join(value[\u0027assetInfo\u0027][\u0027assetPath\u0027].split(\"\\\\\")[2:])\n\treturn value[\u0027assetName\u0027] or \u0027\u0027",
                          "type": "script"
                        }
                      ],
                      "type": "property"
                    }
                  },
                  "props.textStyle.fontSize": {
                    "binding": {
                      "config": {
                        "path": "view.custom.size"
                      },
                      "transforms": [
                        {
                          "code": "\n\treturn \u0027%spx\u0027%(value or 20)",
                          "type": "script"
                        }
                      ],
                      "type": "property"
                    }
                  }
                },
                "props": {
                  "style": {
                    "color": "--kcOnSurface",
                    "fontWeight": "600"
                  }
                },
                "type": "ia.display.label"
              },
