  "propConfig": {
    "custom.assetInfo": {
      "binding": {
        "config": {
          "path": "view.params.value"
        },
        "overlayOptOut": true,
        "type": "property"
      }
    },
    "custom.childCount": {
      "binding": {
        "config": {
          "path": "view.params.value.childCount"
        },
        "overlayOptOut": true,
        "type": "property"
      }
    },
    "custom.tagOEEInfo": {
      "binding": {
        "config": {
          "fallbackDelay": 2.5,
          "mode": "expression",
          "tagPath": "\"[kanoaMES]\" + replace(substring({view.custom.assetInfo.tagPath}, indexOf({view.custom.assetInfo.tagPath}, \"]\") + 1), \"\\\\\", \"/\") + \"/OEE/info\""
        },
        "overlayOptOut": true,
        "transforms": [
          {
            "code": "\n\t#The asset\u0027s OEE/info tag: its kanoaMES OEE tags (which the module keeps for every OEE asset; the [Kanoa] Line UDT\n\t#isn\u0027t always there) in one document that changes whenever any of them does. Flattened to the names the Line UDT\u0027s\n\t#OEE folder had; dates are in milliseconds, as that binding gave them. None without an asset\n\tif value is None: return None\n\tdef folder(name):\n\t\ttry: return value[name]\n\t\texcept: return None\n\tdef field(values, name):\n\t\ttry: return values[name]\n\t\texcept: return None\n\tstatus, run \u003d folder(\u0027Status\u0027), folder(\u0027Current Run\u0027)\n\tinfo \u003d {}\n\tfor name in [\u0027modeId\u0027, \u0027modeName\u0027, \u0027modeTypeName\u0027, \u0027modeColor\u0027, \u0027modeSourceName\u0027, \u0027userName\u0027, \u0027iconPath\u0027, \u0027workOrderId\u0027,\n\t\t\t\u0027workOrderName\u0027, \u0027workOrderTitle\u0027, \u0027reqdQty\u0027, \u0027woActualQty\u0027, \u0027itemId\u0027, \u0027itemName\u0027, \u0027itemDescription\u0027, \u0027infeedUnits\u0027,\n\t\t\t\u0027outfeedUnits\u0027, \u0027wasteUnits\u0027, \u0027packageCount\u0027, \u0027woRemainingMinutes\u0027, \u0027shiftId\u0027, \u0027shiftNameId\u0027, \u0027shiftName\u0027, \u0027shiftStart\u0027,\n\t\t\t\u0027shiftEnd\u0027, \u0027scheduleBlockId\u0027, \u0027scheduleStart\u0027, \u0027scheduleEnd\u0027, \u0027stateName\u0027, \u0027stateStart\u0027, \u0027stateTypeName\u0027, \u0027stateColor\u0027,\n\t\t\t\u0027stateTypeColor\u0027, \u0027stateIconPath\u0027, \u0027assetId\u0027]:\n\t\tinfo[name] \u003d field(status, name)\n\tfor name in [\u0027startDate\u0027, \u0027durationSecs\u0027, \u0027runtimeSecs\u0027, \u0027unplannedDowntimeSecs\u0027, \u0027plannedDowntimeSecs\u0027, \u0027targetCount\u0027,\n\t\t\t\u0027standardRate\u0027, \u0027period\u0027, \u0027infeedRateSecs\u0027, \u0027availability\u0027, \u0027performance\u0027, \u0027quality\u0027, \u0027infeedCount\u0027, \u0027outfeedCount\u0027,\n\t\t\t\u0027wasteCount\u0027]:\n\t\tinfo[name] \u003d field(run, name)\n\t#As the module works it out for the Line tags: the run\u0027s outfeed per minute, in production only\n\tduration, outfeed \u003d info[\u0027durationSecs\u0027], info[\u0027outfeedCount\u0027]\n\tinfo[\u0027outfeedRatePerMinute\u0027] \u003d outfeed / (duration / 60.0) if info[\u0027modeTypeName\u0027] \u003d\u003d \u0027Production\u0027 and duration and outfeed is not None else None\n\tinfo[\u0027endDate\u0027] \u003d None\n\treturn info",
            "type": "script"
          }
        ],
        "type": "tag"
      },
      "persistent": true
    },
    "params.value": {
      "paramDirection": "input",
      "persistent": true
    }
  },
  "props": {
    "defaultSize": {
      "height": 84,
      "width": 340
    }
  },
  "root": {
    "children": [
      {
        "meta": {
          "domId": "flxAccent",
          "name": "flxAccent"
        },
        "position": {
          "basis": "6px",
          "shrink": 0
        },
        "propConfig": {
          "props.style.backgroundColor": {
            "binding": {
              "config": {
                "struct": {
                  "asset": "{view.custom.assetInfo}",
                  "oee": "{view.custom.tagOEEInfo}"
                },
                "waitOnAll": false
              },
              "overlayOptOut": true,
              "transforms": [
                {
                  "code": "\n\t# The state\u0027s colour for an OEE asset (as on the Asset Overview cards); the tile colour for one you step into\n\tasset \u003d value[\u0027asset\u0027] or {}\n\toee \u003d value[\u0027oee\u0027]\n\tif asset.get(\u0027oeeEnabled\u0027):\n\t\treturn (oee and (oee[\u0027stateColor\u0027] or oee[\u0027stateTypeColor\u0027] or oee[\u0027modeColor\u0027])) or \u0027var(--kcOutlineVariant)\u0027\n\treturn \u0027var(--kcPrimary)\u0027",
                  "type": "script"
                }
              ],
              "type": "expr-struct"
            }
          }
        },
        "props": {
          "style": {
            "alignSelf": "stretch"
          }
        },
        "type": "ia.container.flex"
      },
      {
        "children": [
          {
            "meta": {
              "domId": "lblTitle",
              "name": "lblTitle"
            },
            "position": {
              "shrink": 0
            },
            "propConfig": {
              "props.text": {
                "binding": {
                  "config": {
                    "path": "view.custom.assetInfo.assetName"
                  },
                  "overlayOptOut": true,
                  "type": "property"
                }
              }
            },
            "props": {
              "textStyle": {
                "classes": "kanoa/font/titleMedium",
                "overflow": "hidden",
                "textOverflow": "ellipsis",
                "whiteSpace": "nowrap"
              }
            },
            "type": "ia.display.label"
          },
          {
            "meta": {
              "domId": "lblStatus",
              "name": "lblStatus"
            },
            "position": {
              "shrink": 0
            },
            "propConfig": {
              "props.text": {
                "binding": {
                  "config": {
                    "struct": {
                      "asset": "{view.custom.assetInfo}",
                      "count": "{view.custom.childCount}",
                      "locale": "{session.props.locale}",
                      "oee": "{view.custom.tagOEEInfo}"
                    },
                    "waitOnAll": false
                  },
                  "overlayOptOut": true,
                  "transforms": [
                    {
                      "code": "\n\t# OEE asset: its mode and state. Site, area or line: its type and how many assets are under it (868mwap0a)\n\tlocale \u003d value[\u0027locale\u0027]\n\tt \u003d lambda text: system.util.translate(text, locale)\n\tasset \u003d value[\u0027asset\u0027] or {}\n\tif asset.get(\u0027oeeEnabled\u0027):\n\t\toee \u003d value[\u0027oee\u0027]\n\t\tif not oee: return \u0027\u0027\n\t\tparts \u003d [t(p) for p in (oee[\u0027modeName\u0027], oee[\u0027stateName\u0027]) if p]\n\t\treturn u\u0027 \\u00b7 \u0027.join(parts) if parts else t(\u0027No mode set\u0027)\n\tcount \u003d value[\u0027count\u0027] or 0\n\tkind \u003d t((asset.get(\u0027assetTypeName\u0027) or \u0027\u0027).capitalize())\n\ttext \u003d t(\u0027%d asset\u0027 if count \u003d\u003d 1 else \u0027%d assets\u0027) % count\n\treturn kind + u\u0027 \\u00b7 \u0027 + text if kind else text",
                      "type": "script"
                    }
                  ],
                  "type": "expr-struct"
                }
              }
            },
            "props": {
              "textStyle": {
                "classes": "kanoa/font/bodySmall",
                "overflow": "hidden",
                "textOverflow": "ellipsis",
                "whiteSpace": "nowrap"
              }
            },
            "type": "ia.display.label"
          },
          {
            "meta": {
              "domId": "lblOrder",
              "name": "lblOrder"
            },
            "position": {
              "shrink": 0
            },
            "propConfig": {
              "position.display": {
                "binding": {
                  "config": {
                    "path": "view.custom.assetInfo.oeeEnabled"
                  },
                  "overlayOptOut": true,
                  "type": "property"
                }
              },
              "props.text": {
                "binding": {
                  "config": {
                    "struct": {
                      "locale": "{session.props.locale}",
                      "oee": "{view.custom.tagOEEInfo}"
                    },
                    "waitOnAll": false
                  },
                  "overlayOptOut": true,
                  "transforms": [
                    {
                      "code": "\n\toee \u003d value[\u0027oee\u0027]\n\tif not oee: return \u0027\u0027\n\torder \u003d oee[\u0027workOrderName\u0027]\n\tif not order: return system.util.translate(\u0027No running order\u0027, value[\u0027locale\u0027])\n\treturn order + (u\u0027 \\u00b7 \u0027 + oee[\u0027itemName\u0027] if oee[\u0027itemName\u0027] else \u0027\u0027)",
                      "type": "script"
                    }
                  ],
                  "type": "expr-struct"
                }
              }
            },
            "props": {
              "textStyle": {
                "classes": "kanoa/font/bodySmall",
                "color": "var(--kcOnSurfaceVariant)",
                "overflow": "hidden",
                "textOverflow": "ellipsis",
                "whiteSpace": "nowrap"
              }
            },
            "type": "ia.display.label"
          }
        ],
        "meta": {
          "domId": "flxLabel",
          "name": "flxLabel"
        },
        "position": {
          "basis": "0",
          "grow": 1
        },
        "props": {
          "direction": "column",
          "justify": "center",
          "style": {
            "gap": 4,
            "margin": "10px 12px",
            "overflow": "hidden"
          }
        },
        "type": "ia.container.flex"
      },
      {
        "meta": {
          "domId": "icoStep",
          "name": "icoStep",
          "tooltip": {
            "enabled": true
          }
        },
        "position": {
          "basis": "24px",
          "shrink": 0
        },
        "propConfig": {
          "meta.tooltip.text": {
            "binding": {
              "config": {
                "path": "session.props.locale"
              },
              "overlayOptOut": true,
              "transforms": [
                {
                  "code": "\treturn system.util.translate(\u0027Show the assets in it\u0027, value)",
                  "type": "script"
                }
              ],
              "type": "property"
            }
          },
          "position.display": {
            "binding": {
              "config": {
                "path": "view.custom.assetInfo.oeeEnabled"
              },
              "overlayOptOut": true,
              "transforms": [
                {
                  "code": "\treturn not value",
                  "type": "script"
                }
              ],
              "type": "property"
            }
          }
        },
        "props": {
          "path": "material/chevron_right",
          "style": {
            "color": "var(--kcOnSurfaceVariant)",
            "marginRight": "6px"
          }
        },
        "type": "ia.display.icon"
      },
      {
        "children": [
          {
            "meta": {
              "domId": "icon",
              "name": "icon"
            },
            "position": {
              "basis": "34px",
              "grow": 1,
              "shrink": 0
            },
            "propConfig": {
              "props.path": {
                "binding": {
                  "config": {
                    "path": "view.custom.assetInfo.iconPath"
                  },
                  "overlayOptOut": true,
                  "type": "property"
                }
              }
            },
            "props": {
              "style": {
                "color": "var(--kcOnPrimaryContainer)",
                "padding": "12px"
              }
            },
            "type": "ia.display.icon"
          }
        ],
        "meta": {
          "domId": "flxIcon",
          "name": "flxIcon"
        },
        "position": {
          "basis": "72px",
          "shrink": 0
        },
        "props": {
          "alignItems": "center",
          "justify": "center",
          "style": {
            "alignSelf": "stretch",
            "background": "var(--kcPrimaryContainer)"
          }
        },
        "type": "ia.container.flex"
      }
    ],
    "events": {
      "dom": {
        "onClick": {
          "config": {
            "script": "\n\t# Select the asset (Asset Operation follows the stored asset path). On kanoaTablet (openOperation) an OEE asset opens\n\t# its Asset Operation page; anything else shows the assets under it (868mwap0a)\n\tvalue \u003d dict(self.view.params.value)\n\tsystem.kanoa.utilities.storeAssetPath(self, value[\u0027assetPath\u0027])\n\tif value.get(\u0027oeeEnabled\u0027) and value.get(\u0027openOperation\u0027):\n\t\tsystem.perspective.sendMessage(\u0027updateNavigation\u0027, payload\u003d{\u0027path\u0027: \u0027kanoa/mes/asset/operation/main\u0027, \u0027name\u0027: \u0027Asset Operation\u0027, \u0027type\u0027: \u0027view\u0027, \u0027params\u0027: {}})\n\telse:\n\t\tsystem.perspective.sendMessage(\u0027assetNavSelection\u0027, payload\u003d{\u0027value\u0027: {\u0027assetId\u0027: value.get(\u0027assetId\u0027), \u0027assetPath\u0027: value[\u0027assetPath\u0027]}})\n\treturn"
          },
          "scope": "G",
          "type": "script"
        }
      }
    },
    "meta": {
      "domId": "root",
      "name": "root"
    },
    "props": {
      "alignItems": "center",
      "style": {
        "classes": "kanoa/clickable kanoa/container",
        "overflow": "hidden"
      }
    },
    "type": "ia.container.flex"
  }
}