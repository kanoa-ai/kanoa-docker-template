{
  "custom": {},
  "params": {
    "value": {
      "badgeText": "",
      "badgeType": "good",
      "label": "",
      "sub": "",
      "tooltip": "",
      "value": ""
    }
  },
  "propConfig": {
    "params.value": {
      "paramDirection": "input",
      "persistent": true
    }
  },
  "props": {
    "defaultSize": {
      "height": 124,
      "width": 164
    }
  },
  "root": {
    "children": [
      {
        "meta": {
          "name": "lblLabel"
        },
        "propConfig": {
          "props.text": {
            "binding": {
              "config": {
                "path": "view.params.value.label"
              },
              "type": "property"
            }
          }
        },
        "props": {
          "style": {
            "classes": "kanoa/font/default",
            "fontSize": "11.5px"
          }
        },
        "type": "ia.display.label"
      },
      {
        "meta": {
          "name": "lblValue"
        },
        "propConfig": {
          "props.text": {
            "binding": {
              "config": {
                "path": "view.params.value.value"
              },
              "type": "property"
            }
          }
        },
        "props": {
          "style": {
            "classes": "kanoa/font/default",
            "fontSize": "26px",
            "fontWeight": "700"
          }
        },
        "type": "ia.display.label"
      },
      {
        "meta": {
          "name": "lblSub"
        },
        "propConfig": {
          "props.text": {
            "binding": {
              "config": {
                "path": "view.params.value.sub"
              },
              "type": "property"
            }
          }
        },
        "props": {
          "style": {
            "classes": "kanoa/font/default",
            "fontSize": "11.5px"
          }
        },
        "type": "ia.display.label"
      },
      {
        "meta": {
          "name": "lblBadge"
        },
        "propConfig": {
          "props.style": {
            "binding": {
              "config": {
                "path": "view.params.value.badgeType"
              },
              "overlayOptOut": true,
              "transforms": [
                {
                  "code": "\n\tcolors \u003d {\n\t\t\u0027good\u0027: {\u0027color\u0027: \u0027#1a7f5a\u0027, \u0027backgroundColor\u0027: \u0027#e6f4ee\u0027},\n\t\t\u0027warn\u0027: {\u0027color\u0027: \u0027#b25e09\u0027, \u0027backgroundColor\u0027: \u0027#fbeee0\u0027},\n\t\t\u0027bad\u0027: {\u0027color\u0027: \u0027#b3261e\u0027, \u0027backgroundColor\u0027: \u0027#fbe7e5\u0027}\n\t}\n\tc \u003d colors.get(value, colors[\u0027good\u0027])\n\treturn {\n\t\t\u0027color\u0027: c[\u0027color\u0027],\n\t\t\u0027backgroundColor\u0027: c[\u0027backgroundColor\u0027],\n\t\t\u0027borderRadius\u0027: \u0027999px\u0027,\n\t\t\u0027padding\u0027: \u00272px 8px\u0027,\n\t\t\u0027fontSize\u0027: \u002711px\u0027,\n\t\t\u0027fontWeight\u0027: \u0027600\u0027,\n\t\t\u0027display\u0027: \u0027inline-block\u0027\n\t}\n\t",
                  "type": "script"
                }
              ],
              "type": "property"
            }
          },
          "props.text": {
            "binding": {
              "config": {
                "path": "view.params.value.badgeText"
              },
              "type": "property"
            }
          }
        },
        "type": "ia.display.label"
      }
    ],
    "meta": {
      "name": "root",
      "tooltip": {
        "enabled": true,
        "location": "bottom"
      }
    },
    "propConfig": {
      "meta.tooltip.text": {
        "binding": {
          "config": {
            "path": "view.params.value.tooltip"
          },
          "overlayOptOut": true,
          "type": "property"
        }
      }
    },
    "props": {
      "direction": "column",
      "style": {
        "classes": "kanoa/container",
        "gap": "5px",
        "padding": "5px"
      }
    },
    "type": "ia.container.flex"
  }
}