{
  "custom": {
    "edit": {
      "assetId": null,
      "cycleRate": null,
      "enabled": true,
      "itemPeriodId": null
    },
    "rates": [],
    "refresh": null,
    "selectedData": [],
    "selectedRow": null,
    "toolingAssetId": null,
    "userAction": {
      "canCreate": false,
      "canRead": true,
      "canUpdate": false
    },
    "hosts": [],
    "toastId": null
  },
  "params": {
    "value": {
      "toolingAssetId": null
    }
  },
  "propConfig": {
    "custom.security": {
      "binding": {
        "config": {
          "path": "session.custom.kanoa.security"
        },
        "overlayOptOut": true,
        "type": "property"
      },
      "persistent": true
    },
    "params.value": {
      "paramDirection": "input",
      "persistent": true
    },
    "custom.toolingAssetId": {
      "binding": {
        "config": {
          "path": "view.params.value"
        },
        "overlayOptOut": true,
        "transforms": [
          {
            "code": "\n\treturn value.get(\u0027toolingAssetId\u0027) if value else None",
            "type": "script"
          }
        ],
        "type": "property"
      },
      "persistent": true
    },
    "custom.rates": {
      "binding": {
        "config": {
          "struct": {
            "toolingAssetId": "{view.custom.toolingAssetId}",
            "refresh": "{view.custom.refresh}"
          },
          "waitOnAll": true
        },
        "overlayOptOut": true,
        "transforms": [
          {
            "code": "\n\tif value[\u0027toolingAssetId\u0027] is None: return []\n\treturn system.kanoa.utilities.convertDatasetToJSON(system.kanoa.tooling.getCycleRates({\u0027toolingAssetId\u0027: value[\u0027toolingAssetId\u0027]}) or [])",
            "type": "script"
          }
        ],
        "type": "expr-struct"
      }
    },
    "custom.selectedData": {
      "binding": {
        "config": {
          "struct": {
            "rows": "{view.custom.rates}",
            "row": "{view.custom.selectedRow}"
          },
          "waitOnAll": true
        },
        "overlayOptOut": true,
        "transforms": [
          {
            "code": "\n\trows \u003d value[\u0027rows\u0027] or []\n\trow \u003d value[\u0027row\u0027]\n\tif row is None or row \u003c 0 or row \u003e\u003d len(rows): return []\n\treturn [dict(rows[row])]",
            "type": "script"
          }
        ],
        "type": "expr-struct"
      }
    },
    "custom.userAction": {
      "binding": {
        "config": {
          "struct": {
            "security": "{view.custom.security}"
          },
          "waitOnAll": true
        },
        "overlayOptOut": true,
        "transforms": [
          {
            "code": "\n\tsecurity \u003d value[\u0027security\u0027]\n\tuserCRUD \u003d security[\u0027userCRUD\u0027] if security else {}\n\tcanEdit \u003d bool(userCRUD) and (userCRUD.get(\u0027isGatewayAdmin\u0027) or userCRUD.get(\u0027configureAssets\u0027, {}).get(\u0027enabled\u0027))\n\treturn {\u0027canCreate\u0027: canEdit, \u0027canUpdate\u0027: canEdit, \u0027canRead\u0027: True}",
            "type": "script"
          }
        ],
        "type": "expr-struct"
      }
    },
    "custom.hosts": {
      "binding": {
        "config": {
          "path": "view.custom.toolingAssetId"
        },
        "overlayOptOut": true,
        "type": "property",
        "transforms": [
          {
            "code": "\n\t# A tool that belongs to a site has rates only on that site\u0027s machines; one outside any site, on any machine\n\ttoolId \u003d value\n\trows \u003d system.kanoa.utilities.convertDatasetToJSON(system.kanoa.asset.getAssets({\u0027usesTooling\u0027: True}) or []) or []\n\ttools \u003d (system.kanoa.utilities.convertDatasetToJSON(system.kanoa.tooling.getTools({\u0027toolingAssetId\u0027: toolId}) or []) or []) if toolId else []\n\tsiteId \u003d tools[0][\u0027siteId\u0027] if tools else None\n\tif siteId is not None:\n\t\tsites \u003d system.kanoa.utilities.convertDatasetToJSON(system.kanoa.asset.getAssets({\u0027assetId\u0027: siteId}) or []) or []\n\t\tsitePath \u003d sites[0][\u0027assetPath\u0027] + \u0027\\\\\u0027 if sites else None\n\t\trows \u003d [r for r in rows if sitePath and (r[\u0027assetPath\u0027] or \u0027\u0027).startswith(sitePath)]\n\treturn [{\u0027assetId\u0027: r[\u0027assetId\u0027], \u0027assetPath\u0027: r[\u0027assetPath\u0027]} for r in rows]",
            "type": "script"
          }
        ]
      }
    }
  },
  "props": {
    "defaultSize": {
      "height": 500,
      "width": 950
    }
  },
