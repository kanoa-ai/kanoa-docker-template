                "meta": {
                  "name": "evHost"
                },
                "position": {
                  "basis": "0px",
                  "grow": 1
                },
                "propConfig": {
                  "props.params.value.assetPath": {
                    "binding": {
                      "config": {
                        "struct": {
                          "assetId": "{view.custom.edit.assetId}",
                          "targets": "{view.custom.hosts}"
                        },
                        "waitOnAll": true
                      },
                      "overlayOptOut": true,
                      "transforms": [
                        {
                          "code": "\n\t# The selector shows the asset by its path\n\tfor t in value[\u0027targets\u0027] or []:\n\t\tif t[\u0027assetId\u0027] \u003d\u003d value[\u0027assetId\u0027]: return t[\u0027assetPath\u0027]\n\treturn None",
                          "type": "script"
                        }
                      ],
                      "type": "expr-struct"
                    }
                  },
                  "props.params.value.parentPathList": {
                    "binding": {
                      "config": {
                        "path": "view.custom.hosts"
                      },
                      "overlayOptOut": true,
                      "type": "property",
                      "transforms": [
                        {
                          "code": "\n\t# Only these assets can be picked\n\treturn [t[\u0027assetPath\u0027] for t in value or []]",
                          "type": "script"
                        }
                      ]
                    }
                  },
                  "position.display": {
                    "binding": {
                      "config": {
                        "expression": "len({view.custom.hosts}) \u003e 0"
                      },
                      "overlayOptOut": true,
                      "type": "expr"
                    }
                  }
                },
                "props": {
                  "params": {
                    "value": {
                      "followValue": true,
                      "msgHandler": "toolHostSelected",
                      "options": {
                        "dragDrop": false,
                        "expand": false,
                        "multiSelect": false,
                        "showBreadcrumb": true,
                        "showClear": true,
                        "showSelectedPath": false
                      },
                      "parentPathList": [],
                      "persistent": false,
                      "useSessionValue": false
                    }
                  },
                  "path": "kanoa/core/templates/selectors/assetSelector",
                  "style": {
                    "minWidth": "120px"
                  }
                },
                "type": "ia.display.view"
              },
