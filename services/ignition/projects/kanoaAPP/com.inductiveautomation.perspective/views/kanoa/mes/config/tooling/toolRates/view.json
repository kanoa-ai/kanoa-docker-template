          {
            "meta": {
              "name": "flxActions"
            },
            "position": {
              "shrink": 0
            },
            "props": {
              "justify": "center",
              "style": {
                "gap": "5px",
                "overflow": "hidden",
                "padding": "5px"
              }
            },
            "type": "ia.container.flex",
            "children": [
              {
                "events": {
                  "component": {
                    "onActionPerformed": {
                      "config": {
