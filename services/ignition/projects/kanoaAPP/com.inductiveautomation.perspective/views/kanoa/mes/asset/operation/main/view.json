          "script": "\n\tassetInfo \u003d self.view.custom.get(\u0027assetInfo\u0027,{}) or {}\n\tassetId \u003d assetInfo.get(\u0027assetId\u0027)\n\tassetPanels \u003d self.view.custom.get(\u0027assetPanels\u0027,{})\n\t\n\tif assetId is None or assetPanels is None: return\n\n\tself.view.custom.viewPanels \u003d  {\n\t\t\t\u0027body\u0027: {\"viewParams\": {\"value\": {\"assetId\": assetId}}, \"viewPath\": assetPanels[\u0027bodyPanelViewPath\u0027], \"viewTitle\": \"Main Menu\"},\n\t\t\t\u0027infoPanel\u0027: {\"viewParams\": {\"value\": {\"assetId\": assetId}}, \"viewPath\": assetPanels[\u0027infoPanelPath\u0027]}\n\t\t\t}\n\t\n\treturn"
