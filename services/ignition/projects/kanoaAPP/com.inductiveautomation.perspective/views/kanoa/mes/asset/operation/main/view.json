            "binding": {
              "config": {
                "path": "view.custom.assetInfo"
              },
              "transforms": [
                {
                  "code": "\t#The asset now, not the value this run started with: runs can finish out of order, and a stale run from before the\n\t#asset arrived left the screen with only the breadcrumb (868mwv0tm)\n\tvalue \u003d self.view.custom.assetInfo or value\n\t# An asset that isn\u0027t OEE-enabled (a site, area or line): cards for the assets under it (868mwap0a)\n\treturn bool(value and value[\u0027assetId\u0027] is not None and not value[\u0027oeeEnabled\u0027])",
                  "type": "script"
                }
              ],
