          "script": "\n\tif assetInfo[\u0027assetId\u0027] is None: return {\u0027infoPanelPath\u0027: \u0027kanoa/core/dbp/blankView\u0027, \u0027bodyPanelViewPath\u0027: \u0027kanoa/core/dbp/blankView\u0027}\n\t\n\tinfoPanelPath \u003d system.kanoa.asset.getClosestAncestorAttribute(assetInfo[\u0027assetPath\u0027], \u0027_assetOpsInfoPanelViewPath\u0027) or \u0027kanoa/mes/asset/operation/infoPanel/assetInfoPanel\u0027\n\tbodyPanelViewPath \u003d system.kanoa.asset.getClosestAncestorAttribute(assetInfo[\u0027assetPath\u0027], \u0027_assetOpsViewPath\u0027) or \u0027kanoa/mes/asset/operation/opsPanel/assetOperationPanel\u0027\n\t\n\treturn {\u0027infoPanelPath\u0027: infoPanelPath, \u0027bodyPanelViewPath\u0027: bodyPanelViewPath}"
        }
