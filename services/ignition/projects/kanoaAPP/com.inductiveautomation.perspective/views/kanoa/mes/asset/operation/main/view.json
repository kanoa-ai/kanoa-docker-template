  "params": {},
  "propConfig": {
    "custom.assetInfo": {
      "onChange": {
        "enabled": null,
        "script": "\n\t# An empty asset while the page has one selected: the two-way binding lost it at startup (takeSelectedAsset)\n\tif currentValue is not None and (currentValue.value is None or currentValue.value[\u0027assetId\u0027] is None):\n\t\tif self.getChild(\"root\").takeSelectedAsset(None): return\n\n#\tsystem.perspective.print(\u0027assetInfo change\u0027)\n\tif previousValue is None or currentValue.value !\u003d previousValue.value: self.getChild(\"root\").setAssetPanels()\n\n\treturn"
      },
      "persistent": true
    },
    "custom.assetPanels": {
      "binding": {
        "config": {
          "path": "view.custom.assetInfo"
        },
        "overlayOptOut": true,
        "transforms": [
          {
            "code": "\n\t#The asset now, not the value this run started with: runs can finish out of order, and a stale run with no asset\n\t#would leave the panels blank (868mt2m21). self is the view here\n\treturn self.getChild(\"root\").getAssetPanels(self.custom.assetInfo or value)",
            "type": "script"
          }
        ],
        "type": "property"
      },
      "onChange": {
        "enabled": null,
        "script": "\t\n\tself.getChild(\"root\").setAssetPanels()\n\t\n\treturn"
      },
      "persistent": true
    },
    "custom.infoCollapsed": {
      "binding": {
        "config": {
          "expression": "try(toBoolean({session.custom.kanoa.infoPanelCollapsed}), false) \u0026\u0026 {view.custom.assetPanels.infoPanelPath} \u003d \u0027kanoa/mes/asset/operation/infoPanel/assetInfoPanel\u0027"
        },
        "overlayOptOut": true,
        "type": "expr"
      }
    },
    "custom.security": {
      "binding": {
        "config": {
          "struct": {
            "user": "{session.props.auth.user}"
          },
          "waitOnAll": false
        },
        "overlayOptOut": true,
        "transforms": [
          {
            "code": "\t\n\tsecConfig \u003d system.kanoa.utilities.convertDatasetToDict(system.kanoa.security.getConfig({}), \u0027configName\u0027, \u0027configValue\u0027)\n\tuserId \u003d system.kanoa.security.getIDPUserId(value[\u0027user\u0027])\t\n\tuserCRUD \u003d system.kanoa.security.getUserAssetCRUD(userId)\n\t\n\treturn {\"userId\": userId, \"config\": secConfig, \"userCRUD\": userCRUD}",
            "type": "script"
          }
        ],
        "type": "expr-struct"
      },
      "persistent": true
    },
    "custom.viewPanels": {
      "persistent": true
    }
  },
