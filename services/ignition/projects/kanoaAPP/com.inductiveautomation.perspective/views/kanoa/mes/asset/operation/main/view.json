                          "code": "\t#The asset\u0027s info panel view (blank until the asset is known)\n\treturn value[\u0027path\u0027] if value[\u0027assetId\u0027] is not None and value[\u0027path\u0027] else \u0027kanoa/core/dbp/blankView\u0027",
