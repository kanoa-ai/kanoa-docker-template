    "events": {
      "system": {
        "onStartup": {
          "config": {
            "script": "\t# The page\u0027s selected asset when the screen opens, in case the asset selector\u0027s two-way binding never delivers it\n\t# and nothing changes to trigger the recovery: only the breadcrumb showed (868mwv0tm)\n\ttook \u003d self.takeSelectedAsset(None)\n\tlogger \u003d system.util.getLogger(\u0027kanoa.dashboard\u0027)\n\tif logger.isDebugEnabled():\n\t\tassetInfo \u003d self.view.custom.assetInfo or {}\n\t\tlogger.debug(\u0027Asset Operation opened on page %s: asset %s%s\u0027 % (self.page.props.pageId, assetInfo.get(\u0027assetPath\u0027), \u0027, taken from the page\u0027 if took else \u0027\u0027))"
          },
          "scope": "G",
          "type": "script"
        }
      }
    },
    "meta": {
      "domId": "root",
      "name": "root"
    },
    "props": {
      "direction": "column",
      "style": {
        "padding": "3px"
      }
    },
    "scripts": {
      "customMethods": [
        {
          "name": "setAssetPanels",
          "params": [],
          "script": "\n\tassetInfo \u003d self.view.custom.get(\u0027assetInfo\u0027,{}) or {}\n\tassetId \u003d assetInfo.get(\u0027assetId\u0027)\n\tassetPanels \u003d self.view.custom.get(\u0027assetPanels\u0027,{})\n\t\n\tif assetId is None or assetPanels is None: return\n\n\tself.view.custom.viewPanels \u003d  {\n\t\t\t\u0027body\u0027: {\"viewParams\": {\"value\": {\"assetId\": assetId}}, \"viewPath\": assetPanels[\u0027bodyPanelViewPath\u0027], \"viewTitle\": \"Main Menu\"},\n\t\t\t\u0027infoPanel\u0027: {\"viewParams\": {\"value\": {\"assetId\": assetId}}, \"viewPath\": assetPanels[\u0027infoPanelPath\u0027]}\n\t\t\t}\n\t\n\treturn"
        },
        {
          "name": "getAssetPanels",
          "params": [
            "assetInfo"
          ],
          "script": "\n\tif assetInfo[\u0027assetId\u0027] is None: return {\u0027infoPanelPath\u0027: \u0027kanoa/core/dbp/blankView\u0027, \u0027bodyPanelViewPath\u0027: \u0027kanoa/core/dbp/blankView\u0027}\n\t\n\tinfoPanelPath \u003d system.kanoa.asset.getClosestAncestorAttribute(assetInfo[\u0027assetPath\u0027], \u0027_assetOpsInfoPanelViewPath\u0027) or \u0027kanoa/mes/asset/operation/infoPanel/assetInfoPanel\u0027\n\tbodyPanelViewPath \u003d system.kanoa.asset.getClosestAncestorAttribute(assetInfo[\u0027assetPath\u0027], \u0027_assetOpsViewPath\u0027) or \u0027kanoa/mes/asset/operation/opsPanel/assetOperationPanel\u0027\n\t\n\treturn {\u0027infoPanelPath\u0027: infoPanelPath, \u0027bodyPanelViewPath\u0027: bodyPanelViewPath}"
        },
        {
          "name": "takeSelectedAsset",
          "params": [
            "assetInfo"
          ],
          "script": "\t# The asset selector\u0027s assetInfo reaches this view through a two-way binding on its output param. When many\n\t# sessions start together, that binding can write an empty asset back after the selector found the asset, which\n\t# left the screen on Select Asset with the asset in the breadcrumb. This puts the page\u0027s selected asset back.\n\t# assetInfo is the selector\u0027s asset, or None to look the selected asset up. Returns True when it set one\n\tpage \u003d self.page.props.pageId\n\tpage \u003d \u0027designer\u0027 if \u0027/\u0027 in page else page\n\ttry:\n\t\tselected \u003d self.session.custom.kanoa[page][\u0027selectors\u0027][\u0027assetPath\u0027]\n\texcept:\n\t\treturn False\n\tif not selected:\n\t\treturn False\n\tcurrent \u003d self.view.custom.assetInfo\n\tif current is not None and current[\u0027assetId\u0027] is not None and current[\u0027assetPath\u0027] \u003d\u003d selected:\n\t\treturn False\n\tif assetInfo is None:\n\t\tassetInfo \u003d system.kanoa.utilities.convertDatasetRowToJSON(system.kanoa.asset.getAssets({\u0027assetPath\u0027: selected}), 0)\n\tif not assetInfo or assetInfo[\u0027assetId\u0027] is None or assetInfo[\u0027assetPath\u0027] !\u003d selected:\n\t\treturn False\n\tsystem.util.getLogger(\u0027kanoa.assetOperation\u0027).debug(\u0027Took the selected asset %s back after it was cleared at startup\u0027 % selected)\n\tself.view.custom.assetInfo \u003d assetInfo\n\treturn True"
        }
