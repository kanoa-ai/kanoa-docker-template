                {
                  "code": "\t\n\tif not value: return {\u0027value\u0027: {\u0027assetId\u0027: None, \u0027assetName\u0027: \u0027\u0027, \u0027assetPath\u0027: \u0027\u0027}}\n\treturn {\u0027value\u0027: {\u0027assetId\u0027: value[\u0027assetId\u0027], \u0027assetName\u0027: value[\u0027assetName\u0027], \u0027assetPath\u0027: value[\u0027assetPath\u0027]}}",
                  "type": "script"
                }
              ],
