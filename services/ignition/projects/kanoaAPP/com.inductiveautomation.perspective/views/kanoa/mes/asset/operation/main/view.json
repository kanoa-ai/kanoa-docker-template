      "onChange": {
        "enabled": null,
        "script": "\n#\tsystem.perspective.print(\u0027assetInfo change\u0027)\n\tif previousValue is None or currentValue.value !\u003d previousValue.value: self.getChild(\"root\").setAssetPanels()\n\n\treturn"
