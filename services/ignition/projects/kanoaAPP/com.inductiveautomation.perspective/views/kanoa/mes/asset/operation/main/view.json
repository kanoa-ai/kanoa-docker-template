        "overlayOptOut": true,
        "transforms": [
          {
            "code": "\n\treturn self.getChild(\"root\").getAssetPanels(value)",
            "type": "script"
          }
        ],
        "type": "property"
      },
      "onChange": {
        "enabled": null,
        "script": "\t\n\tself.getChild(\"root\").setAssetPanels()\n\t\n\treturn"
