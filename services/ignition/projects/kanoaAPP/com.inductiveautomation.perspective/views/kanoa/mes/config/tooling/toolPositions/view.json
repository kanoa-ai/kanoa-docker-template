{
  "custom": {
    "positions": [],
    "refresh": null,
    "selectedData": [],
    "selectedRow": null,
    "toolingAssetId": null,
    "itemOptions": [],
    "toolFlags": {
      "hasPositions": true,
      "holdsInserts": true
    },
    "state": {
      "tool": false,
      "hasPositions": true,
      "rows": 0
    }
  },
  "params": {
    "value": {
      "toolingAssetId": null
    }
  },
  "propConfig": {
    "custom.security": {
      "binding": {
        "config": {
          "path": "session.custom.kanoa.security"
        },
        "overlayOptOut": true,
        "type": "property"
      },
      "persistent": true
    },
    "params.value": {
      "paramDirection": "input",
      "persistent": true
    },
    "custom.toolingAssetId": {
      "binding": {
        "config": {
          "path": "view.params.value"
        },
        "overlayOptOut": true,
        "transforms": [
          {
            "code": "\n\treturn value.get('toolingAssetId') if value else None",
            "type": "script"
          }
        ],
        "type": "property"
      },
      "persistent": true
    },
    "custom.positions": {
      "binding": {
        "config": {
          "struct": {
            "toolingAssetId": "{view.custom.toolingAssetId}",
            "refresh": "{view.custom.refresh}"
          },
          "waitOnAll": true
        },
        "overlayOptOut": true,
        "transforms": [
          {
            "code": "\n\tif value['toolingAssetId'] is None: return []\n\tdata = system.kanoa.tooling.getPositions({'toolingAssetId': value['toolingAssetId']})\n\t# None, not [], when they didn't load: saving an empty list would delete the tool's positions\n\tif not hasattr(data, 'getRowCount'): return None\n\trows = system.kanoa.utilities.convertDatasetToJSON(data)\n\treturn [{'rowKey': i, 'positionNumber': r['positionNumber'], 'positionType': r['positionType'], 'name': r['name'] or '', 'itemId': r['itemId'],\n\t\t\t 'itemName': r['itemName'] or '', 'outputQty': r['outputQty'], 'isBlocked': bool(r['isBlocked']), 'isRetired': bool(r['isRetired'])} for i, r in enumerate(rows)]",
            "type": "script"
          }
        ],
        "type": "expr-struct"
      },
      "persistent": true
    },
    "custom.selectedData": {
      "binding": {
        "config": {
          "struct": {
            "rows": "{view.custom.positions}",
            "row": "{view.custom.selectedRow}"
          },
          "waitOnAll": true
        },
        "overlayOptOut": true,
        "transforms": [
          {
            "code": "\n\trows = value['rows'] or []\n\trow = value['row']\n\tif row is None or row < 0 or row >= len(rows): return []\n\treturn [dict(rows[row])]",
            "type": "script"
          }
        ],
        "type": "expr-struct"
      }
    },
    "custom.itemOptions": {
      "binding": {
        "config": {
          "expression": "now(0)"
        },
        "overlayOptOut": true,
        "transforms": [
          {
            "code": "\n\trows = system.kanoa.utilities.convertDatasetToJSON(system.kanoa.item.getItems({'enabled': True}) or [])\n\treturn [{'value': r['itemId'], 'label': r['itemName']} for r in rows]",
            "type": "script"
          }
        ],
        "type": "expr"
      },
      "persistent": true
    },
    "custom.toolFlags": {
      "binding": {
        "config": {
          "struct": {
            "toolingAssetId": "{view.custom.toolingAssetId}",
            "refresh": "{view.custom.refresh}"
          },
          "waitOnAll": true
        },
        "overlayOptOut": true,
        "transforms": [
          {
            "code": "\n\t# Unknown (no tool, or the read failed): allow everything and let savePositions decide\n\tflags = {'hasPositions': True, 'holdsInserts': True}\n\tif value['toolingAssetId'] is None: return flags\n\ttools = system.kanoa.tooling.getTools({'toolingAssetId': value['toolingAssetId']})\n\tif hasattr(tools, 'getRowCount') and tools.getRowCount() == 1:\n\t\tflags = {'hasPositions': bool(tools.getValueAt(0, 'hasPositions')), 'holdsInserts': bool(tools.getValueAt(0, 'holdsInserts'))}\n\treturn flags",
            "type": "script"
          }
        ],
        "type": "expr-struct"
      },
      "persistent": true
    },
    "custom.state": {
      "binding": {
        "config": {
          "struct": {
            "toolingAssetId": "{view.custom.toolingAssetId}",
            "flags": "{view.custom.toolFlags}",
            "positions": "{view.custom.positions}"
          },
          "waitOnAll": true
        },
        "overlayOptOut": true,
        "transforms": [
          {
            "code": "\n\treturn {'tool': value['toolingAssetId'] is not None, 'hasPositions': bool(value['flags']['hasPositions']),\n\t\t\t'rows': len(value['positions'] or [])}",
            "type": "script"
          }
        ],
        "type": "expr-struct"
      },
      "persistent": true
    }
  },
  "props": {
    "defaultSize": {
      "height": 500,
      "width": 950
    }
  },
