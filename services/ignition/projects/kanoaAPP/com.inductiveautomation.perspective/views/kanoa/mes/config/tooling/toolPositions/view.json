                  "config": {
                    "script": "\n\tif self.view.custom.positions is None:\n\t\tsystem.kanoa.toast.show({'type': 'error', 'message': \"The tool's positions didn't load, so they can't be changed. Close the tool and open it again.\"})\n\t\treturn\n\trows = [dict(r) for r in self.view.custom.positions]\n\tvalue = event.value\n\tif event.column in ('positionNumber', 'outputQty'):\n\t\ttry: value = int(value)\n\t\texcept: value = None\n\trows[event.row][event.column] = value\n\tself.view.custom.positions = rows\n\treturn"
                  },
                  "scope": "G",
                  "type": "script"
