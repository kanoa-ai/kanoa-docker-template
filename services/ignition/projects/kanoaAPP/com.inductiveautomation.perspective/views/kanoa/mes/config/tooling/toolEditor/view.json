{
  "custom": {
    "refresh": null,
    "toolingAssetId": null
  },
  "params": {
    "value": {
      "toolingAssetId": null
    }
  },
  "propConfig": {
    "custom.security": {
      "binding": {
        "config": {
          "path": "session.custom.kanoa.security"
        },
        "overlayOptOut": true,
        "type": "property"
      },
      "persistent": true
    },
    "params.value": {
      "paramDirection": "input",
      "persistent": true
    },
    "custom.toolingAssetId": {
      "binding": {
        "config": {
          "path": "view.params.value"
        },
        "overlayOptOut": true,
        "transforms": [
          {
            "code": "\n\treturn value.get(\u0027toolingAssetId\u0027) if value else None",
            "type": "script"
          }
        ],
        "type": "property"
      },
      "persistent": true
    }
  },
  "props": {
    "defaultSize": {
      "height": 720,
      "width": 1000
    }
  },
  "root": {
    "meta": {
      "name": "root"
    },
    "props": {
      "direction": "column",
      "style": {
        "classes": "kanoa/font/default",
        "gap": 5,
        "overflow": "hidden",
        "padding": 5
      }
    },
    "type": "ia.container.flex",
    "children": [
      {
        "meta": {
          "name": "lblTitle"
        },
        "position": {
          "basis": "30px",
          "shrink": 0
        },
        "propConfig": {
          "props.text": {
            "binding": {
              "config": {
                "struct": {
                  "toolingAssetId": "{view.custom.toolingAssetId}",
                  "refresh": "{view.custom.refresh}"
                },
                "waitOnAll": true
              },
              "overlayOptOut": true,
              "transforms": [
                {
                  "code": "\n\tif value[\u0027toolingAssetId\u0027] is None: return \u0027New tool\u0027\n\trows \u003d system.kanoa.utilities.convertDatasetToJSON(system.kanoa.tooling.getCounters({\u0027toolingAssetId\u0027: value[\u0027toolingAssetId\u0027]}) or [])\n\tif not rows: return \u0027\u0027\n\treturn \u0027%s  |  %s%s\u0027 % (rows[0][\u0027toolingPath\u0027], rows[0][\u0027status\u0027], (\u0027  |  \u0027 + rows[0][\u0027message\u0027]) if rows[0][\u0027message\u0027] else \u0027\u0027)",
                  "type": "script"
                }
              ],
              "type": "expr-struct"
            }
          }
        },
        "props": {
          "style": {
            "classes": "kanoa/font/default",
            "fontWeight": "bold",
            "paddingLeft": "5px"
          }
        },
        "type": "ia.display.label"
      },
      {
        "meta": {
          "name": "tabs"
        },
        "position": {
          "grow": 1
        },
        "propConfig": {
          "props.tabs": {
            "binding": {
              "config": {
                "path": "view.custom.toolingAssetId"
              },
              "overlayOptOut": true,
              "transforms": [
                {
                  "code": "\n\t# A new tool shows only Details until it\u0027s saved: the other tabs need the tool, and leaving Details would lose what\u0027s been typed\n\tif value is None: return [\u0027Details\u0027]\n\treturn [\u0027Details\u0027, \u0027Positions\u0027, \u0027Life\u0027, \u0027Cycle Rates\u0027, \u0027Fits On\u0027, \u0027History\u0027, \u0027Maintenance\u0027]",
                  "type": "script"
                }
              ],
              "type": "property"
            }
          }
        },
        "props": {
          "menuType": "modern",
          "tabSize": {
            "width": 130
          },
          "tabStyle": {
            "active": {
              "classes": "kanoa/font/default"
            },
            "inactive": {
              "classes": "kanoa/font/default"
            }
          },
          "tabs": [
            "Details",
            "Positions",
            "Life",
            "Cycle Rates",
            "Fits On",
            "History",
            "Maintenance"
          ]
        },
        "type": "ia.container.tab",
        "children": [
          {
            "meta": {
              "name": "evDetails"
            },
            "position": {
              "grow": 1
            },
            "propConfig": {
              "props.params": {
                "binding": {
                  "config": {
                    "path": "view.custom.toolingAssetId"
                  },
                  "overlayOptOut": true,
                  "transforms": [
                    {
                      "code": "\n\treturn {\u0027value\u0027: {\u0027toolingAssetId\u0027: value}}",
                      "type": "script"
                    }
                  ],
                  "type": "property"
                }
              }
            },
            "props": {
              "path": "kanoa/mes/config/tooling/toolDetails"
            },
            "type": "ia.display.view"
          },
          {
            "meta": {
              "name": "evPositions"
            },
            "position": {
              "tabIndex": 1
            },
            "propConfig": {
              "props.params": {
                "binding": {
                  "config": {
                    "path": "view.custom.toolingAssetId"
                  },
                  "overlayOptOut": true,
                  "transforms": [
                    {
                      "code": "\n\treturn {\u0027value\u0027: {\u0027toolingAssetId\u0027: value}}",
                      "type": "script"
                    }
                  ],
                  "type": "property"
                }
              }
            },
            "props": {
              "path": "kanoa/mes/config/tooling/toolPositions"
            },
            "type": "ia.display.view"
          },
          {
            "meta": {
              "name": "evLife"
            },
            "position": {
              "tabIndex": 2
            },
            "propConfig": {
              "props.params": {
                "binding": {
                  "config": {
                    "path": "view.custom.toolingAssetId"
                  },
                  "overlayOptOut": true,
                  "transforms": [
                    {
                      "code": "\n\treturn {\u0027value\u0027: {\u0027toolingAssetId\u0027: value}}",
                      "type": "script"
                    }
                  ],
                  "type": "property"
                }
              }
            },
            "props": {
              "path": "kanoa/mes/config/tooling/toolLife"
            },
            "type": "ia.display.view"
          },
          {
            "meta": {
              "name": "evRates"
            },
            "position": {
              "tabIndex": 3
            },
            "propConfig": {
              "props.params": {
                "binding": {
                  "config": {
                    "path": "view.custom.toolingAssetId"
                  },
                  "overlayOptOut": true,
                  "transforms": [
                    {
                      "code": "\n\treturn {\u0027value\u0027: {\u0027toolingAssetId\u0027: value}}",
                      "type": "script"
                    }
                  ],
                  "type": "property"
                }
              }
            },
            "props": {
              "path": "kanoa/mes/config/tooling/toolRates"
            },
            "type": "ia.display.view"
          },
          {
            "meta": {
              "name": "evFits"
            },
            "position": {
              "tabIndex": 4
            },
            "propConfig": {
              "props.params": {
                "binding": {
                  "config": {
                    "path": "view.custom.toolingAssetId"
                  },
                  "overlayOptOut": true,
                  "transforms": [
                    {
                      "code": "\n\treturn {\u0027value\u0027: {\u0027toolingAssetId\u0027: value}}",
                      "type": "script"
                    }
                  ],
                  "type": "property"
                }
              }
            },
            "props": {
              "path": "kanoa/mes/config/tooling/toolFits"
            },
            "type": "ia.display.view"
          },
          {
            "meta": {
              "name": "evHistory"
            },
            "position": {
              "tabIndex": 5
            },
            "propConfig": {
              "props.params": {
                "binding": {
                  "config": {
                    "path": "view.custom.toolingAssetId"
                  },
                  "overlayOptOut": true,
                  "transforms": [
                    {
                      "code": "\n\treturn {\u0027value\u0027: {\u0027toolingAssetId\u0027: value}}",
                      "type": "script"
                    }
                  ],
                  "type": "property"
                }
              }
            },
            "props": {
              "path": "kanoa/mes/config/tooling/toolHistory"
            },
            "type": "ia.display.view"
          },
          {
            "meta": {
              "name": "evMaintenance"
            },
            "position": {
              "tabIndex": 6
            },
            "propConfig": {
              "props.params": {
                "binding": {
                  "config": {
                    "path": "view.custom.toolingAssetId"
                  },
                  "overlayOptOut": true,
                  "transforms": [
                    {
                      "code": "\n\treturn {\u0027value\u0027: {\u0027toolingAssetId\u0027: value}}",
                      "type": "script"
                    }
                  ],
                  "type": "property"
                }
              }
            },
            "props": {
              "path": "kanoa/mes/config/tooling/toolMaintenance"
            },
            "type": "ia.display.view"
          }
        ]
      },
      {
        "meta": {
          "name": "flxActions"
        },
        "position": {
          "shrink": 0
        },
        "props": {
          "justify": "center",
          "style": {
            "gap": "5px",
            "overflow": "hidden",
            "padding": "5px"
          }
        },
        "type": "ia.container.flex",
        "children": [
          {
            "events": {
              "component": {
                "onActionPerformed": {
                  "config": {
                    "script": "\n\tsystem.perspective.closePopup(\u0027\u0027)\n\treturn"
                  },
                  "scope": "G",
                  "type": "script"
                }
              }
            },
            "meta": {
              "name": "btnClose"
            },
            "position": {
              "shrink": 0
            },
            "props": {
              "image": {
                "icon": {
                  "path": "material/exit_to_app"
                }
              },
              "style": {
                "classes": "kanoa/button/outlined"
              },
              "text": "Close"
            },
            "type": "ia.input.button"
          }
        ]
      }
    ],
    "scripts": {
      "customMethods": [],
      "extensionFunctions": null,
      "messageHandlers": [
        {
          "messageType": "toolUpdated",
          "pageScope": true,
          "script": "\n\tif payload.get(\u0027toolingAssetId\u0027) is not None: self.view.custom.toolingAssetId \u003d payload[\u0027toolingAssetId\u0027]\n\tself.view.custom.refresh \u003d system.date.now()\n\treturn",
          "sessionScope": false,
          "viewScope": false
        }
      ]
    }
  }
}