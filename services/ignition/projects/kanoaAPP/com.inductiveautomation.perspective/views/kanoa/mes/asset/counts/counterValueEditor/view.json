    "custom.counterInfo": {
      "binding": {
        "config": {
          "path": "view.params.value"
        },
        "overlayOptOut": true,
        "type": "property"
      },
      "onChange": {
        "enabled": null,
        "script": "\n\tsystem.perspective.print(\"params change %s\"%origin)\n\t\n\tif origin in (\u0027Script\u0027, \u0027BindingWriteback\u0027): self.custom.changesMade \u003d True\n\t\n\treturn"
      },
      "persistent": true
    },
    "params.value": {
      "paramDirection": "input",
      "persistent": true
    },
    "params.units": {
      "paramDirection": "input",
      "persistent": true
    },
    "custom.itemStateOptions": {
      "binding": {
        "config": {
          "struct": {
            "counterId": "{view.custom.counterInfo.counterId}",
            "params": "{view.params.value}"
          },
          "waitOnAll": false
        },
        "transforms": [
          {
            "code": "\t#The item states linked to the asset or an asset above it, enabled, for the chosen counter\u0027s type (a state for any\n\t#counter always), as on the Buttons tab; until a counter is chosen, only those for any counter. The count\u0027s own state\n\t#stays listed even if it\u0027s no longer linked\n\tparams \u003d value[\u0027params\u0027]\n\tassetPath \u003d system.kanoa.utilities.getFieldValue(\u0027assetPath\u0027, system.kanoa.asset.getAssets({\u0027assetId\u0027: params[\u0027assetId\u0027]})) if params[\u0027assetId\u0027] else None\n\tcounterType \u003d system.kanoa.utilities.getFieldValue(\u0027counterTypeName\u0027, system.kanoa.asset.getCounter({\u0027counterId\u0027: value[\u0027counterId\u0027]})) if value[\u0027counterId\u0027] else None\n\toptions \u003d []\n\tseen \u003d set()\n\tif assetPath:\n\t\tfor row in system.dataset.toPyDataSet(system.kanoa.item.getAssetItemStates({\u0027assetPath\u0027: assetPath, \u0027enabled\u0027: True})):\n\t\t\tif row[\u0027itemStateId\u0027] in seen: continue\n\t\t\tif row[\u0027counterTypeName\u0027] and row[\u0027counterTypeName\u0027] !\u003d counterType: continue\n\t\t\tseen.add(row[\u0027itemStateId\u0027])\n\t\t\toptions.append({\u0027value\u0027: row[\u0027itemStateId\u0027], \u0027label\u0027: system.kanoa.utilities.formatPath(row[\u0027itemStatePath\u0027], {})})\n\tif params[\u0027itemStateId\u0027] is not None and params[\u0027itemStateId\u0027] not in seen:\n\t\tlabel \u003d system.kanoa.utilities.formatPath(params[\u0027itemStatePath\u0027], {}) if params[\u0027itemStatePath\u0027] else str(params[\u0027itemStateId\u0027])\n\t\toptions.append({\u0027value\u0027: params[\u0027itemStateId\u0027], \u0027label\u0027: label})\n\treturn options",
            "type": "script"
          }
        ],
        "type": "expr-struct"
      }
    }
  },
