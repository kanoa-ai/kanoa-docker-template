{
  "custom": {},
  "params": {},
  "props": {
    "defaultSize": {
      "width": 1430
    }
  },
  "root": {
    "children": [
      {
        "children": [
          {
            "meta": {
              "name": "evSourceTypes"
            },
            "props": {
              "path": "kanoa/mes/config/measures/sourceTypeManager"
            },
            "type": "ia.display.view"
          },
          {
            "meta": {
              "name": "evAggregationTypes"
            },
            "position": {
              "tabIndex": 1
            },
            "props": {
              "path": "kanoa/mes/config/measures/aggregationManager"
            },
            "type": "ia.display.view"
          },
          {
            "meta": {
              "name": "evMeasures"
            },
            "position": {
              "tabIndex": 2
            },
            "props": {
              "path": "kanoa/mes/config/measures/measureManager"
            },
            "type": "ia.display.view"
          }
        ],
        "meta": {
          "name": "tabs"
        },
        "position": {
          "grow": 1
        },
        "propConfig": {
          "props.currentTabIndex": {
            "binding": {
              "config": {
                "expression": "now(0)"
              },
              "overlayOptOut": true,
              "transforms": [
                {
                  "code": "\treturn 2",
                  "type": "script"
                }
              ],
              "type": "expr"
            }
          }
        },
        "props": {
          "menuType": "modern",
          "tabSize": {
            "width": 130
          },
          "tabStyle": {
            "active": {
              "classes": "kanoa/font/default"
            },
            "inactive": {
              "classes": "kanoa/font/default"
            }
          },
          "tabs": [
            "Source Types",
            "Aggregation Types",
            "Measures"
          ]
        },
        "type": "ia.container.tab"
      }
    ],
    "meta": {
      "name": "root"
    },
    "props": {
      "direction": "column"
    },
    "type": "ia.container.flex"
  }
}