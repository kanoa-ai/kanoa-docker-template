# Copy this file to .env and set your own values.
# .env is gitignored and should never be committed.

# Docker Compose project settings.
COMPOSE_PROJECT_NAME=kanoa-docker-template
# Only use in the case of needed compose overrides.
# COMPOSE_FILE=docker-compose.yaml:.local/docker-compose.override.yaml

# SQL Server SA password.
# Must meet SQL Server complexity requirements: at least 8 characters and
# include characters from at least three of: uppercase, lowercase, digits, symbols.
SA_PASSWORD=P@ssword1!

# Application database created automatically by the db-init service on startup.
# If you change this, also update the Ignition connection at:
#   services/.../ignition/database-connection/kanoaCore/config.json
DB_NAME=kanoa
